class _DblClickGuard(QObject):
    """يبتلع النقر المزدوج لحظة بعد الانتقال بنقرة على رابط، حتى لا يصيب الصفحةَ الجديدة التي ظهرت تحت المؤشر."""

    def eventFilter(self, obj, ev):
        return ev.type() == QEvent.MouseButtonDblClick


class MainWindow(QMainWindow):
    def __init__(self, session, prefs=None, progress=None):
        super().__init__()
        report = progress or startup.noop                    # progress(fraction, text) من شاشة التحميل
        self.session = session
        self.prefs = prefs or Prefs()
        self.state = AppState()
        self.access = Access(session.can)
        self.runner = TaskRunner(session, self)
        from .update_flow import UpdateController
        self.updates = UpdateController(self)                # زر «البحث عن تحديثات»
        from .auto_backup import AutoBackup
        self.auto_backup = AutoBackup(self)                  # يجب أن يُنشأ قبل استعادة التبويبات: صفحة «النسخ الاحتياطي» تستعمله عند بنائها
        self.logout_requested = False
        self.restart_requested = False                       # إغلاق من أجل تطبيق تحديث (يقرأه launcher)
        self._features = {}
        from alhisabat.ui.core.drafts import DraftStore
        self.drafts = DraftStore(APP_DIR / 'drafts', session.username())     # مسودات الإدخال (استئناف بعد انقطاع التيار)
        from alhisabat.system import year_archive
        self.is_archive = bool(year_archive.archive_label())
        self.setWindowTitle(S.APP_TITLE + (f' — {branding.PRODUCT_NAME} {year_archive.archive_label()} (أرشيف)' if year_archive.archive_label() else ''))
        self.resize(1500, 920)
        self.setMinimumSize(1100, 700)
        self.setLayoutDirection(Qt.RightToLeft)

        self.state.update(mode=self.prefs.get('mode'), density=self.prefs.get('density'), digits=self.prefs.get('digits'))
        T.set_active(self.state.get('mode'))
        fmt.configure(digits=self.state.get('digits'))
        session.load_context(self.state)
        report(0.55, 'تحميل بيانات الشركة…')
        self._detect_features()
        opts = print_settings.load(self.prefs, session.username())      # إعدادات طباعة هذا المستخدم
        print_settings.apply(opts)
        print_settings.set_user(session.username())
        self.prefs.set('paper', opts.paper)

        root = QWidget()
        self.setCentralWidget(root)
        col = QVBoxLayout(root)
        col.setContentsMargins(0, 0, 0, 0)
        col.setSpacing(0)
        self.context_bar = ContextBar(self.state)
        self.context_bar.branchSelected.connect(self._switch_branch)
        self.ribbon = RibbonBar(self.access)
        self.topbar = TopNavBar(self, self._build_user_menu())
        self.notif_btn, self.notif_menu = self.topbar.notif_btn, self.topbar.notif_menu
        self.tabs = TabWorkspace(lambda key, params: registry.create(key, self, params))
        self.tabs.currentPageChanged.connect(self._on_page_changed)
        self.tabs.limitReached.connect(lambda msg: QMessageBox.information(self, S.APP_NAME, msg))
        for w in (self.topbar, self.context_bar, self.ribbon):
            col.addWidget(w)
        col.addWidget(self.tabs, 1)

        report(0.65, 'بناء الواجهة…')
        self._build_statusbar()
        self._shortcuts()
        self.state.subscribe(self._on_state)
        self.palette = CommandPalette(self)
        registry.load_builtin()
        report(0.78, 'تطبيق المظهر…')
        self.apply_theme()
        self._restoring = True                                   # أخطاء الصفحات أثناء الاستعادة لا تُظهر نوافذ مشروطة
        try:
            self._restore_tabs(report)
        finally:
            self._restoring = False
        report(1.0, 'اكتمل')
        QTimer.singleShot(400, self.refresh_notifications)
        QTimer.singleShot(1300, self._offer_draft_recovery)
        self.auto_backup.start()

    # ------------------------------------------------------------------ ميزات/صلاحيات
    def features(self):
        return self._features

    def _detect_features(self):
        try:
            self._features = {'multi_currency': self.session.multi_currency_enabled()}
        except Exception:  # noqa: BLE001
            self._features = {}

    # ------------------------------------------------------------------ قائمة المستخدم (بديل شريط القوائم)
    def _build_user_menu(self):
        m = QMenu(self)
        who = m.addAction((self.state.get('user') or {}).get('name') or 'المستخدم')
        who.setEnabled(False)
        m.addSeparator()
        view = m.addMenu('المظهر والعرض')
        self.act_theme = view.addAction(S.ACTION['theme'] + '\tCtrl+Shift+D', self.toggle_theme)
        self._build_theme_menu(view)
        dens = view.addMenu(S.ACTION['density'])
        grp = QActionGroup(self)
        for key, label in (('compact', 'مضغوط (الافتراضي)'), ('comfortable', 'مريح')):
            a = dens.addAction(label)
            a.setCheckable(True)
            a.setChecked(self.state.get('density') == key)
            grp.addAction(a)
            a.triggered.connect(lambda _c=False, k=key: self.set_density(k))
        digs = view.addMenu('الأرقام')
        grp2 = QActionGroup(self)
        for key, label in (('latin', 'لاتينية 1234'), ('arabic', 'عربية ١٢٣٤')):
            a = digs.addAction(label)
            a.setCheckable(True)
            a.setChecked(self.state.get('digits') == key)
            grp2.addAction(a)
            a.triggered.connect(lambda _c=False, k=key: self.set_digits(k))
        self.act_adv = view.addAction('إظهار الخيارات المتقدمة')
        self.act_adv.setCheckable(True)
        self.act_adv.setChecked(self.prefs.get('show_advanced'))
        self.act_adv.toggled.connect(self.set_show_advanced)
        self.act_inline = view.addAction('عرض نماذج الإدخال داخل الصفحة (بدل النوافذ)')
        self.act_inline.setCheckable(True)
        self.act_inline.setChecked(bool(self.prefs.get('inline_forms')))
        self.act_inline.toggled.connect(lambda f: self.prefs.set('inline_forms', bool(f)))
        m.addAction('تحديث الصفحة\tF5', self.refresh_current)
        m.addSeparator()
        m.addAction('البحث عن تحديثات…', self.updates.check_now)
        m.addAction('حول البرنامج', self._about)
        m.addSeparator()
        m.addAction(S.ACTION['logout'], self.logout)
        m.addAction(S.ACTION['exit'], self.close)
        return m

    def _about(self):
        box = QMessageBox(self)
        box.setWindowTitle(S.APP_NAME)
        box.setText(f'{branding.PRODUCT_NAME}\nالإصدار {VERSION}\nمن تطوير {branding.COMPANY_NAME}')
        pm = logo_pixmap(self.state.get('mode'), 150)
        if pm is not None:
            box.setIconPixmap(pm)

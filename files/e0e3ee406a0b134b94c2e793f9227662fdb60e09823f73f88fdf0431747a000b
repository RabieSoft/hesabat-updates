import json


def log(conn, user_id, action, table, record_id, before=None, after=None, reason=None):
    conn.execute(
        "INSERT INTO audit_log(user_id,action,table_name,record_id,before_json,after_json,reason) VALUES(?,?,?,?,?,?,?)",
        (user_id, action, table, record_id,
         json.dumps(before, ensure_ascii=False) if before is not None else None,
         json.dumps(after, ensure_ascii=False) if after is not None else None, reason))

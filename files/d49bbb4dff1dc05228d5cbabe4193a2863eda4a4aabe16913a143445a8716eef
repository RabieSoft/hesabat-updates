        self.actions_changed.emit()

    def _load_expiry(self):
        try:
            self.e_grid.set_rows(self.svc.expiry_report(status=self.e_filter.currentData()))
            s = self.svc.expiry_summary()
            self.e_summary.setText(f"منتهي: {s['expired_lots']} دفعة · قريب الانتهاء: {s['near_lots']} دفعة")
        except Exception as e: self.show_error(e)

    def _writeoff_state(self):
        st = self.access.state('inventory.adjust')
        if not st.enabled: return st
        if not self._exp_sel or self._exp_sel.get('status') != 'expired': return ActionState(False, 'حدد دفعة منتهية من تبويب الصلاحية')
        return ActionState(True)

    def _writeoff(self):
        from decimal import Decimal as _D
        from alhisabat.ui.app_dialogs.inventory import AdjustDialog
        r = self._exp_sel
        d = AdjustDialog(self, preset={'item_id': r['item_id'], 'warehouse_id': r['warehouse_id'], 'lot_id': r['lot_id'],
                                       'qty': f"{_D(r['qty_milli']) / 1000:f}".rstrip('0').rstrip('.'), 'reason': 'إتلاف — منتهي الصلاحية'})
        if self.exec_form(d):
            ok, _ = self.guarded(self.svc.adjust, d.values(), reload=False)
            if ok: self.notify('تم إتلاف الدفعة المنتهية بنجاح'); self.refresh(); self.window_.data_changed(self.key)

    def _assign_expiry(self):
        from alhisabat.ui.app_dialogs.inventory import AssignExpiryDialog
        d = AssignExpiryDialog(self)
        if self.exec_form(d):
            v = d.values()
            ok, _ = self.guarded(self.svc.assign_untracked, v['item_id'], v['warehouse_id'], v['expiry_date'], v['lot_no'], v['qty'], reload=False)
            if ok: self.notify('تم تحديد تاريخ الانتهاء للرصيد'); self.refresh(); self.window_.data_changed(self.key)


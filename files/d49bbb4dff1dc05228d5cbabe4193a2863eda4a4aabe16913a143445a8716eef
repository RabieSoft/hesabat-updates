    def _on_count_select(self, rows):
        self._count_sel = rows[0] if len(rows) == 1 else None
        self.actions_changed.emit()

    def _load_counts(self):
        try:
            rows = self.svc.list_counts(); self.c_grid.set_rows(rows)
        except Exception as e: self.show_error(e)

    def _count_action_state(self, kind):
        c_state = self.access.state('inventory.count')
        if not c_state.enabled: return c_state
        if not self._count_sel: return ActionState(False, 'حدد عملية جرد أولًا من تبويب الجرد')
        st = self._count_sel.get('status')
        if st != 'draft': return ActionState(False, f'العملية متاحة للجرد المسودة فقط (الحالة الحالية: {st})')
        return ActionState(True)

    def ribbon_groups(self):
        return [
            ActionGroup('عمليات', [
                Action('transfer', 'تحويل مخزني', 'transfer', state_fn=lambda: self.access.state('inventory.transfer'), handler=self._transfer),
                Action('adjust', 'تسوية مخزنية', 'edit', state_fn=lambda: self.access.state('inventory.adjust'), handler=self._adjust),
                Action('opening_stock', 'أرصدة أول المدة', 'coins', state_fn=lambda: self.access.state('inventory.adjust'), handler=self._opening_stock),
                Action('assign_expiry', 'تأريخ رصيد قديم', 'edit', state_fn=lambda: self.access.state('inventory.manage'), handler=self._assign_expiry),
                Action('writeoff_expired', 'إتلاف دفعة منتهية', 'delete', danger=True, state_fn=self._writeoff_state, handler=self._writeoff),
                Action('new_count', 'جرد جديد', 'new', state_fn=lambda: self.access.state('inventory.count'), handler=self._new_count),
                Action('post_count', 'ترحيل الجرد', 'post', state_fn=lambda: self._count_action_state('post'), handler=self._post_count),
                Action('cancel_count', 'إلغاء الجرد', 'delete', danger=True, state_fn=lambda: self._count_action_state('cancel'), handler=self._cancel_count)
            ]),
            ActionGroup('عرض', [
                Action('print', 'طباعة', 'print', handler=lambda: self.sheet.print_()),
                Action('print_wh', 'طباعة كل مستودع', 'print', handler=self._print_warehouses),
                Action('refresh', 'تحديث', 'refresh', handler=self.refresh)
            ])
        ]

    def _transfer(self):
        from alhisabat.ui.app_dialogs.inventory import TransferDialog
        d = TransferDialog(self)
        if self.exec_form(d):
            ok, _ = self.guarded(self.svc.transfer, d.values(), reload=False)
            if ok: self.notify('تم تسجيل التحويل بنجاح'); self.refresh(); self.window_.data_changed(self.key)

    def _adjust(self):
        from alhisabat.ui.app_dialogs.inventory import AdjustDialog
        d = AdjustDialog(self)
        if self.exec_form(d):
            ok, _ = self.guarded(self.svc.adjust, d.values(), reload=False)
            if ok: self.notify('تمت التسوية المخزنية بنجاح'); self.refresh(); self.window_.data_changed(self.key)

    def resume_draft(self, dialog_id):
        """استئناف نافذة إدخال من مسودة محفوظة (يُستدعى من MainWindow بعد موافقة المستخدم)."""
        if dialog_id == 'opening_stock':
            self._opening_stock(resume=True)

    def _opening_stock(self, resume=False):
        from alhisabat.ui.app_dialogs.inventory import OpeningStockDialog
        from alhisabat.ui.components.basic import show_singleton
        # غير مقيِّدة: يمكن تصغيرها («–») والعمل في الشاشة ثم العودة إليها؛ الضغط على الزر مجددًا يُرجع نفس النافذة
        show_singleton(self, '_opening_stock_dlg', lambda: OpeningStockDialog(self, resume=resume))

    def _new_count(self):
        from alhisabat.ui.app_dialogs.inventory import CountDialog
        d = CountDialog(self)
        if self.exec_form(d):
            vals = d.values()
            ok, _ = self.guarded(self.svc.create_count, vals['warehouse_id'], vals['date'], vals.get('is_full', False), vals.get('note', ''), reload=False)
            if ok: self.notify('تم إنشاء مسودة الجرد'); self.refresh(); self.window_.data_changed(self.key)

    def _post_count(self):
        if not self._count_sel:
            return QMessageBox.information(self, self.title, 'حدد جردًا مسودة لترحيله.')
        cid = self._count_sel['id']
        if ask_reason(self, 'ترحيل الجرد', [f"هل تريد ترحيل الجرد رقم {cid} وتوليد التسويات اللازمة؟"], need_reason=False, confirm_text='ترحيل الجرد') is None:
            return
        ok, _ = self.guarded(self.svc.post_count, cid, reload=False)
        if ok: self.notify('تم ترحيل الجرد بنجاح'); self.refresh(); self.window_.data_changed(self.key)

    def _cancel_count(self):
        if not self._count_sel:
            return QMessageBox.information(self, self.title, 'حدد جردًا مسودة لإلغائه.')
        cid = self._count_sel['id']
        reason = ask_reason(self, 'إلغاء الجرد', [f"هل تريد إلغاء الجرد رقم {cid}؟"], need_reason=True, confirm_text='إلغاء الجرد', danger=True)
        if not reason:
            return
        ok, _ = self.guarded(self.svc.cancel_count, cid, reason=reason, reload=False)
        if ok: self.notify('تم إلغاء الجرد'); self.refresh(); self.window_.data_changed(self.key)

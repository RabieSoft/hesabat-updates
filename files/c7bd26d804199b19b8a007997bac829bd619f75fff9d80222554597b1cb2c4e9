def get_purchase(conn, user_id, pid):
    h = _load(conn, pid)
    permissions.require(conn, user_id, h["company_id"], "purchases.view", h["branch_id"])
    lines = [dict(r) for r in conn.execute("SELECT l.*,i.code item_code,i.name item_name FROM purchase_invoice_lines l LEFT JOIN items i ON i.id=l.item_id "
                                           "WHERE l.invoice_id=? ORDER BY l.line_no", (pid,))]
    if h["doc_type"] == "invoice":
        for ln in lines:                       # الكمية المرتجعة سابقًا لكل بند (لنافذة المرتجع)
            ln["returned_milli"] = _returned(conn, ln["id"])[0]
    return {**dict(h), "lines": lines, "direct_costs": [dict(r) for r in conn.execute("SELECT * FROM purchase_direct_costs WHERE invoice_id=?", (pid,))],
            "payments": [dict(r) for r in conn.execute("SELECT * FROM purchase_payments WHERE invoice_id=?", (pid,))]}


def list_purchases(conn, user_id, company_id, *, doc_type=None, status=None, supplier_id=None, date_from=None, date_to=None, limit=50, offset=0, branch_id=None):
    permissions.require(conn, user_id, company_id, "purchases.view", check_branch=False)
    q, a = "SELECT * FROM purchase_invoices WHERE company_id=?", [company_id]
    for col, v, op in (("doc_type", doc_type, "="), ("status", status, "="), ("supplier_id", supplier_id, "="),
                       ("invoice_date", date_from, ">="), ("invoice_date", date_to, "<=")):
        if v is not None:
            q += f" AND {col}{op}?"; a.append(v)
    restricted = [r[0] for r in conn.execute("SELECT branch_id FROM user_branch_access WHERE user_id=?", (user_id,))]
    if restricted:
        q += " AND branch_id IN (%s)" % ",".join("?" * len(restricted)); a += restricted
    f, fa = branch_scope.txn_clause(conn, company_id, branch_id)
    q += f; a += fa
    return [dict(r) for r in conn.execute(q + " ORDER BY invoice_date DESC,id DESC LIMIT ? OFFSET ?", (*a, min(int(limit), 500), int(offset)))]


def purchase_summary(conn, user_id, company_id, date_from, date_to, group_by="supplier"):
    """صافي المشتريات (فواتير − مرتجعات مرحّلة) حسب المورد/الصنف/اليوم وحسب عملة المستند (لا جمع بين العملات). تقرير تشغيلي."""
    permissions.require(conn, user_id, company_id, "purchases.view", check_branch=False)
    permissions.require(conn, user_id, company_id, "report.view", check_branch=False)
    key = {"supplier": "COALESCE(h.supplier_id,0)", "item": "COALESCE(l.item_id,0)", "day": "h.invoice_date"}.get(group_by)
    if not key:
        raise AccountingError("تجميع غير معروف")
    sgn = "CASE h.doc_type WHEN 'invoice' THEN 1 ELSE -1 END"
    return [dict(r) for r in conn.execute(
        f"SELECT {key} k,h.currency cur,SUM({sgn}*l.net_ex) net_ex,SUM({sgn}*l.tax_minor) tax,SUM({sgn}*l.cost_share_minor) landed_costs,"
        f"SUM({sgn}*(l.net_ex+l.tax_minor+l.cost_share_minor)) total FROM purchase_invoice_lines l JOIN purchase_invoices h ON h.id=l.invoice_id "
        f"WHERE h.company_id=? AND h.status='posted' AND h.invoice_date BETWEEN ? AND ? GROUP BY k,h.currency ORDER BY k,h.currency",
        (company_id, date_from, date_to))]


def preview_totals(conn, company_id, lines, *, discount_percent=None, discount_amount=None):
    """معاينة إجماليات فاتورة شراء دون أي كتابة (v1.6): نفس مسار الحفظ (_prep_lines ← compute_lines). القيم بالوحدة الصغرى."""
    prepped = _prep_lines(conn, company_id, lines)
    dt, dv = sales._disc(discount_percent, discount_amount)
    T = dict(sales.compute_lines(prepped, dt, dv))
    T["lines"] = [{"idx": l["idx"], "amount": l["amount"], "line_discount": l["ld"], "tax": l["tax"], "total": l["total"]} for l in prepped]
    return T

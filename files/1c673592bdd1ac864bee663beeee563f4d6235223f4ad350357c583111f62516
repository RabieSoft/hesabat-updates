"""دمج حقول قوالب الرسائل بأمان تام (بلا eval).

خالص بلا Qt وبلا اعتماد على محرك خارجي.
"""
import re
from typing import Any, Dict, List, Set

# خريطة توحيد المفاتيح (عربي وإنجليزي)
_CANONICAL_KEYS = {
    "name": "الاسم",
    "الاسم": "الاسم",
    "invoice_no": "رقم_الفاتورة",
    "رقم_الفاتورة": "رقم_الفاتورة",
    "amount": "المبلغ",
    "المبلغ": "المبلغ",
    "currency": "العملة",
    "العملة": "العملة",
    "receipt_no": "رقم_السند",
    "رقم_السند": "رقم_السند",
    "balance": "الرصيد",
    "الرصيد": "الرصيد",
    "from_date": "من_تاريخ",
    "من_تاريخ": "من_تاريخ",
    "to_date": "إلى_تاريخ",
    "إلى_تاريخ": "إلى_تاريخ",
    "message": "الرسالة",
    "الرسالة": "الرسالة",
    "company": "الشركة",
    "الشركة": "الشركة",
    "branch": "الفرع",
    "الفرع": "الفرع",
}

_TOKEN_RE = re.compile(r"\{([^{}]+)\}")


def extract_placeholders(template: str) -> List[str]:
    """استخراج جميع الحقول المضمنة بين أقواس معقوفة {حقل}."""
    if not template:
        return []
    return [m.group(1).strip() for m in _TOKEN_RE.finditer(template)]


def render_template(template: str, context: Dict[str, Any]) -> str:
    """دمج القيم داخل القالب بأمان.

    لا يستخدم eval ولا exec. القيم تُحوّل إلى نصوص مباشرة.
    الحقول غير المتوفرة تُستبدل بشرطة '—'.
    """
    if not template:
        return ""

    # تجهيز قاموس موحّد المفاتيح
    normalized_context = {}
    for k, v in (context or {}).items():
        val_str = "" if v is None else str(v).strip()
        normalized_context[str(k).strip()] = val_str
        canon = _CANONICAL_KEYS.get(str(k).strip())
        if canon:
            normalized_context[canon] = val_str

    def _replace(match: re.Match) -> str:
        raw_key = match.group(1).strip()
        if raw_key in normalized_context:
            return normalized_context[raw_key]
        canon = _CANONICAL_KEYS.get(raw_key)
        if canon and canon in normalized_context:
            return normalized_context[canon]
        # إذا لم يُعطَ الحقل، لا نترك القوس معطوبًا بل نضع شرطة
        return "—"

    return _TOKEN_RE.sub(_replace, template)

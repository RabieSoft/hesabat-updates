CREATE TABLE units(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id), name TEXT NOT NULL CHECK(length(trim(name))>0),
  UNIQUE(company_id,name));
CREATE TABLE warehouses(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id), code TEXT NOT NULL,
  name TEXT NOT NULL CHECK(length(trim(name))>0), branch_id INTEGER REFERENCES branches(id),
  is_active INTEGER NOT NULL DEFAULT 1 CHECK(is_active IN (0,1)), UNIQUE(company_id,code), UNIQUE(company_id,name));
CREATE TABLE user_warehouse_access(
  user_id INTEGER NOT NULL REFERENCES users(id), warehouse_id INTEGER NOT NULL REFERENCES warehouses(id),
  PRIMARY KEY(user_id,warehouse_id));

CREATE TABLE items(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id), code TEXT NOT NULL,
  name TEXT NOT NULL CHECK(length(trim(name))>0), barcode TEXT NOT NULL DEFAULT '',
  item_type TEXT NOT NULL DEFAULT 'stock' CHECK(item_type IN ('stock','service')),
  base_unit_id INTEGER NOT NULL REFERENCES units(id), category TEXT NOT NULL DEFAULT '',
  min_qty_milli INTEGER NOT NULL DEFAULT 0 CHECK(min_qty_milli>=0),
  inventory_account_id INTEGER REFERENCES accounts(id), cogs_account_id INTEGER REFERENCES accounts(id),
  revenue_account_id INTEGER REFERENCES accounts(id), notes TEXT NOT NULL DEFAULT '',
  is_active INTEGER NOT NULL DEFAULT 1 CHECK(is_active IN (0,1)),
  created_by INTEGER NOT NULL REFERENCES users(id), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE(company_id,code));
CREATE UNIQUE INDEX ux_items_barcode ON items(company_id,barcode) WHERE barcode<>'';
CREATE UNIQUE INDEX ux_items_name ON items(company_id,name COLLATE NOCASE);
CREATE TABLE item_units(
  item_id INTEGER NOT NULL REFERENCES items(id), unit_id INTEGER NOT NULL REFERENCES units(id),
  factor_milli INTEGER NOT NULL CHECK(factor_milli>0),          -- كم وحدة أساس في هذه الوحدة (×1000)
  PRIMARY KEY(item_id,unit_id));

-- أرصدة المخزون: مشتقة من الحركات فقط (تُحدَّث بتريغر، وأي تعديل مباشر مرفوض)
CREATE TABLE stock_guard(id INTEGER PRIMARY KEY CHECK(id=1), active INTEGER NOT NULL DEFAULT 0);
INSERT INTO stock_guard VALUES(1,0);
CREATE TABLE stock_balances(
  item_id INTEGER NOT NULL REFERENCES items(id), warehouse_id INTEGER NOT NULL REFERENCES warehouses(id),
  qty_milli INTEGER NOT NULL DEFAULT 0, value_base INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY(item_id,warehouse_id),
  CHECK(qty_milli>=0 AND value_base>=0 AND (qty_milli>0 OR value_base=0)));
CREATE TRIGGER bal_guard_ins BEFORE INSERT ON stock_balances BEGIN
  SELECT RAISE(ABORT,'أرصدة المخزون تُحسب من الحركات فقط') WHERE (SELECT active FROM stock_guard)=0; END;
CREATE TRIGGER bal_guard_upd BEFORE UPDATE ON stock_balances BEGIN
  SELECT RAISE(ABORT,'أرصدة المخزون تُحسب من الحركات فقط') WHERE (SELECT active FROM stock_guard)=0; END;
CREATE TRIGGER bal_guard_del BEFORE DELETE ON stock_balances BEGIN
  SELECT RAISE(ABORT,'أرصدة المخزون تُحسب من الحركات فقط') WHERE (SELECT active FROM stock_guard)=0; END;

CREATE TABLE stock_movements(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id),
  item_id INTEGER NOT NULL REFERENCES items(id), warehouse_id INTEGER NOT NULL REFERENCES warehouses(id),
  movement_date TEXT NOT NULL,
  movement_type TEXT NOT NULL CHECK(movement_type IN ('opening','purchase','purchase_return','sale','sale_return',
      'adjustment_in','adjustment_out','transfer_in','transfer_out','reversal')),
  direction TEXT NOT NULL CHECK(direction IN ('in','out')),
  qty_milli INTEGER NOT NULL CHECK(qty_milli>0), value_base INTEGER NOT NULL CHECK(value_base>=0),
  ref_movement_id INTEGER REFERENCES stock_movements(id), transfer_group INTEGER,
  journal_entry_id INTEGER REFERENCES journal_entries(id), source_type TEXT, source_id INTEGER,
  note TEXT NOT NULL DEFAULT '', created_by INTEGER NOT NULL REFERENCES users(id),
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CHECK((movement_type IN ('opening','purchase','sale_return','adjustment_in','transfer_in') AND direction='in')
     OR (movement_type IN ('purchase_return','sale','adjustment_out','transfer_out') AND direction='out')
     OR movement_type='reversal'));
CREATE INDEX ix_sm_item ON stock_movements(item_id,warehouse_id,movement_date,id);
CREATE INDEX ix_sm_company_date ON stock_movements(company_id,movement_date);
CREATE INDEX ix_sm_entry ON stock_movements(journal_entry_id);
CREATE UNIQUE INDEX ux_sm_one_reversal ON stock_movements(ref_movement_id) WHERE movement_type='reversal';

CREATE TRIGGER sm_ins_rules BEFORE INSERT ON stock_movements BEGIN
  SELECT RAISE(ABORT,'الأصناف الخدمية لا تدخل المخزون')
   WHERE (SELECT item_type FROM items WHERE id=NEW.item_id)<>'stock';
  SELECT RAISE(ABORT,'الصنف أو المستودع من شركة أخرى')
   WHERE NOT EXISTS(SELECT 1 FROM items i JOIN warehouses w ON w.id=NEW.warehouse_id
                    WHERE i.id=NEW.item_id AND i.company_id=NEW.company_id AND w.company_id=NEW.company_id);
END;
CREATE TRIGGER sm_ai AFTER INSERT ON stock_movements BEGIN
  UPDATE stock_guard SET active=1;
  INSERT OR IGNORE INTO stock_balances(item_id,warehouse_id,qty_milli,value_base) VALUES(NEW.item_id,NEW.warehouse_id,0,0);
  UPDATE stock_balances SET
     qty_milli=qty_milli+CASE NEW.direction WHEN 'in' THEN NEW.qty_milli ELSE -NEW.qty_milli END,
     value_base=value_base+CASE NEW.direction WHEN 'in' THEN NEW.value_base ELSE -NEW.value_base END
   WHERE item_id=NEW.item_id AND warehouse_id=NEW.warehouse_id;
  UPDATE stock_guard SET active=0;
END;
CREATE TRIGGER sm_no_delete BEFORE DELETE ON stock_movements BEGIN SELECT RAISE(ABORT,'حركات المخزون لا تُحذف: التصحيح بحركة عكسية'); END;
CREATE TRIGGER sm_upd_rules BEFORE UPDATE ON stock_movements BEGIN
  SELECT RAISE(ABORT,'حركات المخزون لا تُعدَّل (يُسمح فقط بربطها بقيد مرة واحدة)')
   WHERE NOT (OLD.journal_entry_id IS NULL AND NEW.journal_entry_id IS NOT NULL AND NEW.item_id=OLD.item_id
     AND NEW.warehouse_id=OLD.warehouse_id AND NEW.movement_date=OLD.movement_date AND NEW.movement_type=OLD.movement_type
     AND NEW.direction=OLD.direction AND NEW.qty_milli=OLD.qty_milli AND NEW.value_base=OLD.value_base
     AND NEW.ref_movement_id IS OLD.ref_movement_id AND NEW.transfer_group IS OLD.transfer_group);
END;
CREATE TRIGGER item_immutable BEFORE UPDATE OF item_type,base_unit_id,company_id ON items
WHEN EXISTS(SELECT 1 FROM stock_movements WHERE item_id=OLD.id) BEGIN
  SELECT RAISE(ABORT,'لا يمكن تغيير نوع الصنف أو وحدته الأساسية بعد وجود حركات');
END;
CREATE TRIGGER item_no_delete BEFORE DELETE ON items WHEN EXISTS(SELECT 1 FROM stock_movements WHERE item_id=OLD.id) BEGIN
  SELECT RAISE(ABORT,'لا يمكن حذف صنف له حركات');
END;

CREATE TABLE stock_counts(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id),
  warehouse_id INTEGER NOT NULL REFERENCES warehouses(id), count_date TEXT NOT NULL,
  is_full INTEGER NOT NULL DEFAULT 0 CHECK(is_full IN (0,1)),
  status TEXT NOT NULL DEFAULT 'draft' CHECK(status IN ('draft','posted','cancelled')), note TEXT NOT NULL DEFAULT '',
  created_by INTEGER NOT NULL REFERENCES users(id), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  posted_by INTEGER REFERENCES users(id), posted_at TEXT, journal_entry_id INTEGER REFERENCES journal_entries(id));
CREATE TABLE stock_count_lines(
  count_id INTEGER NOT NULL REFERENCES stock_counts(id), item_id INTEGER NOT NULL REFERENCES items(id),
  counted_qty_milli INTEGER NOT NULL CHECK(counted_qty_milli>=0), unit_cost_minor INTEGER CHECK(unit_cost_minor>=0),
  system_qty_milli INTEGER, diff_qty_milli INTEGER, diff_value_base INTEGER, PRIMARY KEY(count_id,item_id));
CREATE TRIGGER scl_lock_ins BEFORE INSERT ON stock_count_lines
WHEN (SELECT status FROM stock_counts WHERE id=NEW.count_id)<>'draft' BEGIN SELECT RAISE(ABORT,'الجرد ليس مسودة: لا يمكن تعديل بنوده'); END;
CREATE TRIGGER scl_lock_del BEFORE DELETE ON stock_count_lines
WHEN (SELECT status FROM stock_counts WHERE id=OLD.count_id)<>'draft' BEGIN SELECT RAISE(ABORT,'الجرد ليس مسودة: لا يمكن تعديل بنوده'); END;
CREATE TRIGGER sc_upd_rules BEFORE UPDATE ON stock_counts WHEN OLD.status<>'draft' BEGIN
  SELECT RAISE(ABORT,'جرد مرحّل أو ملغى لا يُعدَّل');
END;


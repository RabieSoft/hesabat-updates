def guide_html():
    parts = [f'<h2>دليل الطباعة — {branding.PRODUCT_NAME}</h2>',
             f'<p>إعدادات الطباعة وشرح مختصر لكل خيار. من تطوير {branding.COMPANY_NAME}.</p>']
    for title, items in SECTIONS:
        parts.append(f'<h3>{title}</h3><ul>' + ''.join(f'<li>{i}</li>' for i in items) + '</ul>')
    return '<html dir="rtl"><body dir="rtl">' + ''.join(parts) + '</body></html>'

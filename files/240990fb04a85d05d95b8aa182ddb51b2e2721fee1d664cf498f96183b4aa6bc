            items = []
            if self._transfer_sel.get('journal_entry_id'):
                items.append(('قيد اليومية', f"القيد المحاسبي #{self._transfer_sel['journal_entry_id']}", 'journal', {'id': self._transfer_sel['journal_entry_id']}))
            self.related.set_items(items)

    @staticmethod
    def _wrap(grid):
        w=QWidget(); l=QVBoxLayout(w); l.setContentsMargins(0,4,0,0); l.addWidget(grid,1)
        return w

    def refresh(self):
        if not getattr(self,'_built',False): return
        keep_acc=self._acc['id'] if self._acc else None; keep_v=self._voucher['id'] if self._voucher else None
        keep_t=self._transfer_sel['id'] if self._transfer_sel else None
        try:
            accs=self.svc.list_accounts(); vs=self.svc.vouchers()
            trans=self.svc.transfers(); counts=self.svc.cash_counts()
        except Exception as exc:
            self.show_error(exc); accs=[]; vs=[]; trans=[]; counts=[]
        cf=self.f_cur.currentData()
        if cf:
            accs=[a for a in accs if (a.get('currency') or '')==cf]
            vs=[v for v in vs if (v.get('currency') or '')==cf]
        self.acc_grid.set_rows(accs); self.v_grid.set_rows(vs); self.t_grid.set_rows(trans); self.c_grid.set_rows(counts)
        act=[a for a in act if a.get('is_active')] if (act:=[a for a in accs if a.get('is_active')]) else []
        try:
            from alhisabat.ui.core import format as fmt
            by={}
            for a_ in act:
                for cur,v in (a_.get('balances') or {}).items(): by[cur]=by.get(cur,0)+int(v or 0)
            txt=' | '.join(f"{fmt.fmt_money(Decimal(v)/Decimal(100))} {cur}" for cur,v in sorted(by.items())) or '0.00'
            self.k_total.set_value(txt,'لكل عملة على حدة حسب ما أُدخل')
        except Exception: pass
        self.k_box.set_value(str(sum(1 for a in act if a['kind']=='cashbox')))
        self.k_bank.set_value(str(sum(1 for a in act if a['kind']=='bank')))
        self.k_draft.set_value(str(sum(1 for v in vs if v['status']=='draft')))
        if keep_acc is not None: self.acc_grid.select_where(lambda r: r['id']==keep_acc)
        if keep_v is not None: self.v_grid.select_where(lambda r: r['id']==keep_v)
        if keep_t is not None: self.t_grid.select_where(lambda r: r['id']==keep_t)
        if not self._acc and not self._voucher: self.sheet.set_document(None); self.related.set_items([])
        self.actions_changed.emit()

    def _on_acc(self, rows):
        self._acc=rows[0] if len(rows)==1 else None
        if self._acc:
            try: self.sheet.set_document(DM.from_print_spec({'title':'كشف حساب صندوق','company':self.state.get('company',{}).get('name',''),'extra':[('الاسم',self._acc['name'])],'columns':[],'rows':[],'totals':[]}, 'statement'))
            except Exception: pass
            items = []
            if self._acc.get('account_id'):
                items.append(('شجرة الحسابات', f"الحساب: {self._acc['name']}", 'accounts', {'id': self._acc['account_id']}))
                items.append(('كشف الحساب', f"دفتر أستاذ {self._acc['name']}", 'ledger', {'account_id': self._acc['account_id']}))
            self.related.set_items(items)
        else:
            self.related.set_items([])
        self.actions_changed.emit()


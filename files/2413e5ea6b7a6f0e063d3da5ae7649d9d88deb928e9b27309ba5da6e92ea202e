def _mapping_hint(text):
    m = re.search(r'Account Mapping:\s*([a-z_]+)', text)
    if m and m.group(1) in MAP_KEYS_AR:
        return f'المفتاح المطلوب: «{MAP_KEYS_AR[m.group(1)]}». '
    return ''


def translate(exc):
    """أي استثناء ← UserMessage."""
    from alhisabat.accounting.errors import AccountingError
    from alhisabat.security.permissions import PermissionDenied
    detail = ''.join(traceback.format_exception(type(exc), exc, exc.__traceback__))
    text = str(exc)
    if isinstance(exc, PermissionDenied):
        hint = ('اطلب من مدير النظام إسناد الفرع إليك.' if 'الفرع' in text
                else 'اطلب من مدير النظام صلاحية هذا الإجراء.')
        return UserMessage('لا صلاحية', text, hint, 'warning', 'permission', detail=detail)
    if isinstance(exc, AccountingError):
        for pat, title, hint, action in _RULES:
            if re.search(pat, text):
                if pat == r'اربط حساب':
                    hint = _mapping_hint(text) + hint
                return UserMessage(title, text, hint, 'error', 'rule', action, detail)
        return UserMessage('العملية مرفوضة', text, '', 'error', 'rule', (), detail)
    if isinstance(exc, ValueError):
        return UserMessage('قيمة غير صالحة', text, 'صحّح القيمة المدخلة ثم أعد المحاولة.', 'warning', 'validation', (), detail)
    if isinstance(exc, (sqlite3.IntegrityError, sqlite3.OperationalError)):
        return UserMessage('تعذر تنفيذ العملية', friendly_error(exc), '', 'error', 'data', (), detail)
    return UserMessage('خطأ غير متوقع', 'حدث خطأ غير متوقع. تم تسجيل التفاصيل في ملف السجل.',
                       'إن تكرر الخطأ فأرسل ملف السجل للدعم الفني.', 'error', 'system', (), detail)


def log_entry(msg, where=''):
    """سطر سجل نصي لرسالة (يُكتب في ملف محلي، لا يُعرض)."""
    stamp = datetime.now().isoformat(timespec='seconds')
    return f'[{stamp}] {where} {msg.kind}: {msg.text}\n{msg.detail}'.rstrip() + '\n'

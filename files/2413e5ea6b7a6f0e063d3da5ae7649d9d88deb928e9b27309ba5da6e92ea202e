"""ترجمة أخطاء المحرك إلى رسائل مفهومة مع إجراء مقترح (لا traceback للمستخدم أبدًا).

المرجع: docs/ENGINE_CAPABILITIES.md §8 (كتالوج الرسائل). الرسالة الأصلية عربية دائمًا فتُعرض كما هي،
ويُضاف لها `hint` (ماذا أفعل الآن؟) و`action` (صفحة أو وجهة للانتقال إليها). بلا PySide6.
"""
import re
import sqlite3
import traceback
from dataclasses import dataclass
from datetime import datetime

from alhisabat.ui.core.logic import MAP_KEYS_AR, friendly_error


@dataclass(frozen=True)
class UserMessage:
    title: str
    text: str
    hint: str = ''
    severity: str = 'error'          # error | warning | info
    kind: str = 'rule'               # permission | validation | rule | data | system
    action: tuple = ()               # ('open_page', 'mappings') مثلًا
    detail: str = ''                 # للسجل المحلي فقط، لا يُعرض للمستخدم

    def full_text(self):
        return self.text + (f'\n\n{self.hint}' if self.hint else '')



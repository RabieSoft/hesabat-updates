        bb.accepted.connect(self._accept)
        bb.rejected.connect(self.reject)
        form.addRow(bb)

    def _accept(self):
        if not self.cash.currentData():
            return QMessageBox.warning(self, "خطأ", "اختر صندوقًا للجرد")
        amt_str = self.counted.text().strip().replace(',', '')
        if not amt_str:
            return QMessageBox.warning(self, "خطأ", "أدخل المبلغ الفعلي المجرود")
        try:
            from decimal import Decimal
            Decimal(amt_str)
        except Exception:
            return QMessageBox.warning(self, "خطأ", "المبلغ غير صالح")
        self.accept()

    def values(self):
        return {
            'cash_id': self.cash.currentData(),
            'date': self.date.iso(),
            'amount': self.counted.text().strip().replace(',', ''),
            'note': self.note.text().strip()
        }


class BankReconReportDialog(QDialog):
    """تقرير المطابقة البنكية: مقارنة رصيد الدفاتر برصيد كشف البنك."""
    def __init__(self, page):
        super().__init__(page)
        self.page = page
        self.setWindowTitle("تقرير المطابقة البنكية")
        self.setLayoutDirection(Qt.RightToLeft)
        self.resize(760, 520)

        from PySide6.QtWidgets import QGroupBox, QTableWidget, QTableWidgetItem, QHeaderView
        from alhisabat.ui.components.datagrid import format_minor

        lay = QVBoxLayout(self)
        top = QHBoxLayout()
        self.bank_cb = QComboBox()
        try:
            for cid, lab in page.session.lookup_cash('bank'):
                self.bank_cb.addItem(lab, cid)
        except Exception: pass
        self.as_of = DateField()
        self.stmt_bal = QLineEdit()
        self.stmt_bal.setPlaceholderText("رصيد الكشف...")
        btn_calc = QPushButton("إعداد التقرير")
        btn_calc.setProperty("primary", True)
        btn_calc.clicked.connect(self._calculate)

        top.addWidget(QLabel("البنك:"))
        top.addWidget(self.bank_cb)
        top.addWidget(QLabel("حتى تاريخ:"))
        top.addWidget(self.as_of)
        top.addWidget(QLabel("رصيد الكشف:"))
        top.addWidget(self.stmt_bal)
        top.addWidget(btn_calc)
        lay.addLayout(top)

        self.summary_gb = QGroupBox("الملخص")
        s_form = QFormLayout(self.summary_gb)
        self.lbl_gl_bal = QLabel("0.00")
        self.lbl_stmt_bal = QLabel("0.00")
        self.lbl_diff = QLabel("0.00")
        self.lbl_status = QLabel("—")
        s_form.addRow("رصيد الدفاتر (الأستاذ العام):", self.lbl_gl_bal)
        s_form.addRow("رصيد كشف الحساب الفعلي:", self.lbl_stmt_bal)
        s_form.addRow("الفارق المحسوب:", self.lbl_diff)
        s_form.addRow("حالة المطابقة:", self.lbl_status)
        lay.addWidget(self.summary_gb)

        self.table = QTableWidget()
        self.table.setColumnCount(4)
        self.table.setHorizontalHeaderLabels(["النوع", "التاريخ", "البيان", "المبلغ"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        lay.addWidget(self.table, 1)

        bb = QDialogButtonBox(QDialogButtonBox.Close)
        bb.rejected.connect(self.accept)
        lay.addWidget(bb)

    def _calculate(self):
        cid = self.bank_cb.currentData()
        if not cid:
            return QMessageBox.warning(self, "خطأ", "اختر حسابًا بنكيًا")
        bal_str = self.stmt_bal.text().strip().replace(',', '')
        if not bal_str:
            return QMessageBox.warning(self, "خطأ", "أدخل رصيد كشف الحساب")
        try:
            from decimal import Decimal
            stmt_val = Decimal(bal_str)
        except Exception:
            return QMessageBox.warning(self, "خطأ", "رصيد الكشف غير صالح")

        from alhisabat.ui.components.datagrid import format_minor
        ok, res = self.page.guarded(self.page.svc.reconciliation_report, cid, self.as_of.iso(), stmt_val, reload=False)
        if not ok or not res:
            return

        self.lbl_gl_bal.setText(format_minor(res.get('gl_balance_minor', 0)))
        self.lbl_stmt_bal.setText(format_minor(res.get('statement_balance_minor', 0)))
        diff = res.get('difference_minor', 0)
        self.lbl_diff.setText(format_minor(diff))
        reconciled = res.get('is_reconciled', False)
        if reconciled:
            self.lbl_status.setText("✅ مطابق تمامًا (الفارق = 0)")
            self.lbl_status.setStyleSheet("color: var(--color-success); font-weight: bold;")
        else:
            self.lbl_status.setText("⚠️ غير مطابق (يوجد فارق معلق)")
            self.lbl_status.setStyleSheet("color: var(--color-danger); font-weight: bold;")

        unmatched = res.get('unmatched_items', []) or []
        self.table.setRowCount(len(unmatched))
        for i, item in enumerate(unmatched):
            self.table.setItem(i, 0, QTableWidgetItem(str(item.get('source', ''))))
            self.table.setItem(i, 1, QTableWidgetItem(str(item.get('date', ''))))
            self.table.setItem(i, 2, QTableWidgetItem(str(item.get('description', ''))))
            self.table.setItem(i, 3, QTableWidgetItem(format_minor(item.get('amount_minor', 0))))

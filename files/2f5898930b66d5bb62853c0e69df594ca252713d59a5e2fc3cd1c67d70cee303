@dataclass(frozen=True)
class TopMenu:
    title: str
    icon: str
    items: Tuple[Optional[str], ...]     # مفاتيح الصفحات؛ None = فاصل بين مجموعتين داخل القائمة
    direct: bool = False                 # زر مباشر بلا قائمة (للصفحة الوحيدة فيه)


TOP_MENUS = (
    TopMenu('الرئيسية', 'home', ('dashboard',), direct=True),
    TopMenu('المحاسبة', 'book', ('journal', 'accounts', 'mappings', None, 'currencies', 'cost_centers', None, 'period_end')),
    TopMenu('البيع والشراء', 'cart', ('sales', 'purchases', 'parties', None, 'taxes')),
    TopMenu('المخزون', 'box', ('stock', 'item_info', 'stock_ops', 'warehouses', None, 'item_categories', 'units')),
    TopMenu('النقدية', 'cash', ('cash', 'bank_recon')),
    TopMenu('الموارد', 'users', ('employees', 'payroll', 'assets')),
    TopMenu('التقارير', 'chart', ('reports', 'ledger', 'aging', 'stock_recon')),
    TopMenu('الأدوات', 'import', ('notebook', None, 'import', 'backup', 'audit', None, 'mobile_link', 'messages')),
    TopMenu('الإعدادات', 'settings', ('settings', 'users', 'branches', None, 'print_guide')),
)


def top_menus(access, features=None, show_advanced=False):
    """القوائم المرئية للمستخدم: [(TopMenu, [PageSpec | None])]. تُحذف الصفحات غير المسموحة والمتقدمة المخفية،
    وتُنظَّف الفواصل (لا فاصل في الأول/الآخر ولا فاصلان متتاليان)، وتُحذف القائمة الفارغة."""
    visible = {s.key for _g, specs in visible_pages(access, features, show_advanced) for s in specs}
    out = []
    for menu in TOP_MENUS:
        rows = []
        for k in menu.items:
            if k is None:
                if rows and rows[-1] is not None:
                    rows.append(None)
            elif k in visible:
                rows.append(_BY_KEY[k])
        while rows and rows[-1] is None:
            rows.pop()
        if rows:
            out.append((menu, rows))
    return out

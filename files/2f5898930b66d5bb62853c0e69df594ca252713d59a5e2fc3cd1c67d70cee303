GROUP_ORDER = ('عام', 'المحاسبة', 'المبيعات والمشتريات', 'المخزون', 'النقدية', 'الموارد', 'التقارير والبيانات', 'نهاية الفترة', 'النظام')


def get(key):
    return _BY_KEY.get(key)


def allowed(spec, access):
    """هل يحق للمستخدم فتح الصفحة؟ perm قد تكون None أو رمزًا أو مجموعة (أي منها يكفي)."""
    p = spec.perm
    if not p:
        return True
    if isinstance(p, str):
        return access.has(p)
    return access.any_of(*p)


def visible_pages(access, features=None, show_advanced=False):
    """الصفحات المرئية مجمّعة: [(المجموعة, [PageSpec])]. تُحذف المجموعات الفارغة وتُخفى المتقدمة ما لم تُفعَّل."""
    features = features or {}
    out = {}
    for spec in PAGES:
        if not allowed(spec, access):
            continue
        if spec.advanced and not (show_advanced or (spec.feature and features.get(spec.feature))):
            continue
        out.setdefault(spec.group, []).append(spec)
    return [(g, out[g]) for g in GROUP_ORDER if g in out]


def search_pages(query, access, features=None, show_advanced=True):
    """بحث عربي (يتجاهل التشكيل والهمزات) في عناوين الصفحات وكلماتها المفتاحية، للصفحات المسموح بها فقط."""
    res = []
    for _g, specs in visible_pages(access, features, show_advanced):
        for s in specs:
            if not query or matches(query, s.title, s.keywords, s.group):
                res.append(s)
    return res



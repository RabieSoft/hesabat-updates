    # إعدادات
    def settings(self):
        self.s.require('settings.manage')
        from alhisabat.ui.core import readmodel
        rows=readmodel.settings_rows(self.s.conn, self.s.company_id, _SETTINGS_TABLES)
        for b in self.branches_admin():
            rows.append({'group':'الفروع','key':f"{b['code']} — {b['name']}",'value':'نشط' if b['is_active'] else 'معطّل'})
        return rows
    def update_settings(self, values):
        self.s.require('settings.manage')
        j={k:bool(values.get(k)) for k in ('require_review','require_approval','enforce_separation')}
        for k in ('allow_manual_party_entries','allow_edit_posted_entries','allow_delete_posted_entries'):
            if k in values: j[k]=bool(values[k])
        from alhisabat.accounting import journal_engine as je
        je.set_settings(self.s.conn, self.s.user_id, self.s.company_id, **j)
        sp={k:(values[k] if k=='credit_limit_mode' else bool(values[k])) for k in ('credit_limit_mode','allow_edit_posted_invoice','allow_negative_stock') if k in values}
        if sp:
            from alhisabat.business import sales as sa
            sa.set_settings(self.s.conn, self.s.user_id, self.s.company_id, **sp)
        return self.settings()
    def audit(self, limit=200, table_name=None):
        self.s.require('audit.view')
        tables=[table_name] if table_name else ['journal_entries','accounts','parties','items','sales_invoices','purchase_invoices','cash_vouchers','cash_transfers','payroll_runs','fixed_assets','user_roles','import_batches']
        rows=[]
        for t in tables: rows+=audit_query.search(self.s.conn, self.s.user_id, self.s.company_id, table_name=t, limit=limit)
        rows.sort(key=lambda r: r['id'], reverse=True)
        return rows[:limit]

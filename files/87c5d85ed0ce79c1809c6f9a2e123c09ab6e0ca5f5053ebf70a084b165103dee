    # نسخ
    def backups(self): return backup.list_backups(self.s.conn, self.s.user_id, self.s.company_id)
    def create_backup(self, path, reason='نسخة من الواجهة'): return backup.create_backup(self.s.conn, self.s.user_id, self.s.company_id, path, reason)
    def create_zip_backup(self, dest_dir, reason='نسخة يدوية', auto=False, keep=None): return backup.create_zip_backup(self.s.conn, self.s.user_id, self.s.company_id, dest_dir, reason, auto=auto, keep=keep)
    def folder_backups(self, dest_dir): return backup.list_folder_backups(dest_dir)
    def verify_backup(self, path): return backup.verify_backup(path)
    def restore(self, path):
        self.s.conn.close()
        result=backup.restore_database(self.s.user_id, self.s.company_id, self.s.db_path, path, safety_dir=str(Path(self.s.db_path).parent / 'restore_safety'))
        self.s.conn=result['connection']; return result
    # استيراد
    @staticmethod
    def read_csv(path):
        """يقرأ CSV أو Excel (xlsx) إلى صفوف؛ العناوين العربية (الاسم/الرصيد/النوع/العملة) مقبولة."""
        if not path: raise AccountingError('اختر ملفًا')
        return importer.read_import_file(path)
    def warehouse_choices(self):
        """المستودعات النشطة (id, name) لاختيار مستودع الرصيد الافتتاحي عند استيراد أصناف بكمياتها."""
        self.s.require('data.import')
        return [(r[0], r[1]) for r in self.s.conn.execute("SELECT id,name FROM warehouses WHERE company_id=? AND is_active=1 ORDER BY name", (self.s.company_id,))]
    def unit_names(self):
        """أسماء وحدات الشركة النشطة (لاختيار الوحدة الافتراضية عند قراءة أصناف من مستند)."""
        return importer.import_unit_names(self.s.conn, self.s.user_id, self.s.company_id)
    def read_document(self, path, kind_label, default_unit=''):
        """يقرأ PDF/صورة إلى صفوف بنفس مفاتيح CSV. التحقق والمكرر والاعتماد يبقى كله في محرك الاستيراد."""
        self.s.require('data.import')
        t = IMPORT_TARGETS[kind_label]
        if t not in ('customer', 'supplier', 'item'):
            raise AccountingError('قراءة PDF والصور متاحة للعملاء والموردين والأصناف فقط. استخدم CSV للأرصدة الافتتاحية.')
        res = doc_reader.read_document(path, t, default_unit)
        if t == 'item':      # توحيد كتابة الوحدة (قطعه/قطعة) على اسم وحدة الشركة الفعلي؛ ما لا يطابق يبقى كما هو فيُكشف خطأ في المعاينة
            units = {doc_reader._key(n): n for n in self.unit_names()}
            for r in res['rows']:
                r['unit'] = units.get(doc_reader._key(r.get('unit', '')), r.get('unit', ''))
        return res
    @staticmethod
    def is_vcf(path):
        from alhisabat.business import vcard
        return vcard.is_vcf_file(path)
    def read_vcf(self, path):
        """ملف جهات اتصال (VCF) من نسخ هاتف أندرويد الاحتياطي ← قائمة جهات {name, phones, ...}."""
        self.s.require('data.import')
        from alhisabat.business import vcard
        try:
            return vcard.read_vcf_file(path)
        except ValueError as e:
            raise AccountingError(str(e)) from e
    def import_currencies(self):
        """العملات المفعّلة للشركة (لاختيار عملة الأرصدة الافتتاحية المستوردة)."""
        from alhisabat.ui.core import readmodel
        return [c for c in readmodel.currencies_list(self.s.conn, self.s.company_id) if c['is_enabled']]
    def import_preview(self, rows, kind_label, auto_create_units=False, auto_create_parties=False, currency=None, rate=None, force_currency=False, fiscal_year_id=None, vcf_opts=None):
        t=IMPORT_TARGETS[kind_label]
        if t in ('customer_vcf', 'supplier_vcf'):
            o = vcf_opts or {}
            return importer.preview_party_phones_import(self.s.conn, self.s.user_id, self.s.company_id, t.split('_')[0], rows,
                                                         default_cc=o.get('default_cc') or '+967', normalize_existing=o.get('normalize_existing', True),
                                                         create_new=o.get('create_new', False), branch_id=o.get('preview_branch_id'),
                                                         exclude_party_ids=o.get('exclude_party_ids') or (), exclude_new_names=o.get('exclude_new_names') or ())
        if t in ('customer_opening', 'supplier_opening'):
            k = 'customer' if t == 'customer_opening' else 'supplier'
            return importer.preview_party_opening_import(self.s.conn, self.s.user_id, self.s.company_id, k, rows, auto_create=auto_create_parties,
                                                          currency=currency, rate=rate, force_currency=force_currency,
                                                          fiscal_year_id=int(fiscal_year_id) if fiscal_year_id else None)
        return importer.preview_items_import(self.s.conn, self.s.user_id, self.s.company_id, rows, auto_create_units) if t=='item' else importer.preview_parties_import(self.s.conn, self.s.user_id, self.s.company_id, t, rows)
    def import_commit(self, rows, kind_label, fiscal_year_id=None, auto_create_units=False, opening_stock=None, branch_id=None, auto_create_parties=False,
                      currency=None, rate=None, force_currency=False, vcf_opts=None):
        """branch_id: الفرع الذي تُسجَّل عليه السجلات المستوردة (None = الافتراضي حسب وضع الفروع)."""
        t=IMPORT_TARGETS[kind_label]
        bid = int(branch_id) if branch_id else None
        if t in ('customer_vcf', 'supplier_vcf'):
            o = vcf_opts or {}
            return importer.commit_party_phones_import(self.s.conn, self.s.user_id, self.s.company_id, t.split('_')[0], rows,
                                                        default_cc=o.get('default_cc') or '+967', normalize_existing=o.get('normalize_existing', True),
                                                        create_new=o.get('create_new', False), branch_id=bid or self.s._master_branch(),
                                                        exclude_party_ids=o.get('exclude_party_ids') or (), exclude_new_names=o.get('exclude_new_names') or (), preview_branch_id=o.get('preview_branch_id'))
        if t in ('customer_opening', 'supplier_opening'):
            k = 'customer' if t == 'customer_opening' else 'supplier'
            if not fiscal_year_id:
                from alhisabat.ui.core import readmodel
                fys = readmodel.fiscal_years_list(self.s.conn, self.s.company_id)
                fiscal_year_id = fys[0]['id'] if fys else 1
            return importer.commit_party_opening_import(self.s.conn, self.s.user_id, self.s.company_id, k, rows, int(fiscal_year_id), branch_id=bid, auto_create=auto_create_parties,
                                                         currency=currency, rate=rate, force_currency=force_currency)
        bid = bid or self.s._master_branch()
        return importer.commit_items_import(self.s.conn, self.s.user_id, self.s.company_id, rows, auto_create_units, opening_stock, branch_id=bid) if t=='item' else importer.commit_parties_import(self.s.conn, self.s.user_id, self.s.company_id, t, rows, branch_id=bid)

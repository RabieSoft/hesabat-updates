def parse_csv(text):
    """يقرأ نص CSV (رأس أعمدة + صفوف) إلى قائمة قواميس. يقبل BOM."""
    if text.startswith("\ufeff"):
        text = text[1:]
    rows = list(csv.DictReader(io.StringIO(text)))
    if not rows:
        raise AccountingError("الملف فارغ أو بلا صفوف بيانات")
    return rows


def import_unit_names(conn, user_id, company_id):
    """أسماء وحدات الشركة النشطة، لمن يملك صلاحية الاستيراد (مطابقة وحدة الصنف المقروء من مستند)."""
    permissions.require(conn, user_id, company_id, "data.import", check_branch=False)
    return [r[0] for r in conn.execute("SELECT name FROM units WHERE company_id=? AND is_active=1 ORDER BY name", (company_id,))]


def _ukey(s):
    """مفتاح مقارنة الوحدات: حبه=حبة، أ/إ/آ=ا، ى=ي، مسافات موحدة."""
    s = " ".join(str(s or "").strip().lower().replace("*", " * ").split())
    return s.translate(str.maketrans("أإآةى", "اااهي"))


_EXTRA_NUM = (("qty", "الكمية"), ("purchase_price", "سعر الشراء"), ("sale_price", "سعر البيع"), ("price", "السعر"),
              ("unit_price", "سعر الوحدة"), ("total_value", "الإجمالي"))


def _dec(v, field, required=True, default=None):
    v = (v or "").strip() if v is not None else ""
    if not v:
        if required:
            return None, f"{field} مطلوب"
        return default, None
    try:
        return Decimal(v), None
    except InvalidOperation:
        return None, f"{field} غير رقمي"


def _int(v, field, required=True, default=None, min_v=None, max_v=None):
    v = (v or "").strip() if v is not None else ""
    if not v:
        return (None, f"{field} مطلوب") if required else (default, None)
    try:
        n = int(v)
    except ValueError:
        return None, f"{field} غير صحيح"
    if min_v is not None and n < min_v:
        return None, f"{field} أصغر من الحد الأدنى"
    if max_v is not None and n > max_v:
        return None, f"{field} أكبر من الحد الأقصى"
    return n, None


def _finish(conn, actor_id, company_id, target, rows_report, status="previewed"):
    total = len(rows_report)
    valid = sum(1 for r in rows_report if r["status"] == "valid")
    invalid = sum(1 for r in rows_report if r["status"] == "invalid")
    dup = sum(1 for r in rows_report if r["status"].startswith("duplicate"))
    import json
    bid = conn.execute("INSERT INTO import_batches(company_id,target,status,total_rows,valid_rows,invalid_rows,duplicate_rows,report_json,created_by) "
                       "VALUES(?,?,?,?,?,?,?,?,?)", (company_id, target, status, total, valid, invalid, dup,
                                                     json.dumps(rows_report, ensure_ascii=False), actor_id)).lastrowid
    return {"batch_id": bid, "total": total, "valid": valid, "invalid": invalid, "duplicate": dup, "rows": rows_report}


def _party_numbering_room(conn, company_id, kind):
    """عدد الأرقام المتاحة تحت الحساب الرقابي للعملاء/الموردين، أو None إن تعذّر الحساب (يُترك للتنفيذ)."""
    from alhisabat.business import numbering
    map_key = "customers" if kind == "customer" else "suppliers"
    try:
        control = coa.get_mapping(conn, company_id, map_key)
        ctl = conn.execute("SELECT code, level FROM accounts WHERE id=?", (control,)).fetchone()
        s = numbering.get_settings(conn, company_id)
        level = ctl["level"] + 1
        width = numbering.code_length_for_level(s, level) - len(ctl["code"])
        used = [int(r[0][len(ctl["code"]):]) for r in conn.execute(
            "SELECT code FROM accounts WHERE parent_id=?", (control,)) if r[0][len(ctl["code"]):].isdigit()]
        last = max(used) if used else 0
        return max(0, (10 ** width - 1) - last)
    except Exception:
        return None



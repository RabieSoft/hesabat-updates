def _preview_only(conn, actor_id, company_id, target, build_rows_report):
    """يبني تقرير المعاينة عبر SAVEPOINT مؤقت (بلا آثار جانبية إن احتاج البناء استعلامات فقط) ثم يسجّل الدفعة."""
    rows_report = build_rows_report()
    return _finish(conn, actor_id, company_id, target, rows_report, status="previewed")


def preview_parties_import(conn, user_id, company_id, kind, rows):
    permissions.require(conn, user_id, company_id, "data.import", check_branch=False)
    if kind not in ("customer", "supplier"):
        raise AccountingError("الاستيراد مدعوم للعملاء والموردين فقط")

    def build():
        existing = {r[0].strip().lower() for r in conn.execute("SELECT name FROM parties WHERE company_id=? AND kind=?", (company_id, kind))}
        groups_map = {r["name"].strip().lower(): r["id"] for r in conn.execute(
            "SELECT pg.id, a.name FROM party_groups pg JOIN accounts a ON a.id=pg.account_id "
            "WHERE pg.company_id=? AND pg.kind=? AND a.is_active=1", (company_id, kind)).fetchall()}
        seen_in_file = set()
        out = []
        # سعة الترقيم المتبقية تحت الحساب الرقابي: تُفحص في المعاينة حتى لا تنهار الدفعة في منتصف الاعتماد
        room = _party_numbering_room(conn, company_id, kind)
        for i, row in enumerate(rows, 1):
            errs = []
            name = (row.get("name") or "").strip()
            if not name:
                errs.append("الاسم مطلوب")
            key = name.lower()
            status = "valid"
            g_raw = (row.get("group") or row.get("المجموعة") or row.get("group_name") or "").strip()
            group_id = None
            if g_raw:
                if g_raw.lower() in groups_map:
                    group_id = groups_map[g_raw.lower()]
                else:
                    errs.append("المجموعة غير موجودة")
            if not errs:
                if key in existing:
                    status, errs = "duplicate_existing", ["الاسم مسجَّل بالفعل"]
                elif key in seen_in_file:
                    status, errs = "duplicate_in_file", ["الاسم مكرر داخل الملف نفسه"]
                elif group_id is None:
                    if room is not None and room <= 0:
                        status, errs = "invalid", ["لا توجد أرقام حسابات متاحة تحت الحساب الرقابي: زد طول المقطع الأخير في إعدادات الترقيم"]
                    elif room is not None:
                        room -= 1
            credit_limit, e1 = _dec(row.get("credit_limit"), "الحد الائتماني", required=False, default=Decimal(0))
            terms, e2 = _int(row.get("payment_terms_days"), "مدة السداد", required=False, default=0, min_v=0, max_v=3650)
            more = [e for e in (e1, e2) if e]
            if credit_limit is not None and credit_limit < 0:
                more.append("الحد الائتماني لا يقبل قيمة سالبة")
            if kind != "customer" and credit_limit:
                more.append("الحد الائتماني خاص بالعملاء")
            errs += more
            if errs and status == "valid":
                status = "invalid"
            if status == "valid":
                seen_in_file.add(key)
            out.append({"row_no": i, "status": status, "errors": errs, "data": {
                "name": name, "phone": (row.get("phone") or "").strip(), "email": (row.get("email") or "").strip(),
                "tax_no": (row.get("tax_no") or "").strip(), "notes": (row.get("notes") or "").strip(),
                "credit_limit": str(credit_limit) if credit_limit else "0",
                "payment_terms_days": terms if terms is not None else 0,
                "group_id": group_id, "group": g_raw}})
        return out
    return _preview_only(conn, user_id, company_id, kind + "s", build)


def commit_parties_import(conn, user_id, company_id, kind, rows, branch_id=None):
    """يعيد التحقق (لا يثق بتقرير معاينة سابق قد يكون تغيّر واقعه) ويستورد الصفوف الصالحة فقط، فورا، صفا صفا."""
    prev = preview_parties_import(conn, user_id, company_id, kind, rows)
    created, errors_summary = [], []
    with transaction(conn):
        for r in prev["rows"]:
            if r["status"] != "valid":
                continue
            d = r["data"]
            # كل صف في سافنت خاص به: فشل صف واحد (مثلا نفاد الترقيم) لا يُسقط الدفعة كلها
            try:
                with transaction(conn):
                    pid = pt.create_party(conn, user_id, company_id, kind, d["name"], phone=d["phone"], email=d["email"],
                                          tax_no=d["tax_no"], notes=d["notes"], credit_limit=Decimal(d["credit_limit"]),
                                          payment_terms_days=d["payment_terms_days"], branch_id=branch_id,
                                          group_id=d.get("group_id"))
            except AccountingError as e:
                r["status"], r["errors"] = "invalid", [str(e)]
                continue
            created.append({"row_no": r["row_no"], "party_id": pid, "name": d["name"]})
        import json
        conn.execute("UPDATE import_batches SET status='committed',committed_by=?,committed_at=CURRENT_TIMESTAMP,committed_report_json=? WHERE id=?",
                     (user_id, json.dumps(created, ensure_ascii=False), prev["batch_id"]))
        audit.log(conn, user_id, "commit_import", "import_batches", prev["batch_id"], after={"target": kind, "created": len(created)})
    return {"batch_id": prev["batch_id"], "created": created, "imported": len(created),
           "skipped": prev["total"] - len(created), "skipped_rows": [r for r in prev["rows"] if r["status"] != "valid"]}


# ---------------- تنظيف هواتف العملاء/الموردين من جهات الاتصال (VCF) ----------------
def preview_party_phones_import(conn, user_id, company_id, kind, contacts, *, default_cc="+967", normalize_existing=True,
                                create_new=False, branch_id=None, exclude_party_ids=(), exclude_new_names=()):
    """يطابق أطراف النظام (عملاء/موردين) بجهات اتصال الهاتف ويقترح الرقم النظيف بصيغة E.164.

    المطابقة (بالترتيب): الاسم المطبَّع → الاسم بعد حذف الأقواس → الاسم بترتيب كلمات مختلف → رقم الطرف الحالي
    ضمن أرقام الجهة. الأسماء المتشابهة فقط (≥0.9) تُعلَّم «يحتاج مراجعة» ولا تُستورد تلقائيًا.
    الحالات: valid (تحديث/إنشاء) · unchanged · not_found · review · invalid.
    """
    import difflib
    from alhisabat.business import branch_scope, vcard as vc
    permissions.require(conn, user_id, company_id, "data.import", check_branch=False)
    if kind not in ("customer", "supplier"):
        raise AccountingError("تنظيف الهواتف مدعوم للعملاء والموردين فقط")
    exclude = {int(x) for x in (exclude_party_ids or ())}
    exclude_new = {vc.norm_name(x) for x in (exclude_new_names or ())}

    def build():
        # فهارس جهات الاتصال
        by_name, by_core, by_tokens, by_phone, tok_index = {}, {}, {}, {}, {}
        cinfo = []
        for ci, c in enumerate(contacts):
            phones = vc.clean_contact_phones(c, default_cc)
            cinfo.append({"contact": c, "phones": phones, "used": False})
            nn, cn, tk = vc.norm_name(c.get("name")), vc.core_name(c.get("name")), vc.name_tokens_key(c.get("name"))
            if nn:
                by_name.setdefault(nn, []).append(ci)
                by_core.setdefault(cn, []).append(ci)
                by_tokens.setdefault(tk, []).append(ci)
                for t in set(nn.split()):
                    tok_index.setdefault(t, set()).add(ci)
            for e, _t in phones:
                by_phone.setdefault(e, []).append(ci)

        q = "SELECT id, name, phone FROM parties WHERE company_id=? AND kind=? AND is_active=1"
        args = [company_id, kind]
        f, fa = branch_scope.master_clause(conn, company_id, branch_id, col="branch_id")
        parties = conn.execute(q + f + " ORDER BY name", args + fa).fetchall()
        existing_names = {vc.norm_name(p["name"]) for p in conn.execute(
            "SELECT name FROM parties WHERE company_id=? AND kind=?", (company_id, kind))}

        def pick(idx_list):
            ids = []
            for i in idx_list:
                if i not in ids:
                    ids.append(i)
            return ids

        out, n = [], 0
        for p in parties:
            if p["id"] in exclude:
                continue
            n += 1
            old_raw = (p["phone"] or "").strip()
            old_e, _why = vc.clean_phone(old_raw, default_cc) if old_raw else (None, "")
            nn = vc.norm_name(p["name"])
            how, ids = "", []
            if nn in by_name:
                how, ids = "الاسم", pick(by_name[nn])
            elif vc.core_name(p["name"]) in by_core and vc.core_name(p["name"]):
                how, ids = "الاسم (بعد حذف الأقواس)", pick(by_core[vc.core_name(p["name"])])
            elif vc.name_tokens_key(p["name"]) in by_tokens:
                how, ids = "الاسم (ترتيب مختلف)", pick(by_tokens[vc.name_tokens_key(p["name"])])
            elif old_e and old_e in by_phone:
                how, ids = "رقم الطرف الحالي", pick(by_phone[old_e])
            row = {"row_no": n, "status": "valid", "errors": [], "notes": [], "data": {
                "name": p["name"], "party_id": p["id"], "phone_old": old_raw, "phone_new": "", "contact": "", "match": how, "action": "update"}}
            d = row["data"]
            if ids:
                cands = []
                for i in ids:
                    cinfo[i]["used"] = True
                    for e, t in cinfo[i]["phones"]:
                        if e not in [x[0] for x in cands]:
                            cands.append((e, t))
                d["contact"] = " / ".join(dict.fromkeys(cinfo[i]["contact"].get("name") or "" for i in ids))
                if not cands:
                    bad = [pp["raw"] for i in ids for pp in cinfo[i]["contact"].get("phones", [])]
                    row["status"] = "invalid"
                    row["errors"] = ["جهة الاتصال بلا رقم صالح" + (": " + "، ".join(bad[:3]) if bad else "")]
                else:
                    cands.sort(key=lambda t: 0 if "CELL" in t[1] or "MOBILE" in t[1] else 1)
                    chosen = next((e for e, _t in cands if e == old_e), cands[0][0])
                    d["phone_new"] = chosen
                    if len(cands) > 1:
                        row["notes"].append("أرقام أخرى للجهة: " + "، ".join(e for e, _t in cands if e != chosen))
                    if old_raw == chosen:
                        row["status"] = "unchanged"
            else:
                # لا جهة مطابقة: اسم مشابه للمراجعة؟
                cand_idx = set()
                for t in nn.split():
                    cand_idx |= tok_index.get(t, set())
                best, best_r = None, 0.0
                for i in list(cand_idx)[:400]:
                    r = difflib.SequenceMatcher(None, nn, vc.norm_name(cinfo[i]["contact"].get("name"))).ratio()
                    if r > best_r:
                        best, best_r = i, r
                if best is not None and best_r >= 0.9:
                    row["status"] = "review"
                    d["contact"] = cinfo[best]["contact"].get("name") or ""
                    d["match"] = "اسم مشابه"
                    row["notes"].append(f"اسم مشابه في جهات الاتصال ({int(best_r * 100)}٪): صحّح الاسم ثم أعد المعاينة")
                elif normalize_existing and old_raw:
                    if old_e:
                        d["phone_new"], d["match"] = old_e, "تنسيق فقط"
                        if old_raw == old_e:
                            row["status"] = "unchanged"
                    else:
                        row["status"] = "invalid"
                        row["errors"] = [f"رقم الطرف الحالي غير صالح ({_why}) ولا جهة مطابقة"]
                else:
                    row["status"] = "not_found"
                    row["notes"].append("لا توجد جهة اتصال مطابقة")
            out.append(row)

        if create_new:
            seen = set()
            for ci in cinfo:
                c = ci["contact"]
                nn = vc.norm_name(c.get("name"))
                if ci["used"] or not nn or nn in existing_names or nn in seen or nn in exclude_new or not ci["phones"]:
                    continue
                seen.add(nn)
                n += 1
                out.append({"row_no": n, "status": "valid", "errors": [], "notes": ["جهة جديدة ستُنشأ كطرف"], "data": {
                    "name": c["name"], "party_id": None, "phone_old": "", "phone_new": ci["phones"][0][0], "contact": c["name"],
                    "match": "جديد", "action": "create"}})
        return out
    return _preview_only(conn, user_id, company_id, kind + "s", build)      # جدول الدفعات يقبل customers/suppliers فقط (CHECK)


def commit_party_phones_import(conn, user_id, company_id, kind, contacts, *, default_cc="+967", normalize_existing=True,
                               create_new=False, branch_id=None, exclude_party_ids=(), exclude_new_names=(), preview_branch_id=None):
    """يعيد المعاينة ويطبّق الصفوف الصالحة فقط: تعديل هاتف الطرف (edit_party) أو إنشاء طرف جديد."""
    import json
    prev = preview_party_phones_import(conn, user_id, company_id, kind, contacts, default_cc=default_cc,
                                       normalize_existing=normalize_existing, create_new=create_new,
                                       branch_id=preview_branch_id, exclude_party_ids=exclude_party_ids,
                                       exclude_new_names=exclude_new_names)
    updated, created = [], []
    with transaction(conn):
        for r in prev["rows"]:
            if r["status"] != "valid":
                continue
            d = r["data"]
            try:
                with transaction(conn):
                    if d["action"] == "create":
                        pid = pt.create_party(conn, user_id, company_id, kind, d["name"], phone=d["phone_new"], branch_id=branch_id)
                        created.append({"row_no": r["row_no"], "party_id": pid, "name": d["name"]})
                    else:
                        pt.edit_party(conn, user_id, d["party_id"], phone=d["phone_new"])
                        updated.append({"row_no": r["row_no"], "party_id": d["party_id"], "name": d["name"],
                                        "old": d["phone_old"], "new": d["phone_new"]})
            except AccountingError as e:
                r["status"], r["errors"] = "invalid", [str(e)]
        conn.execute("UPDATE import_batches SET status='committed',committed_by=?,committed_at=CURRENT_TIMESTAMP,committed_report_json=? WHERE id=?",
                     (user_id, json.dumps({"updated": updated, "created": created}, ensure_ascii=False), prev["batch_id"]))
        audit.log(conn, user_id, "commit_import", "import_batches", prev["batch_id"],
                  after={"target": kind + "_phones", "updated": len(updated), "created": len(created)})
    n = len(updated) + len(created)
    return {"batch_id": prev["batch_id"], "updated": updated, "created": created, "imported": n,
            "skipped": prev["total"] - n, "parties_created": len(created)}



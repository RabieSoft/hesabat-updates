    def _mov_since(self):
        return (date.today() - timedelta(days=self.sp_mov_days.value())).isoformat()

    def _scan_movements(self, silent=False):
        try:
            rows = self.svc.scan_movements(self._mov_since())
        except Exception as e:
            if not silent:
                QMessageBox.critical(self, self.title, f"تعذرت قراءة الحركات: {e}")
            return
        old = {m["key"] for m in self._movs}
        keys = {m["key"] for m in rows}
        new_n = len(keys - old)
        self._movs = rows
        self.grid_mov.set_rows(rows)
        self.lbl_mov_info.setText(f"{len(rows)} حركة غير مرسلة منذ {self._mov_since()}" + (f" — منها {new_n} جديدة" if old and new_n else ""))
        idx = self.tabs.indexOf(self._tab_mov)
        if idx >= 0:
            self.tabs.setTabText(idx, f"حركات جديدة ({len(rows)})" if rows else "حركات جديدة")
        if not silent and not rows:
            QMessageBox.information(self, self.title, "لا توجد حركات جديدة غير مرسلة.")

    def _auto_scan_movements(self):
        if self.isVisible() and self.chk_mov_auto.isChecked():
            self._scan_movements(silent=True)

    def _on_mov_select(self, rows):
        self.btn_mov_send.setEnabled(bool(rows))
        self.btn_mov_send.setText(f"إدراج المحدد في الطابور ({len(rows)})" if rows else "إدراج المحدد في الطابور")

    def _send_movements(self):
        sel = self.grid_mov.selected_rows()
        if not sel:
            return
        if QMessageBox.question(self, self.title, f"إدراج {len(sel)} رسالة في طابور الإرسال؟") != QMessageBox.Yes:
            return
        ok, errors = self.svc.enqueue_movements(sel)
        self._ensure_worker()
        msg = f"تم إدراج {ok} رسالة في الطابور."
        if errors:
            msg += f"\n\nتعذر إدراج {len(errors)}:\n" + "\n".join(errors[:8])
        QMessageBox.information(self, self.title, msg)
        self._scan_movements(silent=True)
        self._load_queue()

    def _ignore_movements(self):
        sel = self.grid_mov.selected_rows()
        if not sel:
            return
        if QMessageBox.question(self, self.title, f"تجاهل {len(sel)} حركة (لن تظهر مجددًا)؟") != QMessageBox.Yes:
            return
        self.svc.ignore_movements(sel)
        self._scan_movements(silent=True)


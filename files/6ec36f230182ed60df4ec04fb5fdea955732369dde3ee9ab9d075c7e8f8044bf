    # --------------------------------------------------------- منطق العمل والتحميل
    def _ensure_worker(self):
        """تشغيل الخدمة تلقائيًا عند وجود رسائل في الانتظار (ما لم يوقفها المستخدم عمدًا)."""
        try:
            self.svc.ensure_worker()
        except Exception:  # noqa: BLE001
            pass

    def _on_poll(self):
        self._ensure_worker()
        if not self.isVisible():
            return
        self._update_worker_ui()
        if self.tabs.currentIndex() == 0:
            self._load_queue()

    def _reload_all(self):
        self._load_queue()
        self._load_parties()
        self._load_templates()
        self._load_settings()
        self._load_logs()
        self._update_worker_ui()

    def _update_worker_ui(self):
        up = self.svc.is_worker_running()
        paused = up and self.svc.is_worker_paused()
        self.lbl_worker_status.setText(self.svc.worker_status_text())
        self.btn_toggle_worker.setText("استئناف الخدمة" if paused else ("إيقاف الخدمة" if up else "تشغيل الخدمة"))

    def _toggle_worker(self):
        if self.svc.is_worker_running() and self.svc.is_worker_paused():
            self.svc.resume_worker()
        elif self.svc.is_worker_running():
            self.svc.stop_worker()
        else:
            self.svc.start_worker()
        self._update_worker_ui()

    def _check_connection(self):
        # الفحص قد يفتح نافذة Chrome وينتظر تحميل واتساب؛ يجري في الخلفية كي لا تتجمد الواجهة
        if getattr(self, "_checking", False):
            return
        self._checking = True
        self.lbl_conn_detail.setText("جاري فتح نافذة واتساب وفحص الجلسة...")

        def _bg(_session, _ctx):
            return self.svc.check_connection()

        def _done(st):
            self._checking = False
            self.lbl_conn_detail.setText(f"حالة الاتصال: {st.message}")
            QMessageBox.information(self, self.title, f"حالة الجلسة: {st.message}")

        def _err(exc):
            self._checking = False
            self.lbl_conn_detail.setText(f"تعذر الفحص: {exc}")
            QMessageBox.warning(self, self.title, f"تعذر فحص الجلسة:\n{exc}")

        self.run_task(_bg, on_done=_done, on_error=_err)

    def _browse_shortcut(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "اختيار اختصار واتساب", str(Path.home() / "Desktop"), "اختصار أو برنامج (*.lnk *.exe)"
        )
        if path:
            self.txt_shortcut.setText(path)

    def _load_browser_prefs(self):
        pr = browser_prefs.load_prefs()
        i = self.cb_browser.findData(pr.get("browser", "chrome"))
        self.cb_browser.setCurrentIndex(i if i >= 0 else 0)
        self.txt_shortcut.setText(str(pr.get("shortcut", "") or ""))

    def _save_browser_prefs(self):
        browser_prefs.save_prefs({
            "browser": self.cb_browser.currentData(),
            "shortcut": self.txt_shortcut.text().strip().strip('"'),
        })
        QMessageBox.information(
            self, self.title,
            "تم حفظ إعداد المتصفح. إن كانت نافذة واتساب مفتوحة فاضغط «ربط واتساب / فحص الجلسة» لإعادة الاتصال بها.",
        )

    def _load_queue(self):
        st = self.cb_filter.currentData()
        rows = self.svc.list_queue(status=st)
        self.grid_queue.set_rows(rows)

    def _on_queue_select(self, rows):
        self._sel_outbox = rows[0] if len(rows) == 1 else None
        can_cancel = bool(self._sel_outbox and self._sel_outbox.get("status") == "queued")
        can_retry = bool(self._sel_outbox and self._sel_outbox.get("status") in ("failed", "cancelled"))
        self.btn_cancel.setEnabled(can_cancel)
        self.btn_retry.setEnabled(can_retry)

    def _on_cancel(self):
        if not self._sel_outbox:
            return
        self.svc.cancel_message(self._sel_outbox["id"])
        self._load_queue()

    def _on_retry(self):
        if not self._sel_outbox:
            return
        self.svc.retry_message(self._sel_outbox["id"])
        self._load_queue()

    def _load_parties(self):
        self.cb_party.clear()
        self.cb_party.addItem("— اختر طرفًا —", None)
        parties = self.svc.list_parties_with_phones()
        for p in parties:
            tag = "" if p["wa_consent"] else " [بلا موافقة]"
            self.cb_party.addItem(f"{p['name']} ({p['phone']}){tag}", p)

    def _on_party_changed(self):
        p = self.cb_party.currentData()
        if p:
            self.txt_manual_phone.setText(p["phone"])
            self._update_send_preview()

    def _load_templates(self):
        self.cb_send_template.clear()
        self.cb_tpl_list.clear()
        tpls = self.svc.list_templates()
        for t in tpls:
            self.cb_send_template.addItem(t["title"], t)
            self.cb_tpl_list.addItem(t["title"], t)
        self._on_tpl_selected()
        self._update_send_preview()

    def _on_send_template_changed(self):
        self._update_send_preview()

    def _update_send_preview(self):
        tpl = self.cb_send_template.currentData()
        if not tpl:
            return
        p = self.cb_party.currentData() or {}
        ctx = {"name": p.get("name", "العميل"), "phone": p.get("phone", "")}
        rendered = render_template(tpl.get("body", ""), ctx)
        self.txt_message_body.setText(rendered)

    def _browse_attachment(self):
        fn, _ = QFileDialog.getOpenFileName(self, "اختر ملف المرفق (PDF)", "", "PDF Files (*.pdf);;All Files (*.*)")
        if fn:
            self.txt_attachment.setText(fn)

    def _on_enqueue(self):
        p = self.cb_party.currentData()
        phone = self.txt_manual_phone.text().strip() or (p.get("phone") if p else "")
        body = self.txt_message_body.toPlainText().strip()
        att = self.txt_attachment.text().strip()
        bypass = self.chk_bypass.isChecked()
        party_id = p.get("id") if p else None

        if not phone or not body:
            QMessageBox.warning(self, self.title, "يرجى تحديد رقم الهاتف ونص الرسالة")
            return

        try:
            kind = "document" if att else "text"
            mid = self.svc.enqueue(
                phone=phone,
                body=body,
                party_id=party_id,
                kind=kind,
                attachment_path=att,
                bypass_idempotency=bypass,
            )
            self._ensure_worker()
            QMessageBox.information(self, self.title, f"تم إدراج الرسالة في الطابور بنجاح (رقم: {mid})")
            self.tabs.setCurrentIndex(0)
            self._load_queue()
        except Exception as e:
            QMessageBox.critical(self, self.title, f"تعذر الإدراج في الطابور: {e}")

    def _on_tpl_selected(self):
        t = self.cb_tpl_list.currentData()
        if t:
            self.txt_tpl_title.setText(t.get("title", ""))
            self.txt_tpl_body.setText(t.get("body", ""))

    def _save_template(self):
        t = self.cb_tpl_list.currentData()
        if not t:
            return
        title = self.txt_tpl_title.text().strip()
        body = self.txt_tpl_body.toPlainText().strip()
        if not title or not body:
            QMessageBox.warning(self, self.title, "العنوان والنص مطلوبان")
            return
        self.svc.save_template(t["code"], title, body)
        QMessageBox.information(self, self.title, "تم حفظ القالب بنجاح")
        self._load_templates()

    def _load_settings(self):
        self._load_browser_prefs()
        cfg = self.svc.get_settings()
        idx = self.cb_mode.findData(cfg.get("mode", "web"))
        if idx >= 0:
            self.cb_mode.setCurrentIndex(idx)
        self.txt_cc.setText(cfg.get("country_code", "+967"))
        self.sp_min_delay.setValue(cfg.get("min_delay", 12))
        self.sp_max_delay.setValue(cfg.get("max_delay", 35))
        self.sp_daily_cap.setValue(cfg.get("daily_cap", 150))
        self.sp_hourly_cap.setValue(cfg.get("hourly_cap", 40))
        self.txt_win_start.setText(cfg.get("window_start", "08:00"))
        self.txt_win_end.setText(cfg.get("window_end", "21:00"))

    def _save_settings(self):
        cfg = {
            "mode": self.cb_mode.currentData(),
            "country_code": self.txt_cc.text().strip(),
            "min_delay": self.sp_min_delay.value(),
            "max_delay": self.sp_max_delay.value(),
            "daily_cap": self.sp_daily_cap.value(),
            "hourly_cap": self.sp_hourly_cap.value(),
            "window_start": self.txt_win_start.text().strip(),
            "window_end": self.txt_win_end.text().strip(),
        }
        self.svc.save_settings(cfg)
        QMessageBox.information(self, self.title, "تم حفظ الإعدادات بنجاح")

    def _load_logs(self):
        rows = self.svc.list_logs()
        self.grid_logs.set_rows(rows)

            {'date': today, 'no': '2', 'desc': 'سند قبض (نموذج)', 'debit': Decimal('0'), 'credit': Decimal('100'), 'balance': Decimal('1110')}]
    spec = {'title': 'كشف حساب (نموذج للمعاينة)', 'company': company or branding.PRODUCT_NAME, 'branch': 'الفرع الرئيسي',

                    self.header_image.textChanged, self.header_only.toggled, self.header_note.textChanged,
                    self.footer_note.textChanged, self.report_style.currentIndexChanged, self._show_statement.toggled):
            sig.connect(self._on_change)
        for cb in self._toggles.values():
            cb.toggled.connect(self._on_change)
        for ed in self._contact.values():
            ed.textChanged.connect(self._on_change)
        return box

    @staticmethod
    def _available_printers():
        try:
            from PySide6.QtPrintSupport import QPrinterInfo
            return list(QPrinterInfo.availablePrinterNames())
        except Exception:  # noqa: BLE001 — لا دعم طباعة في هذه البيئة: تبقى الطابعة الافتراضية فقط
            return []

    # ---------------------------------------------------------------- القراءة/الكتابة
    def _collect(self):
        data = {'paper': self.paper.currentData(), 'orientation': self.orient.currentData(),
                'margin_mm': self.margin.value(), 'font_pt': self.font.currentData(), 'copies': self.copies.value(),
                'printer_name': self.printer.currentData() or '', 'show_logo': self.show_logo.isChecked(),
                'logo_path': self.logo_path.text(), 'header_mode': self.header_mode.currentData(),
                'header_image_path': self.header_image.text(), 'header_image_only': self.header_only.isChecked(), 'header_note': self.header_note.toPlainText(),
                'footer_note': self.footer_note.text(), 'report_style': self.report_style.currentData()}
        data.update({k: ed.text() for k, ed in self._contact.items()})
        data.update({k: cb.isChecked() for k, cb in self._toggles.items()})
        return PSET.from_dict(data)

    def _fill(self, o):
        self._loading = True
        try:
            for combo, val in ((self.paper, o.paper), (self.orient, o.orientation), (self.font, o.font_pt)):
                i = combo.findData(val)
                combo.setCurrentIndex(max(i, 0))
            j = self.printer.findData(o.printer_name)
            if j < 0 and o.printer_name:                      # طابعة محفوظة لم تعد موجودة: تبقى ظاهرة ولا تُفقد
                self.printer.addItem(f'{o.printer_name} (غير متصلة)', o.printer_name)
                j = self.printer.count() - 1
            self.printer.setCurrentIndex(max(j, 0))
            self.margin.setValue(o.margin_mm)
            self.copies.setValue(o.copies)
            self.show_logo.setChecked(o.show_logo)
            self.logo_path.setText(o.logo_path)
            self.header_mode.setCurrentIndex(max(self.header_mode.findData(o.header_mode), 0))
            self.header_image.setText(o.header_image_path)
            self.header_only.setChecked(o.header_image_only)
            self.header_note.setPlainText(o.header_note)
            self.footer_note.setText(o.footer_note)
            self.report_style.setCurrentIndex(max(self.report_style.findData(o.report_style), 0))
            for k, ed in self._contact.items():
                ed.setText(getattr(o, k))
            for k, cb in self._toggles.items():
                cb.setChecked(getattr(o, k))
        finally:
            self._loading = False
        self._sync_header_mode()

    def _pick_header_image(self):
        path, _ = QFileDialog.getOpenFileName(self, 'اختيار صورة الترويسة', '', 'صور (*.png *.jpg *.jpeg)')
        if not path:
            return
        self.header_image.setText(self._store_header_copy(path))
        if self.header_mode.currentData() != 'image':
            self.header_mode.setCurrentIndex(self.header_mode.findData('image'))

    def _store_header_copy(self, path):
        """نسخة من الصورة داخل مجلد بيانات التطبيق ليبقى القالب سليمًا لو نُقل الأصل أو حُذف؛ وعند الفشل يُستعمل المسار الأصلي."""
        try:
            base = os.path.join(os.environ.get('APPDATA') or os.path.expanduser('~'), 'AlhisabatPro', 'print_headers')
            os.makedirs(base, exist_ok=True)
            user = re.sub(r'[^\w\-]+', '_', str(self._username or 'default'), flags=re.UNICODE)
            dest = os.path.join(base, f'{user}{os.path.splitext(path)[1].lower()}')
            if os.path.abspath(path) != os.path.abspath(dest):
                shutil.copyfile(path, dest)
            return dest
        except OSError:
            return path

    def _sync_header_mode(self):
        on = self.header_mode.currentData() == 'image'
        self.header_image.setEnabled(on)
        self.header_only.setEnabled(on)
        for b in self._header_btns:
            b.setEnabled(on)
        for w in (self.show_logo, self.logo_path, self.header_note):
            w.setEnabled(not on)

    def _pick_logo(self):
        path, _ = QFileDialog.getOpenFileName(self, 'اختيار الشعار', '', 'صور (*.png *.jpg *.jpeg)')
        if path:
            self.logo_path.setText(path)

    def _on_change(self, *_a):
        if self._loading:
            return
        self._sync_header_mode()
        PSET.apply(self._collect())
        self._rerender()

    def _on_preview_paper(self, paper):
        i = self.paper.findData(paper)
        if i >= 0 and self.paper.currentIndex() != i:
            self.paper.setCurrentIndex(i)

    def _rerender(self):
        o = PSET.active()
        self.preview.set_paper(o.paper)
        company = self.state.get('company', {}).get('name', '')
        self.preview.set_document(sample_statement(company) if self._show_statement.isChecked() else sample_document(company))
        self.state_lbl.setText('تعديلات لم تُحفظ بعد.' if self.is_dirty() else 'الإعدادات المعروضة هي المحفوظة.')
        self.actions_changed.emit()

    # ---------------------------------------------------------------- الإجراءات
    def save(self):
        try:
            self._saved = PSET.save(self.window_.prefs, self._username, self._collect())
        except ValueError as e:
            QMessageBox.warning(self, S.APP_NAME, str(e))
            return
        PSET.apply(self._saved)
        self.window_.prefs.set('paper', self._saved.paper)
        self._rerender()
        self.notify('تم حفظ إعدادات الطباعة الخاصة بك.')

    def reset_defaults(self):
        self._fill(PSET.PrintOptions())
        self._on_change()

    def preview_print(self):
        self.preview.print_()

    def refresh(self):
        pass

    def is_dirty(self):
        if getattr(self, 'preview', None) is None:                # لم تكتمل بنية الصفحة بعد
            return False
        return self._collect() != self._saved

    def can_close(self):
        if not super().can_close():
            return False
        if getattr(self, '_saved', None) is not None:
            PSET.apply(self._saved)                           # ما لم يُحفظ لا يبقى فعّالًا بعد الإغلاق
        return True

    def ribbon_groups(self):
        return [ActionGroup('الطباعة', [
            Action('save', 'حفظ إعداداتي', 'save', handler=self.save),
            Action('reset', 'استعادة الافتراضي', 'refresh', handler=self.reset_defaults),
            Action('test', 'طباعة صفحة اختبار', 'print', handler=self.preview_print)])]

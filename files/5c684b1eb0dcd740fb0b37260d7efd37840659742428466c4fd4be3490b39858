class PrintGuidePage(BasePage):
    key = 'print_guide'
    title = 'دليل الطباعة'
    icon = 'print'
    required_permission = None            # لكل مستخدم: الإعدادات خاصة بحسابه

    def build(self):
        self._username = self.session.username()
        self._saved = PSET.load(self.window_.prefs, self._username)
        self._loading = False
        lay = QVBoxLayout(self)
        lay.setContentsMargins(6, 6, 6, 6)
        self.tabs = QTabWidget()
        lay.addWidget(self.tabs)

        self.guide = QTextBrowser()
        self.guide.setLayoutDirection(Qt.RightToLeft)
        self.guide.setHtml(guide_html())
        self.tabs.addTab(self.guide, 'دليل الطباعة')

        holder = QSplitter(Qt.Horizontal)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QScrollArea.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setLayoutDirection(Qt.RightToLeft)
        scroll.setMinimumWidth(400)
        scroll.setMaximumWidth(500)
        scroll.setWidget(self._build_form())
        holder.addWidget(scroll)
        self.preview = DocumentSheet(self._saved.paper)
        self.preview.paperChanged.connect(self._on_preview_paper)
        holder.addWidget(self.preview)
        holder.setStretchFactor(0, 0)
        holder.setStretchFactor(1, 1)
        self.tabs.addTab(holder, 'إعدادات الطباعة الخاصة بي')
        self._fill(self._saved)
        PSET.apply(self._saved)
        self._rerender()

    # ---------------------------------------------------------------- النموذج
    def _build_form(self):
        box = QWidget()
        box.setLayoutDirection(Qt.RightToLeft)
        box.setMinimumWidth(380)
        outer = QVBoxLayout(box)
        form = QFormLayout()
        form.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)
        form.setRowWrapPolicy(QFormLayout.DontWrapRows)
        form.setVerticalSpacing(8)
        form.setLabelAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.paper = QComboBox()
        for k in PSET.PAPERS:
            self.paper.addItem(DM.PAPER_LABELS[k], k)
        self.orient = QComboBox()
        for k in PSET.ORIENTATIONS:
            self.orient.addItem(ORIENT_LABELS[k], k)
        self.margin = QSpinBox()
        self.margin.setRange(0, PSET.MARGIN_MAX)
        self.margin.setSpecialValueText('تلقائي')
        self.margin.setSuffix(' مم')
        self.font = QComboBox()
        for v in PSET.FONT_SIZES:
            self.font.addItem('تلقائي' if v == 0 else f'{v} نقطة', v)
        self.copies = QSpinBox()
        self.copies.setRange(1, PSET.COPIES_MAX)
        self.printer = QComboBox()
        self.printer.addItem('الطابعة الافتراضية للنظام', '')
        for name in self._available_printers():
            self.printer.addItem(name, name)
        form.addRow('الورق:', self.paper)
        form.addRow('الاتجاه:', self.orient)
        form.addRow('الهامش:', self.margin)
        form.addRow('حجم الخط:', self.font)
        form.addRow('عدد النسخ:', self.copies)
        form.addRow('الطابعة المفضلة:', self.printer)

        self.header_mode = QComboBox()
        for k in PSET.HEADER_MODES:
            self.header_mode.addItem(HEADER_LABELS[k], k)
        self.header_image = QLineEdit()
        self.header_image.setReadOnly(True)
        self.header_image.setPlaceholderText('لم تُختر صورة ترويسة')
        pick_h = QPushButton('اختيار…')
        pick_h.clicked.connect(self._pick_header_image)
        clear_h = QPushButton('إزالة')
        clear_h.clicked.connect(lambda: self.header_image.setText(''))
        self._header_btns = (pick_h, clear_h)
        row_h = QHBoxLayout()
        for w in (self.header_image, pick_h, clear_h):
            row_h.addWidget(w)
        form.addRow('ترويسة الصفحة:', self.header_mode)
        form.addRow('صورة الترويسة:', row_h)
        self.header_only = QCheckBox('الترويسة فقط (إخفاء عنوان المستند ورقمه وتاريخه وختمه من الرأس)')
        form.addRow(self.header_only)
        self.header_hint = QLabel('تُطبع الصورة بعرض الصفحة كاملًا أعلى كل مستند، وتحل محل الشعار واسم الشركة ونص الترويسة. '
                                  'يُفضَّل صورة عريضة (مثل 1600×250) بخلفية بيضاء.')
        self.header_hint.setWordWrap(True)
        form.addRow(self.header_hint)

        self.show_logo = QCheckBox('إظهار الشعار')
        self.logo_path = QLineEdit()
        self.logo_path.setReadOnly(True)
        self.logo_path.setPlaceholderText('لم يُختر شعار')
        pick = QPushButton('اختيار…')
        pick.clicked.connect(self._pick_logo)
        clear = QPushButton('إزالة')
        clear.clicked.connect(lambda: self.logo_path.setText(''))
        row = QHBoxLayout()
        for w in (self.logo_path, pick, clear):
            row.addWidget(w)
        form.addRow(self.show_logo)
        form.addRow('ملف الشعار:', row)
        self.header_note = QPlainTextEdit()
        self.header_note.setMinimumHeight(64)
        self.header_note.setMaximumHeight(64)
        self.header_note.setPlaceholderText('مثال: العنوان — الهاتف — الرقم الضريبي')
        self.footer_note = QLineEdit()
        self.footer_note.setPlaceholderText('مثال: البضاعة المباعة لا تُسترد بعد 7 أيام')
        form.addRow('نص الترويسة:', self.header_note)
        form.addRow('نص التذييل:', self.footer_note)
        self._show_statement = QCheckBox('معاينة كشف حساب (لرؤية شكل التقارير والكشوف)')
        self._show_statement.setChecked(True)
        self.report_style = QComboBox()
        self.report_style.addItem('شكل 1', 'rabee')
        self.report_style.addItem('شكل 2', 'modern')
        form.addRow('شكل التقارير والكشوف:', self.report_style)
        form.addRow(self._show_statement)
        self._contact = {}
        for key, label, ph in (('company_name_en', 'الاسم الإنجليزي للشركة:', 'Al-Mahyoob Group for Trading - Main Branch'),
                               ('phone', 'Tele No.:', ''), ('fax', 'Fax No.:', ''), ('pobox', 'P.O.Box:', '')):
            ed = QLineEdit()
            ed.setPlaceholderText(ph)
            ed.setLayoutDirection(Qt.LeftToRight)
            self._contact[key] = ed
            form.addRow(label, ed)
        self._toggles = {}
        for key, label in TOGGLES:
            cb = QCheckBox(label)
            self._toggles[key] = cb
            form.addRow(cb)
        for cls in (QComboBox, QSpinBox, QLineEdit):          # كل صنف على حدة (بعض إصدارات PySide6 لا تقبل tuple)
            for w in box.findChildren(cls):
                w.setMinimumHeight(30)
                w.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        for lbl in (self.header_hint,):
            lbl.setMinimumHeight(lbl.sizeHint().height() + 24)
        outer.addLayout(form)

        btns = QHBoxLayout()
        save = QPushButton('حفظ')
        save.setProperty('primary', True)
        save.clicked.connect(self.save)
        reset = QPushButton('استعادة الافتراضي')
        reset.clicked.connect(self.reset_defaults)
        test = QPushButton('طباعة صفحة اختبار')
        test.clicked.connect(self.preview_print)
        for b in (save, reset, test):
            btns.addWidget(b)
        outer.addLayout(btns)
        self.state_lbl = QLabel('')
        self.state_lbl.setWordWrap(True)
        outer.addWidget(self.state_lbl)
        outer.addStretch(1)

        for sig in (self.paper.currentIndexChanged, self.orient.currentIndexChanged, self.font.currentIndexChanged,

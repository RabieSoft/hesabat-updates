    cols = [{'key': 'date', 'label': 'التاريخ'}, {'key': 'no', 'label': 'رقم القيد'}, {'key': 'desc', 'label': 'البيان'},
            {'key': 'debit', 'label': 'مدين', 'numeric': True}, {'key': 'credit', 'label': 'دائن', 'numeric': True},

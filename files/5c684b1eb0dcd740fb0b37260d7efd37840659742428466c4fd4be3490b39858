def sample_document(company=''):
    """مستند نموذجي للمعاينة فقط (بيانات وهمية معنونة صراحةً بـ«نموذج»)."""
    cols = [{'key': 'item', 'label': 'الصنف/الوصف'}, {'key': 'qty', 'label': 'الكمية', 'numeric': True},
            {'key': 'price', 'label': 'السعر', 'numeric': True}, {'key': 'total', 'label': 'الإجمالي', 'numeric': True}]
    rows = [{'item': 'صنف نموذجي أ', 'qty': Decimal('2'), 'price': Decimal('50'), 'total': Decimal('100')},
            {'item': 'صنف نموذجي ب', 'qty': Decimal('1'), 'price': Decimal('110'), 'total': Decimal('110')}]
    spec = {'title': 'فاتورة مبيعات (نموذج للمعاينة)', 'company': company or branding.PRODUCT_NAME, 'branch': 'الفرع الرئيسي',
            'currency': '', 'period': '', 'printed_at': datetime.now().isoformat(timespec='minutes'),
            'extra': [('رقم المستند', 'نموذج-0001'), ('التاريخ', date.today().isoformat()), ('الحالة', 'posted'), ('العميل', 'عميل نموذجي')],
            'columns': cols, 'rows': rows,
            'totals': [{'label': 'الإجمالي', 'value': Decimal('210')}, {'label': 'المدفوع', 'value': Decimal('100')},
                       {'label': 'المتبقي', 'value': Decimal('110')}]}
    return DM.from_print_spec(spec, 'invoice', amount_words='مائتان وعشرة فقط لا غير (مثال)')



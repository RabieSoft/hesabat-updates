"""خدمات التقارير والقوائم المالية (ReportsService): طبقة الخدمات الموحدة للمركز المالي والتقارير.

تلتزم بقيود المحرك:
- Decimal فقط للمبالغ ولا float إطلاقًا.
- استدعاء المحرك المحاسبي مباشرة (balance_engine, financial_statements, cost_center_reports, ledger_engine, aging).
- توليد مواصفات الطباعة الموحدة لكل تقرير لمعاينتها على DocumentSheet وتصديرها (HTML, XLSX, CSV).
"""
from datetime import date
from decimal import Decimal
from pathlib import Path
from typing import Dict, List, Optional, Tuple, Any

from alhisabat.accounting import balance_engine as be, cost_center_reports as ccr, financial_statements as fs, ledger_engine as le
from alhisabat.accounting.errors import AccountingError
from alhisabat.business import aging as ag, inventory as inv
from alhisabat.reporting import extra_reports, group_reports, party_reports, printing, words as report_words
from alhisabat.ui.core import readmodel
from alhisabat.ui.core.format import minor_to_decimal


def _d(v) -> Optional[Decimal]:
    if v is None:
        return None
    if isinstance(v, Decimal):
        return v
    return Decimal(int(v)) / 100



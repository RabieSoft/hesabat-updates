INSERT INTO account_mappings(company_id,map_key,account_id)
SELECT c.id,'cash',a.id FROM companies c JOIN accounts a ON a.company_id=c.id AND a.code='1101'
WHERE NOT EXISTS(SELECT 1 FROM account_mappings m WHERE m.company_id=c.id AND m.map_key='cash');

"""نوافذ الحسابات والربط.
"""
from PySide6.QtCore import Qt
from PySide6.QtWidgets import QCheckBox, QComboBox, QDialog, QDialogButtonBox, QFormLayout, QLabel, QLineEdit, QMessageBox

from alhisabat.ui.core import strings_ar as S

class AccountCreateDialog(QDialog):
    def __init__(self, page, parent_id=None, parent_type=None):
        super().__init__(page); self.setWindowTitle('حساب فرعي جديد' if parent_id else 'حساب جديد'); self.setLayoutDirection(Qt.RightToLeft); self.setMinimumWidth(420)
        form=QFormLayout(self)
        self.name=QLineEdit(); self.code=QLineEdit(); self.desc=QLineEdit()
        self.type=QComboBox()
        from alhisabat.ui.core import logic as L
        for code,label in L.ACCOUNT_TYPES: self.type.addItem(label, code)
        if parent_type:
            idx=self.type.findData(parent_type)
            if idx>=0: self.type.setCurrentIndex(idx)
        self.parent=QComboBox(); self.parent.addItem('— بدون أب (حساب رئيسي) —', None)
        try:
            for aid,label in page.session.lookup_accounts(groups=True): self.parent.addItem(label, aid)
        except Exception: pass
        if parent_id is not None:
            idx=self.parent.findData(int(parent_id))
            if idx>=0: self.parent.setCurrentIndex(idx)
        self.is_group=QCheckBox('مجلد تجميعي (لا يقبل حركات مباشرة)')
        form.addRow('اسم الحساب *', self.name); form.addRow('نوع الحساب', self.type); form.addRow('الحساب الأب', self.parent); form.addRow('', self.is_group); form.addRow('الكود (فارغ=تلقائي)', self.code); form.addRow('الوصف', self.desc)
        bb=QDialogButtonBox(QDialogButtonBox.Ok|QDialogButtonBox.Cancel); bb.accepted.connect(self._accept); bb.rejected.connect(self.reject); form.addRow(bb)
    def _accept(self):
        if not self.name.text().strip(): return QMessageBox.warning(self,'خطأ','اسم الحساب مطلوب')
        self.accept()
    def values(self): return {'name':self.name.text().strip(),'type':self.type.currentData(),'parent':self.parent.currentData(),'is_group':self.is_group.isChecked(),'code':self.code.text().strip() or None,'description':self.desc.text().strip()}


def create_count(conn, actor_id, company_id, warehouse_id, count_date, *, is_full=False, note=""):
    _req(conn, actor_id, company_id, "inventory.count", warehouse_id)
    _wh(conn, warehouse_id, company_id)
    with transaction(conn):
        cid = conn.execute("INSERT INTO stock_counts(company_id,warehouse_id,count_date,is_full,note,created_by) VALUES(?,?,?,?,?,?)",
                           (company_id, warehouse_id, count_date, int(is_full), note, actor_id)).lastrowid
        audit.log(conn, actor_id, "create_count", "stock_counts", cid, after={"warehouse": warehouse_id, "date": count_date})
    return cid


def _count(conn, count_id):
    c = conn.execute("SELECT * FROM stock_counts WHERE id=?", (count_id,)).fetchone()
    if not c:
        raise AccountingError("الجرد غير موجود")
    return c


def set_count_line(conn, actor_id, count_id, item_id, counted_qty, *, unit_id=None, unit_cost=None):
    c = _count(conn, count_id)
    _req(conn, actor_id, c["company_id"], "inventory.count", c["warehouse_id"])
    it = _item(conn, item_id, c["company_id"])
    if it["item_type"] != "stock":
        raise AccountingError("الصنف الخدمي لا يُجرد")
    if c["status"] != "draft":
        raise AccountingError("الجرد ليس مسودة")
    q = Decimal(str(counted_qty))
    if q < 0:
        raise AccountingError("الكمية المعدودة لا تقبل قيمة سالبة")
    f = conn.execute("SELECT factor_milli FROM item_units WHERE item_id=? AND unit_id=?", (item_id, unit_id or it["base_unit_id"])).fetchone()
    if not f:
        raise AccountingError("الوحدة غير معرّفة لهذا الصنف")
    m = _round(q * f[0])
    uc = None if unit_cost is None else je._minor(unit_cost)
    with transaction(conn):
        conn.execute("DELETE FROM stock_count_lines WHERE count_id=? AND item_id=?", (count_id, item_id))
        conn.execute("INSERT INTO stock_count_lines(count_id,item_id,counted_qty_milli,unit_cost_minor) VALUES(?,?,?,?)", (count_id, item_id, m, uc))


def cancel_count(conn, actor_id, count_id, reason=""):
    c = _count(conn, count_id)
    _req(conn, actor_id, c["company_id"], "inventory.count", c["warehouse_id"])
    if c["status"] != "draft":
        raise AccountingError("الجرد ليس مسودة")
    with transaction(conn):
        conn.execute("UPDATE stock_counts SET status='cancelled' WHERE id=?", (count_id,))
        audit.log(conn, actor_id, "cancel_count", "stock_counts", count_id, reason=reason or None)


def post_count(conn, actor_id, count_id):
    """يرحّل الجرد: فروقات (معدود - رصيد النظام) تصير حركات تسوية بتاريخ الجرد وقيدا آليا واحدا. يُرفض إن وُجدت حركات بعد تاريخ الجرد."""
    c = _count(conn, count_id)
    cid, wh, d = c["company_id"], c["warehouse_id"], c["count_date"]
    _req(conn, actor_id, cid, "inventory.count", wh)
    permissions.require(conn, actor_id, cid, "journal.create", check_branch=False)
    permissions.require(conn, actor_id, cid, "journal.post", check_branch=False)
    if c["status"] != "draft":
        raise AccountingError("الجرد ليس مسودة")
    lines = conn.execute("SELECT * FROM stock_count_lines WHERE count_id=? ORDER BY item_id", (count_id,)).fetchall()
    if not lines:
        raise AccountingError("لا توجد بنود جرد")
    if c["is_full"]:
        listed = {l["item_id"] for l in lines}
        missing = [r["code"] for r in conn.execute(
            "SELECT i.code,i.id FROM stock_balances b JOIN items i ON i.id=b.item_id WHERE b.warehouse_id=? AND b.qty_milli>0", (wh,))
            if r["id"] not in listed]
        if missing:
            raise AccountingError("جرد شامل: أصناف بلا جرد: " + "، ".join(missing))
    adj = _mapping(conn, cid, "inventory_adjustment")
    with transaction(conn):
        entry_lines, movs = {}, []
        for l in lines:
            if conn.execute("SELECT 1 FROM stock_movements WHERE item_id=? AND warehouse_id=? AND movement_date>?", (l["item_id"], wh, d)).fetchone():
                raise AccountingError("توجد حركات بعد تاريخ الجرد لأحد الأصناف: أعد الجرد بتاريخ حديث")
            qb, _vb = _balance(conn, l["item_id"], wh)
            diff = l["counted_qty_milli"] - qb
            acc = item_accounts(conn, l["item_id"])["inventory"]
            if diff == 0:
                conn.execute("UPDATE stock_count_lines SET system_qty_milli=?,diff_qty_milli=0,diff_value_base=0 WHERE count_id=? AND item_id=?", (qb, count_id, l["item_id"]))
                continue
            if not acc or not adj:
                raise AccountingError("اربط حساب المخزون وحساب تسويات المخزون (Account Mapping) أولا")
            if diff > 0:
                if qb > 0:
                    cost = _round(Decimal(_balance(conn, l["item_id"], wh)[1]) * diff / qb)
                elif l["unit_cost_minor"] is not None:
                    cost = _round(Decimal(l["unit_cost_minor"]) * diff / 1000)
                else:
                    avg = _avg_cost_anywhere(conn, l["item_id"])
                    if avg is None:
                        raise AccountingError(f"الصنف {_item(conn, l['item_id'])['code']}: زيادة بلا رصيد سابق تتطلب تكلفة وحدة في بند الجرد")
                    cost = _round(avg * diff / 1000)
                mv = record_movement(conn, actor_id, cid, l["item_id"], wh, d, "adjustment_in", Decimal(diff) / 1000, _value=cost,
                                     source_type="stock_count", source_id=count_id, note="جرد", _perm="inventory.count")
            else:
                mv = record_movement(conn, actor_id, cid, l["item_id"], wh, d, "adjustment_out", Decimal(-diff) / 1000,
                                     source_type="stock_count", source_id=count_id, note="جرد", _perm="inventory.count")
            sv = mv["value_base"] * (1 if diff > 0 else -1)
            conn.execute("UPDATE stock_count_lines SET system_qty_milli=?,diff_qty_milli=?,diff_value_base=? WHERE count_id=? AND item_id=?",
                         (qb, diff, sv, count_id, l["item_id"]))
            movs.append(mv["movement_id"])
            entry_lines[acc] = entry_lines.get(acc, 0) + sv
        eid = None
        net = sum(entry_lines.values())
        if any(entry_lines.values()):
            jl = []
            for acc, v in entry_lines.items():
                if v:
                    jl.append({"account_id": acc, "debit": _units(v) if v > 0 else 0, "credit": _units(-v) if v < 0 else 0})
            if net:
                jl.append({"account_id": adj, "debit": _units(-net) if net < 0 else 0, "credit": _units(net) if net > 0 else 0})
            eid = je.create_draft(conn, cid, actor_id, d, jl, f"تسوية جرد رقم {count_id}", entry_type="auto",
                                  source_type="stock_count", source_id=count_id)
            je.post(conn, eid, actor_id)
            for m in movs:
                conn.execute("UPDATE stock_movements SET journal_entry_id=? WHERE id=?", (eid, m))
        conn.execute("UPDATE stock_counts SET status='posted',posted_by=?,posted_at=CURRENT_TIMESTAMP,journal_entry_id=? WHERE id=?", (actor_id, eid, count_id))
        audit.log(conn, actor_id, "post_count", "stock_counts", count_id, after={"entry": eid, "movements": len(movs)})
    return {"count_id": count_id, "entry_id": eid, "movements": movs}

CONFIRMED, REVIEW = "confirmed", "review"
_NATURE = {"asset": "debit", "expense": "debit", "cogs": "debit", "liability": "credit", "equity": "credit", "revenue": "credit"}
_REQUIRED_MAPPINGS = (("period_result", "نتيجة الفترة"), ("retained_earnings", "الأرباح المحتجزة"))


def _f(code, title, severity, subject, amount, cause, treatment, action, impact, preview=None, fix=None, params=None, details=None):
    return {"code": code, "title": title, "severity": severity, "subject": subject, "amount": int(amount or 0),
            "cause": cause, "treatment": treatment, "action": action, "impact": impact, "preview": preview,
            "fix": fix, "fix_params": params or {}, "details": details or []}


def _acc_label(accs, aid):
    a = accs.get(aid)
    return f"{a['code']} — {a['name']}" if a else str(aid)


def _lines_preview(conn, accs, lines):
    out = []
    for l in lines:
        out.append({"account_id": l["account_id"], "code": accs[l["account_id"]]["code"], "name": accs[l["account_id"]]["name"],
                    "currency": l.get("currency"), "debit": l.get("debit", 0), "credit": l.get("credit", 0), "memo": l.get("memo", "")})
    return out


# ───────────────────────── 1) أرصدة الحسابات مقابل دفتر الأستاذ ─────────────────────────
def _ledger_vs_accounts(conn, company_id, day, accs):
    ys = be.year_start(conn, company_id, day)
    eff, counted, _x = be.frag("a")
    args = {"c": company_id, "t": day, "ys": ys, "fl": be.perm_floor(conn, company_id, ys)}
    direct = {}
    for r in conn.execute(
            f"SELECT l.account_id, SUM(l.debit_base-l.credit_base) n FROM journal_lines l JOIN journal_entries e ON e.id=l.entry_id "
            f"JOIN accounts a ON a.id=l.account_id WHERE e.company_id=:c AND e.status IN {be.POSTED} AND e.entry_date<=:t AND {counted} "
            f"GROUP BY l.account_id", args):
        t = be.final_target(accs, r["account_id"])
        direct[t] = direct.get(t, 0) + r["n"]
    tot = be.aggregate(accs, be.movements(conn, company_id, ys, day, ys))
    out = []
    for aid, a in accs.items():
        if a["is_group"] or a["merged_into_id"]:
            continue
        eng = tot[aid][0] + tot[aid][1] - tot[aid][2]
        if eng != direct.get(aid, 0):
            diff = eng - direct.get(aid, 0)
            out.append(_f("ledger_vs_account", "اختلاف رصيد الحساب مع دفتر الأستاذ", CONFIRMED, _acc_label(accs, aid), abs(diff),
                          "رصيد محرك الأرصدة يختلف عن مجموع سطور القيود المرحّلة للحساب نفسه: غالبًا قيد معدّل مباشرة في قاعدة البيانات خارج النظام، أو حساب مدموج/منقول بطريقة غير مكتملة.",
                          "لا يُصحَّح بقيد: يجب تحديد القيد أو الحركة المسببة ومعالجة أصلها (عكس القيد الخاطئ وإعادة تسجيله صحيحًا).",
                          "راجع كشف حساب هذا الحساب وقارنه بالقيود المرحّلة، وأعد النسخة الاحتياطية الأحدث إن ثبت تلاعب مباشر بالقاعدة.",
                          f"رصيد المحرك {eng} مقابل مجموع القيود {direct.get(aid, 0)}"))
    return out


# ───────────────────────── 2) عدم توازن القيود ─────────────────────────
def _unbalanced_entries(conn, company_id, day, accs):
    rows = conn.execute(
        f"SELECT e.id, e.posted_no, e.entry_date, e.entry_type, "
        f"(SELECT COALESCE(SUM(debit_base),0) FROM journal_lines WHERE entry_id=e.id) d, "
        f"(SELECT COALESCE(SUM(credit_base),0) FROM journal_lines WHERE entry_id=e.id) c, "
        f"(SELECT COUNT(*) FROM journal_lines WHERE entry_id=e.id) n FROM journal_entries e "
        f"WHERE e.company_id=? AND e.status IN {be.POSTED} AND e.entry_date<=?", (company_id, day)).fetchall()
    out = []
    for r in rows:
        if r["d"] != r["c"] or r["n"] < 2:
            out.append(_f("unbalanced_entry", "قيد غير متوازن", CONFIRMED, f"قيد رقم {r['posted_no'] or r['id']} بتاريخ {r['entry_date']} ({r['entry_type']})",
                          abs(r["d"] - r["c"]),
                          "مجموع المدين لا يساوي مجموع الدائن (أو القيد بسطر واحد): لا يمكن أن يحدث من الشاشات؛ يدل على تعديل مباشر للقاعدة أو سطور ناقصة.",
                          "القيد المرحّل لا يُعدَّل: يُعكس بقيد عكسي ثم يُعاد تسجيل القيد الصحيح بعد معرفة السطر الناقص من المستند الأصلي.",
                          "افتح القيد وراجع مستنده الأصلي لتحديد السطر الناقص، ولا تضف سطرًا بحساب وسيط.",
                          f"يخلّ الميزان بمقدار {abs(r['d'] - r['c'])}", details=[{"entry_id": r["id"]}]))
    return out


# ───────────────────────── 3) ميزان المراجعة ─────────────────────────
def _trial_balance(conn, company_id, day, accs, unbalanced_found):
    d, c = conn.execute(f"SELECT COALESCE(SUM(l.debit_base),0),COALESCE(SUM(l.credit_base),0) FROM journal_lines l "
                        f"JOIN journal_entries e ON e.id=l.entry_id WHERE e.company_id=? AND e.status IN {be.POSTED} AND e.entry_date<=?",
                        (company_id, day)).fetchone()
    if d == c:
        return []
    cause = ("سببه القيود غير المتوازنة المعروضة أعلاه." if unbalanced_found else
             "لا توجد قيود غير متوازنة فرديًا، فالفرق ناتج عن سطور محذوفة أو مكررة مباشرة في القاعدة أو عن قيد مرحّل ناقص السطور.")
    return [_f("trial_balance", "اختلاف ميزان المراجعة", CONFIRMED, f"إجمالي مدين={d} · إجمالي دائن={c} حتى {day}", abs(d - c), cause,
               "لا يوجد قيد تصحيحي صحيح قبل معرفة الأصل؛ إدخال فرق على حساب وسيط يخفي الخطأ ولا يعالجه.",
               "عالج القيود غير المتوازنة أولًا ثم أعد الفحص.", f"الميزان يختل بمقدار {abs(d - c)}")]


# ───────────────────────── 4) العملاء/الموردون/الموظفون مقابل الحساب الرقابي ─────────────────────────
def _amount_from(detail):
    m = re.search(r"رقابي=(-?\d+)\s+مجموع الأطراف=(-?\d+)", detail or "")
    return abs(int(m.group(1)) - int(m.group(2))) if m else 0


def _control_accounts(conn, company_id, day, accs):
    out = []
    for ch in (integrity._control_checks(conn, company_id, day) or []):
        if ch["status"] != "fail":
            continue
        det = ch["detail"]
        causes, treat = [], []
        if "فرق:" in det:
            causes.append("رصيد الحساب الرقابي لا يساوي مجموع أرصدة الأطراف: غالبًا قيد يدوي مسَّ الحساب الرقابي مباشرة أو طرف نُقل خارج الرقابي")
            treat.append("حدّد القيد الذي مسّ الحساب الرقابي أو الطرف الخارج عنه؛ ثم اعكسه وأعد تسجيله على حساب الطرف نفسه")
        if "حركة مباشرة" in det:
            causes.append("توجد حركة مرحّلة مباشرة على الحساب الرقابي بدل حسابات الأطراف")
            treat.append("انقل الحركة إلى حساب الطرف الصحيح بعكس القيد وإعادة تسجيله")
        if "حسابات بلا طرف" in det or "خارج الرقابي" in det or "نوع آخر" in det:
            causes.append("ربط الحسابات ناقص: حساب تحت الرقابي بلا طرف أو طرف خارجه أو نوع طرف مختلط")
            treat.append("صحّح ربط الطرف بحسابه أو مكان الحساب في الشجرة (لا يلزم قيد)")
        out.append(_f("control_account", "اختلاف الحساب الرقابي مع الأطراف", CONFIRMED if "فرق:" in det else REVIEW, ch["name"], _amount_from(det),
                      "؛ ".join(causes) or "غير محدد", "؛ ".join(treat) or "راجع الحسابات يدويًا",
                      "افتح «ربط الحسابات» وكشف الأطراف وقارن؛ لا تُنشئ قيدًا لتسوية الفرق قبل معرفة سببه.", det))
    return out



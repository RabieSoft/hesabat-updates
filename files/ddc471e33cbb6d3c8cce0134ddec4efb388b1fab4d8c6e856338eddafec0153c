# ---------------------------------------------------------------- توحيد النص
_AR_DIGITS = str.maketrans("٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹٫٬،", "01234567890123456789.,,")
_BIDI = dict.fromkeys(list(range(0x200B, 0x2010)) + list(range(0x202A, 0x202F)) + list(range(0x2066, 0x206A)) + [0xFEFF])
_DIACRITICS = re.compile("[\u064B-\u065F\u0670\u06D6-\u06ED\u0640]")
_AR_LETTER = re.compile("[\u0621-\u064A\u066E-\u06D3\u06FA-\u06FF]")
_LATIN = re.compile("[A-Za-z]")


def _clean(s):
    """NFKC (يفك أشكال العرض العربية FExx) + إزالة علامات الاتجاه + أرقام لاتينية + مسافات موحدة."""
    s = unicodedata.normalize("NFKC", str(s or "")).translate(_BIDI).translate(_AR_DIGITS)
    return re.sub(r"[ \t\u00A0]+", " ", s).strip()


def _key(s):
    """مفتاح مقارنة لعناوين الأعمدة: بلا تشكيل/تطويل، ألفات وياء وتاء مربوطة موحدة، بلا ترقيم."""
    s = _DIACRITICS.sub("", _clean(s)).lower()
    s = s.translate(str.maketrans("أإآٱىة", "اااايه"))
    return re.sub(r"[^\w\s]|_", " ", s).strip()


def _arabic_count(s):
    return len(_AR_LETTER.findall(s))


def _is_arabic_word(w):
    letters = [c for c in w if c.isalpha()]
    return bool(letters) and all(_AR_LETTER.match(c) for c in letters) and not any(c.isdigit() for c in w)


def _looks_reversed(words):
    """هل كلمات طبقة نص PDF العربية بحروف معكوسة (ترتيب بصري)؟ استدلال: ال التعريف في أول الكلمة، وتاء مربوطة/ألف مقصورة
    لا تبدأ كلمة. يقارن شكل الكلمة كما هي بشكلها معكوسة، والتعادل يعني «معكوسة» لأن استخراج الإحداثيات يعطي الترتيب البصري عادة."""
    fwd = rev = 0
    for w in words:
        if not _is_arabic_word(w) or len(w) < 2:
            continue
        for cand, sign in ((w, 1), (w[::-1], -1)):
            sc = 0
            if cand.startswith("ال"):
                sc += 2
            if cand[0] in "ةىءئ":          # لا تبدأ بها كلمة
                sc -= 3
            if cand[-1] in "ةى" or cand.endswith(("ات", "ين", "ون", "ان")):
                sc += 1
            if cand[-1] in "وؤ" and len(cand) > 3:
                sc -= 0
            if sign == 1:
                fwd += sc
            else:
                rev += sc
    return rev >= fwd


def _fix_visual(text, reverse_chars, reorder_tokens=True):
    """نص بصري (يسار→يمين) ← منطقي: عكس حروف الكلمة العربية فقط (الأرقام واللاتيني كما هي)، وعكس ترتيب الكلمات
    إن كان النص سطرًا كاملًا (نص خلايا الجداول). كلمات الإحداثيات تُرتَّب أصلًا من اليمين فلا تُعكس."""
    if not reverse_chars:
        return text
    toks = text.split(" ")
    if reorder_tokens:
        toks = toks[::-1]
    return " ".join(t[::-1] if _is_arabic_word(t) else t for t in toks)


# ---------------------------------------------------------------- كلمات → أسطر → خلايا
class _Box:
    __slots__ = ("text", "x0", "x1", "top", "bottom", "conf")

    def __init__(self, text, x0, x1, top, bottom, conf=100):
        self.text, self.x0, self.x1, self.top, self.bottom, self.conf = text, x0, x1, top, bottom, conf


def _median(v, default):
    v = sorted(v)
    return v[len(v) // 2] if v else default


def _group_boxes(boxes, rtl, gap_factor=1.3):
    """يجمّع الكلمات في أسطر بالإحداثي الرأسي ثم في خلايا بفجوة أفقية كبيرة. الخلية الأولى في السطر هي الأقرب لجهة القراءة."""
    boxes = [b for b in boxes if b.text.strip()]
    if not boxes:
        return []
    med_h = _median([b.bottom - b.top for b in boxes], 10)
    boxes.sort(key=lambda b: (b.top + b.bottom) / 2)
    lines, cur, cur_y = [], [], None
    for b in boxes:
        cy = (b.top + b.bottom) / 2
        if cur_y is None or abs(cy - cur_y) <= med_h * 0.6:
            cur.append(b)
            cur_y = cy if cur_y is None else (cur_y * (len(cur) - 1) + cy) / len(cur)
        else:
            lines.append(cur)
            cur, cur_y = [b], cy
    if cur:
        lines.append(cur)
    out = []
    for ln in lines:
        ln.sort(key=lambda b: b.x0, reverse=rtl)
        cells, cell = [], [ln[0]]
        for prev, b in zip(ln, ln[1:]):
            gap = (prev.x0 - b.x1) if rtl else (b.x0 - prev.x1)
            if gap > med_h * gap_factor:
                cells.append(cell)
                cell = [b]
            else:
                cell.append(b)
        cells.append(cell)
        conf = [b.conf for b in ln if b.conf is not None and b.conf >= 0]
        out.append({"cells": [" ".join(b.text for b in c) for c in cells], "groups": cells,
                    "conf": (sum(conf) / len(conf)) if conf else 100})
    return out



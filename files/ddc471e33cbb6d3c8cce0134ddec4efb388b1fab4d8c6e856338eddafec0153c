def _declare_bundled_deps():
    """لا تُستدعى أبدًا: تكشف لـ PyInstaller المكتبات التي تُحمَّل ديناميكيًا عبر _need فيضمّها داخل exe."""
    import pdfplumber  # noqa: F401
    import pypdfium2  # noqa: F401
    import pytesseract  # noqa: F401
    import pdfminer  # noqa: F401
    import cv2  # noqa: F401
    import numpy  # noqa: F401


def _need(mod, label):
    try:
        return __import__(mod)
    except ImportError:
        import sys
        if getattr(sys, "frozen", False):
            raise AccountingError(f"نسخة البرنامج هذه بُنيت بلا مكتبة {label}. أعد بناء البرنامج بـ build.py (يضمّها تلقائيًا) أو استخدم CSV.")
        raise AccountingError(f"قراءة هذا الملف تحتاج مكتبة {label} وهي غير مثبَّتة. ثبّتها (pip install {label}) أو استخدم CSV.")


def _pdf_pages_text(path):
    """طبقة النص: لكل صفحة {lines|tables}. يرجع قائمة صفحات (قد تكون فارغة للممسوح ضوئيًا)."""
    pdfplumber = _need("pdfplumber", "pdfplumber")
    pages = []
    with pdfplumber.open(path) as pdf:
        if len(pdf.pages) > MAX_PAGES:
            raise AccountingError(f"الملف أكثر من {MAX_PAGES} صفحة. قسّمه ثم استورد كل جزء على حدة.")
        for pg in pdf.pages:
            tables = []
            try:
                for t in pg.extract_tables() or []:
                    rows = [[(c or "").replace("\n", " ") for c in r] for r in t if r and any((c or "").strip() for c in r)]
                    if len(rows) >= 2:
                        tables.append(rows)
            except Exception:  # noqa: BLE001 — جدول مشوَّه لا يوقف قراءة الكلمات
                tables = []
            words = [_Box(w["text"], w["x0"], w["x1"], w["top"], w["bottom"], None)
                     for w in (pg.extract_words(x_tolerance=2, y_tolerance=3, keep_blank_chars=False) or [])]
            pages.append({"tables": tables, "words": words})
    return pages


def _pdf_pages_ocr(path, lang):
    pdfium = _need("pypdfium2", "pypdfium2")
    out = []
    pdf = pdfium.PdfDocument(path)
    try:
        if len(pdf) > MAX_PAGES:
            raise AccountingError(f"الملف أكثر من {MAX_PAGES} صفحة. قسّمه ثم استورد كل جزء على حدة.")
        for i in range(len(pdf)):
            img = pdf[i].render(scale=300 / 72).to_pil()
            out.append(_ocr_image(img, lang))
    finally:
        pdf.close()
    return out


# ---------------------------------------------------------------- OCR
_TESS_PATHS = (r"C:\Program Files\Tesseract-OCR\tesseract.exe", r"C:\Program Files (x86)\Tesseract-OCR\tesseract.exe")


def _tesseract(lang):
    """يضبط مسار Tesseract (PATH ثم مجلد tesseract بجوار البرنامج ثم المسارات المعتادة) ويختار اللغات المتاحة فعلًا."""
    pt = _need("pytesseract", "pytesseract")
    cmd = shutil.which("tesseract")
    if not cmd:
        base = os.path.dirname(os.path.abspath(__import__("alhisabat").__file__))
        for p in (os.path.join(base, "..", "tesseract", "tesseract.exe"),) + _TESS_PATHS:
            if os.path.exists(p):
                cmd = p
                break
    if not cmd:
        raise AccountingError("قراءة الصور وملفات PDF الممسوحة ضوئيًا تحتاج برنامج Tesseract OCR (مع لغة العربية ara). "
                              "ثبّته من مشروع UB-Mannheim ثم أعد المحاولة، أو استخدم ملف PDF نصيًا أو CSV.")
    pt.pytesseract.tesseract_cmd = cmd
    try:
        have = set(pt.get_languages(config=""))
    except Exception:  # noqa: BLE001
        have = set()
    wanted = [x for x in lang.split("+") if x in have]
    warn = None
    if "ara" not in have:
        warn = "لغة العربية (ara) غير مثبَّتة في Tesseract: دقة قراءة الأسماء العربية ستكون ضعيفة جدًا. ثبّت ملف ara.traineddata."
    return pt, ("+".join(wanted) or "eng"), warn


def _preprocess(img):
    """تحسين الصورة للتعرف: اتجاه EXIF، تدرج رمادي، تكبير الصغيرة، إزالة الضوضاء، عتبة تكيفية."""
    from PIL import ImageOps
    img = ImageOps.exif_transpose(img).convert("L")
    if img.width < 1800:
        k = 1800 / img.width
        img = img.resize((int(img.width * k), int(img.height * k)))
    try:
        import cv2
        import numpy as np
        a = cv2.fastNlMeansDenoising(np.array(img), None, 12, 7, 21)
        a = cv2.adaptiveThreshold(a, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 41, 15)
        from PIL import Image
        return Image.fromarray(a)
    except Exception:  # noqa: BLE001 — بدون OpenCV نكتفي بتباين PIL
        return ImageOps.autocontrast(img)


def _ocr_image(img, lang):
    pt, use_lang, warn = _tesseract(lang)
    data = pt.image_to_data(_preprocess(img), lang=use_lang, config="--psm 6", output_type=pt.Output.DICT)
    boxes = []
    for i, t in enumerate(data["text"]):
        t = (t or "").strip()
        try:
            conf = float(data["conf"][i])
        except (TypeError, ValueError):
            conf = -1
        if t and conf >= 0:
            boxes.append(_Box(t, data["left"][i], data["left"][i] + data["width"][i], data["top"][i],
                              data["top"][i] + data["height"][i], conf))
    return {"tables": [], "words": boxes, "ocr": True, "warn": warn}


# ---------------------------------------------------------------- استخراج الأسطر
def _extract_lines(path, lang="ara+eng"):
    """يرجع (أسطر، وصف المصدر، تحذيرات). السطر = {cells, conf, page}. ترتيب الخلايا: الأولى هي الأقرب لجهة القراءة."""
    ext = os.path.splitext(path)[1].lower()
    if not os.path.isfile(path):
        raise AccountingError("الملف غير موجود")
    warnings = []
    if ext in IMAGE_EXT:
        from PIL import Image
        pages, source = [_ocr_image(Image.open(path), lang)], "صورة (OCR)"
    elif ext in PDF_EXT:
        pages = _pdf_pages_text(path)
        total_chars = sum(len(b.text) for p in pages for b in p["words"])
        if total_chars < 15 * max(1, len(pages)):          # لا طبقة نص كافية: ممسوح ضوئيًا
            pages, source = _pdf_pages_ocr(path, lang), "PDF ممسوح ضوئيًا (OCR)"
        else:
            source = "PDF نصي"
    else:
        raise AccountingError("نوع الملف غير مدعوم. المدعوم: CSV وPDF والصور (PNG/JPG/TIFF/BMP/WEBP).")
    for p in pages:
        if p.get("warn") and p["warn"] not in warnings:
            warnings.append(p["warn"])

    all_words = [b.text for p in pages for b in p["words"]]
    from_text_layer = source == "PDF نصي"
    ar = sum(_arabic_count(w) for w in all_words)
    lat = sum(len(_LATIN.findall(w)) for w in all_words)
    rtl = ar > lat
    reverse = bool(from_text_layer and rtl and _looks_reversed(all_words))

    # ترتيب الكلمات: OCR وPDF بصري (معكوس الحروف) موضوعان فعلًا من اليمين لليسار؛ نص PDF منطقي موضوع يسار→يمين يبقى كذلك
    sort_rtl = rtl and (reverse or not from_text_layer)
    lines = []
    for pno, p in enumerate(pages, 1):
        if p["tables"]:
            for t in p["tables"]:
                for r in t:
                    cells = [_clean(_fix_visual(_clean(c), reverse, reorder_tokens=True)) for c in r]
                    cells = cells[::-1] if (rtl and from_text_layer) else cells
                    lines.append({"cells": cells, "conf": 100, "page": pno, "table": True})
            continue
        for b in p["words"]:
            b.text = _clean(b.text)
            if reverse and _is_arabic_word(b.text):
                b.text = b.text[::-1]
        for ln in _group_boxes(p["words"], sort_rtl):
            ln["page"], ln["table"] = pno, False
            lines.append(ln)
    if not lines:
        raise AccountingError("لم يُعثر على أي نص في الملف. تأكد من وضوح المستند أو استخدم صورة أعلى جودة.")
    return _regrid_by_header(lines, sort_rtl), source, warnings


def _regrid_by_header(lines, rtl):
    """إن وُجد صف عناوين بثلاث خلايا فأكثر: يعيد توزيع كلمات كل سطر على أعمدة العناوين بأقرب مركز أفقي، فلا تلتصق
    الأعمدة المتقاربة (اسم طويل بجوار الكود). الأسطر القادمة من جداول PDF تبقى كما هي."""
    hi, _m = _find_header(lines)
    if hi is None or "groups" not in lines[hi] or len(lines[hi]["groups"]) < 3:
        return lines
    groups = lines[hi]["groups"]
    order = sorted(range(len(groups)), key=lambda i: min(x.x0 for x in groups[i]))      # أعمدة من اليسار لليمين
    left = [min(x.x0 for x in groups[i]) for i in order]
    right = [max(x.x1 for x in groups[i]) for i in order]
    bounds = [(right[k] + left[k + 1]) / 2 for k in range(len(order) - 1)]              # منتصف الفجوة بين عمودين
    for k, ln in enumerate(lines):
        if k <= hi or "groups" not in ln:
            continue
        cols = [[] for _ in groups]
        for g in ln["groups"]:
            for bx in g:
                cx = (bx.x0 + bx.x1) / 2
                pos = sum(1 for bd in bounds if cx > bd)
                cols[order[pos]].append(bx)
        ln["cells"] = [" ".join(bx.text for bx in sorted(c, key=lambda t: t.x0, reverse=rtl)) for c in cols]
    return lines



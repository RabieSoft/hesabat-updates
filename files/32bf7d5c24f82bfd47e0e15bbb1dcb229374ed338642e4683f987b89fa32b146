-- العملة المرتبطة بحساب نقدي لا تتغير بعد تسجيل أي حركة عليه.
CREATE TRIGGER cash_account_currency_lock BEFORE UPDATE OF currency ON cash_accounts
WHEN OLD.currency<>NEW.currency AND EXISTS(SELECT 1 FROM journal_lines WHERE account_id=OLD.account_id)
BEGIN SELECT RAISE(ABORT,'لا يمكن تغيير عملة صندوق/بنك له حركات'); END;


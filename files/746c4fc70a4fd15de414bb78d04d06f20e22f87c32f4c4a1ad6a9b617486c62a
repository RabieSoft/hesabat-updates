def svg(name, color='#000000', size=24, stroke=1.8):
    """نص SVG كامل للأيقونة بلون محدد (لا اعتماد على Qt)."""
    body = _P.get(name, _P['info'])
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 24 24" '
            f'fill="none" stroke="{color}" stroke-width="{stroke}" stroke-linecap="round" stroke-linejoin="round">{body}</svg>')


_CACHE = {}


def qicon(name, color='#000000', size=20):
    """QIcon من SVG (يحتاج PySide6.QtSvg). يعود QIcon فارغًا إن تعذّر، فلا تنهار الواجهة."""
    key = (name, color, size)
    if key in _CACHE:
        return _CACHE[key]
    from PySide6.QtCore import QByteArray, Qt
    from PySide6.QtGui import QIcon, QPainter, QPixmap
    try:
        from PySide6.QtSvg import QSvgRenderer
    except Exception:  # noqa: BLE001
        _CACHE[key] = QIcon()
        return _CACHE[key]
    ratio = 2  # شاشات عالية الكثافة
    r = QSvgRenderer(QByteArray(svg(name, color, size * ratio).encode('utf-8')))
    pm = QPixmap(size * ratio, size * ratio)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    r.render(p)
    p.end()
    pm.setDevicePixelRatio(ratio)
    ic = QIcon(pm)
    _CACHE[key] = ic
    return ic

-- سياسات المبيعات القابلة للتفعيل من الإعدادات (لمدير النظام فقط):
--  1) السماح بتعديل فاتورة مبيعات مرحّلة (أصنافها/أسعارها/كمياتها/دفعاتها): تُعكس آثارها القديمة بقيد عكسي وحركات عكسية ثم تُرحَّل بالقيم الجديدة بنفس رقمها، ويُوثَّق ذلك في سجل التعديلات والتدقيق.
--  2) السماح ببيع كمية تتجاوز الرصيد (رصيد سالب): الكمية الزائدة تُقيَّم بآخر تكلفة معروفة، وعند الشراء اللاحق تُوازَن الكمية تلقائيًا ويُسوَّى فرق التكلفة على تكلفة المبيعات.
ALTER TABLE sales_settings ADD COLUMN allow_edit_posted_invoice INTEGER NOT NULL DEFAULT 0 CHECK(allow_edit_posted_invoice IN (0,1));
ALTER TABLE sales_settings ADD COLUMN allow_negative_stock INTEGER NOT NULL DEFAULT 0 CHECK(allow_negative_stock IN (0,1));


class ItemUnitsDialog(QDialog):
    """وحدات التحويل لصنف: عرض/إضافة/تعديل المعامل/إزالة. الوحدة الأساسية ثابتة (معاملها 1)."""

    def __init__(self, page, item):
        super().__init__(page)
        self.page, self.item = page, item
        self.setWindowTitle(f"وحدات الصنف — {item.get('name')}")
        self.setLayoutDirection(Qt.RightToLeft)
        self.resize(520, 380)
        lay = QVBoxLayout(self)
        self.tbl = QTableWidget(0, 3)
        self.tbl.setHorizontalHeaderLabels(['الوحدة', 'المعامل (× الوحدة الأساسية)', 'النوع'])
        self.tbl.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tbl.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tbl.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tbl.horizontalHeader().setStretchLastSection(True)
        self.tbl.setColumnWidth(0, 170)
        self.tbl.setColumnWidth(1, 200)
        lay.addWidget(self.tbl, 1)
        row = QHBoxLayout()
        for text, fn in (('+ وحدة تحويل', self._add), ('تعديل المعامل', self._edit), ('إزالة', self._remove)):
            b = QPushButton(text)
            b.clicked.connect(fn)
            row.addWidget(b)
        row.addStretch(1)
        close = QPushButton('إغلاق')
        close.clicked.connect(self.accept)
        row.addWidget(close)
        lay.addLayout(row)
        self._units = []
        self._load()

    def _load(self):
        self.tbl.setRowCount(0)
        try:
            self._units = self.page.svc.item_units(self.item['id'])
        except Exception as exc:  # noqa: BLE001
            self.page.show_error(exc)
            self._units = []
        for u in self._units:
            r = self.tbl.rowCount()
            self.tbl.insertRow(r)
            f = Decimal(u.get('factor_milli') or 0) / Decimal(1000)
            self.tbl.setItem(r, 0, QTableWidgetItem(u['name']))
            self.tbl.setItem(r, 1, QTableWidgetItem(f"{f:g}"))
            self.tbl.setItem(r, 2, QTableWidgetItem('أساسية' if u.get('is_base') else 'تحويل'))

    def _current(self):
        r = self.tbl.currentRow()
        return self._units[r] if 0 <= r < len(self._units) else None

    def _ask_factor(self, title, unit_label, default='1'):
        dlg = QDialog(self)
        dlg.setWindowTitle(title)
        dlg.setLayoutDirection(Qt.RightToLeft)
        form = QFormLayout(dlg)
        factor = QLineEdit(default)
        form.addRow(f"كم من «{self.item.get('unit')}» في {unit_label}؟", factor)
        bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        bb.accepted.connect(dlg.accept)
        bb.rejected.connect(dlg.reject)
        form.addRow(bb)
        if dlg.exec() != QDialog.Accepted:
            return None
        return factor.text().strip().replace(',', '') or '1'

    def _add(self):
        dlg = QDialog(self)
        dlg.setWindowTitle('وحدة تحويل جديدة')
        dlg.setLayoutDirection(Qt.RightToLeft)
        form = QFormLayout(dlg)
        cb = QComboBox()
        have = {u['id'] for u in self._units}
        try:
            for u in self.page.svc.units():
                if u['id'] not in have:
                    cb.addItem(u['name'], u['id'])
        except Exception as exc:  # noqa: BLE001
            self.page.show_error(exc)
        if cb.count() == 0:
            return QMessageBox.information(self, 'تنبيه', 'لا توجد وحدات أخرى في دليل الوحدات؛ أضِف وحدة من «دليل الوحدات» أولًا.')
        factor = QLineEdit('1')
        form.addRow('الوحدة', cb)
        form.addRow(f"المعامل (كم × {self.item.get('unit')})", factor)
        bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        bb.accepted.connect(dlg.accept)
        bb.rejected.connect(dlg.reject)
        form.addRow(bb)
        if dlg.exec() != QDialog.Accepted:
            return
        ok, _ = self.page.guarded(self.page.svc.add_item_unit, self.item['id'], cb.currentData(),
                                  factor.text().strip().replace(',', '') or '1', reload=False)
        if ok:
            self._load()

    def _edit(self):
        u = self._current()
        if not u:
            return QMessageBox.information(self, 'تنبيه', 'حدد وحدة أولًا')
        if u.get('is_base'):
            return QMessageBox.information(self, 'تنبيه', 'معامل الوحدة الأساسية ثابت (1)')
        cur = Decimal(u.get('factor_milli') or 0) / Decimal(1000)
        f = self._ask_factor('تعديل المعامل', f"«{u['name']}»", f"{cur:g}")
        if f is None:
            return
        ok, _ = self.page.guarded(self.page.svc.update_item_unit, self.item['id'], u['id'], f, reload=False)
        if ok:
            self._load()

    def _remove(self):
        u = self._current()
        if not u:
            return QMessageBox.information(self, 'تنبيه', 'حدد وحدة أولًا')
        if u.get('is_base'):
            return QMessageBox.information(self, 'تنبيه', 'لا يمكن إزالة الوحدة الأساسية')
        if QMessageBox.question(self, 'تأكيد', f"إزالة الوحدة «{u['name']}» من هذا الصنف؟",
                                QMessageBox.Yes | QMessageBox.No, QMessageBox.No) != QMessageBox.Yes:
            return
        ok, _ = self.page.guarded(self.page.svc.remove_item_unit, self.item['id'], u['id'], reload=False)
        if ok:
            self._load()


class BranchDialog(QDialog):
    """إضافة/تعديل فرع."""

    def __init__(self, page, existing=None):
        super().__init__(page)
        self.setWindowTitle('تعديل فرع' if existing else 'فرع جديد')
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(420)
        form = QFormLayout(self)
        e = existing or {}
        self.name = QLineEdit(e.get('name', ''))
        self.code = QLineEdit(e.get('code', ''))
        self.code.setPlaceholderText('فارغ = تلقائي')
        self.address = QLineEdit(e.get('address', ''))
        self.phone = QLineEdit(e.get('phone', ''))
        self.notes = QPlainTextEdit(e.get('notes', ''))
        self.notes.setFixedHeight(64)
        form.addRow('اسم الفرع *', self.name)
        form.addRow('الكود', self.code)
        form.addRow('العنوان', self.address)
        form.addRow('الهاتف', self.phone)
        form.addRow('ملاحظات', self.notes)
        _buttons(self, form)

    def _accept(self):
        if not self.name.text().strip():
            return QMessageBox.warning(self, 'تنبيه', 'اسم الفرع مطلوب')
        self.accept()

    def values(self):
        return {'name': self.name.text().strip(), 'code': self.code.text().strip(), 'address': self.address.text().strip(),
                'phone': self.phone.text().strip(), 'notes': self.notes.toPlainText().strip()}

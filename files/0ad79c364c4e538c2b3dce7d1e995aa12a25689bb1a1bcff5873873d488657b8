"""نوافذ دليل التصنيفات والوحدات والفروع. لا SQL هنا: كل شيء عبر خدمات الصفحة (page.svc)."""
from decimal import Decimal

from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QAbstractItemView, QComboBox, QDialog, QDialogButtonBox, QFormLayout, QHBoxLayout, QLabel, QLineEdit,
    QListWidget, QListWidgetItem, QMessageBox, QPlainTextEdit, QPushButton, QTableWidget, QTableWidgetItem, QVBoxLayout
)


def _buttons(dlg, form_or_layout, ok_text='حفظ'):
    bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
    bb.button(QDialogButtonBox.Ok).setText(ok_text)
    bb.button(QDialogButtonBox.Cancel).setText('إلغاء')
    bb.accepted.connect(dlg._accept)
    bb.rejected.connect(dlg.reject)
    if isinstance(form_or_layout, QFormLayout):
        form_or_layout.addRow(bb)
    else:
        form_or_layout.addWidget(bb)


class CategoryDialog(QDialog):
    """إضافة/تعديل تصنيف. parent_path نص للعرض فقط (التصنيف الأب)."""

    def __init__(self, page, existing=None, parent_id=None, parent_path=''):
        super().__init__(page)
        self.parent_id = parent_id
        self.setWindowTitle('تعديل تصنيف' if existing else ('تصنيف فرعي جديد' if parent_id else 'تصنيف رئيسي جديد'))
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(400)
        form = QFormLayout(self)
        if parent_path:
            form.addRow('التصنيف الأب', QLabel(parent_path))
        self.name = QLineEdit(existing.get('name', '') if existing else '')
        self.code = QLineEdit(existing.get('code', '') if existing else '')
        self.code.setPlaceholderText('فارغ = تلقائي')
        self.notes = QLineEdit(existing.get('notes', '') if existing else '')
        form.addRow('اسم التصنيف *', self.name)
        form.addRow('الكود', self.code)
        form.addRow('ملاحظات', self.notes)
        from alhisabat.ui.core import strings_ar as S
        self.method = QComboBox()
        self.method.addItem('موروثة من التصنيف الأب (الافتراضي: المتوسط المرجّح)', '')
        for k, lab in S.COST_METHOD_LABELS.items():
            self.method.addItem(lab, k)
        i = self.method.findData((existing or {}).get('cost_method') or '')
        self.method.setCurrentIndex(max(i, 0))
        form.addRow('طريقة تقييم المخزون', self.method)
        note = QLabel(S.COST_METHOD_NOTE); note.setWordWrap(True); note.setObjectName('ctxKey')
        form.addRow(note)
        _buttons(self, form)

    def _accept(self):
        if not self.name.text().strip():
            return QMessageBox.warning(self, 'تنبيه', 'اسم التصنيف مطلوب')
        self.accept()

    def values(self):
        return {'name': self.name.text().strip(), 'code': self.code.text().strip(), 'notes': self.notes.text().strip(),
                'parent_id': self.parent_id, 'cost_method': self.method.currentData() or ''}


class CategoryPickDialog(QDialog):
    """اختيار تصنيف من الشجرة (مسارات كاملة). allow_none يضيف «بدون تصنيف/جذر»."""

    def __init__(self, page, title, categories, exclude_ids=(), allow_none=False, none_text='بدون تصنيف'):
        super().__init__(page)
        self.setWindowTitle(title)
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(420)
        form = QFormLayout(self)
        self.combo = QComboBox()
        if allow_none:
            self.combo.addItem(none_text, None)
        for c in categories:
            if c['id'] in exclude_ids or not c.get('is_active', 1):
                continue
            self.combo.addItem(('    ' * c['depth']) + c['name'] + f"   [{c['path']}]" if c['depth'] else c['name'], c['id'])
        form.addRow('التصنيف', self.combo)
        _buttons(self, form, 'موافق')

    def _accept(self):
        self.accept()

    def value(self):
        return self.combo.currentData()


class ItemsPickDialog(QDialog):
    """اختيار أصناف متعددة بعلامات (مع بحث) لربطها بتصنيف."""

    def __init__(self, page, title, items):
        super().__init__(page)
        self.setWindowTitle(title)
        self.setLayoutDirection(Qt.RightToLeft)
        self.resize(480, 520)
        lay = QVBoxLayout(self)
        self.search = QLineEdit()
        self.search.setPlaceholderText('بحث بالاسم أو الكود…')
        self.search.textChanged.connect(self._filter)
        lay.addWidget(self.search)
        self.lst = QListWidget()
        for it in items:
            li = QListWidgetItem(f"{it.get('code', '')} — {it.get('name', '')}   [{it.get('category') or 'بدون تصنيف'}]")
            li.setData(Qt.UserRole, it['id'])
            li.setFlags(li.flags() | Qt.ItemIsUserCheckable)
            li.setCheckState(Qt.Unchecked)
            self.lst.addItem(li)
        lay.addWidget(self.lst, 1)
        _buttons(self, lay, 'ربط المحدد')

    def _filter(self, text):
        t = (text or '').strip()
        for i in range(self.lst.count()):
            self.lst.item(i).setHidden(bool(t) and t not in self.lst.item(i).text())

    def _accept(self):
        if not self.ids():
            return QMessageBox.information(self, 'تنبيه', 'ضع علامة على صنف واحد على الأقل')
        self.accept()

    def ids(self):
        return [self.lst.item(i).data(Qt.UserRole) for i in range(self.lst.count())
                if self.lst.item(i).checkState() == Qt.Checked]



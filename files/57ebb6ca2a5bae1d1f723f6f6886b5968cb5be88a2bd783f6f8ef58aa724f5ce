-- 0049: قالب إشعار الحركة الجديد (الشركة، نوع القيد، الأخوة/الاسم، لكم/عليكم، المبلغ بالحروف، البيان، الرصيد)
-- يُحدَّث القالب الافتراضي فقط إن لم يُعدَّل يدويًا.
UPDATE wa_templates SET body = '*{الشركة}*
({نوع_القيد})
الأخوة / {الاسم}
{لكم_عليكم} ({نوع_القيد})
رقم ({رقم_المستند})
المبلغ : {المبلغ} ({اسم_العملة})
{المبلغ_كتابة}
البيان : {البيان}
بتاريخ : {التاريخ}
الرصيد {جانب_الرصيد}
{الرصيد} {اسم_العملة}'
 WHERE code = 'movement' AND branch_id IS NULL
   AND body = 'مرحبًا {الاسم}، تم تسجيل {نوع_الحركة} رقم {رقم_المستند} بتاريخ {التاريخ} بمبلغ {المبلغ} {العملة} ({الجانب}). رصيدكم الحالي: {الرصيد} {العملة}.';

"""التشغيل السريع: محرّك الترتيب والتجميع الخالص (بلا PySide6 ولا SQL) خلف نافذة Ctrl+K.

يجمع في قائمة واحدة مرتّبة:
  • مهام  (task)   : إجراءات تنفَّذ مباشرة (فاتورة بيع جديدة، قيد جديد، عميل جديد، تبديل المظهر…).
  • شاشات (screen) : كل صفحات النظام المسموحة للمستخدم، مع اسم القائمة العلوية التي تنتمي إليها.
  • سجلات (record) : بحث عميق في بيانات الشركة: عملاء/موردون (اسم، كود، هاتف، رقم ضريبي)، أصناف (اسم، كود، باركود)،
                     حسابات، فواتير بيع/شراء (رقم، طرف، ملاحظات، أو المبلغ)، قيود يومية (رقم، بيان، بيان الأسطر)،
                     مستودعات، صناديق وبنوك، فروع، عملات، مستخدمون.

القواعد: كل مصدر يُفحص بصلاحيته (Access) وبنطاق الفرع الحالي؛ مصدر بلا صلاحية أو فاشل يُتجاوز بصمت ولا يوقف البقية.
البحث يتجاهل التشكيل والهمزات والأرقام العربية/اللاتينية (logic.normalize_ar).
"""
import json
from dataclasses import dataclass
from typing import Optional

from alhisabat.ui.core.logic import matches, relevance

from . import navigation as N

MAX_RESULTS = 60
RECENT_LIMIT = 6
RECENT_KEY = 'quick_recent'
KIND_ORDER = {'task': 0, 'screen': 1, 'record': 2}


@dataclass(frozen=True)
class Hit:
    kind: str                  # task | screen | record
    title: str                 # عمود «الشاشة»
    group: str                 # عمود «القائمة»: اسم القائمة العلوية / «مهمة» / نوع السجل
    detail: str = ''
    page: str = ''             # مفتاح الصفحة (screen/record)
    params: object = None      # معاملات الصفحة (record) مثل {'id': 5}
    task: str = ''             # مفتاح المهمة (task)
    score: int = 0
    icon: str = 'list'         # اسم أيقونة من design/icons
    hint: str = ''             # اختصار لوحة المفاتيح إن وُجد (F5…)


@dataclass(frozen=True)
class TaskSpec:
    key: str
    title: str
    page: str = ''             # الصفحة التي تُفتح ثم تُستدعى طريقتها
    method: str = ''           # اسم الطريقة في الصفحة (مثل _new)
    args: tuple = ()
    window_method: str = ''    # بدلًا من ذلك: طريقة في النافذة الرئيسية (toggle_theme…)
    keywords: str = ''
    writes: bool = True        # تعدّل بيانات (تُمنع في وضع القراءة فقط)
    icon: str = 'new'
    shortcut: str = ''



    TaskSpec('cash_transfer', 'تحويل بين الصناديق والبنوك', 'cash', '_transfer', keywords='تحويل نقل صندوق بنك مناقلة', icon='bank'),
    TaskSpec('new_customer', 'إضافة عميل', 'parties', '_add', ('customer',), keywords='عميل زبون جديد طرف', icon='users'),

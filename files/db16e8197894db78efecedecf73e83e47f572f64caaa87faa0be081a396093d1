_TASK_BY_KEY = {t.key: t for t in TASKS}


def task(key) -> Optional[TaskSpec]:
    return _TASK_BY_KEY.get(key)


# ------------------------------------------------------------------ مساعدات
def _menu_of_pages():
    out = {}
    for m in N.TOP_MENUS:
        for k in m.items:
            if k:
                out[k] = m.title
    return out


def _page_icon(key):
    spec = N.get(key)
    return spec.icon if spec else 'list'


# ------------------------------------------------------------------ الشاشات والمهام
def screen_hits(query, access, features=None, show_advanced=True):
    menu = _menu_of_pages()
    out = []
    for spec in N.search_pages(query, access, features, show_advanced):
        out.append(Hit('screen', spec.title, menu.get(spec.key, spec.group), spec.description, page=spec.key,
                       score=relevance(query, spec.title, spec.keywords, spec.group), icon=spec.icon))
    return out


def task_hits(query, access, features=None):
    out = []
    for t in TASKS:
        if t.page:
            spec = N.get(t.page)
            if spec is None or not N.allowed(spec, access):
                continue
        if not query or matches(query, t.title, t.keywords):
            out.append(Hit('task', t.title, 'مهمة', 'تنفيذ مباشر', task=t.key, score=relevance(query, t.title, t.keywords),
                           icon=t.icon, hint=t.shortcut))
    return out


# ------------------------------------------------------------------ بحث السجلات (القراءة في services/search.py)
def record_hits(session, query, access):
    """بحث عميق في السجلات عبر session.search_records (بالصلاحيات ونطاق الفرع)؛ يُحوَّل كل قاموس إلى Hit."""
    try:
        rows = session.search_records(query, access)
    except Exception:  # noqa: BLE001 — فشل البحث العميق لا يُسقط الشاشات والمهام
        return []
    return [Hit('record', r['title'], r['group'], r['detail'], r['page'], r['params'], score=r['score'], icon=_page_icon(r['page']))
            for r in rows]


def search(session, access, query, features=None, show_advanced=True):
    """القائمة النهائية. بلا استعلام: المهام ثم كل الشاشات (كجدول «التشغيل السريع»). باستعلام: الأعلى صلة أولًا،
    وعند التساوي المهام ثم الشاشات ثم السجلات."""
    q = (query or '').strip()
    hits = task_hits(q, access, features) + screen_hits(q, access, features, show_advanced)
    if q:
        hits += record_hits(session, q, access)
        hits.sort(key=lambda h: (-h.score, KIND_ORDER[h.kind]))
    return hits[:MAX_RESULTS] if q else hits


# ------------------------------------------------------------------ الأخيرة (تُحفظ في تفضيلات المستخدم المحلية)
def hit_key(h):
    """هوية ثابتة للنتيجة (للحذف من التكرار): نوعها + هدفها + معاملاتها (للسجل: وعنوانه)."""
    params = json.dumps(h.params, sort_keys=True, ensure_ascii=False, default=str) if h.params else ''
    return (h.kind, h.task or h.page, params, h.title if h.kind == 'record' else '')


def _hit_dict(h):
    return {'kind': h.kind, 'title': h.title, 'group': h.group, 'detail': h.detail, 'page': h.page,
            'params': h.params, 'task': h.task, 'icon': h.icon, 'hint': h.hint}


def recent_load(raw):
    """نص JSON ← قائمة Hit؛ أي تلف في المخزن يُتجاهل بصمت (قائمة فارغة)."""
    try:
        data = json.loads(raw or '[]')
    except (TypeError, ValueError):
        return []
    out = []
    for d in data if isinstance(data, list) else []:
        try:
            if d['kind'] in KIND_ORDER and isinstance(d['title'], str):
                out.append(Hit(d['kind'], d['title'], d.get('group', ''), d.get('detail', ''), d.get('page', ''),
                               d.get('params'), d.get('task', ''), 0, d.get('icon') or 'list', d.get('hint', '')))
        except (KeyError, TypeError):
            continue
    return out


def recent_push(raw, hit, limit=RECENT_LIMIT):
    """يضيف النتيجة المنفَّذة في مقدمة «الأخيرة» (بلا تكرار) ويعيد النص الجديد للحفظ."""
    cur = [h for h in recent_load(raw) if hit_key(h) != hit_key(hit)]
    return json.dumps([_hit_dict(h) for h in ([hit] + cur)[:limit]], ensure_ascii=False, default=str)


def recent_allowed(raw, access):
    """الأخيرة الصالحة اليوم فقط: المهمة ما زالت موجودة ومسموحة، والصفحة مسموحة بصلاحية المستخدم الحالي."""
    out = []
    for h in recent_load(raw):
        if h.kind == 'task':
            t = task(h.task)
            if t is None:
                continue
            if t.page:
                spec = N.get(t.page)
                if spec is None or not N.allowed(spec, access):
                    continue
            out.append(Hit('task', t.title, 'مهمة', 'تنفيذ مباشر', task=t.key, icon=t.icon, hint=t.shortcut))
        else:
            spec = N.get(h.page)
            if spec is not None and N.allowed(spec, access):
                out.append(h)
    return out


# ------------------------------------------------------------------ ترتيب العرض (أقسام + مرشّح التصنيف)
FILTERS = (('all', 'الكل'), ('task', 'مهام'), ('screen', 'شاشات'), ('record', 'سجلات'))


def layout_rows(hits, recents=(), query='', kind='all'):
    """يحوّل النتائج إلى صفوف عرض: ('header', نص) أو ('hit', Hit).

    • باستعلام: قائمة مسطّحة بترتيب الصلة (الأقسام تكسر الترتيب).
    • بلا استعلام: «الأخيرة» ثم «المهام» ثم الشاشات مجمّعة تحت اسم قائمتها؛ ما ظهر في «الأخيرة» لا يتكرر.
    • kind: all | task | screen | record يرشّح النتائج (الأخيرة تظهر مع «الكل» فقط).
    """
    hits = [h for h in hits if kind in ('all', h.kind)]
    if (query or '').strip():
        return [('hit', h) for h in hits]
    rows, seen = [], set()
    if kind == 'all':
        rec = [h for h in recents]
        if rec:
            rows.append(('header', 'الأخيرة'))
            for h in rec:
                seen.add(hit_key(h))
                rows.append(('hit', h))
    tasks = [h for h in hits if h.kind == 'task' and hit_key(h) not in seen]
    if tasks:
        rows.append(('header', 'المهام السريعة'))
        rows += [('hit', h) for h in tasks]
    last = None
    for h in hits:
        if h.kind != 'screen' or hit_key(h) in seen:
            continue
        if h.group != last:
            rows.append(('header', f'الشاشات — {h.group}'))
            last = h.group
        rows.append(('hit', h))
    for h in hits:
        if h.kind == 'record':
            rows.append(('hit', h))
    return rows


def step_index(selectable, current, step, wrap=True):
    """التنقل بالأزرار: selectable قائمة مواضع الصفوف القابلة للتحديد؛ يعيد الموضع الجديد (يتجاوز العناوين)."""
    if not selectable:
        return -1
    if current not in selectable:
        return selectable[0] if step >= 0 else selectable[-1]
    i = selectable.index(current) + step
    if wrap and abs(step) == 1:
        i %= len(selectable)
    return selectable[max(0, min(len(selectable) - 1, i))]

        self.fav_panel.browse.connect(lambda: self._open_recipes(None, switch=True))
        body = QHBoxLayout()
        body.addWidget(self.tabs, 1)
        body.addWidget(self.fav_panel)
        lay.addLayout(body, 1)
        self.att_lbl = QLabel('')
        self.att_lbl.setObjectName('ctxKey')
        lay.addWidget(self.att_lbl)

        self.toast = QLabel('')                          # إشعار أخضر سفلي بعد «حفظ» (النافذة تبقى مفتوحة)
        self.toast.setAlignment(Qt.AlignCenter)
        self.toast.setStyleSheet('background: #1b8a4a; color: white; font-weight: bold; border-radius: 6px; padding: 6px 14px;')
        self.toast.setVisible(False)
        self._toast_timer = QTimer(self)
        self._toast_timer.setSingleShot(True)
        self._toast_timer.timeout.connect(lambda: self.toast.setVisible(False))
        lay.addWidget(self.toast)
        bb = QDialogButtonBox()
        self.ok = bb.addButton('حفظ كمسودة', QDialogButtonBox.AcceptRole)
        self.ok.setProperty('primary', True)
        self.ok.setAutoDefault(False)                  # Enter ينقل بين الخلايا ولا يحفظ القيد قبل اكتماله
        if not entry:
            more = bb.addButton('حفظ وقيد جديد', QDialogButtonBox.ActionRole)
            more.setAutoDefault(False)
            more.clicked.connect(self._save_and_new)
        cancel = bb.addButton(S.ACTION['cancel'], QDialogButtonBox.RejectRole)
        cancel.setAutoDefault(False)
        bb.accepted.connect(self._accept)
        bb.rejected.connect(self.reject)
        lay.addWidget(bb)
        QShortcut(QKeySequence('Ctrl+S'), self, activated=lambda: self._save_stay() if self.save_stay_cb else self._accept())
        QShortcut(QKeySequence('Insert'), self, activated=lambda: self.tabs.currentIndex() == 1 and self.lines.add_row(focus=True))

        self.btn_att.setEnabled(not entry)         # القيد الموجود: المرفقات من نافذة «المرفقات» في الصفحة
        self._reload_templates()
        if entry:
            self.date.set_iso(entry['entry_date'])
            self.desc.setText(entry.get('description') or '')
            curs = {ln.get('currency') or self._base_cur for ln in entry['lines']}
            ecur = next(iter(curs)) if len(curs) == 1 else self._base_cur
            if self.cur.findData(ecur) >= 0:
                self.cur.setCurrentIndex(self.cur.findData(ecur))
            use_orig = ecur != self._base_cur
            rows = [{'account_id': ln['account_id'],
                     'debit': (ln.get('debit_orig') if use_orig else ln['debit']) or None,
                     'credit': (ln.get('credit_orig') if use_orig else ln['credit']) or None,
                     'memo': ln.get('memo') or ''} for ln in entry['lines']]
            simple = JS.lines_to_simple(rows)
            if simple:                                  # سطران بمبلغ واحد → يُفتح كقيد بسيط
                self._fill_simple(simple)
            else:                                       # غير ذلك → مركب
                self.lines.set_rows(rows)
                self._tab = 1
                self.tabs.blockSignals(True)
                self.tabs.setCurrentIndex(1)
                self.tabs.blockSignals(False)
        self._totals(self.lines.rows())
        self._simple_preview()
        self._on_currency()
        if preset and not entry:
            self._apply_preset(preset)
        elif tab is not None and not entry:                  # «حفظ وقيد جديد»: العودة لآخر واجهة كنت فيها
            self.tabs.setCurrentIndex(int(tab))

    def _apply_preset(self, preset):
        if preset in ('receipt', 'payment'):
            receipt = preset == 'receipt'
            try:
                ids = {r[0] for r in self.page.session.conn.execute(
                    'SELECT account_id FROM cash_accounts WHERE company_id=? AND is_active=1', (self.page.session.company_id,))}
            except Exception:  # noqa: BLE001
                ids = set()
            if ids:                                     # الصندوق/البنك: حسابات النقدية فقط
                loader = lambda: [r for r in self.page.session.lookup_accounts() if r[0] in ids]  # noqa: E731
                (self.s_from if receipt else self.s_to)._loader = loader
                (self.s_from if receipt else self.s_to).reload()
            lab_from, lab_to = (('الصندوق / البنك (مدين) *', 'الحساب المقابل (دائن) *') if receipt
                                else ('الحساب المقابل (مدين) *', 'الصندوق / البنك (دائن) *'))
            self.lbl_from.setText(lab_from)
            self.lbl_to.setText(lab_to)
            if not self.desc.text().strip():
                self.desc.setText('سند قبض' if receipt else 'سند صرف')
            self.btn_swap.setVisible(False)
            self.s_preview.set_dir('in' if receipt else 'out')        # سند قبض: أخضر، سند صرف: أحمر
        elif isinstance(preset, str) and preset.startswith('recipe:'):
            self.tabs.setCurrentIndex(1)
            QTimer.singleShot(0, lambda k=preset.split(':', 1)[1]: self._open_recipes(k))

    # ---------------------------------------------------------------- مسودة الاستئناف
    @staticmethod
    def _dec_or_none(v):
        return Decimal(str(v)) if v not in (None, '') else None

    def draft_state(self):
        rows = [{k: (str(v) if isinstance(v, Decimal) else v) for k, v in r.items()} for r in self.lines.rows()]
        amt = self.s_amount.value()
        return {'date': self.date.iso(), 'desc': self.desc.text(), 'tab': self.tabs.currentIndex(),
                'from': self.s_from.current_id(), 'to': self.s_to.current_id(), 'amount': None if amt is None else str(amt),
                'memo': self.s_memo.text(), 'rows': rows, 'currency': self._cur_code()}

    def restore_state(self, st):
        if st.get('date'):
            self.date.set_iso(st['date'])
        self.desc.setText(st.get('desc', ''))
        if st.get('currency') and self.cur.findData(st['currency']) >= 0:
            self.cur.setCurrentIndex(self.cur.findData(st['currency']))
        self.s_from.set_id(st.get('from'))
        self.s_to.set_id(st.get('to'))
        self.s_amount.set_value(self._dec_or_none(st.get('amount')))
        self.s_memo.setText(st.get('memo', ''))
        rows = [dict(r, debit=self._dec_or_none(r.get('debit')), credit=self._dec_or_none(r.get('credit'))) for r in st.get('rows', [])]
        if any(r.get('account_id') or r.get('debit') or r.get('credit') or r.get('memo') for r in rows):
            self.lines.set_rows(rows)
        if st.get('tab') == 1:
            self._tab = 1
            self.tabs.blockSignals(True)
            self.tabs.setCurrentIndex(1)
            self.tabs.blockSignals(False)
        self._totals(self.lines.rows())
        self._simple_preview()


    # ---------------------------------------------------------------- القيد البسيط
    @staticmethod
    def _qs():
        from PySide6.QtCore import QSettings
        return QSettings('AlhisabatPro', 'journalEditor')

    def _cur_code(self):
        return self.cur.currentData() or self._base_cur

    def _on_currency(self):
        code = self._cur_code()
        if not code or code == self._base_cur:
            self.rate_lbl.setText('')
        else:
            rate = self.svc.rate_for(code, self.date.iso())
            self.rate_lbl.setText(f'السعر: {rate.normalize():f}' if rate else '⚠ لا يوجد سعر صرف لهذا التاريخ (أضفه من العملات)')
        self._simple_preview()
        if getattr(self, 'lines', None) is not None:
            self._totals(self.lines.rows())             # يحدّث تفقيط المركب عند تغيير العملة

    def _open_recipes(self, key=None, switch=False):
        if switch:
            self.tabs.setCurrentIndex(1)
        d = RecipeDialog(self, self.svc, key, favorites=self.fav)
        ok = d.exec()
        self.fav_panel.reload()                        # قد تتغير المفضلة من قائمة القوالب بزر الفأرة الأيمن
        if not ok or not d.result_rows:
            return
        if self.lines.non_empty_rows() and QMessageBox.question(self, 'قالب جاهز', 'سيستبدل القالب السطور الحالية. متابعة؟') != QMessageBox.Yes:
            return
        self.lines.set_rows(d.result_rows)
        self.used_recipe = d.result_key
        if not self.desc.text().strip():
            self.desc.setText(d.result_desc)
        self._totals(self.lines.rows())

    def _fill_simple(self, d):
        self.s_from.set_id(d['from_account_id'])
        self.s_to.set_id(d['to_account_id'])
        self.s_amount.set_value(d['amount'])
        self.s_memo.setText(d.get('memo') or '')

    def _simple_values(self):
        return JS.simple_to_lines(self.s_from.current_id(), self.s_to.current_id(), self.s_amount.value(), self.s_memo.text())

    def _simple_preview(self):
        a, b, amt = self.s_from.current_id(), self.s_to.current_id(), self.s_amount.value()
        self.s_preview.set_amount(f'{amt:,.2f} {self._cur_code()}'.strip() if amt and amt > 0 else '0.00')
        if a and b and amt and amt > 0:
            self.s_preview.setText(f'مدين {self.s_from.currentText()}  ←  دائن {self.s_to.currentText()}')
        else:
            self.s_preview.setText('')
        self.desc.setPlaceholderText(self._auto_desc() or 'وصف القيد')
        if getattr(self, 's_words', None) is not None:
            w = self._words(amt)
            self.s_words.setText(w); self.s_words.setVisible(bool(w))
        if getattr(self, 's_cur_lbl', None) is not None:
            self.s_cur_lbl.setText(self._cur_code() or '')
        self._refresh_notes()

    def _words(self, amt):
        """المبلغ كتابةً بعملة القيد ('' إن لم يُدخل مبلغ موجب)."""
        try:
            return FMT.amount_in_words(amt, self._cur_code()) if amt and amt > 0 else ''
        except Exception:  # noqa: BLE001 — التفقيط للعرض فقط
            return ''

    def _auto_desc(self):
        """البيان التلقائي للقيد البسيط (أسماء الحسابين) أو '' إن لم يُختر الحسابان."""
        if self.s_from.current_id() and self.s_to.current_id():
            return JS.simple_auto_description(self.s_from.currentText(), self.s_to.currentText())
        return ''

    def _refresh_notes(self):
        sess, iso, cur = self.page.session, self.date.iso(), self._cur_code()
        if getattr(self, 's_note', None) is not None:
            self.s_note.setText(BN.balances_text(sess, [(self.s_from.current_id(), self.s_from.currentText()),
                                                        (self.s_to.current_id(), self.s_to.currentText())], iso, cur))
        if getattr(self, 'c_note', None) is not None:
            try:
                accs = [(r.get('account_id'), self.lines.cell_text(i, 'account_id')) for i, r in enumerate(self.lines.rows())]
            except Exception:  # noqa: BLE001
                accs = []
            self.c_note.setText(BN.balances_text(sess, accs, iso, cur))

    def _simple_is_empty(self):
        return not (self.s_from.current_id() or self.s_to.current_id() or self.s_amount.value() or self.s_memo.text().strip())

    def _place_cur(self):
        """صندوق العملة واحد ينتقل بحسب التبويب: في «قيد بسيط» بجانب المبلغ (يمينه) لتسهيل الإدخال، وفي «قيد مركب» في الشريط العلوي."""
        row = getattr(self, '_simple_amount_row', None)
        if row is None:
            return
        simple = self.tabs.currentIndex() == 0
        row.removeWidget(self.cur)
        self._top.removeWidget(self.cur)
        if simple:
            row.insertWidget(0, self.cur)                       # أول عنصر = أقصى اليمين في الاتجاه العربي
            self.cur_lbl_top.setVisible(False)
        else:
            self._top.insertWidget(self._cur_top_index, self.cur)
            self.cur_lbl_top.setVisible(True)
        self.cur.setVisible(True)

    def _on_tab(self, idx):
        prev, self._tab = self._tab, idx
        if prev == idx:
            return
        if idx == 1:                                   # بسيط ← مركب: ننقل ما أُدخل
            self.desc.setPlaceholderText('وصف القيد')   # البيان التلقائي خاص بالقيد البسيط
            if not self._simple_is_empty() and not self.lines.non_empty_rows():
                try:
                    self.lines.set_rows(self._simple_values())
                except AccountingError:                # ناقص: ننقل ما أمكن دون تحقق
                    self.lines.set_rows([{'account_id': self.s_from.current_id(), 'debit': self.s_amount.value(), 'credit': None, 'memo': self.s_memo.text()},
                                         {'account_id': self.s_to.current_id(), 'debit': None, 'credit': self.s_amount.value(), 'memo': self.s_memo.text()}])
            return
        rows = self.lines.non_empty_rows()             # مركب ← بسيط
        if not rows:
            return
        d = JS.lines_to_simple(rows)
        if d is None:
            QMessageBox.information(self, 'قيد مركب', 'هذا القيد له أكثر من طرفين أو مبالغ غير متطابقة، ولا يمكن عرضه كقيد بسيط. أكمله من تبويب «قيد مركب».')
            self._tab = 1
            self.tabs.blockSignals(True)
            self.tabs.setCurrentIndex(1)
            self.tabs.blockSignals(False)
            return
        self._fill_simple(d)
        self._simple_preview()

    # ---------------------------------------------------------------- مساعدات
    def _closed_reason(self, iso):
        return ST.period_reason(self.page.session.period_info(iso))

    def _totals(self, rows):
        d, c, _diff = JS.balance_of(rows)
        text, tone = EL.journal_status_text(d, c)
        self.totals_strip.update_totals(d, c, text.rsplit('   ', 1)[-1].strip(), tone)   # الأرقام في الخانات الملوّنة والحالة في الشارة
        if getattr(self, 'c_words', None) is not None:
            w = self._words(d)
            self.c_words.setText(w); self.c_words.setVisible(bool(w))
        return {}                                      # النص كله في شريط التوازن؛ لا نكرره في شريط المحرر

    def _seed_row(self, rows):
        """السطر الجديد (Enter في آخر خلية) يأتي بمبلغ الموازنة في الجهة المقابلة: يوفّر كتابة آخر سطر في كل قيد."""
        side, amt = EL.balancing_suggestion(rows)
        return {side: amt} if side else None

    def _on_lines_changed(self):
        self._issues = EL.journal_row_issues(self.lines.rows())
        self.lines.set_issues(self._issues)
        self._refresh_notes()

    def _swap_simple(self):
        a, b = self.s_from.current_id(), self.s_to.current_id()
        if a is not None:
            self.s_to.set_id(a)
        if b is not None:
            self.s_from.set_id(b)
        self._simple_preview()

    def _reload_templates(self):
        self.tpl.clear()
        try:
            rows = self.svc.templates()
        except Exception:  # noqa: BLE001
            rows = []
        self.tpl.addItem('— بلا —', None)
        for t in rows:
            self.tpl.addItem(t['name'], t['id'])
        for b in (self.btn_load_tpl, self.btn_del_tpl):
            b.setEnabled(bool(rows))

    def _apply_template(self):
        tid = self.tpl.currentData()
        if tid is None:
            return
        try:
            t = self.svc.template(tid)
        except Exception as exc:  # noqa: BLE001
            return self.page.show_error(exc)
        if t.get('description') and not self.desc.text().strip():
            self.desc.setText(t['description'])
        self.lines.set_rows([{'account_id': x['account_id'], 'debit': x['debit'] or None, 'credit': x['credit'] or None, 'memo': x.get('memo', '')}
                             for x in t['lines']])

    def _save_template(self):
        rows = self.lines.non_empty_rows()
        if not rows:
            return QMessageBox.information(self, 'حفظ كقالب', 'أدخل سطرًا واحدًا على الأقل قبل حفظ القالب.')
        name, ok = QInputDialog.getText(self, 'حفظ كقالب', 'اسم القالب:')
        if not ok or not name.strip():
            return
        try:
            self.svc.save_template(name, self.desc.text(), rows)
        except Exception as exc:  # noqa: BLE001
            return self.page.show_error(exc)
        self._reload_templates()

    def _delete_template(self):
        tid = self.tpl.currentData()
        if tid is None:
            return
        if ask_reason(self, 'حذف القالب', [f'حذف القالب «{self.tpl.currentText()}» نهائيًا.'], need_reason=False, confirm_text='حذف') is None:
            return
        try:
            self.svc.delete_template(tid)
        except Exception as exc:  # noqa: BLE001
            return self.page.show_error(exc)
        self._reload_templates()

    def _import_csv(self):
        path, _ = QFileDialog.getOpenFileName(self, 'استيراد سطور من CSV', '', 'CSV (*.csv *.txt)')
        if not path:
            return
        try:
            lines, errs = self.svc.parse_csv(path)
        except Exception as exc:  # noqa: BLE001
            return self.page.show_error(exc)
        if errs:
            QMessageBox.warning(self, 'استيراد CSV', f'استُورد {len(lines)} سطرًا، وتعذّر {len(errs)}:\n' + '\n'.join(errs[:15]))
        if lines:
            self.lines.set_rows([{'account_id': x['account_id'], 'debit': x['debit'] or None, 'credit': x['credit'] or None, 'memo': x['memo']} for x in lines])

    def _add_attachment(self):
        paths, _ = QFileDialog.getOpenFileNames(self, 'إضافة مرفق', '')
        self._pending += [{'path': p, 'name': None} for p in paths]
        self.att_lbl.setText(f'مرفقات ستُحفظ مع القيد: {len(self._pending)}' if self._pending else '')

    def _save_and_new(self):
        self.add_another = True
        self._accept()

    def _check(self):
        """تحقق الواجهة قبل الحفظ (يعرض الرسالة ويُرجع False عند النقص)."""
        if self.tabs.currentIndex() == 0:
            try:
                self._simple_values()
            except AccountingError as exc:
                QMessageBox.warning(self, 'بيانات ناقصة', str(exc))
                return False
            return True
        errs = self.lines.validate()
        if errs:
            QMessageBox.warning(self, 'بيانات ناقصة', '\n'.join(m for _i, m in errs[:10]))
            return False
        issues = EL.journal_row_issues(self.lines.rows())
        if issues:
            QMessageBox.warning(self, 'سطور تحتاج تصحيحًا', '\n'.join(sorted({m for _n, _k, m in issues}))[:600])
            return False
        if len(self.lines.non_empty_rows()) < 2:
            QMessageBox.warning(self, 'بيانات ناقصة', 'أدخل سطرين على الأقل.')
            return False
        return True

    def _accept(self):
        self.add_another, want_more = False, self.add_another
        if not self._check():
            return
        self.add_another = want_more
        self.accept()

    # ---------------------------------------------------------------- «حفظ» دون إغلاق
    def enable_stay_save(self, cb):
        """cb(dialog) ← True عند نجاح الحفظ. يُظهر زر «حفظ» الذي يبقي النافذة مفتوحة."""
        self.save_stay_cb = cb
        self.btn_stay.setVisible(True)
        self.btn_stay_c.setVisible(True)

    def _enter_in_amount(self):
        if self.save_stay_cb is not None and self.s_amount.value():
            self._save_stay()
        else:
            self.s_memo.setFocus()

    def _enter_in_memo(self):
        if self.save_stay_cb is not None:
            self._save_stay()
        else:
            self._accept()

    def show_toast(self, text='تم الحفظ'):
        self.toast.setText('✓ ' + text)
        self.toast.setVisible(True)
        self._toast_timer.start(2500)

    def _save_stay(self):
        if self._saving or self.save_stay_cb is None or not self._check():
            return
        self._saving = True
        try:
            ok = bool(self.save_stay_cb(self))
        finally:
            self._saving = False
        if not ok:
            return
        self.show_toast('تم الحفظ')
        if self.entry is None:
            self._reset_for_next()
        self._restored = False
        self._baseline = self._widget_snapshot()      # بعد الحفظ لا يُعدّ شيء «غير محفوظ»

    @staticmethod
    def _clear_picker(p):
        p.setCurrentIndex(-1)
        p.setEditText('')

    def _reset_for_next(self):
        """بعد حفظ قيد جديد: نموذج فارغ لقيد تالٍ (يبقى التاريخ والعملة والتبويب الحالي)."""
        self.desc.clear()
        self._pending = []
        self.att_lbl.setText('')
        self.used_recipe = None
        self.chk_adj.setChecked(False)
        self._clear_picker(self.s_from)
        self._clear_picker(self.s_to)
        self.s_amount.set_value(None)
        self.s_memo.clear()
        self.lines.set_rows([])
        self._totals(self.lines.rows())
        self._simple_preview()
        (self.s_from if self.tabs.currentIndex() == 0 else self.desc).setFocus()   # القيد البسيط: يبدأ التالي من الحساب المدين مباشرة

    def values(self):
        lines = self._simple_values() if self.tabs.currentIndex() == 0 else self.lines.non_empty_rows()
        code = self._cur_code()
        if code and code != self._base_cur:
            lines = [dict(x, currency=code) for x in lines]
        self._qs().setValue('last_currency', code or '')
        desc = self.desc.text().strip()
        if not desc and self.tabs.currentIndex() == 0:
            desc = self._auto_desc()                   # بيان فارغ في القيد البسيط ← «قيد بسيط ــ من حساب … الى حساب …»
        return {'date': self.date.iso(), 'description': desc, 'lines': lines,
                'pending_attachments': list(self._pending),
                'entry_type': 'adjustment' if self.chk_adj.isChecked() else 'general'}

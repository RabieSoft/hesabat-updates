    center_on_show = True               # تنبثق في وسط الشاشة تلقائيًا
    nonmodal_exec = True                # تصغير «–» والعمل في شاشات أخرى
    draft_clear_on_page_save = True
    draft_page = 'journal'
    draft_title = 'قيد يومي جديد'


        self.used_recipe = None         # آخر قالب جاهز/مفضل أُدرج في هذا القيد (يعيد «حفظ وقيد جديد» فتحه)
        self.page, self.svc, self.entry = page, page.svc, entry
        self.preset = preset            # 'receipt' | 'payment' | 'recipe:<key>' | None
        self.draft_key = None if (entry or preset) else 'journal_new'      # مسودة للقيد الجديد فقط (تعديل المسودة المحفوظة موجود أصلًا في القاعدة)
        s = page.session
        self.setWindowTitle(f"تعديل القيد رقم {entry.get('entry_no')}" if entry else {'receipt': 'قيد سند قبض', 'payment': 'قيد سند صرف'}.get(preset, 'قيد جديد'))
        self.setLayoutDirection(Qt.RightToLeft)
        self.resize(1060, 620)
        self._pending = []
        self._tab = 0
        self._issues = []
        self.add_another = False
        self.save_stay_cb = None         # تضعه الصفحة: يحفظ القيد دون إغلاق النافذة (إدخال طويل)
        self._saving = False
        lay = QVBoxLayout(self)

        top = QHBoxLayout()
        yr = page.state.get('year') or {}
        top.addWidget(QLabel('التاريخ:'))
        self.date = DateField(yr.get('start'), yr.get('end'), closed_reason_fn=self._closed_reason)
        top.addWidget(self.date)
        top.addWidget(QLabel('البيان:'))
        self.desc = QLineEdit()
        self.desc.setPlaceholderText('وصف القيد')
        top.addWidget(self.desc, 1)
        self.btn_att = QPushButton('+ مرفق')
        self.btn_att.clicked.connect(self._add_attachment)
        self._top = top
        self.cur_lbl_top = QLabel('العملة:')           # تظهر في الشريط العلوي لتبويب «قيد مركب» فقط؛ في «قيد بسيط» تنتقل العملة بجانب المبلغ
        top.addWidget(self.cur_lbl_top)
        self.cur = QComboBox()
        self.cur.setMinimumWidth(130)
        self.cur.setToolTip('عملة مبالغ القيد كله. يُحوَّل للعملة الأساسية بسعر الصرف المسجّل بتاريخ القيد.')
        self._base_cur = ''
        try:
            self._base_cur = self.svc.base_currency()
            for code, label, _b in self.svc.currency_options():
                self.cur.addItem(label, code)
        except Exception:  # noqa: BLE001
            self.cur.addItem(self._base_cur or '—', self._base_cur or None)
        if entry is None:                                          # القيد الجديد يبدأ بعملة الإدخال الافتراضية للشركة (اليمني مثلًا)
            try:
                dflt = self.svc.default_currency()
            except Exception:  # noqa: BLE001
                dflt = ''
            if dflt and self.cur.findData(dflt) >= 0:
                self.cur.setCurrentIndex(self.cur.findData(dflt))
        self.rate_lbl = QLabel('')
        self.rate_lbl.setObjectName('ctxKey')
        self.cur.currentIndexChanged.connect(lambda _i: self._on_currency())
        if hasattr(self.date, 'dateChanged'):
            self.date.dateChanged.connect(lambda *_a: self._on_currency())
        self._cur_top_index = top.count()
        top.addWidget(self.cur)
        top.addWidget(self.rate_lbl)
        top.addWidget(self.btn_att)
        self.chk_adj = QCheckBox('قيد تسوية')
        self.chk_adj.setToolTip('يسمح بحسابات المخزون (لتصحيح/إعادة قيد معكوس). يتطلب بيانًا يوضح السبب.')
        self.chk_adj.setVisible(entry is None)
        top.addWidget(self.chk_adj)
        lay.addLayout(top)

        self.tabs = QTabWidget()
        self.tabs.setLayoutDirection(Qt.RightToLeft)
        self.tabs.addTab(self._build_simple(s), 'قيد بسيط')
        self.tabs.addTab(self._build_compound(s), 'قيد مركب')
        self.tabs.currentChanged.connect(self._on_tab)
        self.tabs.tabBar().currentChanged.connect(lambda _i: self._place_cur())     # يعمل حتى لو حُجبت إشارات QTabWidget أثناء التبديل البرمجي
        self._place_cur()
        self.fav = FavoriteStore(lambda: self._qs().value('favorite_recipes', ''), lambda v: self._qs().setValue('favorite_recipes', v), [r.key for r in JR.RECIPES])
        self.fav_panel = FavoritesPanel(self.fav)                  # يسار النافذة (المساحة الفارغة) في الاتجاه العربي

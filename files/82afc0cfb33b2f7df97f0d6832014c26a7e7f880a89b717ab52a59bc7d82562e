"""سجل الصفحات: مفتاح الصفحة (navigation.PAGE_KEYS) ← صنفها. ما لم يُسجَّل بعد يظهر بصفحة «قيد البناء» (PlaceholderPage)."""
from alhisabat.ui.core.base_page import PlaceholderPage
from alhisabat.ui.shell import navigation as N

_CLASSES = {}


def register(key, cls):
    if key not in N.PAGE_KEYS:
        raise KeyError(f'مفتاح صفحة غير معرّف في navigation: {key}')
    _CLASSES[key] = cls


def create(key, window, params=None):
    spec = N.get(key)
    if spec is None:
        return None
    cls = _CLASSES.get(key)
    if cls is None:
        return PlaceholderPage(window, spec)
    page = cls(window)
    page.params = params
    return page


def registered():
    return dict(_CLASSES)



BY_KEY = {r.key: r for r in RECIPES}


def build(key, values):
    """يبني سطور القيد من قالب. يرمي AccountingError عند نقص بيان. يضمن توازن السطور."""
    r = BY_KEY[key]
    rows = r.build(values)
    for x in rows:
        dv, cv = _d(x['debit']), _d(x['credit'])
        if (dv > 0) == (cv > 0) or dv < 0 or cv < 0:
            raise AccountingError('تعذر بناء القيد: كل سطر يجب أن يكون مدينًا أو دائنًا بمبلغ موجب')
    d = sum((_d(x['debit']) for x in rows), Decimal(0))
    c = sum((_d(x['credit']) for x in rows), Decimal(0))
    if d != c:
        raise AccountingError('تعذر بناء قيد متوازن من هذه المدخلات')
    ids = [x['account_id'] for x in rows]
    if len(ids) == 2:
        _same(*ids)
    return rows


def suggested_description(key, party_label=''):
    base = BY_KEY[key].desc
    return f'{base} — {party_label}'.strip(' —') if party_label else base

INTERNAL = 'internal'                        # حساب جاري داخلي (نقطة بيع / مستودع) من الأصول أو الالتزامات
INCOME = 'income'                            # حسابات الإيرادات (خصم مكتسب، إيراد متنوع) بلا قيمة افتراضية
CONTRA = 'contra'                            # مردودات المبيعات: إيرادات أو مصروفات (بحسب دليل حسابات الشركة)
EQUITY = 'equity'                            # رأس المال / جاري الشريك

G_CUS, G_SUP, G_EXP, G_CASH, G_EMP, G_INT = ('العملاء', 'الموردون', 'المصروفات والإيرادات', 'الصناديق والبنوك والملاك',
                                              'الموظفون', 'تعاملات داخلية')


@dataclass(frozen=True)
class Field:
    key: str
    label: str
    kind: str


@dataclass(frozen=True)
class Recipe:
    key: str
    title: str
    hint: str
    fields: tuple
    build: object          # callable(values: dict) -> list[dict]
    desc: str = ''         # بيان مقترح (يُضاف إليه اسم الطرف عند توفره)
    group: str = ''        # مجموعة القائمة


def _d(v):
    if v in (None, ''):
        return Decimal(0)
    return v if isinstance(v, Decimal) else Decimal(str(v))


def _ln(account_id, debit=None, credit=None, memo=''):
    return {'account_id': int(account_id), 'debit': debit, 'credit': credit, 'memo': memo}


def _need(v, *keys):
    """يتحقق من الحسابات والمبالغ المطلوبة ويرمي AccountingError برسالة عربية واضحة."""
    labels = {f.key: f.label for r in RECIPES for f in r.fields}
    for k in keys:
        x = v.get(k)
        if k.startswith('amt'):
            if _d(x) <= 0:
                raise AccountingError(f'أدخل «{labels.get(k, k)}» بمبلغ أكبر من صفر')
        elif not x:
            raise AccountingError(f'اختر «{labels.get(k, k)}»')


def _same(*ids):
    ids = [int(i) for i in ids]
    if len(set(ids)) != len(ids):
        raise AccountingError('الحسابان المدين والدائن متطابقان: اختر حسابين مختلفين')


# ---------------------------------------------------------------- العملاء
def _cust_receipt(v):
    _need(v, 'customer', 'cash', 'amt'); a = _d(v['amt'])
    return [_ln(v['cash'], debit=a, memo='سند قبض'), _ln(v['customer'], credit=a, memo='سند قبض - سداد من العميل')]


def _cust_credit_sale(v):
    _need(v, 'customer', 'sales', 'amt'); a = _d(v['amt'])
    return [_ln(v['customer'], debit=a, memo='مبيعات آجلة'), _ln(v['sales'], credit=a, memo='مبيعات آجلة')]


def _cust_cash_sale(v):
    _need(v, 'cash', 'sales', 'amt'); a = _d(v['amt'])
    return [_ln(v['cash'], debit=a, memo='مبيعات نقدية'), _ln(v['sales'], credit=a, memo='مبيعات نقدية')]


def _cust_pay_and_buy(v):
    """العميل سدّد دفعة على حسابه وأخذ بضاعة بقيمة آجلة: قيد سند قبض + قيد مبيعات آجلة."""
    _need(v, 'customer', 'cash', 'sales', 'amt_in', 'amt_out'); i, o = _d(v['amt_in']), _d(v['amt_out'])
    return [_ln(v['cash'], debit=i, memo='سند قبض'), _ln(v['customer'], credit=i, memo='سند قبض - دفعة من العميل'),
            _ln(v['customer'], debit=o, memo='مبيعات آجلة'), _ln(v['sales'], credit=o, memo='مبيعات آجلة')]


def _cust_partial(v):
    _need(v, 'customer', 'cash', 'sales', 'amt_total', 'amt_paid'); t, p = _d(v['amt_total']), _d(v['amt_paid'])
    if p > t:
        raise AccountingError('المدفوع أكبر من إجمالي المبيعات')
    rows = [_ln(v['cash'], debit=p, memo='دفعة مقدمة')]
    if t - p > 0:
        rows.append(_ln(v['customer'], debit=t - p, memo='المتبقي ذمة على العميل (آجل)'))
    rows.append(_ln(v['sales'], credit=t, memo='إجمالي المبيعات'))
    return rows


def _cust_refund(v):
    _need(v, 'customer', 'cash', 'amt'); a = _d(v['amt'])
    return [_ln(v['customer'], debit=a, memo='سند صرف للعميل'), _ln(v['cash'], credit=a, memo='سند صرف للعميل')]



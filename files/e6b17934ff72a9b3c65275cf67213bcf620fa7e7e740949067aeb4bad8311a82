def _cust_cash_return(v):
    _need(v, 'sales_ret', 'cash', 'amt'); a = _d(v['amt'])
    return [_ln(v['sales_ret'], debit=a, memo='مردودات مبيعات'), _ln(v['cash'], credit=a, memo='سند صرف - رد ثمن مردودات المبيعات')]


def _cust_receipt_discount(v):
    _need(v, 'customer', 'cash', 'disc_exp', 'amt_in', 'amt_disc'); i, k = _d(v['amt_in']), _d(v['amt_disc'])
    return [_ln(v['cash'], debit=i, memo='سند قبض'), _ln(v['disc_exp'], debit=k, memo='خصم مسموح به'),
            _ln(v['customer'], credit=i + k, memo='سند قبض - سداد من العميل مع خصم مسموح به')]


def _cust_discount(v):

"""محرر عميل/مورد، وحوار الرصيد الافتتاحي لطرف واحد. بلا float.
"""
from decimal import Decimal, InvalidOperation

from alhisabat.ui.components.basic import CompactForm, DialogGuardMixin
from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QComboBox, QDialog, QDialogButtonBox, QFormLayout, QGroupBox,
    QLabel, QLineEdit, QScrollArea, QVBoxLayout, QWidget,
)

from alhisabat.ui.core import strings_ar as S

_HINT_STYLE = "color: var(--color-text-muted); font-size: 11px;"
_ERR_STYLE = "color: var(--color-danger); font-weight: bold;"
_REQ_STYLE = "color: var(--color-danger);"


def _section(title, per_row=2):
    """QGroupBox موحّد الشكل لأقسام الحوار؛ حقوله بصفوف أفقية مضغوطة (عنوان فوق كل حقل) بدل عمود طويل."""
    gb = QGroupBox(title)
    form = CompactForm(gb, per_row)
    form.setContentsMargins(10, 4, 10, 8)
    return gb, form


class PartyEditor(DialogGuardMixin, QDialog):
    """محرر عميل/مورد (v1.6): تحقق لحظي بنص الخطأ تحت الحقل، تنبيه من تكرار الاسم، Enter ينقل للحقل التالي ولا يحفظ،
    Ctrl+S يحفظ، و«حفظ وإضافة آخر» للإدخال المتتابع. الرصيد الافتتاحي عند الإضافة فقط
    (التعديل اللاحق من زر «رصيد افتتاحي» في الصفحة حتى لا يُخلط برصيد له حركات فعلية).
    المنطق في core/entry_logic.py، والمحرك هو الحَكَم النهائي عند الحفظ."""

    guard_save_stay = False             # الحفظ يتم في الصفحة بعد القبول
    nonmodal_exec = True                # تصغير «–» والعمل في شاشات أخرى

    def __init__(self, page, kind, existing=None):
        super().__init__(page)
        from PySide6.QtGui import QKeySequence, QShortcut
        from PySide6.QtWidgets import QSpinBox
        from alhisabat.ui.components.basic import DateField, MoneyEdit
        self.page, self.kind, self.existing = page, kind, existing
        self.add_another = False
        label = 'عميل' if kind == 'customer' else 'مورد'
        self.setWindowTitle(('تعديل بيانات ' if existing else 'إضافة ') + label)
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(680)
        # التخطيط الخارجي: منطقة تمرير للأقسام + شريط ثابت (تنبيه/خطأ/أزرار) أسفلها، فلا تتجاوز النافذة الشاشة
        outer = QVBoxLayout(self)
        outer.setSpacing(8)
        self._scroll = QScrollArea()
        self._scroll.setWidgetResizable(True)
        self._scroll.setFrameShape(QScrollArea.NoFrame)
        self._scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self._scroll.setStyleSheet('QScrollArea { background: transparent; border: none; }'
                                   ' QScrollArea > QWidget > QWidget { background: transparent; }')
        body = QWidget()
        lay = QVBoxLayout(body)
        lay.setContentsMargins(0, 0, 6, 0)
        lay.setSpacing(8)
        self._scroll.setWidget(body)
        outer.addWidget(self._scroll, 1)
        ex = existing or {}

        title = QLabel(('تعديل بيانات ' if existing else 'إضافة ') + label + (f" — {ex.get('name', '')}" if existing else ''))
        title.setStyleSheet("font-size: 14px; font-weight: bold;")
        lay.addWidget(title)

        gb_basic, f_basic = _section('البيانات الأساسية')
        self.name = QLineEdit(ex.get('name', ''))
        self.name.setPlaceholderText(f'اسم {label} (مطلوب)')
        self.phone = QLineEdit(ex.get('phone', ''))
        self.phone.setPlaceholderText('مثال: 777123456 (يقبل الأرقام العربية)')
        self.phone.setLayoutDirection(Qt.LeftToRight)
        self.email = QLineEdit(ex.get('email', ''))
        self.email.setPlaceholderText('اختياري')
        self.email.setLayoutDirection(Qt.LeftToRight)
        self.addr = QLineEdit(ex.get('address', ''))
        self.addr.setPlaceholderText('اختياري')
        lbl_name = QLabel('الاسم *')
        lbl_name.setStyleSheet(_REQ_STYLE)
        f_basic.addWide(lbl_name.text(), self.name)
        f_basic.addRow('الهاتف', self.phone)
        f_basic.addRow('البريد الإلكتروني', self.email)
        f_basic.addWide('العنوان', self.addr)
        self.group_combo = None
        if not existing:
            self.group_combo = QComboBox()
            self.group_combo.addItem('بلا مجموعة', None)
            try:
                from alhisabat.ui.core.party_groups_service import PartyGroupsService

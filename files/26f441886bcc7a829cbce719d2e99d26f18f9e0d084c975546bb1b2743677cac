def is_morning(hour):
    return MORNING_FROM <= int(hour) < MORNING_TO


def adhkar_for(hour):
    """(عنوان القسم، قائمة الأذكار) حسب الساعة (0–23)."""
    return ('أذكار الصباح', MORNING) if is_morning(hour) else ('أذكار المساء', EVENING)

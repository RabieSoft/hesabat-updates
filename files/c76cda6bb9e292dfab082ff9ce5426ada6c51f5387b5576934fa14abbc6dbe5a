CREATE TABLE cost_centers(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id),
  code TEXT NOT NULL, name TEXT NOT NULL CHECK(length(trim(name))>0),
  parent_id INTEGER REFERENCES cost_centers(id), level INTEGER NOT NULL DEFAULT 1 CHECK(level>=1),
  is_group INTEGER NOT NULL DEFAULT 0 CHECK(is_group IN (0,1)),
  is_active INTEGER NOT NULL DEFAULT 1 CHECK(is_active IN (0,1)),
  branch_id INTEGER REFERENCES branches(id),          -- إن وُجد: مركز التكلفة الافتراضي لهذا الفرع (لتوزيع تلقائي من المستندات)
  created_by INTEGER NOT NULL REFERENCES users(id), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE(company_id,code), UNIQUE(company_id,name));
CREATE UNIQUE INDEX ux_cc_branch_default ON cost_centers(company_id,branch_id) WHERE branch_id IS NOT NULL;

CREATE TRIGGER cc_ins_rules BEFORE INSERT ON cost_centers WHEN NEW.parent_id IS NOT NULL BEGIN
  SELECT RAISE(ABORT,'مركز التكلفة الأب غير موجود أو ليس تجميعيا')
   WHERE NOT EXISTS(SELECT 1 FROM cost_centers p WHERE p.id=NEW.parent_id AND p.is_group=1 AND p.company_id=NEW.company_id);
END;
CREATE TRIGGER cc_no_delete BEFORE DELETE ON cost_centers BEGIN
  SELECT RAISE(ABORT,'لا يمكن حذف مركز تكلفة: استخدم التعطيل')
   WHERE EXISTS(SELECT 1 FROM journal_lines WHERE cost_center_id=OLD.id) OR EXISTS(SELECT 1 FROM cost_centers WHERE parent_id=OLD.id);
END;
CREATE TRIGGER cc_upd_rules BEFORE UPDATE ON cost_centers BEGIN
  SELECT RAISE(ABORT,'لا يمكن تحويل مركز له حركات إلى تجميعي')
   WHERE NEW.is_group=1 AND OLD.is_group=0 AND EXISTS(SELECT 1 FROM journal_lines WHERE cost_center_id=OLD.id);
  SELECT RAISE(ABORT,'نقل مركز التكلفة سيُنشئ دائرة أو إلى نفسه/أحد أبنائه')
   WHERE NEW.parent_id IS NOT OLD.parent_id AND NEW.parent_id IS NOT NULL AND (
     NEW.parent_id=OLD.id OR EXISTS(
      WITH RECURSIVE anc(id) AS (SELECT NEW.parent_id UNION ALL SELECT c.parent_id FROM cost_centers c JOIN anc ON c.id=anc.id WHERE c.parent_id IS NOT NULL)
      SELECT 1 FROM anc WHERE id=OLD.id));
END;

ALTER TABLE accounts ADD COLUMN requires_cost_center INTEGER NOT NULL DEFAULT 0 CHECK(requires_cost_center IN (0,1));

-- التحقق من مركز التكلفة على سطر القيد (صالح/نشط/غير تجميعي/نفس الشركة)، وإلزامه إن اشترطه الحساب
DROP TRIGGER jl_ins_rules;
CREATE TRIGGER jl_ins_rules BEFORE INSERT ON journal_lines BEGIN
  SELECT RAISE(ABORT,'لا يمكن إضافة سطر إلى قيد غير مسودة')
   WHERE (SELECT status FROM journal_entries WHERE id=NEW.entry_id)<>'draft';
  SELECT RAISE(ABORT,'القيد تحت المراجعة أو معتمد: أعده إلى المسودة قبل التعديل')
   WHERE (SELECT workflow_state FROM journal_entries WHERE id=NEW.entry_id)<>'draft';
  SELECT RAISE(ABORT,'الحساب غير موجود أو غير نشط أو تجميعي: لا تقبل الحركة')
   WHERE NOT EXISTS(SELECT 1 FROM accounts a JOIN journal_entries e ON e.id=NEW.entry_id
      WHERE a.id=NEW.account_id AND a.is_group=0 AND a.company_id=e.company_id
        AND (a.is_active=1 OR e.entry_type IN ('reversal','closing','opening')));
  SELECT RAISE(ABORT,'قيد الافتتاح يقبل حسابات الميزانية فقط (أصول/خصوم/حقوق ملكية)')
   WHERE (SELECT entry_type FROM journal_entries WHERE id=NEW.entry_id)='opening'
     AND (SELECT account_type FROM accounts WHERE id=NEW.account_id) NOT IN ('asset','liability','equity');
  SELECT RAISE(ABORT,'حسابات العملاء والموردين والمخزون لا تقبل قيدا يدويا عاديا: استخدم المستند المناسب أو قيد تسوية')
   WHERE (SELECT entry_type FROM journal_entries WHERE id=NEW.entry_id)='general'
     AND (EXISTS(SELECT 1 FROM parties WHERE account_id=NEW.account_id)
          OR EXISTS(SELECT 1 FROM account_mappings m WHERE m.account_id=NEW.account_id AND m.map_key='inventory')
          OR EXISTS(SELECT 1 FROM items WHERE inventory_account_id=NEW.account_id));
  SELECT RAISE(ABORT,'مركز التكلفة غير صالح (غير موجود أو غير نشط أو تجميعي أو من شركة أخرى)')
   WHERE NEW.cost_center_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM cost_centers cc JOIN journal_entries e ON e.id=NEW.entry_id
      WHERE cc.id=NEW.cost_center_id AND cc.is_active=1 AND cc.is_group=0 AND cc.company_id=e.company_id);
  SELECT RAISE(ABORT,'هذا الحساب يتطلب مركز تكلفة')
   WHERE NEW.cost_center_id IS NULL AND EXISTS(SELECT 1 FROM accounts a WHERE a.id=NEW.account_id AND a.requires_cost_center=1);
END;


FILTERS = [('الكل', None, None), ('مسودة', 'draft', 'draft'), ('قيد المراجعة', 'draft', 'reviewed'), ('معتمد غير مرحّل', 'draft', 'approved'),
           ('مرحّل', 'posted', None), ('معكوس', 'reversed', None)]
# فترات جاهزة للتصفية بالتاريخ (المفتاح، الاسم): تضبط «من/إلى» تلقائيًا؛ «مدى مخصص» يفتحهما للتعديل
PERIODS = [('month', 'هذا الشهر'), ('today', 'اليوم'), ('last_month', 'الشهر الماضي'), ('last30', 'آخر 30 يومًا'),
           ('year', 'هذه السنة'), ('all', 'كل التواريخ'), ('custom', 'مدى مخصص')]
PAGE_SIZE = 200
_AR_DIGITS = str.maketrans('٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹', '01234567890123456789')


def period_range(key, today=None):
    """(من، إلى) لفترة جاهزة، أو None لـ «كل التواريخ/مخصص»."""
    t = today or _dt.date.today()
    if key == 'today':
        return t, t
    if key == 'month':
        return t.replace(day=1), t.replace(day=calendar.monthrange(t.year, t.month)[1])
    if key == 'last_month':
        last = t.replace(day=1) - _dt.timedelta(days=1)
        return last.replace(day=1), last
    if key == 'last30':
        return t - _dt.timedelta(days=29), t
    if key == 'year':
        return t.replace(month=1, day=1), t.replace(month=12, day=31)
    return None


def parse_entry_no(text):
    """«25» أو «#25» أو «25-40» (وبالأرقام العربية) ← (من، إلى)، وإلا None."""
    t = (text or '').translate(_AR_DIGITS).replace('#', '').strip()
    m = re.fullmatch(r'(\d+)', t)
    if m:
        return int(m.group(1)), int(m.group(1))
    m = re.fullmatch(r'(\d+)\s*-\s*(\d+)', t)
    if m:
        a, b = int(m.group(1)), int(m.group(2))
        return (a, b) if a <= b else (b, a)
    return None



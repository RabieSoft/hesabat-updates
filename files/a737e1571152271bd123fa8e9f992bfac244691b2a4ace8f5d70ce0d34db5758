    # ---------------------------------------------------------------- تحميل
    def refresh(self):
        if not self._built:
            return
        st, ws = self.f_status.currentData()
        kw, cur, by_no = {}, self.f_cur.currentData(), parse_entry_no(self.f_no.text())
        if by_no:                                          # بحث برقم القيد: عبر كل التواريخ والحالات والعملات (فوري ولا يتأثر بحد العرض)
            st = ws = cur = None
            kw = {'no_from': by_no[0], 'no_to': by_no[1]}
        elif self.f_period.currentData() != 'all':
            kw = {'date_from': self.f_from.iso(), 'date_to': self.f_to.iso()}
        if self.f_text.text().strip():
            kw['text'] = self.f_text.text().strip()
        keep = self._sel['id'] if self._sel else None
        if keep is None and getattr(self, 'params', None):
            if isinstance(self.params, dict):
                keep = self.params.get('id') or self.params.get('entry_id')
            elif isinstance(self.params, int):
                keep = self.params
            self.params = None
        try:
            self._qkw = dict(status=st, workflow_state=ws, currency=cur, **kw)
            rows = self.svc.list(**self._qkw, limit=PAGE_SIZE)
        except Exception as exc:  # noqa: BLE001
            self.show_error(exc)
            rows = []
            self._qkw = None
        # إذا كان السجل المطلوب غير موجود في التصفية الحالية، نلغي التصفية لعرضه
        if keep is not None and not any(r.get('id') == keep for r in rows):
            try:
                self._qkw = dict(status=None, workflow_state=None, currency=None)
                rows = self.svc.list(**self._qkw, limit=PAGE_SIZE)
                self._set_period('all', refresh=False)
                self.f_status.blockSignals(True)
                self.f_status.setCurrentIndex(0)
                self.f_status.blockSignals(False)
                self.f_cur.blockSignals(True)
                self.f_cur.setCurrentIndex(0)
                self.f_cur.blockSignals(False)
            except Exception:
                pass
        for r in rows:
            r['type_label'] = ENTRY_TYPES.get(r.get('entry_type'), r.get('entry_type') or '')
        self._rows = rows
        self.grid.set_rows(rows)
        self._more = len(rows) >= PAGE_SIZE
        self.btn_more.setVisible(self._more)
        self._update_count(by_no)
        has_any = True
        if not rows:
            try:
                has_any = bool(self.svc.list(limit=1))
            except Exception:  # noqa: BLE001
                has_any = True
        self._empty.setVisible(not has_any)
        if keep is not None:
            self._select_id(keep)
        else:
            self._on_select([])

    def _update_count(self, by_no=None):
        msg = f'{len(self._rows)} قيد'
        if by_no:
            msg += ' — نتيجة البحث برقم القيد في كل التواريخ'
        if getattr(self, '_more', False):
            msg += ' — توجد قيود أخرى: «عرض المزيد»'
        self.count_lbl.setText(msg)

    def _load_more(self):
        """يحمّل الدفعة التالية من نفس التصفية ويضيفها بدل حد العرض الثابت."""
        if not getattr(self, '_qkw', None):
            return
        keep = self._sel['id'] if self._sel else None
        try:
            more = self.svc.list(**self._qkw, limit=PAGE_SIZE, offset=len(self._rows))
        except Exception as exc:  # noqa: BLE001
            return self.show_error(exc)
        for r in more:
            r['type_label'] = ENTRY_TYPES.get(r.get('entry_type'), r.get('entry_type') or '')
        self._rows = self._rows + more
        self.grid.set_rows(self._rows)
        self._more = len(more) >= PAGE_SIZE
        self.btn_more.setVisible(self._more)
        self._update_count(parse_entry_no(self.f_no.text()))
        if keep is not None:
            self._select_id(keep)

    def _set_period(self, key, refresh=True):
        """يضبط الفترة: الفترات الجاهزة تملأ «من/إلى» وتقفلهما، و«مدى مخصص» يفتحهما انطلاقًا من آخر فترة (لا «اليوم» فقط)."""
        i = self.f_period.findData(key)
        if i >= 0 and self.f_period.currentIndex() != i:
            self.f_period.blockSignals(True)
            self.f_period.setCurrentIndex(i)
            self.f_period.blockSignals(False)
        rng = period_range(key)
        if rng:
            for w, d in ((self.f_from, rng[0]), (self.f_to, rng[1])):
                w.blockSignals(True)
                w.set_iso(d.isoformat())
                w.blockSignals(False)
        self.f_from.setEnabled(key == 'custom')
        self.f_to.setEnabled(key == 'custom')
        if refresh:
            self.refresh()

    def _search_now(self):
        """Enter في خانة رقم القيد: بحث فوري ثم تحديد أول نتيجة ونقل التركيز للجدول."""
        self._t_no.stop()
        self.refresh()
        if self._rows and self.grid.select_where(lambda r: True):
            self.grid.table.setFocus()

    def _select_id(self, eid):
        if not self.grid.select_where(lambda r: r['id'] == eid):
            self._on_select([])

    def _on_select(self, rows):
        self._sel = rows[0] if len(rows) == 1 else None
        self._entry, self._ro = None, ''
        if self._sel:
            try:
                self._entry = self.svc.get(self._sel['id'])
                self._ro = ST.period_reason(self.session.period_info(self._entry['entry_date']))
                self.sheet.set_document(self._doc())
            except Exception as exc:  # noqa: BLE001
                self._entry = None
                self.show_error(exc)
        else:
            self.sheet.set_document(None)
        self._fill_related()
        self.actions_changed.emit()

    def _on_activate(self, _row):
        if self._action_state('edit').enabled:        # النقر المزدوج يعدّل المسودة فقط، وبصمت لغيرها
            self.do('edit')

    def _foreign(self):
        """هل في القيد سطور بعملة غير عملة الأساس؟ تعديلها من هنا يفقد العملة الأصلية، فنمنعه حماية للبيانات."""
        base = (self.state.get('company') or {}).get('base_currency')
        curs = {(ln.get('currency') or base) for ln in (self._entry or {}).get('lines', [])}
        return len(curs) > 1        # عملة واحدة (يمني مثلًا) تُعدَّل بأصلها؛ المختلط فقط غير مدعوم

    def _ctx_entry(self):
        return {**self._entry, 'entry_no': (self._sel or {}).get('entry_no', self._entry.get('entry_no'))}

    def _doc(self):
        e = self._entry
        doc = DM.from_print_spec(self.svc.print_spec(e['id']), 'journal', status=e['status'])
        if e['status'] == 'draft' and e.get('workflow_state') in ('reviewed', 'approved'):
            doc.status = e['workflow_state']
        return doc

    def _fill_related(self):
        items, e = [], self._entry
        if e:
            page = SOURCE_PAGES.get(e.get('source_type') or '')
            if e.get('source_type'):
                items.append(('المصدر', f"{e['source_type']} #{e.get('source_id')}", page or 'journal', None))
            if self._sel and self._sel.get('link'):
                items.append(('ارتباط', self._sel['link'], 'journal', None))
            if self._sel and self._sel.get('attachment_count'):
                items.append(('مرفقات', f"{self._sel['attachment_count']} ملف", 'journal', None))
        self.related.set_items(items)

    def _open_related(self, page, params):
        if page != 'journal':
            self.open_page_requested.emit(page, params)

    def on_context_changed(self, keys):
        super().on_context_changed(keys)

    def is_dirty(self):
        return False

    # ---------------------------------------------------------------- الإجراءات
    def _action_state(self, key):
        e = self._entry
        if key == 'new':
            return self.access.state('journal.create')
        if not e:
            return ActionState(False, 'حدد قيدًا أولًا')
        acts = {a.key: a for a in W.journal_actions(e, self.svc.settings(), self.access, self.session.user_id, self._ro)}
        a = acts.get(key)
        if a is not None and key in ('edit', 'edit_posted') and a.enabled and self._foreign():
            return ActionState(False, 'القيد يحوي أكثر من عملة: تعديله من هذه الشاشة غير مدعوم بعد (يفقد العملة الأصلية)')
        return ActionState(a.enabled, a.reason) if a else ActionState(False, 'غير متاح لهذه الحالة')

    def ribbon_groups(self):
        def act(key, label, icon, **kw):
            return Action(key, label, icon, state_fn=lambda k=key: self._action_state(k), handler=lambda k=key: self.do(k), **kw)
        return [
            ActionGroup('قيد', [act('new', 'قيد جديد', 'new', shortcut='Ctrl+N', primary=True), act('edit', 'تعديل', 'edit', shortcut='F2'),
                                act('delete', 'حذف المسودة', 'delete', danger=True),
                                act('edit_posted', 'تعديل مرحّل', 'edit'), act('delete_posted', 'حذف مرحّل', 'delete', danger=True)]),
            ActionGroup('سير العمل', [act('review', 'مراجعة', 'review'), act('approve', 'اعتماد', 'approve'),
                                      act('return_to_draft', 'إعادة لمسودة', 'return'), act('post', 'ترحيل', 'post', shortcut='F9'),
                                      act('reverse', 'عكس', 'reverse', danger=True)]),
            ActionGroup('أدوات', [Action('attach', 'مرفقات', 'attach', state_fn=lambda: self._action_state('print') if self._entry else ActionState(False, 'حدد قيدًا أولًا'),
                                         handler=lambda: self.do('attachments')),
                                  Action('print', 'طباعة', 'print', shortcut='Ctrl+P', state_fn=lambda: self._action_state('print'), handler=lambda: self.sheet.print_()),
                                  Action('refresh', 'تحديث', 'refresh', handler=self.refresh)]),
        ]

    def do(self, key):
        e = self._entry
        if key == 'new':
            return self._new()
        if not e:
            return QMessageBox.information(self, self.title, 'حدد قيدًا أولًا.')
        st = self._action_state(key) if key not in ('attachments',) else ActionState(True)
        if not st.enabled:
            return QMessageBox.information(self, self.title, st.reason)
        if key == 'edit':
            return self._edit()
        if key == 'edit_posted':
            return self._edit_posted()
        if key == 'delete_posted':
            r = ask_reason(self, 'حذف قيد مرحّل', ['سيُحذف القيد نهائيًا (مع عكسه إن وُجد) ولا يمكن التراجع.',
                                                 'تُحفظ نسخة كاملة منه مع السبب في سجل المحذوفات ويُسجَّل في التدقيق.',
                                                 'يبقى رقمه الرسمي فجوة في ترقيم القيود.'], True, 'حذف')
            return None if r is None else self._run('delete_posted', reason=r)
        if key == 'attachments':
            return self._attachments()
        if key == 'post':
            if ask_reason(self, 'تأكيد الترحيل', ['الترحيل يثبّت القيد ولا يمكن تعديله بعده (يمكن عكسه فقط).'], need_reason=False, confirm_text='ترحيل', danger=False) is None:
                return
            return self._run('post')
        if key == 'delete':
            if ask_reason(self, 'حذف المسودة', ['ستُحذف مسودة القيد نهائيًا ويُسجَّل ذلك في التدقيق.'], need_reason=False, confirm_text='حذف') is None:
                return
            return self._run('delete')
        if key == 'return_to_draft':
            r = ask_reason(self, 'إعادة القيد إلى المسودة', ['يعود القيد إلى حالة المسودة ويُلغى ما تم من مراجعة/اعتماد.'], True, 'إعادة')
            return None if r is None else self._run('return_to_draft', reason=r)
        if key == 'reverse':
            y = self.state.get('year') or {}
            d = ReverseDialog(self, self._ctx_entry(), None, y.get('end'))
            if self.exec_form(d):
                on_date, reason = d.values()
                self._run('reverse', reason=reason, on_date=on_date)
            return None
        return self._run(key)

    def _run(self, key, **kw):
        eid = self._entry['id']
        ok, _ = self.guarded(self.svc.act, eid, key, reload=False, **kw)
        if ok:
            self.notify(DONE.get(key, 'تم'))
            self.refresh()
            self.window_.data_changed(self.key)
        return ok

    def resume_draft(self, dialog_id):
        """استئناف قيد جديد من مسودة محفوظة (بعد انقطاع الكهرباء)."""
        if dialog_id == 'journal_new':
            self._new(resume=True)

    def start_new(self, preset=None):
        """من قائمة المحاسبة العلوية: 'receipt' قيد سند قبض، 'payment' قيد سند صرف، 'recipe:<key>' قالب جاهز."""
        return self._new(preset=preset)

    def _new(self, resume=False, preset=None):
        if not self.access.has('journal.create'):
            return QMessageBox.information(self, self.title, 'ليست لديك صلاحية إنشاء القيود.')
        tab = None
        while True:                                    # «حفظ وقيد جديد» يعيد فتح محرر فارغ بعد كل حفظ ناجح
            d = JournalEditor(self, preset=preset, tab=tab)
            d.enable_stay_save(self._save_stay_new)
            d._resume, resume = resume, False
            if not self.exec_form(d):
                return
            v = d.values()
            ok, eid = self.guarded(self.svc.create, v['date'], v['description'], v['lines'], v['pending_attachments'],
                                 entry_type=v.get('entry_type', 'general'), reload=False)
            if not ok:
                return
            d.clear_draft()                            # نجح الحفظ: لا حاجة للمسودة التلقائية
            self.notify('تم حفظ القيد كمسودة')
            self._sel = {'id': eid}
            self.refresh()
            self.window_.data_changed(self.key)
            if not d.add_another:
                return
            # يعود لآخر قالب مفضل/جاهز استُعمل، وإلا لآخر واجهة (بسيط/مركب) كنت فيها
            preset = f'recipe:{d.used_recipe}' if d.used_recipe else (preset if preset in ('receipt', 'payment') else None)
            tab = d.tabs.currentIndex()

    def _on_link(self, row, _key):
        self.open_entry_requested.emit({'entry_id': row.get('id'), 'source_type': row.get('source_type'), 'source_id': row.get('source_id')})

    def show_source(self, tgt):
        """يحدّد القيد في القائمة؛ وإن كان خارج الفلاتر يبحث برقمه (البحث بالرقم يتجاوز الفترة والحالة والعملة)."""
        try:
            eid = tgt.entry_id
            if not eid:
                return False
            if self.grid.select_where(lambda r: r.get('id') == eid):
                return True
            from alhisabat.ui.core import readmodel
            meta = readmodel.entry_source(self.session.conn, eid)
            if not meta:
                return False
            self.f_no.setText(str(meta['label_no']))
            self.refresh()
            return bool(self.grid.select_where(lambda r: r.get('id') == eid))
        except Exception:  # noqa: BLE001
            return False

    def _save_stay_new(self, d):
        """زر «حفظ» في المحرر: يحفظ مسودة جديدة وتبقى النافذة مفتوحة لإدخال التالي."""
        v = d.values()
        ok, eid = self.guarded(self.svc.create, v['date'], v['description'], v['lines'], v['pending_attachments'],
                               entry_type=v.get('entry_type', 'general'), reload=False)
        if not ok:
            return False
        d.clear_draft()
        self.notify('تم حفظ القيد كمسودة')
        self._sel = {'id': eid}
        self.refresh()
        self.window_.data_changed(self.key)
        return True

    def _save_stay_edit(self, d):
        v = d.values()
        ok, _ = self.guarded(self.svc.update, d.entry['id'], v['date'], v['description'], v['lines'], reload=False)
        if not ok:
            return False
        self.notify('تم تحديث المسودة')
        self.refresh()
        self.window_.data_changed(self.key)
        return True

    def _edit(self):
        d = JournalEditor(self, self._entry)
        d.enable_stay_save(self._save_stay_edit)
        if self.exec_form(d):
            v = d.values()
            ok, _ = self.guarded(self.svc.update, self._entry['id'], v['date'], v['description'], v['lines'], reload=False)
            if ok:
                self.notify('تم تحديث المسودة')
                self.refresh()
                self.window_.data_changed(self.key)

    def _edit_posted(self):
        d = JournalEditor(self, self._entry)
        if not self.exec_form(d):
            return
        v = d.values()
        r = ask_reason(self, 'تعديل قيد مرحّل', ['سيُعكس القيد الحالي بقيد عكسي ويُرحَّل قيد جديد بالقيم المعدّلة.',
                                                'يظهر الأثران في كشف الحساب، ويُسجَّل السبب في التدقيق.'], True, 'تعديل')
        if r is None:
            return
        ok, _ = self.guarded(self.svc.edit_posted, self._entry['id'], v['date'], v['description'], v['lines'], r, reload=False)
        if ok:
            self.notify('تم تعديل القيد: عُكس القديم ورُحّل الجديد')
            self.refresh()
            self.window_.data_changed(self.key)

    def _attachments(self):
        d = AttachmentsDialog(self, self.svc, self._ctx_entry(), self.access.has('journal.create'), self.show_error)
        self.exec_form(d)
        if d.changed:
            self.refresh()



        sum_box = QFrame(); sum_box.setObjectName('invCard')
        sum_box.setFrameShape(QFrame.StyledPanel)
        g = QHBoxLayout(sum_box); g.setContentsMargins(10, 4, 10, 4); g.setSpacing(14)
        self._sum = {}
        for k, t in (('total', 'إجمالي المرتجع'), ('refund', 'المسترد الآن'), ('rest', 'يُخصم من رصيد الطرف' if self._party_id else 'المتبقي')):
            kl = QLabel(t); kl.setObjectName('invSumKey'); g.addWidget(kl)
            v = QLabel('—')
            v.setObjectName('invSumVal'); v.setProperty('sk', k)
            v.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
            g.addWidget(v)
            self._sum[k] = v
        bottom.addWidget(sum_box, 3)
        lay.addLayout(bottom)
        lay.addWidget(self.pay_note)

        self.err = QLabel('')
        self.err.setWordWrap(True)
        self.err.setStyleSheet('color: var(--color-danger); font-weight: bold;')
        self.err.setVisible(False)
        lay.addWidget(self.err)

        bb = QDialogButtonBox()
        self.ok = bb.addButton('إنشاء المرتجع', QDialogButtonBox.AcceptRole)
        self.ok.setProperty('primary', True)
        self.ok.setAutoDefault(False)
        c = bb.addButton(S.ACTION['cancel'], QDialogButtonBox.RejectRole)
        c.setAutoDefault(False)
        bb.accepted.connect(self._accept)
        bb.rejected.connect(self.reject)
        lay.addWidget(bb)

        # الفاتورة بلا طرف (نقدية): الاسترداد كامل وجوبًا → اختر أول صندوق تلقائيًا
        if self._party_id is None:
            rows = _safe(lambda: s.lookup_pay_accounts(), [])
            if rows:
                self.pay_cash.set_id(rows[0][0])
            self.pay_note.setText('فاتورة نقدية بلا ' + ('عميل' if self._is_sales else 'مورد') + ': يجب استرداد كامل قيمة المرتجع.')
        first = next((w for _l, w, avail in self.rows if avail > 0), None)
        if first is not None:
            QTimer.singleShot(0, first.setFocus)             # ابدأ الكتابة فورًا في أول صنف قابل للإرجاع
        self._auto_refund = True                         # يتبع المبلغ المسترد الإجمالي ما لم يعدّله المستخدم
        self.pay_amount.textEdited.connect(self._manual_refund)
        self.pay_amount.textChanged.connect(self._refresh)
        self.pay_cash.selected.connect(lambda _i: self._refresh())
        self.date.dateIso.connect(lambda _d: self._refresh())
        self._refresh()

    # ---------------------------------------------------------------- منطق الواجهة
    def _next_qty(self, i):
        """Enter في كمية مرتجع: الصنف التالي القابل للإرجاع، وبعد آخر صنف إلى الصندوق/المبلغ المسترد."""
        for _l, w, avail in self.rows[i + 1:]:
            if avail > 0:
                w.setFocus(); w.selectAll(); return
        (self.pay_amount if self.pay_cash.current_id() else self.pay_cash).setFocus()

    def _manual_refund(self, _t):
        self._auto_refund = False

    def _fill_all(self):
        for _l, w, avail in self.rows:
            if avail > 0:
                w.set_value(Decimal(avail) / 1000)
        self._auto_refund = True

    def _clear(self):
        for _l, w, _a in self.rows:
            w.setText('')
        self._auto_refund = True

    def _refund_full(self):
        if self._total_minor:
            self._set_refund(self._total_minor)
            if self.pay_cash.current_id() is None:
                rows = _safe(lambda: self.page.session.lookup_pay_accounts(), [])
                if rows:
                    self.pay_cash.set_id(rows[0][0])
            self._auto_refund = True
            self._refresh()

    def _set_refund(self, minor):
        self.pay_amount.blockSignals(True)
        self.pay_amount.set_value(Decimal(minor) / 100 if minor else None)
        self.pay_amount.blockSignals(False)

    def _entered(self):
        """[(orig_line_id, qty نص)] للأسطر المعبّأة + أخطاء الكميات (نص أول خطأ أو '')."""
        out, bad = [], ''
        for l, w, avail in self.rows:
            txt = w.text().strip().replace(',', '')
            ok = True
            if txt:
                v = w.value()
                if v is None or v <= 0:
                    ok = False
                    bad = bad or 'كمية مرتجع غير صالحة'
                elif int(v * 1000) > avail:
                    ok = False
                    bad = bad or f"كمية المرتجع تتجاوز المتاح للصنف «{l.get('item_name') or ''}»"
                else:
                    out.append((int(l['id']), txt))
            w.setProperty('invalid', not ok)
            repolish(w)
        return out, bad

    def _refresh(self, *_):
        entered, bad = self._entered()
        msg = bad
        self._total_minor = None
        if entered and not bad:
            try:
                self._total_minor = int(self.page.svc.return_preview(
                    self.kind, self.inv['id'], [{'orig_line_id': i, 'qty': q} for i, q in entered], self.date.iso()))
            except Exception as exc:  # noqa: BLE001 — رسالة المحرك كما هي
                msg = str(exc)
        total = self._total_minor
        # الاسترداد التلقائي: كامل إن لم يكن هناك طرف، أو كانت الفاتورة الأصلية مسدّدة بالكامل
        if self._auto_refund and total is not None:
            full_default = self._party_id is None or int(self.inv.get('due_total') or 0) <= 0
            self._set_refund(total if full_default else 0)
        refund = int((self.pay_amount.value() or Decimal(0)) * 100)
        if total is None:
            for k in self._sum:
                self._sum[k].setText('—')
        else:
            self._sum['total'].setText(fmt.fmt_money(total, minor=True))
            self._sum['refund'].setText(fmt.fmt_money(refund, minor=True))
            self._sum['rest'].setText(fmt.fmt_money(total - refund, minor=True))
            if not msg:
                if self.pay_amount.text().strip() and self.pay_amount.value() is None:
                    msg = 'مبلغ الاسترداد غير صالح'
                elif refund > total:
                    msg = 'المبلغ المسترد يتجاوز إجمالي المرتجع'
                elif refund > 0 and self.pay_cash.current_id() is None:
                    msg = 'اختر الصندوق/البنك الذي يتم الاسترداد عبره'
                elif self._party_id is None and refund != total:
                    msg = 'الفاتورة نقدية بلا طرف: يجب استرداد كامل المرتجع (اختر الصندوق/البنك واضغط «استرداد كامل»)'
        self.btn_full.setEnabled(bool(total))
        self._err_msg = msg
        self.err.setText(msg)
        self.err.setVisible(bool(msg))
        self.ok.setEnabled(bool(entered) and not msg and total is not None)

    def _accept(self):
        if not self.ok.isEnabled():
            return
        self.accept()

    def values(self):
        entered, _bad = self._entered()
        refund = self.pay_amount.value() or Decimal(0)
        payments = []
        if refund > 0 and self.pay_cash.current_id() is not None:
            payments.append({'account_id': int(self.pay_cash.current_id()), 'amount': str(refund)})
        return {'date': self.date.iso(), 'lines': [{'orig_line_id': i, 'qty': q} for i, q in entered],
                'payments': payments, 'notes': self.notes.text().strip()}

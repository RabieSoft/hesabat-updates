        lay.addWidget(self.table, 1)

        tools = QHBoxLayout()
        self.btn_all = QPushButton('إرجاع كل المتاح')
        self.btn_all.setAutoDefault(False)
        self.btn_all.clicked.connect(self._fill_all)
        self.btn_clear = QPushButton('مسح الكميات')
        self.btn_clear.setAutoDefault(False)
        self.btn_clear.clicked.connect(self._clear)
        tools.addWidget(self.btn_all)
        tools.addWidget(self.btn_clear)
        self.date = DateField()
        self.notes = QLineEdit()
        self.notes.setPlaceholderText('سبب المرتجع / ملاحظة (اختياري)')
        tools.addSpacing(10)
        tools.addWidget(QLabel('التاريخ:'))
        tools.addWidget(self.date)
        tools.addWidget(self.notes, 1)                       # التاريخ والملاحظة في نفس صف الأزرار بدل صفين إضافيين
        lay.addLayout(tools)

        # ---- الاسترداد + الملخص في صف واحد مضغوط
        bottom = QHBoxLayout(); bottom.setSpacing(10)
        pay_box = QFrame()
        pay_box.setFrameShape(QFrame.StyledPanel)
        pf = QHBoxLayout(pay_box); pf.setContentsMargins(10, 4, 10, 4); pf.setSpacing(8)
        ttl = QLabel('استرداد ' + ('للعميل' if self._is_sales else 'من المورد'))
        ttl.setStyleSheet('font-weight: bold;')
        s = page.session
        self.pay_cash = SearchPicker(cached_loader(lambda: _safe(s.lookup_pay_accounts, [])),
                                     placeholder='— بدون استرداد نقدي (يُخصم من الرصيد) —')
        self.pay_amount = MoneyEdit(); self.pay_amount.setMaximumWidth(130)
        self.btn_full = QPushButton('استرداد كامل')
        self.btn_full.setAutoDefault(False)
        self.btn_full.clicked.connect(self._refund_full)
        for w_ in (self.pay_cash, self.pay_amount, self.btn_full):
            w_.setFixedHeight(30)
        pf.addWidget(ttl)
        pf.addWidget(QLabel('الصندوق/البنك')); pf.addWidget(self.pay_cash, 3)
        pf.addWidget(QLabel('المبلغ')); pf.addWidget(self.pay_amount, 1); pf.addWidget(self.btn_full)

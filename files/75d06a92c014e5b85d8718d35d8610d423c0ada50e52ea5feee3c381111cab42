def _safe(fn, default):
    """استدعاء قائمة اختيار: الصلاحية قد تمنعها فتظهر فارغة ولا تنهار النافذة."""
    try:
        return fn()
    except Exception:  # noqa: BLE001
        return default


class InvoiceEditor(DialogGuardMixin, QDialog):
    guard_save_stay = False
    nonmodal_exec = True
    center_on_show = True
    draft_clear_on_page_save = True
    submitted = Signal()                 # المضمَّن: طلب الحفظ بعد اجتياز التحقق (بدل accept() الذي يخفي العنصر)
    clearRequested = Signal()            # المضمَّن: زر «جديدة/مسح» أو «إلغاء التعديل»

    def __init__(self, page, kind, existing=None, defaults=None):
        super().__init__(page)
        self.page, self.kind, self.existing = page, kind, existing
        self._defaults = dict(defaults or {})            # ما يُتذكَّر من الفاتورة السابقة (التاريخ والعملة) للفاتورة الجديدة فقط
        self.draft_key = None if existing else f'invoice_{kind}_new'     # مسودة للفاتورة الجديدة فقط
        self.draft_page = 'sales' if kind == 'sales' else 'purchases'
        self.draft_title = 'فاتورة مبيعات جديدة' if kind == 'sales' else 'فاتورة مشتريات جديدة'
        self.add_another = False
        is_sales = kind == 'sales'
        self._party_kind = 'customer' if is_sales else 'supplier'
        self._carry_payments, self._carry_costs, self._totals, self._carry_disc_amount = [], [], None, ''
        self._ctx = None
        self._last_pick, self._last_price_info = None, None
        self._unit_names = {}
        self._units_cache = {}                           # item_id -> {unit_id: factor_milli} لتحويل السعر عند تغيير الوحدة
        self.setWindowTitle('تعديل فاتورة' if existing else ('فاتورة مبيعات' if is_sales else 'فاتورة مشتريات'))
        self.setLayoutDirection(Qt.RightToLeft)
        self.setObjectName('invDialog')
        if self.embedded:

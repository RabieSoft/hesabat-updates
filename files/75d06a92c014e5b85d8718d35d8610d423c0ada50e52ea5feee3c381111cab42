class ReturnEditor(QDialog):
    """مرتجع فاتورة (مبيعات/مشتريات): ملخص الفاتورة الأصلية، جدول كميات واضح (الأصلية/سبق إرجاعه/المتاح/المرتجع)،
    إجمالي المرتجع من المحرك نفسه، ثم **الاسترداد**: الصندوق/البنك والمبلغ. الفاتورة بلا طرف تُسترد كاملة وجوبًا.
    الباقي بعد الاسترداد يُخصم من رصيد الطرف (يبقى ذمة). المحرك هو الحَكَم النهائي عند الحفظ."""

    def __init__(self, page, kind, invoice):

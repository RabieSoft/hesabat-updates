        self.setLayoutDirection(Qt.RightToLeft)
        make_resizable(self, 900, 620, (760, 500))
        lay = QVBoxLayout(self)
        lay.setSpacing(8)

        # ---- ملخص الفاتورة الأصلية
        sel = getattr(page, '_sel', None) or {}
        party_txt = (f"{party_word}: {sel['party']}" if sel.get('party') else f"بلا {party_word} (فاتورة نقدية)")
        cur = invoice.get('currency') or ''
        head = QLabel(f"مرتجع على فاتورة {word} رقم  {invoice.get('invoice_no') or invoice.get('id')}")
        head.setStyleSheet('font-size: 15px; font-weight: bold;')
        lay.addWidget(head)
        info = QLabel(f"التاريخ: {invoice.get('invoice_date', '')}     ·     {party_txt}"
                      f"     ·     الإجمالي: {fmt.fmt_money(invoice.get('grand_total'), minor=True)} {cur}"
                      f"     ·     المدفوع: {fmt.fmt_money(invoice.get('paid_total'), minor=True)} {cur}")
        info.setObjectName('ctxKey')
        lay.addWidget(info)
        hint = QLabel('اكتب في عمود «كمية المرتجع» الكمية المراد إرجاعها لكل صنف (لا تتجاوز «المتاح»)، أو اضغط «إرجاع كل المتاح».')
        hint.setWordWrap(True)
        hint.setStyleSheet('color: var(--color-text-muted);')
        lay.addWidget(hint)

        # ---- جدول البنود
        self.table = QTableWidget(0, 5)
        self.table.setHorizontalHeaderLabels(['الصنف', 'الكمية الأصلية', 'سبق إرجاعه', 'المتاح للإرجاع', 'كمية المرتجع'])
        hh = self.table.horizontalHeader()
        hh.setSectionResizeMode(0, QHeaderView.Stretch)
        for c in (1, 2, 3, 4):
            hh.setSectionResizeMode(c, QHeaderView.ResizeToContents)
        self.table.setLayoutDirection(Qt.RightToLeft)
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.table.setSelectionMode(QTableWidget.NoSelection)
        self.table.verticalHeader().setVisible(False)
        self.table.setAlternatingRowColors(True)
        self.rows = []                                  # (سطر الفاتورة، حقل الكمية، المتاح بالألف)
        for l in invoice.get('lines', []):
            r = self.table.rowCount()
            self.table.insertRow(r)
            qty = int(l.get('qty_milli') or 0)
            done = int(l.get('returned_milli') or 0)
            avail = max(qty - done, 0)
            name = f"{l.get('item_code') or ''} — {l.get('item_name') or l.get('description') or ''}".strip(' —')
            for c, txt in ((0, name), (1, EL_fmt_qty(qty)), (2, EL_fmt_qty(done)), (3, EL_fmt_qty(avail))):
                it = QTableWidgetItem(txt)
                if c:
                    it.setTextAlignment(Qt.AlignCenter)
                self.table.setItem(r, c, it)
            w = MoneyEdit(places=3)
            w.setMinimumWidth(120)
            w.setPlaceholderText('0')
            if avail <= 0:
                w.setEnabled(False)
                w.setPlaceholderText('مُرجَع بالكامل')
            w.textChanged.connect(self._refresh)
            w.returnPressed.connect(lambda ix=len(self.rows): self._next_qty(ix))        # Enter: ينتقل لكمية الصنف التالي
            self.table.setCellWidget(r, 4, w)
            self.table.setRowHeight(r, 34)

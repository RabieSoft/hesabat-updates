LRE, PDF = '‪', '‬'

# محرك النص الغني في Qt (QTextDocument) يرصّ خلايا الجدول من اليسار لليمين حتى مع dir="rtl" (ظهر ذلك في معاينة كشف الحساب).
# فنكتب كل صف من كشف الحساب بترتيب منطقي «أول عمود = أقصى اليمين» (التاريخ ثم نوع المستند ... ثم الرصيد) ونعكسه هنا ليظهر عربيًا صحيحًا.
# إن ظهر الترتيب معكوسًا على جهازك (نسخة Qt تعكس الجداول تلقائيًا) اجعلها False.
MIRROR = True


def _tr(cells, mirror=True):
    return '<tr>' + ''.join(reversed(cells) if (MIRROR and mirror) else cells) + '</tr>'


def _e(v):
    return escape('' if v is None else str(v))


def _ltr(s):
    """نص لاتيني/أرقام يُعرض من اليسار لليمين داخل فقرة عربية."""
    return f'{LRE}{_e(s)}{PDF}'


def dmy(s):
    """2026-08-05 → 05/08/2026 (كما في العيّنة)."""
    m = re.match(r'^(\d{4})-(\d{2})-(\d{2})', str(s or ''))
    return f'{m.group(3)}/{m.group(2)}/{m.group(1)}' if m else str(s or '')


def currency_label(code):
    code = (code or '').strip().upper()
    return _CURRENCIES.get(code, (code, code)) if code else ('', '')


def printed_stamp(iso):
    """«11:24:14 AM 05/08/2026» من ISO؛ يُرجع '' إن تعذّر."""
    try:
        d = datetime.fromisoformat(str(iso))
    except (TypeError, ValueError):
        return ''
    h12 = d.hour % 12 or 12
    return f"{LRE}{'AM' if d.hour < 12 else 'PM'} {h12:02d}:{d.minute:02d}:{d.second:02d} {d.day:02d}/{d.month:02d}/{d.year}{PDF}"


def money(v, blank_zero=False, places=2):
    if v is None:
        return ''
    if isinstance(v, Decimal):
        if blank_zero and v == 0:
            return ''
        return _e(fmt.fmt_money(v, places=places))
    return _e(v)


def is_statement(doc):
    return doc.sums is not None and {c.get('key') for c in doc.columns} >= {'date', 'desc', 'debit', 'credit'}


def _period_line(doc):
    p = (doc.period or '').strip()
    if not p:
        return ''
    parts = [x.strip() for x in p.split('—')]
    if len(parts) == 2 and all(parts):
        return f'من تاريخ : {_ltr(dmy(parts[0]))}&nbsp;&nbsp;&nbsp;&nbsp;إلى تاريخ : {_ltr(dmy(parts[1]))}'
    return f'كما في تاريخ : {_ltr(dmy(p))}'



def _contact_block(opts):
    lines = []
    for label, val in (('Tele No.', opts.phone), ('Fax No.', opts.fax), ('P.O.Box', opts.pobox)):
        lines.append(f'<b>{label}</b>' + (f' {_ltr(val)}' if val else ''))
    return '<br>'.join(f'<span style="font-size:9pt;">{x}</span>' for x in lines)


def _is_doc(doc):
    """فاتورة/سند/قيد/جرد/رواتب (لا تقرير ولا كشف): تُظهر الشعار ونص الترويسة وسطر العلامة وتحترم «الترويسة فقط»."""
    return doc.kind not in ('report', 'statement')


def _image_only(doc, opts, header_image_html):
    return bool(header_image_html) and _is_doc(doc) and bool(getattr(opts, 'header_image_only', False))



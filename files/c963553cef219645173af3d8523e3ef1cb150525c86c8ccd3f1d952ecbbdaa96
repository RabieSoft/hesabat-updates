-- 0051: متغيّرات الصنف (الألوان) — للأقمشة والملابس: صنف أم + لون = صنف مخزني فرعي.
-- تصميم إضافي فقط: كل لون صنف فرعي حقيقي (items) مرتبط بالأم، فتعمل كل المحركات القائمة (حركات، تكلفة، دفعات، جرد، فواتير)
-- لكل لون على حدة دون أي تعديل عليها. الأم «مجمِّعة» فقط ولا تُسجَّل عليها حركات ولا بنود فواتير.
-- لا يغيّر بيانات أو حركات قائمة؛ الأصناف الحالية has_variants=0 وparent_item_id NULL فيبقى سلوكها كما هو.
CREATE TABLE colors(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id),
  code TEXT NOT NULL CHECK(length(trim(code))>0), name TEXT NOT NULL CHECK(length(trim(name))>0),
  shade_code TEXT NOT NULL DEFAULT '',            -- الدرجة اللونية: مثل 12 أو 5B
  color_family TEXT NOT NULL DEFAULT '',          -- العائلة: أبيض، أحمر، أزرق...
  hex TEXT NOT NULL DEFAULT '' CHECK(hex='' OR hex GLOB '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'),
  is_active INTEGER NOT NULL DEFAULT 1 CHECK(is_active IN (0,1)),
  created_by INTEGER REFERENCES users(id), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE(company_id,code));
CREATE UNIQUE INDEX ux_colors_name_shade ON colors(company_id,name COLLATE NOCASE,shade_code COLLATE NOCASE);
CREATE INDEX ix_colors_family ON colors(company_id,color_family);

ALTER TABLE items ADD COLUMN has_variants INTEGER NOT NULL DEFAULT 0 CHECK(has_variants IN (0,1));
ALTER TABLE items ADD COLUMN parent_item_id INTEGER REFERENCES items(id);
ALTER TABLE items ADD COLUMN color_id INTEGER REFERENCES colors(id);
CREATE INDEX ix_items_parent ON items(parent_item_id);
CREATE INDEX ix_items_color ON items(color_id);
CREATE UNIQUE INDEX ux_items_parent_color ON items(parent_item_id,color_id) WHERE parent_item_id IS NOT NULL;

CREATE TRIGGER items_variant_rules_ins BEFORE INSERT ON items
WHEN NEW.parent_item_id IS NOT NULL OR NEW.has_variants=1 BEGIN
  SELECT RAISE(ABORT,'صنف المتغيّر يحتاج أمًّا ولونًا') WHERE NEW.parent_item_id IS NOT NULL AND NEW.color_id IS NULL;
  SELECT RAISE(ABORT,'الأم المجمِّعة لا تكون متغيّرًا') WHERE NEW.has_variants=1 AND NEW.parent_item_id IS NOT NULL;
  SELECT RAISE(ABORT,'الأم غير صالحة (يجب أن تكون صنفًا مخزنيًا مفعَّلًا بالمتغيّرات من نفس الشركة)')
   WHERE NEW.parent_item_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM items p WHERE p.id=NEW.parent_item_id AND p.company_id=NEW.company_id
         AND p.has_variants=1 AND p.item_type='stock' AND p.parent_item_id IS NULL);
  SELECT RAISE(ABORT,'اللون من شركة أخرى') WHERE NEW.color_id IS NOT NULL
   AND NOT EXISTS(SELECT 1 FROM colors c WHERE c.id=NEW.color_id AND c.company_id=NEW.company_id);
END;

-- لا تغيير لارتباط الأم/اللون بعد وجود حركات، ولا تفعيل/إلغاء التجميع لصنف له حركات أو متغيّرات.
CREATE TRIGGER items_variant_link_locked BEFORE UPDATE OF parent_item_id,color_id,has_variants ON items
WHEN (OLD.parent_item_id IS NOT NEW.parent_item_id OR OLD.color_id IS NOT NEW.color_id OR OLD.has_variants<>NEW.has_variants)
 AND (EXISTS(SELECT 1 FROM stock_movements WHERE item_id=OLD.id)
      OR (OLD.has_variants=1 AND EXISTS(SELECT 1 FROM items c WHERE c.parent_item_id=OLD.id))) BEGIN
  SELECT RAISE(ABORT,'لا يمكن تغيير ارتباط الصنف بالألوان بعد وجود حركات أو متغيّرات');
END;

-- الأم المجمِّعة لا حركات مخزنية عليها ولا بنود فواتير: يجب اختيار اللون.
CREATE TRIGGER sm_no_parent BEFORE INSERT ON stock_movements
WHEN (SELECT has_variants FROM items WHERE id=NEW.item_id)=1 BEGIN
  SELECT RAISE(ABORT,'الصنف له ألوان: اختر لونًا محددًا للحركة');
END;
CREATE TRIGGER sil_no_parent BEFORE INSERT ON sales_invoice_lines
WHEN NEW.item_id IS NOT NULL AND (SELECT has_variants FROM items WHERE id=NEW.item_id)=1 BEGIN
  SELECT RAISE(ABORT,'الصنف له ألوان: اختر لونًا محددًا في بند الفاتورة');
END;
CREATE TRIGGER pil_no_parent BEFORE INSERT ON purchase_invoice_lines
WHEN NEW.item_id IS NOT NULL AND (SELECT has_variants FROM items WHERE id=NEW.item_id)=1 BEGIN
  SELECT RAISE(ABORT,'الصنف له ألوان: اختر لونًا محددًا في بند الفاتورة');
END;
CREATE TRIGGER scl_no_parent BEFORE INSERT ON stock_count_lines
WHEN (SELECT has_variants FROM items WHERE id=NEW.item_id)=1 BEGIN
  SELECT RAISE(ABORT,'الصنف له ألوان: اجرد كل لون على حدة');
END;

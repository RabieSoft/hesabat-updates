def get_invoice(conn, user_id, invoice_id):
    h = _load(conn, invoice_id)
    permissions.require(conn, user_id, h["company_id"], "sales.view", h["branch_id"])
    lines = [dict(r) for r in conn.execute("SELECT l.*,i.code item_code,i.name item_name FROM sales_invoice_lines l JOIN items i ON i.id=l.item_id "
                                           "WHERE l.invoice_id=? ORDER BY l.line_no", (invoice_id,))]
    pays = [dict(r) for r in conn.execute("SELECT * FROM invoice_payments WHERE invoice_id=?", (invoice_id,))]
    if h["doc_type"] == "invoice":
        for ln in lines:                       # الكمية المرتجعة سابقًا لكل بند (لنافذة المرتجع)
            ln["returned_milli"] = _returned_sums(conn, ln["id"])[0]
    return {**dict(h), "lines": lines, "payments": pays}


def list_invoices(conn, user_id, company_id, *, doc_type=None, status=None, customer_id=None, date_from=None, date_to=None, limit=50, offset=0, branch_id=None):
    permissions.require(conn, user_id, company_id, "sales.view", check_branch=False)
    q, a = "SELECT * FROM sales_invoices WHERE company_id=?", [company_id]
    for col, v, op in (("doc_type", doc_type, "="), ("status", status, "="), ("customer_id", customer_id, "="),
                       ("invoice_date", date_from, ">="), ("invoice_date", date_to, "<=")):
        if v is not None:
            q += f" AND {col}{op}?"; a.append(v)
    restricted = [r[0] for r in conn.execute("SELECT branch_id FROM user_branch_access WHERE user_id=?", (user_id,))]
    if restricted:
        q += " AND branch_id IN (%s)" % ",".join("?" * len(restricted)); a += restricted
    f, fa = branch_scope.txn_clause(conn, company_id, branch_id)
    q += f; a += fa
    return [dict(r) for r in conn.execute(q + " ORDER BY invoice_date DESC,id DESC LIMIT ? OFFSET ?", (*a, min(int(limit), 500), int(offset)))]


def sales_summary(conn, user_id, company_id, date_from, date_to, group_by="customer"):
    """المبيعات الصافية (فواتير مرحّلة − مرتجعات مرحّلة، غير الملغاة) مجمّعة حسب العميل/الصنف/اليوم وحسب عملة المستند (لا جمع بين العملات).
    الربح = الصافي بدون ضريبة − تكلفة البنود المخزنية (بالعملة الأساسية) — يُقارَن بعملة المستند فقط للمستندات بالعملة الأساسية.
    تقرير تشغيلي؛ التقرير المحاسبي الرسمي من الأستاذ."""
    permissions.require(conn, user_id, company_id, "sales.view", check_branch=False)
    permissions.require(conn, user_id, company_id, "report.view", check_branch=False)
    key = {"customer": "COALESCE(h.customer_id,0)", "item": "l.item_id", "day": "h.invoice_date"}.get(group_by)
    if not key:
        raise AccountingError("تجميع غير معروف")
    sgn = "CASE h.doc_type WHEN 'invoice' THEN 1 ELSE -1 END"
    rows = conn.execute(
        f"SELECT {key} k,h.currency cur,SUM({sgn}*l.gross_ex) gross_ex,SUM({sgn}*l.discount_ex) discount_ex,SUM({sgn}*l.net_ex) net_ex,"
        f"SUM({sgn}*l.tax_minor) tax,SUM({sgn}*l.total_minor) total,SUM({sgn}*l.cost_base_minor) cost "
        f"FROM sales_invoice_lines l JOIN sales_invoices h ON h.id=l.invoice_id WHERE h.company_id=? AND h.status='posted' "
        f"AND h.invoice_date BETWEEN ? AND ? GROUP BY k,h.currency ORDER BY k,h.currency", (company_id, date_from, date_to)).fetchall()
    base = fxr.base_currency(conn, company_id)
    return [{**dict(r), "profit": (r["net_ex"] - r["cost"]) if r["cur"] == base else None} for r in rows]


def preview_totals(conn, company_id, lines, *, discount_percent=None, discount_amount=None):
    """معاينة إجماليات مستند دون أي كتابة (v1.6): نفس مسار الحفظ تمامًا (_prep_lines ← compute_lines)،
    فلا يختلف رقم المعاينة عن رقم الحفظ. يرفع AccountingError بنفس رسائل الحفظ. القيم بالوحدة الصغرى."""
    prepped = _prep_lines(conn, company_id, lines)
    dt, dv = _disc(discount_percent, discount_amount)
    T = compute_lines(prepped, dt, dv)
    T = dict(T)
    T["lines"] = [{"idx": l["idx"], "amount": l["amount"], "line_discount": l["ld"], "tax": l["tax"], "total": l["total"]} for l in prepped]
    return T

def _next_number(conn, company_id, doc_type, fiscal_year_id):
    conn.execute("INSERT OR IGNORE INTO doc_sequences(company_id,doc_type,fiscal_year_id,last_no) VALUES(?,?,?,0)", (company_id, doc_type, fiscal_year_id))
    conn.execute("UPDATE doc_sequences SET last_no=last_no+1 WHERE company_id=? AND doc_type=? AND fiscal_year_id=?", (company_id, doc_type, fiscal_year_id))
    n = conn.execute("SELECT last_no FROM doc_sequences WHERE company_id=? AND doc_type=? AND fiscal_year_id=?", (company_id, doc_type, fiscal_year_id)).fetchone()[0]
    y = conn.execute("SELECT name FROM fiscal_years WHERE id=?", (fiscal_year_id,)).fetchone()[0]
    return f"{PREFIX[doc_type]}-{y}-{n:06d}"


def _je_line(account, cur, rate, debit=0, credit=0, cost_center_id=None):
    ln = {"account_id": account, "debit": _u(debit) if debit else 0, "credit": _u(credit) if credit else 0, "currency": cur}
    if rate is not None:
        ln["rate"] = rate
    if cost_center_id is not None:
        ln["cost_center_id"] = cost_center_id
    return ln


def _agg(d, k, v):
    d[k] = d.get(k, 0) + v


def post_invoice(conn, actor_id, invoice_id, *, _keep_no=None, _mv_date=None):
    """يرحّل فاتورة أو مرتجعا: كل الآثار في معاملة واحدة، وأي فشل = Rollback كامل (لا رقم مستهلك، لا حركة، لا قيد)."""
    h = _load(conn, invoice_id)
    cid = h["company_id"]
    permissions.require(conn, actor_id, cid, "sales.post", h["branch_id"])
    permissions.require(conn, actor_id, cid, "journal.create", h["branch_id"])
    permissions.require(conn, actor_id, cid, "journal.post", h["branch_id"])
    if h["status"] != "draft":
        raise AccountingError("المستند ليس مسودة")
    is_ret = h["doc_type"] == "return"
    base = fxr.base_currency(conn, cid)
    lines = conn.execute("SELECT * FROM sales_invoice_lines WHERE invoice_id=? ORDER BY line_no", (invoice_id,)).fetchall()
    pays = conn.execute("SELECT * FROM invoice_payments WHERE invoice_id=?", (invoice_id,)).fetchall()
    if not lines:
        raise AccountingError("المستند بلا بنود")
    per = period_engine.find_period(conn, cid, h["invoice_date"])
    je._assert_open(per)
    if is_ret:
        rate = Decimal(h["exchange_rate"])
    else:
        rate = fxr.get_rate(conn, cid, h["currency"], h["invoice_date"])
    cur, jrate = h["currency"], (None if h["currency"] == base else rate)
    cust = None
    if h["customer_id"] is not None:
        cust = conn.execute("SELECT * FROM parties WHERE id=?", (h["customer_id"],)).fetchone()
        if not cust["is_active"]:
            raise AccountingError("العميل غير نشط")
    for p in pays:
        if not _pay_accounts_ok(conn, cid, p["account_id"]):
            raise AccountingError("حساب دفع/استرداد غير صالح")
    disc_acc, ret_acc = _mapping(conn, cid, "sales_discount"), _mapping(conn, cid, "sales_returns")
    if h["discount_ex_total"] and not disc_acc:
        raise AccountingError("اربط حساب خصم المبيعات (Account Mapping: sales_discount)")
    if is_ret and not ret_acc:
        raise AccountingError("اربط حساب مردودات المبيعات (Account Mapping: sales_returns)")
    stock_lines = [l for l in lines if inv._item(conn, l["item_id"])["item_type"] == "stock"]
    if stock_lines:
        permissions.require(conn, actor_id, cid, "inventory.move", check_branch=False)
    from alhisabat.business import cost_centers as cc
    default_cc = cc.for_branch(conn, cid, h["branch_id"])
    mode = get_settings(conn, cid)["credit_limit_mode"]
    with transaction(conn):
        # ---- الأصول التشغيلية: الائتمان (للبيع فقط) والمخزون
        if not is_ret and h["due_total"] > 0 and mode != "off" and cust["credit_limit"] > 0:
            bal = pt.balances(conn, cid, [cust], pt.latest_day(conn, cid))[cust["id"]]
            due_base = _r(Decimal(h["due_total"]) * rate)
            if bal + due_base > cust["credit_limit"]:
                if mode == "block":
                    raise AccountingError(f"تجاوز الحد الائتماني للعميل: الرصيد {bal} + المستحق {due_base} > الحد {cust['credit_limit']} (بالوحدة الصغرى)")
                audit.log(conn, actor_id, "credit_limit_exceeded", "sales_invoices", invoice_id, after={"balance": bal, "due": due_base, "limit": cust["credit_limit"]})
        mids = []
        for l in stock_lines:
            if is_ret:
                ol = conn.execute("SELECT * FROM sales_invoice_lines WHERE id=?", (l["orig_line_id"],)).fetchone()
                om = conn.execute("SELECT * FROM stock_movements WHERE id=?", (ol["movement_id"],)).fetchone()
                _rq, *_ = _returned_sums(conn, ol["id"])
                if _rq + l["qty_milli"] > ol["qty_milli"]:
                    raise AccountingError("كمية المرتجع تتجاوز المتبقي (مرتجعات أخرى رُحّلت)")
                mv = inv.record_movement(conn, actor_id, cid, l["item_id"], om["warehouse_id"], h["invoice_date"], "sale_return",
                                         Decimal(l["qty_milli"]) / 1000, unit_id=l["unit_id"], ref_movement_id=om["id"],
                                         source_type="sales_invoice", source_id=invoice_id)
            else:
                mv = inv.record_movement(conn, actor_id, cid, l["item_id"], h["warehouse_id"], _mv_date or h["invoice_date"], "sale",
                                         Decimal(l["qty_milli"]) / 1000, unit_id=l["unit_id"], source_type="sales_invoice", source_id=invoice_id)
            conn.execute("UPDATE sales_invoice_lines SET cost_base_minor=?,movement_id=? WHERE id=?", (mv["value_base"], mv["movement_id"], l["id"]))
            mids.append(mv["movement_id"])
        # ---- قيد المستند (بعملة المستند) + قيد التكلفة (أساسي)
        rev, tax = {}, {}
        for l in lines:
            if is_ret:
                pass
            else:
                _agg(rev, l["revenue_account_id"], l["gross_ex"])
            # ملاحظة: التجميع أعلاه بالحساب فقط؛ مركز التكلفة يُطبَّق أدناه لكل حساب فرعا من الفرع (الحد: مركز واحد لكل حساب إيراد)
            if l["tax_minor"]:
                t = conn.execute("SELECT account_id FROM tax_rates WHERE id=?", (l["tax_rate_id"],)).fetchone()
                if not t:
                    raise AccountingError("ضريبة بلا نسبة")
                _agg(tax, t[0], l["tax_minor"])
        jl = []
        if not is_ret:
            for p in pays:
                jl.append(_je_line(p["account_id"], cur, jrate, debit=p["amount_minor"]))
            if h["due_total"] > 0:
                jl.append(_je_line(cust["account_id"], cur, jrate, debit=h["due_total"]))
            if h["discount_ex_total"]:
                jl.append(_je_line(disc_acc, cur, jrate, debit=h["discount_ex_total"]))
            for a, v in rev.items():
                jl.append(_je_line(a, cur, jrate, credit=v, cost_center_id=default_cc))
            for a, v in tax.items():
                jl.append(_je_line(a, cur, jrate, credit=v))
            jl += inv.sale_cost_lines(conn, cid, mids) if mids else []
        else:
            jl.append(_je_line(ret_acc, cur, jrate, debit=h["gross_ex_total"], cost_center_id=default_cc))
            if h["discount_ex_total"]:
                jl.append(_je_line(disc_acc, cur, jrate, credit=h["discount_ex_total"]))
            for a, v in tax.items():
                jl.append(_je_line(a, cur, jrate, debit=v))
            for p in pays:
                jl.append(_je_line(p["account_id"], cur, jrate, credit=p["amount_minor"]))
            if h["due_total"] > 0:
                jl.append(_je_line(cust["account_id"], cur, jrate, credit=h["due_total"]))
            jl += inv.sale_return_cost_lines(conn, cid, mids) if mids else []
        eid = je.create_draft(conn, cid, actor_id, h["invoice_date"], jl,
                              ("مرتجع مبيعات" if is_ret else "فاتورة مبيعات") + f" رقم {invoice_id}", branch_id=h["branch_id"], entry_type="auto",
                              source_type="sales_invoice", source_id=invoice_id, trusted_rates=True)
        je.post(conn, eid, actor_id)
        if mids:
            inv.link_movements(conn, actor_id, cid, eid, mids)
        no = _keep_no or _next_number(conn, cid, h["doc_type"], per["yid"])
        conn.execute("UPDATE sales_invoices SET status='posted',invoice_no=?,journal_entry_id=?,exchange_rate=?,posted_by=?,posted_at=CURRENT_TIMESTAMP WHERE id=?",
                     (no, eid, str(rate), actor_id, invoice_id))
        audit.log(conn, actor_id, "post_invoice", "sales_invoices", invoice_id, after={"no": no, "entry": eid, "total": h["grand_total"]})
    return {"invoice_id": invoice_id, "invoice_no": no, "entry_id": eid, "movements": mids}


# ---------------- تعديل فاتورة مرحّلة ----------------
def edit_posted_invoice(conn, actor_id, invoice_id, invoice_date, lines, *, reason, customer_id=None, warehouse_id=None, currency=None,
                        discount_percent=None, discount_amount=None, payments=None, notes="", branch_id=None):
    """تعديل أصناف/كميات/أسعار/دفعات فاتورة مبيعات مرحّلة (خيار يفعّله مدير النظام من الإعدادات).
    في معاملة واحدة: عكس الحركات المخزنية القديمة + عكس القيد القديم بقيد عكسي، ثم إعادة الترحيل بالقيم الجديدة بنفس رقم الفاتورة.
    تبقى الآثار القديمة ظاهرة في الأستاذ (قيد عكسي) ويُسجَّل التعديل في sales_invoice_edits والتدقيق. أي فشل = Rollback كامل."""
    h = _load(conn, invoice_id)
    cid = h["company_id"]
    if not get_settings(conn, cid)["allow_edit_posted_invoice"]:
        raise AccountingError("تعديل الفاتورة المرحّلة غير مفعّل: يفعّله مدير النظام من الإعدادات")
    permissions.require(conn, actor_id, cid, "sales.edit_posted", h["branch_id"])
    for code in ("sales.create", "sales.post", "journal.reverse"):
        permissions.require(conn, actor_id, cid, code, h["branch_id"])
    if not reason or not reason.strip():
        raise AccountingError("تعديل فاتورة مرحّلة يتطلب ذكر السبب")
    if h["status"] != "posted" or h["doc_type"] != "invoice":
        raise AccountingError("تُعدَّل الفاتورة المرحّلة فقط (لا المرتجعات ولا الملغاة)")
    if conn.execute("SELECT 1 FROM sales_invoices WHERE original_invoice_id=? AND status='posted'", (invoice_id,)).fetchone():
        raise AccountingError("توجد مرتجعات فعّالة على هذه الفاتورة: ألغِها أولا ثم عدّل الفاتورة")
    if conn.execute("SELECT 1 FROM voucher_allocations va JOIN cash_vouchers cv ON cv.id=va.voucher_id WHERE va.doc_type='sales_invoice' "
                    "AND va.doc_id=? AND cv.status='posted'", (invoice_id,)).fetchone():
        raise AccountingError("الفاتورة مسدَّدة (كليا أو جزئيا) بسندات قبض مرحّلة: ألغِ السندات أولا ثم عدّل الفاتورة")
    old_lines = conn.execute("SELECT * FROM sales_invoice_lines WHERE invoice_id=? ORDER BY line_no", (invoice_id,)).fetchall()
    # تاريخ الحركات المخزنية: لا يسبق آخر حركة للصنف (المحرك لا يعيد احتساب التاريخ)؛ قيد الفاتورة يبقى بتاريخها
    mv_date = h["invoice_date"]
    for l in old_lines:
        if l["movement_id"]:
            m = conn.execute("SELECT item_id,warehouse_id FROM stock_movements WHERE id=?", (l["movement_id"],)).fetchone()
            last = conn.execute("SELECT MAX(movement_date) FROM stock_movements WHERE item_id=? AND warehouse_id=?", (m[0], m[1])).fetchone()[0]
            mv_date = max(mv_date, last or mv_date)
    for l in (lines or []):                     # أصناف جديدة قد تكون لها حركات لاحقة أيضا
        wid = warehouse_id if warehouse_id is not None else h["warehouse_id"]
        last = conn.execute("SELECT MAX(movement_date) FROM stock_movements WHERE item_id=? AND warehouse_id=?", (l.get("item_id"), wid)).fetchone()[0]
        mv_date = max(mv_date, last or mv_date)
    new_date = invoice_date or h["invoice_date"]
    with transaction(conn):
        old_entry = h["journal_entry_id"]
        for l in old_lines:
            if l["movement_id"]:
                permissions.require(conn, actor_id, cid, "inventory.adjust", check_branch=False)
                inv.void_movement(conn, actor_id, l["movement_id"], "تعديل فاتورة مرحّلة: " + reason, movement_date=mv_date, reverse_entry=False)
        rid = je.reverse(conn, old_entry, actor_id, max(h["invoice_date"], new_date), "تعديل فاتورة مرحّلة: " + reason)
        conn.execute("UPDATE doc_edit_guard SET active=1")
        try:
            conn.execute("UPDATE sales_invoices SET status='draft',journal_entry_id=NULL WHERE id=?", (invoice_id,))
            _write(conn, actor_id, cid, invoice_id, new_date, lines, customer_id if customer_id is not None else h["customer_id"],
                   warehouse_id if warehouse_id is not None else h["warehouse_id"], currency or h["currency"], discount_percent, discount_amount,
                   payments, notes if notes != "" else h["notes"], branch_id if branch_id is not None else h["branch_id"])
            res = post_invoice(conn, actor_id, invoice_id, _keep_no=h["invoice_no"], _mv_date=mv_date)
        finally:
            conn.execute("UPDATE doc_edit_guard SET active=0")
        new_total = conn.execute("SELECT grand_total FROM sales_invoices WHERE id=?", (invoice_id,)).fetchone()[0]
        conn.execute("INSERT INTO sales_invoice_edits(invoice_id,old_entry_id,reversal_entry_id,new_entry_id,old_total,new_total,reason,edited_by) VALUES(?,?,?,?,?,?,?,?)",
                     (invoice_id, old_entry, rid, res["entry_id"], h["grand_total"], new_total, reason, actor_id))
        audit.log(conn, actor_id, "edit_posted_invoice", "sales_invoices", invoice_id, {"total": h["grand_total"], "entry": old_entry},
                  {"total": new_total, "entry": res["entry_id"], "reversal": rid}, reason)
    return {"invoice_id": invoice_id, "invoice_no": h["invoice_no"], "old_entry_id": old_entry, "reversal_entry_id": rid,
            "entry_id": res["entry_id"], "movements": res["movements"]}


# ---------------- الإلغاء ----------------
def cancel_invoice(conn, actor_id, invoice_id, cancel_date, reason):
    h = _load(conn, invoice_id)
    cid = h["company_id"]
    permissions.require(conn, actor_id, cid, "sales.cancel", h["branch_id"])
    permissions.require(conn, actor_id, cid, "journal.reverse", h["branch_id"])
    if not reason or not reason.strip():
        raise AccountingError("الإلغاء يتطلب ذكر السبب")
    if h["status"] != "posted":
        raise AccountingError("يُلغى المستند المرحّل فقط")
    if h["doc_type"] == "invoice" and conn.execute(
            "SELECT 1 FROM sales_invoices WHERE original_invoice_id=? AND status='posted'", (invoice_id,)).fetchone():
        raise AccountingError("توجد مرتجعات فعّالة على هذه الفاتورة: ألغِها أولا")
    if cancel_date < h["invoice_date"]:
        raise AccountingError("تاريخ الإلغاء أقدم من تاريخ المستند")
    if conn.execute("SELECT 1 FROM sales_invoice_lines WHERE invoice_id=? AND movement_id IS NOT NULL", (invoice_id,)).fetchone():
        permissions.require(conn, actor_id, cid, "inventory.adjust", check_branch=False)      # عكس الحركات المخزنية
    with transaction(conn):
        for l in conn.execute("SELECT * FROM sales_invoice_lines WHERE invoice_id=? AND movement_id IS NOT NULL", (invoice_id,)).fetchall():
            inv.void_movement(conn, actor_id, l["movement_id"], reason, movement_date=cancel_date, reverse_entry=False)
        rid = je.reverse(conn, h["journal_entry_id"], actor_id, cancel_date, reason)
        conn.execute("UPDATE sales_invoices SET status='cancelled',cancelled_by=?,cancelled_at=CURRENT_TIMESTAMP,cancel_reason=?,cancel_entry_id=? WHERE id=?",
                     (actor_id, reason, rid, invoice_id))
        audit.log(conn, actor_id, "cancel_invoice", "sales_invoices", invoice_id, {"status": "posted"}, {"status": "cancelled", "reversal": rid}, reason)
    return {"invoice_id": invoice_id, "reversal_entry_id": rid}



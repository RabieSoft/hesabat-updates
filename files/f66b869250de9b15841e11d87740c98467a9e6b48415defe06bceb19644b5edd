"""المبيعات: الفاتورة مصدر تشغيلي، وترحيلها ينتج في معاملة واحدة: القيد المحاسبي (المبيعات/الخصم/الضريبة/الذمة أو الصندوق)،
الأثر المخزني (حركات بيع بتكلفتها)، وتكلفة المبيعات. المرتجع مرتبط بالفاتورة الأصلية بمبالغها وتكلفتها. الإلغاء بعكس كامل بسبب موثّق.
المبالغ بالوحدة الصغرى لعملة المستند؛ الكميات بالألف بوحدة البند؛ التكلفة دائما بالعملة الأساسية."""
from datetime import date as _date, timedelta
from decimal import Decimal, ROUND_HALF_UP
from alhisabat.accounting.errors import AccountingError
from alhisabat.accounting import balance_engine as be, journal_engine as je, period_engine, rates as fxr
from alhisabat.audit import audit
from alhisabat.business import branch_scope
from alhisabat.business import inventory as inv, parties as pt
from alhisabat.database.tx import transaction
from alhisabat.security import permissions

PREFIX = {"invoice": "INV", "return": "SRT", "purchase": "PUR", "purchase_return": "PRT", "receipt": "RCV", "payment": "PAY", "transfer": "TRF"}


def _r(x):
    return int(Decimal(x).quantize(Decimal(1), ROUND_HALF_UP))


def _u(minor):
    return Decimal(int(minor)) / 100


def _mapping(conn, company_id, key):
    r = conn.execute("SELECT account_id FROM account_mappings WHERE company_id=? AND map_key=?", (company_id, key)).fetchone()
    return r[0] if r else None


# ---------------- الإعدادات ----------------
def get_settings(conn, company_id):
    r = conn.execute("SELECT credit_limit_mode,allow_edit_posted_invoice,allow_negative_stock FROM sales_settings WHERE company_id=?", (company_id,)).fetchone()
    return {"credit_limit_mode": r[0] if r else "block", "allow_edit_posted_invoice": int(r[1]) if r else 0,
            "allow_negative_stock": int(r[2]) if r else 0}


def set_settings(conn, actor_id, company_id, *, credit_limit_mode=None, allow_edit_posted_invoice=None, allow_negative_stock=None):
    """None = بلا تغيير. حد الائتمان بصلاحية settings.manage؛ تفعيل/إلغاء تعديل الفاتورة المرحّلة بصلاحية sales.edit_posted؛
    وتفعيل/إلغاء البيع بالسالب بصلاحية stock.allow_negative (مدير النظام افتراضيًا)."""
    permissions.require(conn, actor_id, company_id, "settings.manage")
    old = get_settings(conn, company_id)
    new = dict(old)
    if credit_limit_mode is not None:
        if credit_limit_mode not in ("block", "warn", "off"):
            raise AccountingError("وضع الحد الائتماني غير معروف")
        new["credit_limit_mode"] = credit_limit_mode
    if allow_edit_posted_invoice is not None and int(bool(allow_edit_posted_invoice)) != old["allow_edit_posted_invoice"]:
        permissions.require(conn, actor_id, company_id, "sales.edit_posted", check_branch=False)
        new["allow_edit_posted_invoice"] = int(bool(allow_edit_posted_invoice))
    if allow_negative_stock is not None and int(bool(allow_negative_stock)) != old["allow_negative_stock"]:
        permissions.require(conn, actor_id, company_id, "stock.allow_negative", check_branch=False)
        new["allow_negative_stock"] = int(bool(allow_negative_stock))
    with transaction(conn):
        conn.execute("INSERT INTO sales_settings(company_id,credit_limit_mode,allow_edit_posted_invoice,allow_negative_stock) VALUES(?,?,?,?) "
                     "ON CONFLICT(company_id) DO UPDATE SET credit_limit_mode=excluded.credit_limit_mode,"
                     "allow_edit_posted_invoice=excluded.allow_edit_posted_invoice,allow_negative_stock=excluded.allow_negative_stock",
                     (company_id, new["credit_limit_mode"], new["allow_edit_posted_invoice"], new["allow_negative_stock"]))
        audit.log(conn, actor_id, "set_sales_settings", "sales_settings", company_id, old, new)


def _fixed_line_amount(ln, qty_milli, price):
    """إجمالي البند كما أدخله المستخدم (قبل الخصم والضريبة) بالوحدة الصغرى، أو None إن لم يُدخل.
    السعر يُحفظ بخانتين فقط، فقسمة الإجمالي على الكمية تُقرَّب وقد يختلف qty×price عن الإجمالي المكتوب بقرش أو أكثر.
    لذلك يُعتمد الإجمالي المُدخل نفسه، بشرط أن يتوافق مع qty×price ضمن أثر تقريب السعر فقط (نصف قرش للوحدة) وإلا يُرفض."""
    raw = ln.get("line_total")
    if raw is None or str(raw).strip() == "":
        return None
    amt = je._minor(raw)
    if amt < 0:
        raise AccountingError("إجمالي البند لا يقبل قيمة سالبة")
    calc = _r(Decimal(qty_milli) * price / 1000)
    if abs(amt - calc) > Decimal(qty_milli) / 2000 + 1:
        raise AccountingError("إجمالي البند لا يتوافق مع الكمية × السعر؛ صحّح السعر أو الإجمالي")
    return amt


# ---------------- الحساب ----------------
def compute_lines(prepped, inv_disc_type="none", inv_disc_value=0):
    """prepped: [{qty_milli, price, ldt, ldv, bps, incl}] → يضيف الحقول المحسوبة لكل بند ويرجع إجماليات المستند.
    ترتيب العمليات: مبلغ البند ← خصم البند ← توزيع خصم الفاتورة نسبيا ← الضريبة (شاملة/غير شاملة) على البند."""
    for l in prepped:
        amt = l["fixed_amount"] if l.get("fixed_amount") is not None else _r(Decimal(l["qty_milli"]) * l["price"] / 1000)
        ld = _r(Decimal(amt) * l["ldv"] / 10000) if l["ldt"] == "percent" else (l["ldv"] if l["ldt"] == "amount" else 0)
        if ld > amt:
            raise AccountingError("خصم البند يتجاوز مبلغه")
        l["amount"], l["ld"], l["base"] = amt, ld, amt - ld
    tot = sum(l["base"] for l in prepped)
    idisc = _r(Decimal(tot) * inv_disc_value / 10000) if inv_disc_type == "percent" else (inv_disc_value if inv_disc_type == "amount" else 0)
    if idisc > tot:
        raise AccountingError("خصم الفاتورة يتجاوز إجمالي البنود")
    shares = [(idisc * l["base"] // tot) if tot else 0 for l in prepped]
    rem = idisc - sum(shares)
    for i in sorted(range(len(prepped)), key=lambda k: (-prepped[k]["base"], k)):
        if rem <= 0:
            break
        shares[i] += 1; rem -= 1
    T = {"gross_ex": 0, "discount_ex": 0, "net_ex": 0, "tax": 0, "total": 0}
    for l, sh in zip(prepped, shares):
        after = l["base"] - sh
        bps = l["bps"]
        if l["incl"] and bps:
            total = after; tax = _r(Decimal(after) * bps / (10000 + bps)); net = total - tax
            disc_ex = _r(Decimal(l["ld"] + sh) * 10000 / (10000 + bps)); gross = net + disc_ex
        else:
            net = after; tax = _r(Decimal(after) * bps / 10000); total = net + tax; disc_ex = l["ld"] + sh; gross = l["amount"]
        l.update({"share": sh, "gross_ex": gross, "discount_ex": disc_ex, "net_ex": net, "tax": tax, "total": total})
        for k, v in (("gross_ex", gross), ("discount_ex", disc_ex), ("net_ex", net), ("tax", tax), ("total", total)):
            T[k] += v
    return T


def _pay_accounts_ok(conn, company_id, account_id):
    a = conn.execute("SELECT * FROM accounts WHERE id=?", (account_id,)).fetchone()
    if not a or a["company_id"] != company_id or a["is_group"] or not a["is_active"] or a["account_type"] != "asset":
        return False
    if conn.execute("SELECT 1 FROM cash_accounts WHERE account_id=? AND is_active=1", (account_id,)).fetchone():
        return True                                                    # صندوق/بنك مسجَّل
    for key in ("cash", "bank"):
        m = _mapping(conn, company_id, key)
        if m and account_id in be.subtree_ids(conn, m, include_merged=False):
            return True
    return False


def _prep_payments(conn, company_id, payments):
    out = []
    for p in payments or []:
        amt = je._minor(p["amount"])
        if amt <= 0:
            raise AccountingError("مبلغ الدفعة يجب أن يكون أكبر من صفر")
        if not _pay_accounts_ok(conn, company_id, p["account_id"]):
            raise AccountingError("حساب الدفع/الاسترداد يجب أن يكون صندوقا أو بنكا نشطا")
        out.append({"account_id": p["account_id"], "amount": amt, "note": p.get("note", "")})
    return out


def _prep_lines(conn, company_id, lines):
    if not lines:
        raise AccountingError("المستند يجب أن يحتوي بندا واحدا على الأقل")
    out = []
    for i, ln in enumerate(lines, 1):
        it = inv._item(conn, ln["item_id"], company_id)
        if not it["is_active"]:
            raise AccountingError(f"الصنف {it['code']} غير نشط")
        unit_id = ln.get("unit_id") or it["base_unit_id"]
        f = conn.execute("SELECT factor_milli FROM item_units WHERE item_id=? AND unit_id=?", (it["id"], unit_id)).fetchone()
        if not f:
            raise AccountingError("الوحدة غير معرّفة لهذا الصنف")
        try:
            q = _r(Decimal(str(ln["qty"])) * 1000)
        except Exception:
            raise AccountingError("كمية غير صالحة")
        if q <= 0:
            raise AccountingError("الكمية يجب أن تكون أكبر من صفر")
        price = je._minor(ln["unit_price"])
        if price < 0:
            raise AccountingError("السعر لا يقبل قيمة سالبة")
        dp, da = ln.get("discount_percent"), ln.get("discount_amount")
        if dp is not None and da is not None:
            raise AccountingError("خصم البند نسبة أو مبلغ وليس الاثنين")
        ldt, ldv = "none", 0
        if dp is not None:
            ldv = _r(Decimal(str(dp)) * 100); ldt = "percent"
            if not 0 <= ldv <= 10000:
                raise AccountingError("نسبة الخصم بين 0 و100")
        elif da is not None:
            ldv = je._minor(da); ldt = "amount"
            if ldv < 0:
                raise AccountingError("الخصم لا يقبل قيمة سالبة")
        tid, bps = ln.get("tax_rate_id"), 0
        if tid is not None:
            t = conn.execute("SELECT * FROM tax_rates WHERE id=?", (tid,)).fetchone()
            if not t or t["company_id"] != company_id or not t["is_active"] or t["kind"] != "output":
                raise AccountingError("نسبة الضريبة غير صالحة")
            bps = t["rate_bps"]
        rev = inv.item_accounts(conn, it["id"])["revenue"]
        if not rev:
            raise AccountingError("حساب الإيراد غير مربوط للصنف (Account Mapping)")
        out.append({"idx": i, "item": it, "unit_id": unit_id, "factor": f[0], "qty_milli": q, "price": price, "ldt": ldt, "ldv": ldv,
                    "fixed_amount": _fixed_line_amount(ln, q, price),
                    "tid": tid, "bps": bps, "incl": bool(ln.get("tax_inclusive")), "desc": ln.get("description", ""), "rev": rev})
    return out


def _disc(discount_percent, discount_amount):
    if discount_percent is not None and discount_amount is not None:
        raise AccountingError("خصم الفاتورة نسبة أو مبلغ وليس الاثنين")
    if discount_percent is not None:
        v = _r(Decimal(str(discount_percent)) * 100)
        if not 0 <= v <= 10000:
            raise AccountingError("نسبة الخصم بين 0 و100")
        return "percent", v
    if discount_amount is not None:
        v = je._minor(discount_amount)
        if v < 0:
            raise AccountingError("الخصم لا يقبل قيمة سالبة")
        return "amount", v
    return "none", 0


# ---------------- مسودة الفاتورة ----------------
def _write(conn, actor_id, company_id, invoice_id, invoice_date, lines, customer_id, warehouse_id, currency, dp, da, payments, notes, branch_id):
    try:
        _date.fromisoformat(invoice_date)
    except Exception:
        raise AccountingError("تاريخ غير صالح")
    base = fxr.base_currency(conn, company_id)
    currency = currency or base
    if currency != base and not fxr.currency_enabled(conn, company_id, currency):
        raise AccountingError(f"العملة {currency} غير مفعّلة")
    branch_id = branch_scope.resolve(conn, company_id, branch_id)
    branch_scope.check_party(conn, company_id, branch_id, customer_id)
    branch_scope.check_warehouse(conn, company_id, branch_id, warehouse_id)
    cust = None
    if customer_id is not None:
        cust = conn.execute("SELECT * FROM parties WHERE id=? AND company_id=? AND kind='customer'", (customer_id, company_id)).fetchone()
        if not cust:
            raise AccountingError("العميل غير موجود في هذه الشركة")
    prepped = _prep_lines(conn, company_id, lines)
    branch_scope.check_items(conn, company_id, branch_id, [l["item"]["id"] for l in prepped])
    if any(l["item"]["item_type"] == "stock" for l in prepped):
        if warehouse_id is None:
            raise AccountingError("المستودع مطلوب لبنود مخزنية")
        inv._wh(conn, warehouse_id, company_id)
    dt, dv = _disc(dp, da)
    T = compute_lines(prepped, dt, dv)
    pays = _prep_payments(conn, company_id, payments)
    paid = sum(p["amount"] for p in pays)
    if paid > T["total"]:
        raise AccountingError("مجموع الدفعات يتجاوز إجمالي المستند")
    due = T["total"] - paid
    if due > 0 and cust is None:
        raise AccountingError("البيع الآجل (المتبقي غير مدفوع) يتطلب عميلا")
    due_date = (_date.fromisoformat(invoice_date) + timedelta(days=cust["payment_terms_days"])).isoformat() if due > 0 and cust else None
    with transaction(conn):
        if invoice_id is None:
            invoice_id = conn.execute(
                "INSERT INTO sales_invoices(company_id,branch_id,warehouse_id,invoice_date,due_date,customer_id,currency,discount_type,discount_value,"
                "gross_ex_total,discount_ex_total,net_ex_total,tax_total,grand_total,paid_total,due_total,notes,created_by) "
                "VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (company_id, branch_id, warehouse_id, invoice_date, due_date, customer_id, currency, dt, dv, T["gross_ex"], T["discount_ex"],
                 T["net_ex"], T["tax"], T["total"], paid, due, notes or "", actor_id)).lastrowid
            audit.log(conn, actor_id, "create_invoice", "sales_invoices", invoice_id, after={"total": T["total"]})
        else:
            conn.execute("DELETE FROM sales_invoice_lines WHERE invoice_id=?", (invoice_id,))
            conn.execute("DELETE FROM invoice_payments WHERE invoice_id=?", (invoice_id,))
            conn.execute("UPDATE sales_invoices SET branch_id=?,warehouse_id=?,invoice_date=?,due_date=?,customer_id=?,currency=?,discount_type=?,"
                         "discount_value=?,gross_ex_total=?,discount_ex_total=?,net_ex_total=?,tax_total=?,grand_total=?,paid_total=?,due_total=?,notes=? "
                         "WHERE id=?", (branch_id, warehouse_id, invoice_date, due_date, customer_id, currency, dt, dv, T["gross_ex"], T["discount_ex"],
                                        T["net_ex"], T["tax"], T["total"], paid, due, notes or "", invoice_id))
            audit.log(conn, actor_id, "update_invoice", "sales_invoices", invoice_id, after={"total": T["total"]})
        for l in prepped:
            conn.execute(
                "INSERT INTO sales_invoice_lines(invoice_id,line_no,item_id,description,qty_milli,unit_id,factor_milli,unit_price_minor,line_discount_type,"
                "line_discount_value,tax_rate_id,tax_bps,tax_inclusive,amount_minor,line_discount_minor,invoice_discount_share,gross_ex,discount_ex,"
                "net_ex,tax_minor,total_minor,revenue_account_id) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (invoice_id, l["idx"], l["item"]["id"], l["desc"], l["qty_milli"], l["unit_id"], l["factor"], l["price"], l["ldt"], l["ldv"], l["tid"],
                 l["bps"], int(l["incl"]), l["amount"], l["ld"], l["share"], l["gross_ex"], l["discount_ex"], l["net_ex"], l["tax"], l["total"], l["rev"]))
        for p in pays:
            conn.execute("INSERT INTO invoice_payments(invoice_id,account_id,amount_minor,note) VALUES(?,?,?,?)", (invoice_id, p["account_id"], p["amount"], p["note"]))
    return invoice_id


def create_invoice(conn, actor_id, company_id, invoice_date, lines, *, customer_id=None, warehouse_id=None, currency=None,
                   discount_percent=None, discount_amount=None, payments=None, notes="", branch_id=None):
    branch_id = branch_scope.resolve_for_user(conn, company_id, actor_id, branch_id)
    permissions.require(conn, actor_id, company_id, "sales.create", branch_id)
    return _write(conn, actor_id, company_id, None, invoice_date, lines, customer_id, warehouse_id, currency, discount_percent,
                  discount_amount, payments, notes, branch_id)


def _load(conn, invoice_id):
    i = conn.execute("SELECT * FROM sales_invoices WHERE id=?", (invoice_id,)).fetchone()
    if not i:
        raise AccountingError("المستند غير موجود")
    return i


def update_invoice(conn, actor_id, invoice_id, invoice_date, lines, *, customer_id=None, warehouse_id=None, currency=None,
                   discount_percent=None, discount_amount=None, payments=None, notes="", branch_id=None):
    i = _load(conn, invoice_id)
    permissions.require(conn, actor_id, i["company_id"], "sales.create", i["branch_id"])
    if i["status"] != "draft" or i["doc_type"] != "invoice":
        raise AccountingError("يُعدَّل مسودة فاتورة فقط")
    if i["created_by"] != actor_id and not permissions.has(conn, actor_id, i["company_id"], "sales.cancel"):
        raise permissions.PermissionDenied("لا يمكنك تعديل مسودة مستخدم آخر")
    return _write(conn, actor_id, i["company_id"], invoice_id, invoice_date, lines, customer_id, warehouse_id, currency, discount_percent,
                  discount_amount, payments, notes, branch_id)


def delete_draft(conn, actor_id, invoice_id):
    i = _load(conn, invoice_id)
    permissions.require(conn, actor_id, i["company_id"], "sales.create", i["branch_id"])
    if i["status"] != "draft":
        raise AccountingError("لا يُحذف إلا المسودة")
    with transaction(conn):
        conn.execute("DELETE FROM sales_invoice_lines WHERE invoice_id=?", (invoice_id,))
        conn.execute("DELETE FROM invoice_payments WHERE invoice_id=?", (invoice_id,))
        conn.execute("DELETE FROM sales_invoices WHERE id=?", (invoice_id,))
        audit.log(conn, actor_id, "delete_invoice_draft", "sales_invoices", invoice_id, before={"total": i["grand_total"]})


# ---------------- المرتجع ----------------
def _returned_sums(conn, orig_line_id):
    r = conn.execute("SELECT COALESCE(SUM(l.qty_milli),0),COALESCE(SUM(l.gross_ex),0),COALESCE(SUM(l.discount_ex),0),COALESCE(SUM(l.tax_minor),0),"
                     "COALESCE(SUM(l.amount_minor),0),COALESCE(SUM(l.line_discount_minor),0),COALESCE(SUM(l.invoice_discount_share),0) "
                     "FROM sales_invoice_lines l JOIN sales_invoices h ON h.id=l.invoice_id WHERE l.orig_line_id=? AND h.status='posted' AND h.doc_type='return'",
                     (orig_line_id,)).fetchone()
    return tuple(r)


def create_return(conn, actor_id, original_invoice_id, return_date, lines, *, payments=None, notes="", dry_run=False):
    """مرتجع مرتبط بالفاتورة الأصلية: lines=[{orig_line_id, qty}]. المبالغ والضريبة والخصم نسبية من الأصل والباقي بلا بقايا تقريب.
    dry_run=True: يتحقق ويعيد إجمالي المرتجع (وحدة صغرى) دون كتابة شيء (لمعاينة النافذة)."""
    o = _load(conn, original_invoice_id)
    permissions.require(conn, actor_id, o["company_id"], "sales.create", o["branch_id"])
    if o["doc_type"] != "invoice" or o["status"] != "posted":
        raise AccountingError("المرتجع يرتبط بفاتورة مرحّلة وغير ملغاة")
    try:
        _date.fromisoformat(return_date)
    except Exception:
        raise AccountingError("تاريخ غير صالح")
    if return_date < o["invoice_date"]:
        raise AccountingError("تاريخ المرتجع أقدم من تاريخ الفاتورة")
    if not lines:
        raise AccountingError("المرتجع يحتاج بندا واحدا على الأقل")
    rows, T = [], {"gross": 0, "disc": 0, "tax": 0}
    seen = set()
    for i, ln in enumerate(lines, 1):
        ol = conn.execute("SELECT * FROM sales_invoice_lines WHERE id=? AND invoice_id=?", (ln["orig_line_id"], original_invoice_id)).fetchone()
        if not ol or ol["id"] in seen:
            raise AccountingError("بند أصلي غير صالح")
        seen.add(ol["id"])
        q = _r(Decimal(str(ln["qty"])) * 1000)
        if q <= 0:
            raise AccountingError("الكمية يجب أن تكون أكبر من صفر")
        rq, rg, rd, rt, ra, rld, rsh = _returned_sums(conn, ol["id"])
        if rq + q > ol["qty_milli"]:
            raise AccountingError("كمية المرتجع تتجاوز المتبقي من البند الأصلي")
        last = rq + q == ol["qty_milli"]

        def part(orig, done):
            return orig - done if last else _r(Decimal(orig) * q / ol["qty_milli"])
        g, d, t = part(ol["gross_ex"], rg), part(ol["discount_ex"], rd), part(ol["tax_minor"], rt)
        amt, ld, sh = part(ol["amount_minor"], ra), part(ol["line_discount_minor"], rld), part(ol["invoice_discount_share"], rsh)
        rows.append((i, ol, q, g, d, g - d, t, g - d + t, amt, ld, sh))
        T["gross"] += g; T["disc"] += d; T["tax"] += t
    total = T["gross"] - T["disc"] + T["tax"]
    if dry_run:
        return total
    pays = _prep_payments(conn, o["company_id"], payments)
    paid = sum(p["amount"] for p in pays)
    if paid > total:
        raise AccountingError("مجموع المبالغ المستردة يتجاوز إجمالي المرتجع")
    if o["customer_id"] is None and paid != total:
        raise AccountingError("مرتجع فاتورة نقدية بلا عميل يجب أن يُسترد كاملا (حدد حساب الصندوق/البنك)")
    with transaction(conn):
        rid = conn.execute(
            "INSERT INTO sales_invoices(company_id,branch_id,warehouse_id,doc_type,invoice_date,customer_id,currency,exchange_rate,gross_ex_total,"
            "discount_ex_total,net_ex_total,tax_total,grand_total,paid_total,due_total,original_invoice_id,notes,created_by) "
            "VALUES(?,?,?,'return',?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (o["company_id"], o["branch_id"], o["warehouse_id"], return_date, o["customer_id"], o["currency"], o["exchange_rate"], T["gross"], T["disc"],
             T["gross"] - T["disc"], T["tax"], total, paid, total - paid, original_invoice_id, notes or "", actor_id)).lastrowid
        for (i, ol, q, g, d, n, t, tot, amt, ld, sh) in rows:
            conn.execute(
                "INSERT INTO sales_invoice_lines(invoice_id,line_no,item_id,description,qty_milli,unit_id,factor_milli,unit_price_minor,line_discount_type,"
                "line_discount_value,tax_rate_id,tax_bps,tax_inclusive,amount_minor,line_discount_minor,invoice_discount_share,gross_ex,discount_ex,net_ex,"
                "tax_minor,total_minor,revenue_account_id,orig_line_id) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (rid, i, ol["item_id"], ol["description"], q, ol["unit_id"], ol["factor_milli"], ol["unit_price_minor"], ol["line_discount_type"],
                 ol["line_discount_value"], ol["tax_rate_id"], ol["tax_bps"], ol["tax_inclusive"], amt, ld, sh, g, d, n, t, tot, ol["revenue_account_id"], ol["id"]))
        for p in pays:
            conn.execute("INSERT INTO invoice_payments(invoice_id,account_id,amount_minor,note) VALUES(?,?,?,?)", (rid, p["account_id"], p["amount"], p["note"]))
        audit.log(conn, actor_id, "create_return", "sales_invoices", rid, after={"original": original_invoice_id, "total": total})
    return rid



# ---------------------------------------------------------------- القيود
def journal_totals(rows):
    """rows: [{'debit': نص/رقم, 'credit': نص/رقم, ...}] → (مدين, دائن, الفرق, متوازن).
    القيم غير الصالحة تُحسب صفرًا هنا (التحقق الكامل يجري في LinesEditor.validated والمحرك)."""
    d = c = Decimal(0)
    for r in rows:
        try:
            d += parse_money(r.get('debit'))
        except ValueError:
            pass
        try:
            c += parse_money(r.get('credit'))
        except ValueError:
            pass
    return d, c, d - c, (d > 0 and d == c)


def invoice_line_total(qty, price, discount_pct=0):
    """إجمالي بند فاتورة للعرض فقط (المحرك هو المرجع عند الحفظ: يضيف الضريبة والخصم العام)."""
    try:
        q, p, x = parse_money(qty), parse_money(price), parse_money(discount_pct)
    except ValueError:
        return Decimal(0)
    return (q * p * (Decimal(100) - x) / Decimal(100)).quantize(Decimal('0.01'))


# ---------------------------------------------------------------- الأخطاء
def _is_sqlite(e, name):
    return type(e).__module__ == 'sqlite3' and type(e).__name__ == name


def friendly_error(e):
    """رسالة عربية مفهومة لأي استثناء (الرسائل المحاسبية عربية أصلًا)."""
    from alhisabat.accounting.errors import AccountingError
    if isinstance(e, AccountingError):
        return str(e)
    if _is_sqlite(e, 'IntegrityError'):
        m = str(e)
        if 'UNIQUE' in m:
            return 'القيمة موجودة مسبقًا (تكرار غير مسموح).'
        if 'FOREIGN KEY' in m:
            return 'السجل مرتبط بسجلات أخرى ولا يمكن تنفيذ العملية عليه.'
        if 'CHECK' in m or 'trigger' in m.lower():
            return 'العملية مرفوضة لأنها تخالف قواعد سلامة البيانات.'
        return 'تعذر حفظ البيانات: ' + m
    if _is_sqlite(e, 'OperationalError'):
        if 'locked' in str(e).lower():
            return 'قاعدة البيانات مشغولة حاليًا. أعد المحاولة بعد لحظات.'
        return 'خطأ في قاعدة البيانات: ' + str(e)
    if isinstance(e, PermissionError):
        return 'ليست لديك صلاحية لتنفيذ هذه العملية.'
    if isinstance(e, ValueError):
        return str(e)
    if isinstance(e, (FileNotFoundError, OSError)):
        return 'تعذر الوصول إلى الملف: ' + str(e)
    return 'حدث خطأ غير متوقع: ' + (str(e) or e.__class__.__name__)


def cell_text(value, kind):
    """تنسيق خلية جدول حسب نوع العمود: text/int/minor/money/status/bool/qty/label:<group>."""
    if value is None:
        return ''
    if kind == 'minor':
        return fmt_money(value, minor=True)
    if kind == 'money':
        return fmt_money(value) if not isinstance(value, str) else value
    if kind == 'qty':
        return fmt_qty_milli(value)
    if kind == 'bool':
        return 'نعم' if value in (1, True, '1') else 'لا'
    if kind == 'status':
        return label('status', value)
    if kind.startswith('label:'):
        return label(kind.split(':', 1)[1], value)
    if kind == 'int':
        return str(value)
    return str(value)



# ---------------------------------------------------------------- الأرقام
_DIGITS = str.maketrans('٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹٫٬،', '01234567890123456789.,,')
_BIDI = dict.fromkeys(list(range(0x200E, 0x2010)) + list(range(0x202A, 0x202F)) + list(range(0x2066, 0x206A)))


def to_ascii_digits(s):
    """يحوّل الأرقام العربية/الفارسية وفواصلها إلى لاتينية."""
    return str(s).translate(_DIGITS)


def strip_bidi(s):
    return str(s).translate(_BIDI)


def parse_money(text, label='القيمة', allow_empty=True, allow_negative=False):
    """نص → Decimal. يقبل الأرقام العربية وفواصل الآلاف. يرفع ValueError برسالة عربية واضحة."""
    t = strip_bidi(to_ascii_digits(text or '')).replace(',', '').replace(' ', '').strip()
    if not t:
        if allow_empty:
            return Decimal(0)
        raise ValueError(f'{label}: أدخل قيمة.')
    try:
        v = Decimal(t)
    except InvalidOperation:
        raise ValueError(f'{label}: قيمة غير صالحة ({text}).')
    if not v.is_finite():
        raise ValueError(f'{label}: قيمة غير صالحة.')
    if v < 0 and not allow_negative:
        raise ValueError(f'{label}: لا تقبل قيمة سالبة.')
    return v


def fmt_money(v, minor=False, places=2):
    """يُنسّق مبلغًا بفواصل الآلاف. minor=True يعني أن القيمة بالوحدة الصغرى (1/100)."""
    if v is None or v == '':
        return '—'
    try:
        d = Decimal(str(v))
    except InvalidOperation:
        return str(v)
    if minor:
        d = d / 100
    q = Decimal(1).scaleb(-places)
    d = d.quantize(q)
    return f'{d:,.{places}f}'


def fmt_qty_milli(v):
    if v is None:
        return '—'
    d = Decimal(int(v)) / 1000
    s = f'{d:,.3f}'.rstrip('0').rstrip('.')
    return s or '0'


# ---------------------------------------------------------------- البحث العربي
_TASHKEEL = re.compile('[\u064B-\u0652\u0670\u0640]')


def normalize_ar(s):
    """توحيد النص للبحث: يتجاوز التشكيل والتطويل واختلاف الألف والتاء المربوطة والياء، والأرقام العربية."""
    t = strip_bidi(to_ascii_digits(s or '')).lower()
    t = _TASHKEEL.sub('', t)
    for a in 'أإآٱ':
        t = t.replace(a, 'ا')
    return t.replace('ى', 'ي').replace('ة', 'ه').replace('ؤ', 'و').replace('ئ', 'ي').strip()


def matches(query, *texts):
    """كل كلمات الاستعلام (مفصولة بمسافة) يجب أن تظهر في النص المجمَّع."""
    q = normalize_ar(query)
    if not q:
        return True
    hay = normalize_ar(' '.join(str(t) for t in texts if t is not None))
    return all(w in hay for w in q.split())


def relevance(query, title, *others):
    """درجة صلة نتيجة بحث (للترتيب): تطابق تام 100 > بداية العنوان 80 > بداية كلمة 60 > احتواء 40 > في حقل آخر 20 > 10."""
    q, t = normalize_ar(query), normalize_ar(title)
    if not q:
        return 0
    if t == q:
        return 100
    if t.startswith(q):
        return 80
    if any(w.startswith(q) for w in t.split()):
        return 60
    if q in t:
        return 40
    return 20 if any(q in normalize_ar(o) for o in others) else 10


def numeric_query(query):
    """استعلام رقمي صرف (يقبل الأرقام العربية والفواصل) → Decimal غير سالب، وإلا None."""
    t = to_ascii_digits(query).replace(',', '').replace(' ', '').strip()
    if not t:
        return None
    try:
        d = Decimal(t)
    except InvalidOperation:
        return None
    return d if d.is_finite() and d >= 0 else None


# ---------------------------------------------------------------- الفترات
PERIODS = ['كل الفترات', 'اليوم', 'هذا الشهر', 'الشهر الماضي', 'هذا العام']


def period_range(label, today=None):
    t = today or date.today()
    if label == 'اليوم':
        return t.isoformat(), t.isoformat()
    if label == 'هذا الشهر':
        a = t.replace(day=1)
        nxt = date(t.year + (t.month == 12), (t.month % 12) + 1, 1)
        return a.isoformat(), (nxt - timedelta(days=1)).isoformat()
    if label == 'الشهر الماضي':
        first = t.replace(day=1)
        last = first - timedelta(days=1)
        return last.replace(day=1).isoformat(), last.isoformat()
    if label == 'هذا العام':
        return date(t.year, 1, 1).isoformat(), date(t.year, 12, 31).isoformat()
    return None, None



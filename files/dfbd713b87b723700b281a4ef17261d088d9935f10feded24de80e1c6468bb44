"""محرك الضرائب المستقل: نسب بحساب محاسبي، وطريقة حساب (السعر شامل/غير شامل)، والإعفاء = بند بلا نسبة.
النسبة بالنقطة الأساسية (1500 = 15.00%). حساب الضريبة على مستوى البند بالتقريب لأقرب وحدة صغرى (HALF_UP)."""
from decimal import Decimal, ROUND_HALF_UP
from alhisabat.accounting.errors import AccountingError
from alhisabat.audit import audit
from alhisabat.database.tx import transaction
from alhisabat.security import permissions


def _r(x):
    return int(Decimal(x).quantize(Decimal(1), ROUND_HALF_UP))


def compute(amount_minor, rate_bps, inclusive=False):
    """يرجع (الصافي بدون ضريبة، الضريبة) لمبلغ. شامل: المبلغ يتضمن الضريبة."""
    if rate_bps == 0:
        return int(amount_minor), 0
    if inclusive:
        tax = _r(Decimal(amount_minor) * rate_bps / (10000 + rate_bps))
        return int(amount_minor) - tax, tax
    return int(amount_minor), _r(Decimal(amount_minor) * rate_bps / 10000)


def create_tax_rate(conn, actor_id, company_id, code, name, rate_percent, account_id, kind="output"):
    permissions.require(conn, actor_id, company_id, "tax.manage", check_branch=False)
    if kind not in ("output", "input"):
        raise AccountingError("نوع الضريبة غير معروف")
    bps = _r(Decimal(str(rate_percent)) * 100)
    if not (0 <= bps <= 10000):
        raise AccountingError("النسبة يجب أن تكون بين 0 و100%")
    a = conn.execute("SELECT * FROM accounts WHERE id=?", (account_id,)).fetchone()
    okt = ("liability",) if kind == "output" else ("asset", "liability")
    if not a or a["company_id"] != company_id or a["is_group"] or not a["is_active"] or a["account_type"] not in okt:
        raise AccountingError("حساب الضريبة غير صالح (حساب حركة نشط من النوع المناسب)")
    with transaction(conn):
        tid = conn.execute("INSERT INTO tax_rates(company_id,code,name,rate_bps,kind,account_id,created_by) VALUES(?,?,?,?,?,?,?)",
                           (company_id, (code or "").strip(), (name or "").strip(), bps, kind, account_id, actor_id)).lastrowid
        audit.log(conn, actor_id, "create_tax_rate", "tax_rates", tid, after={"code": code, "bps": bps})
    return tid


def set_tax_active(conn, actor_id, tax_id, active: bool):
    t = conn.execute("SELECT * FROM tax_rates WHERE id=?", (tax_id,)).fetchone()
    if not t:
        raise AccountingError("نسبة الضريبة غير موجودة")
    permissions.require(conn, actor_id, t["company_id"], "tax.manage", check_branch=False)
    with transaction(conn):
        conn.execute("UPDATE tax_rates SET is_active=? WHERE id=?", (int(active), tax_id))
        audit.log(conn, actor_id, "tax_active", "tax_rates", tax_id, after={"active": active})


def list_tax_rates(conn, user_id, company_id, kind=None, active_only=False):
    permissions.require(conn, user_id, company_id, "sales.view", check_branch=False)
    q, a = "SELECT * FROM tax_rates WHERE company_id=?", [company_id]
    if kind:
        q += " AND kind=?"; a.append(kind)
    if active_only:
        q += " AND is_active=1"
    return [dict(r) for r in conn.execute(q + " ORDER BY code", a)]

_BK_FILTER = 'نسخة احتياطية (*.zip *.db);;الكل (*.*)'


class BackupPage(BasePage):
    key='backup'; title='النسخ الاحتياطي'; icon='backup'; required_permission='backup.manage'
    def build(self):
        self.svc=SystemService(self.session); self._sel=None
        lay=QVBoxLayout(self); lay.setContentsMargins(6,6,6,6)
        from alhisabat.ui.components.backup_settings import BackupSettingsPanel
        self.settings_panel=None
        ab=getattr(self.window_,'auto_backup',None)
        if ab is not None:                                     # لا تنهار الصفحة إن غابت اللوحة؛ بقية الصفحة (القائمة والاستعادة) تعمل
            try:
                self.settings_panel=BackupSettingsPanel(ab, self.window_.prefs); lay.addWidget(self.settings_panel)
            except Exception as e: self.window_.log_error(str(e),'backup_panel')
        self.grid=DataGrid([Column('created_at','التاريخ',width=140), Column('reason','السبب',width=200), Column('size_bytes','الحجم (بايت)','int',110), Column('path','المسار',width=300)], grid_id='backups')
        self.grid.selectionChangedRows.connect(lambda rows: (setattr(self,'_sel', rows[0] if len(rows)==1 else None), self.actions_changed.emit()))
        lay.addWidget(self.grid,1)
    def _dir(self):
        from alhisabat.ui.core import backup_logic as BL
        return BL.load(self.window_.prefs)['dir']
    def refresh(self):
        if not getattr(self,'_built',False): return
        keep=self._sel['id'] if self._sel and 'id' in self._sel else None
        try: rows=self.svc.backups()
        except Exception as e: self.show_error(e); rows=[]
        self.grid.set_rows(rows)
        if self.settings_panel is not None: self.settings_panel.reload()
        if keep is not None: self.grid.select_where(lambda r: r.get('id')==keep)
        self.actions_changed.emit()
    def _state(self,k):
        if k in ('create','verify','now'): return self.access.state('backup.manage')
        if k=='restore': return self.access.state('backup.restore')
        return ActionState(True)
    def ribbon_groups(self):
        def a(k,lab,icon,**kw): return Action(k,lab,icon,state_fn=lambda kk=k: self._state(kk), handler=lambda kk=k: self.do(kk), **kw)
        return [ActionGroup('نسخ',[a('now','نسخ الآن إلى المجلد','new',primary=True), a('create','نسخة إلى مجلد آخر','new'), a('verify','التحقق من ملف','refresh'), a('restore','استعادة نسخة','delete',danger=True)]), ActionGroup('عرض',[Action('refresh','تحديث','refresh',handler=self.refresh)])]
    def do(self,k):
        st=self._state(k)
        if not st.enabled: return QMessageBox.information(self,self.title,st.reason)
        if k=='now':
            ab=getattr(self.window_,'auto_backup',None)
            if ab is None: return QMessageBox.information(self,self.title,'النسخ التلقائي غير متاح حاليًا.')
            if not self._dir():
                if not ab.choose_folder(self): return
                if self.settings_panel is not None: self.settings_panel.reload()
            return ab.run('manual', on_done=lambda _r: self.refresh(), on_error=self.show_error)
        if k=='create':
            d=QFileDialog.getExistingDirectory(self,'اختر مجلد حفظ النسخة (ملف مضغوط)', self._dir())
            if not d: return
            self.notify('جارٍ إنشاء النسخة الاحتياطية المضغوطة في الخلفية...')
            def _bg(s, ctx):
                from alhisabat.ui.core.system_service import SystemService
                return SystemService(s).create_zip_backup(d)
            def _done(r):
                self.refresh()
                self.notify('تم إنشاء النسخة الاحتياطية بنجاح: '+os.path.basename(r['path']))
                self.window_.data_changed(self.key)
            self.run_task(_bg, on_done=_done)
        if k=='verify':
            p,_=QFileDialog.getOpenFileName(self,'اختيار النسخة',self._dir(),_BK_FILTER)
            if not p: return
            try:
                v=self.svc.verify_backup(p)
                QMessageBox.information(self,'نتيجة التحقق','النسخة سليمة.' if v.get('integrity_ok') else 'النسخة غير سليمة — لا تعتمد عليها.')
            except Exception as e: self.show_error(e)
        if k=='restore':
            p,_=QFileDialog.getOpenFileName(self,'اختيار النسخة للاستعادة',self._dir(),_BK_FILTER)
            if not p: return
            if QMessageBox.question(self,'تأكيد الاستعادة','سيتم استبدال قاعدة البيانات الحالية بالنسخة المختارة (تُحفظ نسخة أمان قبل ذلك). هل أنت متأكد؟', QMessageBox.Yes|QMessageBox.No)!=QMessageBox.Yes: return
            try: self.svc.restore(p)
            except Exception as e: return self.show_error(e)
            r=QMessageBox.question(self,'تمت الاستعادة','تمت استعادة النسخة بنجاح. يلزم إعادة تشغيل البرنامج لتحميل البيانات المستعادة. هل تريد إعادة التشغيل الآن؟', QMessageBox.Yes|QMessageBox.No)
            if r==QMessageBox.Yes:
                self.window_.restart_requested=True
                if not self.window_.close(): self.window_.restart_requested=False


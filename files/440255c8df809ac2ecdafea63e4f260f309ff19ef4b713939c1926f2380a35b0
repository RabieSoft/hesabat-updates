class TaxesPage(BasePage):
    key='taxes'; title='الضرائب'; icon='percent'; required_permission='sales.view'
    def build(self):
        self.svc=SystemService(self.session); self._sel=None
        lay=QVBoxLayout(self); lay.setContentsMargins(6,6,6,6)
        self.grid=DataGrid([Column('code','الكود',width=80), Column('name','الاسم',width=200), Column('rate_bps','النسبة %',width=90), Column('account_id','الحساب',width=120), Column('is_active','نشط','status',70)], grid_id='taxes')
        self.grid.selectionChangedRows.connect(lambda rows: (setattr(self,'_sel', rows[0] if len(rows)==1 else None), self.actions_changed.emit()))
        lay.addWidget(self.grid,1)
    def refresh(self):
        if not getattr(self,'_built',False): return
        keep=self._sel['id'] if self._sel else None
        try: rows=self.svc.tax_rates()
        except Exception as e: self.show_error(e); rows=[]
        # تحويل rate_bps → نسبة
        for r in rows:
            try: r['rate_bps']=f"{Decimal(r.get('rate_bps') or 0)/100:.2f}"
            except Exception: pass
        self.grid.set_rows(rows)
        if keep is not None: self.grid.select_where(lambda r: r['id']==keep)
        self.actions_changed.emit()
    def _state(self,k):
        if k=='add': return self.access.state('tax.manage')
        if not self._sel: return ActionState(False,'حدد سطرًا')
        if k=='toggle': return self.access.state('tax.manage')
        return ActionState(True)
    def ribbon_groups(self):
        def a(k,lab,icon,**kw): return Action(k,lab,icon,state_fn=lambda kk=k: self._state(kk), handler=lambda kk=k: self.do(kk), **kw)
        return [ActionGroup('ضريبة',[a('add','+ نسبة ضريبة','new',primary=True), a('toggle','تفعيل/تعطيل','refresh')]), ActionGroup('عرض',[Action('refresh','تحديث','refresh',handler=self.refresh)])]
    def do(self,k):
        st=self._state(k)
        if not st.enabled: return QMessageBox.information(self,self.title,st.reason)
        if k=='add':
            from alhisabat.ui.app_dialogs.system import TaxDialog
            d=TaxDialog(self)
            if self.exec_form(d):
                ok,_=self.guarded(self.svc.create_tax, d.values(), reload=False)
                if ok: self.refresh(); self.window_.data_changed(self.key)
        if k=='toggle':
            ok,_=self.guarded(self.svc.set_tax_active, self._sel['id'], not bool(self._sel.get('is_active')), reload=False)
            if ok: self.refresh(); self.window_.data_changed(self.key)


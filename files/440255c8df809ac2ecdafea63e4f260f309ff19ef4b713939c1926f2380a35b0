class UsersPage(BasePage):
    key='users'; title='المستخدمون والصلاحيات'; icon='shield'; required_permission='user.manage'
    def build(self):
        self.svc=SystemService(self.session); self._sel=None
        lay=QVBoxLayout(self); lay.setContentsMargins(6,6,6,6)
        self.grid=DataGrid([Column('username','المستخدم',width=120), Column('full_name','الاسم الكامل',width=160), Column('roles','الأدوار',width=200), Column('is_active','نشط','status',70)], grid_id='users')
        self.grid.selectionChangedRows.connect(lambda rows: (setattr(self,'_sel', rows[0] if len(rows)==1 else None), self.actions_changed.emit()))
        lay.addWidget(self.grid,1)

    def refresh(self):
        if not getattr(self,'_built',False): return
        keep=self._sel['id'] if self._sel else None
        try: rows=self.svc.users()
        except Exception as e: self.show_error(e); rows=[]
        self.grid.set_rows(rows)
        if keep is not None: self.grid.select_where(lambda r: r['id']==keep)
        self.actions_changed.emit()

    def _state(self,k):
        if k in ('add','roles'): return self.access.state('user.manage')
        if not self._sel: return ActionState(False,'حدد مستخدمًا')
        return self.access.state('user.manage')

    def ribbon_groups(self):
        def a(k,lab,icon,**kw): return Action(k,lab,icon,state_fn=lambda kk=k: self._state(kk), handler=lambda kk=k: self.do(kk), **kw)
        return [
            ActionGroup('مستخدم',[
                a('add','+ مستخدم','new',primary=True),
                a('toggle','تفعيل/تعطيل','refresh'),
                a('edit_user','تعديل بيانات المستخدم','edit'),
                a('role','مجموعات صلاحيات المستخدم','edit'),
                a('restrict','تقييد النطاق','lock')
            ]),
            ActionGroup('الصلاحيات',[a('roles','إدارة مجموعات الصلاحيات','shield',primary=True)]),
            ActionGroup('عرض',[Action('refresh','تحديث','refresh',handler=self.refresh)])
        ]

    def do(self,k):
        st=self._state(k)
        if not st.enabled: return QMessageBox.information(self,self.title,st.reason)
        if k=='roles':
            from alhisabat.ui.app_dialogs.system import RolesManagerDialog
            self.exec_form(RolesManagerDialog(self))
            self.access.invalidate(); self.refresh(); self.window_.data_changed(self.key); return
        if k=='add':
            from alhisabat.ui.app_dialogs.system import UserDialog
            d=UserDialog(self)
            if self.exec_form(d):
                ok,_=self.guarded(self.svc.create_user, d.values(), reload=False)
                if ok: self.refresh(); self.window_.data_changed(self.key)
        if k=='toggle':
            ok,_=self.guarded(self.svc.set_user_active, self._sel['id'], not bool(self._sel.get('is_active')), reload=False)
            if ok: self.refresh(); self.window_.data_changed(self.key)
        if k=='edit_user':
            from alhisabat.ui.app_dialogs.system import UserEditDialog
            d=UserEditDialog(self, self._sel)
            if self.exec_form(d):
                uid=self._sel['id']
                ok,_=self.guarded(self.svc.update_user, uid, d.values(), reload=False)
                if ok:
                    self.notify('تم تعديل بيانات المستخدم'); self.refresh(); self.window_.data_changed(self.key)
        if k=='role':
            from alhisabat.ui.app_dialogs.system import RoleDialog
            try: cur=self.svc.user_role_ids(self._sel['id'])
            except Exception as exc: return self.show_error(exc)
            d=RoleDialog(self, cur)
            if self.exec_form(d):
                ok,_=self.guarded(self.svc.set_user_roles, self._sel['id'], d.values()['role_ids'], reload=False)
                if ok: self.notify('تم تحديث مجموعات المستخدم'); self.access.invalidate(); self.refresh(); self.window_.data_changed(self.key)
        if k=='restrict':
            from alhisabat.ui.app_dialogs.system import UserRestrictionDialog
            d=UserRestrictionDialog(self, self._sel)
            self.exec_form(d)


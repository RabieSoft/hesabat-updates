    def _is_vcf(self):
        return '(VCF)' in self.kind.currentText()

    def _apply_vcf_layout(self):
        """يُظهر أعمدة وخيارات تنظيف الهواتف فقط عند اختيار هدف VCF، ويخفي أعمدة الأصناف والأرصدة."""
        v = self._is_vcf()
        for w_ in self._vcf_widgets: w_.setVisible(v)
        self.btn_drop.setText('استبعاد الأسطر المحددة من التنظيف' if v else 'حذف الأسطر المحددة من المعاينة')
        vcf_cols = {'phone_old', 'phone_new', 'contact', 'match'}
        other_cols = {'code', 'unit', 'side', 'currency', 'amount', 'qty', 'purchase_price', 'sale_price', 'total_value', 'review', 'raw'}
        for i, c in enumerate(self.grid.columns):
            if c.key in vcf_cols: self.grid.table.setColumnHidden(i, not v)
            elif c.key in other_cols and v: self.grid.table.setColumnHidden(i, True)
            elif c.key in other_cols and not v: self.grid.table.setColumnHidden(i, False)

    def _vcf_opts(self):
        return {'default_cc': self.vcf_cc.text().strip() or '+967', 'normalize_existing': self.vcf_norm.isChecked(),
                'create_new': self.vcf_new.isChecked(), 'preview_branch_id': self.branch_cb.currentData(),
                'exclude_party_ids': sorted(self._vcf_excl_ids), 'exclude_new_names': sorted(self._vcf_excl_names)}

    def _on_kind_change(self):
        was_vcf_rows = getattr(self, '_rows_are_vcf', False)
        if self._rows and was_vcf_rows != self._is_vcf():      # صفوف جهات الاتصال لا تصلح لبقية الأهداف والعكس
            self._rows = None; self._details = {}; self.grid.set_rows([]); self.btn_commit.setEnabled(False)
            self._vcf_excl_ids.clear(); self._vcf_excl_names.clear()
            self.info.setText('اختر ملفًا مناسبًا لنوع البيانات المحدد.')
        self._apply_vcf_layout()
        if self._is_vcf(): self._doc_path = None            # هدف VCF لا يقرأ PDF/صور: لا نعيد قراءة مستند قديم
        is_opening = 'افتتاحية' in self.kind.currentText()
        self.fy_label.setVisible(is_opening)
        self.auto_parties.setVisible(is_opening)
        for w_ in self._cur_widgets: w_.setVisible(is_opening)
        self._sync_cur_widgets()
        self.fy_cb.setVisible(is_opening)
        is_item = IMPORT_TARGETS_ITEM == self.kind.currentText()
        self.unit_lbl.setVisible(is_item); self.unit_cb.setVisible(is_item); self.auto_units.setVisible(is_item)
        for w_ in (self.stock_chk, self.stock_wh, self.stock_lbl, self.stock_date): w_.setVisible(is_item)
        if self._doc_path and is_opening:
            self._rows = None; self._details = {}; self.grid.set_rows([]); self.btn_commit.setEnabled(False)
            self.doc_note.setText('قراءة PDF والصور لا تدعم الأرصدة الافتتاحية: استخدم ملف Excel أو CSV لها.'); self.doc_note.show()
        elif self._doc_path:
            self._read_doc(self._doc_path)        # نوع البيانات يغيّر قواعد التعرف: أعد القراءة
        elif self._rows:
            self.preview()

    def _sync_cur_widgets(self):
        """سعر الصرف يظهر فقط عند اختيار عملة أجنبية (غير الأساسية) لصفوف الأرصدة الافتتاحية."""
        code = self.cur_cb.currentData()
        show = (not self.cur_cb.isHidden()) and bool(code) and code != self._base_cur
        self.rate_lbl.setVisible(show); self.rate_edit.setVisible(show)
        if not show: self.rate_edit.clear()

    def _cur_args(self):
        """وسائط العملة للمحرك: لا شيء لغير الأرصدة الافتتاحية."""
        if self.cur_cb.isHidden(): return {}
        code = self.cur_cb.currentData()
        return {'currency': code, 'rate': (self.rate_edit.text().strip() or None) if code else None, 'force_currency': bool(code) and self.force_chk.isChecked()}

    def refresh(self): pass

    def _open_reconcile(self):
        from alhisabat.ui.app_dialogs.party_reconcile import PartyReconcileDialog
        PartyReconcileDialog(self).exec()

    def choose(self):
        p, _ = QFileDialog.getOpenFileName(self, 'اختيار ملف الاستيراد', '', 'ملفات الاستيراد (*.csv *.xlsx *.xlsm *.vcf *.pdf *.png *.jpg *.jpeg *.tif *.tiff *.bmp *.webp);;جهات اتصال أندرويد (*.vcf);;Excel (*.xlsx *.xlsm);;CSV (*.csv);;PDF (*.pdf);;صور (*.png *.jpg *.jpeg *.tif *.tiff *.bmp *.webp)')
        if not p: return
        p = p.strip().strip('"')
        self.path.setText(p)
        self._details = {}; self._doc_path = None; self.doc_note.hide()
        self._vcf_excl_ids.clear(); self._vcf_excl_names.clear()
        if self.svc.is_vcf(p):                           # بالامتداد أو بمحتوى BEGIN:VCARD (ملفات الهاتف المؤقتة قد تأتي باسم غريب)
            if not self._is_vcf():                       # ملف جهات اتصال: انتقل تلقائيًا إلى هدف تنظيف الهواتف (عملاء افتراضيًا)
                self.kind.blockSignals(True); self.kind.setCurrentText('تنظيف هواتف العملاء (VCF)'); self.kind.blockSignals(False)
                self._apply_vcf_layout()
            try:
                self._rows = self.svc.read_vcf(p); self._rows_are_vcf = True
                self.doc_note.setText(f'تمت قراءة {len(self._rows)} جهة اتصال من الملف. تُطابَق بأسماء أطراف النظام وتُقترح أرقام نظيفة بصيغة دولية (+967…). لا يُكتب شيء قبل «اعتماد».'); self.doc_note.show()
                self.preview()
            except Exception as e:
                self._rows = None; self.show_error(e)
            return
        if self._is_vcf():
            return QMessageBox.warning(self, self.title, f'هذا الهدف يقرأ ملفات جهات الاتصال (.vcf) فقط، وهذا الملف ليس منها (الامتداد: «{os.path.splitext(p)[1] or "بلا امتداد"}»). اختر نوع بيانات آخر لهذا الملف.')
        self._rows_are_vcf = False
        if p.lower().endswith(('.csv', '.xlsx', '.xlsm', '.xls')):
            try:
                self._rows = self.svc.read_csv(p)
                self.preview()
            except Exception as e:
                self.show_error(e)
        else:
            self._doc_path = p
            self._read_doc(p)

    def _read_doc(self, p):
        """قراءة PDF/صورة في الخلفية (OCR قد يستغرق ثوانيَ)، ثم المعاينة عبر محرك الاستيراد نفسه."""
        kind_txt, unit = self.kind.currentText(), self.unit_cb.currentText()
        self.notify('جارٍ قراءة المستند والتعرف على الأسطر...')
        def _bg(s, ctx):
            from alhisabat.ui.core.system_service import SystemService
            return SystemService(s).read_document(p, kind_txt, unit)
        def _done(res):
            self._rows = res['rows']
            self._details = {i: d for i, d in enumerate(res['details'], 1)}
            notes = [f"المصدر: {res['source']} — تم التعرف على {len(res['rows'])} سطر. راجع الأسطر المعلَّمة «يحتاج مراجعة» واحذف ما لا يصلح قبل الاعتماد."]
            notes += res['warnings']
            self.doc_note.setText('\n'.join(notes)); self.doc_note.show()
            self.preview()
        def _err(e):
            self._rows = None; self.grid.set_rows([]); self.btn_commit.setEnabled(False); self.show_error(e)
        self.run_task(_bg, on_done=_done, on_error=_err)

    def drop_selected(self):
        """يحذف الأسطر المحددة (ضجيج أو قراءة خاطئة) من الصفوف قبل الاعتماد؛ لا شيء يُكتب في قاعدة البيانات هنا."""
        sel = {r['row_no'] for r in self.grid.selected_rows()}
        if not sel or not self._rows: return
        if self._is_vcf():                            # استبعاد صفوف من التنظيف (مطابقة خاطئة مثلًا) دون المساس بجهات الاتصال المقروءة
            for rn in sel:
                kind_, key_ = self._vcf_pid.get(rn, (None, None))
                if kind_ == 'party': self._vcf_excl_ids.add(key_)
                elif kind_ == 'new': self._vcf_excl_names.add(key_)
            return self.preview()
        keep = [(r, self._details.get(i)) for i, r in enumerate(self._rows, 1) if i not in sel]
        self._rows = [r for r, _d in keep]
        self._details = {i: d for i, (_r, d) in enumerate(keep, 1) if d}
        if not self._rows:
            self.grid.set_rows([]); self.btn_commit.setEnabled(False); self.info.setText('حُذفت كل الأسطر.')
            self.actions_changed.emit(); return
        self.preview()

    def preview(self):
        if not self._rows: return
        try:
            res = self.svc.import_preview(self._rows, self.kind.currentText(), auto_create_units=self.auto_units.isChecked(), auto_create_parties=self.auto_parties.isChecked(),
                                          fiscal_year_id=(self.fy_cb.currentData() if self.fy_cb.isVisible() else None), vcf_opts=(self._vcf_opts() if self._is_vcf() else None), **(self._cur_args() if not self._is_vcf() else {}))
        except Exception as e:
            return self.show_error(e)
        rows = []
        self._vcf_pid = {}
        for r in res.get('rows', []):
            d = r.get('data') or {}
            if self._is_vcf():
                self._vcf_pid[r['row_no']] = ('party', d['party_id']) if d.get('party_id') else ('new', d.get('name'))
                rows.append({'id': r['row_no'], 'row_no': r['row_no'], 'status': r['status'], 'name': d.get('name') or '',
                             'phone_old': d.get('phone_old') or '', 'phone_new': d.get('phone_new') or '', 'contact': d.get('contact') or '',
                             'match': d.get('match') or '', 'errors': '، '.join((r.get('errors') or []) + (r.get('notes') or []))})
                continue
            label = d.get('name') or d.get('code') or ''
            rows.append({
                'id': r['row_no'],
                'row_no': r['row_no'],
                'status': r['status'],
                'name': label,
                'code': d.get('code') or '',
                'unit': d.get('new_unit') or d.get('unit') or '',
                'side': {'credit': 'دائن', 'debit': 'مدين'}.get(d.get('side') or '', ''), 'currency': d.get('currency') or '', 'amount': d.get('amount'),
                'qty': d.get('qty'), 'purchase_price': d.get('purchase_price'), 'sale_price': d.get('sale_price') or d.get('price'),
                'total_value': d.get('total_value'),
                'review': ('يحتاج مراجعة' if (self._details.get(r['row_no']) or {}).get('review') else ('' if not self._details else 'مطمئن')),
                'raw': (self._details.get(r['row_no']) or {}).get('raw', ''),
                'errors': '، '.join((r.get('errors') or []) + (r.get('notes') or []) + list((self._details.get(r['row_no']) or {}).get('notes') or []))
            })
        self.grid.set_rows(rows)
        counts = {}
        for r in res.get('rows', []):
            st = r['status']
            counts[st] = counts.get(st, 0) + 1
        valid_cnt = counts.get('valid', 0)
        names = {'valid': 'صالح', 'invalid': 'غير صالح', 'duplicate_in_file': 'مكرر في الملف', 'duplicate': 'مكرر', 'exists': 'موجود مسبقًا', 'duplicate_existing': 'له رصيد افتتاحي قائم',
                 'unchanged': 'بلا تغيير', 'not_found': 'لا جهة مطابقة', 'review': 'يحتاج مراجعة'}
        self._valid_rows = [r for r in res.get('rows', []) if r['status'] == 'valid']
        self.info.setText(' | '.join(f"{names.get(k, k)}: {v}" for k, v in counts.items()))
        self.btn_commit.setEnabled(valid_cnt > 0)
        self.btn_drop.setEnabled(bool(res.get('rows')))
        self.actions_changed.emit()

    def _state(self, k):
        if k == 'commit': return ActionState(bool(self._rows and self.btn_commit.isEnabled()), 'تحقق من الملف أولاً')
        return ActionState(True)

    def ribbon_groups(self):
        def a(k, lab, icon, **kw): return Action(k, lab, icon, state_fn=lambda kk=k: self._state(kk), handler=lambda kk=k: self.do(kk), **kw)
        return [ActionGroup('استيراد', [Action('choose', 'اختيار ملف (Excel/CSV/PDF/صورة/VCF)', 'new', handler=self.choose), a('commit', 'اعتماد الصفوف الصالحة', 'post', primary=True)])]

    def do(self, k):
        if k == 'commit':
            if not self._rows: return QMessageBox.information(self, self.title, 'اختر ملفًا أولًا.')
            msg = 'ستُدخل الصفوف الصالحة فقط. هل تريد المتابعة؟'
            if (not self.cur_cb.isHidden()) and getattr(self, '_valid_rows', None):
                tot = {}
                for r_ in self._valid_rows:
                    d_ = r_.get('data') or {}
                    try: tot[d_.get('currency') or ''] = tot.get(d_.get('currency') or '', Decimal(0)) + Decimal(d_.get('amount') or 0)
                    except Exception: pass
                msg = f"سيُستورد {len(self._valid_rows)} رصيدًا افتتاحيًا:\n" + '\n'.join(f"  {c}: {v:,.2f}" for c, v in sorted(tot.items())) + "\n\nهل تريد المتابعة؟"
            if self._is_vcf() and getattr(self, '_valid_rows', None) is not None:
                n_new = sum(1 for r_ in self._valid_rows if (r_.get('data') or {}).get('action') == 'create')
                msg = f"سيُحدَّث هاتف {len(self._valid_rows) - n_new} طرفًا" + (f" وسيُنشأ {n_new} طرفًا جديدًا" if n_new else '') + " بالأرقام النظيفة المعروضة.\nالصفوف غير الصالحة أو «بلا تغيير» أو «يحتاج مراجعة» لا تُمَس.\n\nهل تريد المتابعة؟"
            if QMessageBox.question(self, 'اعتماد الاستيراد', msg, QMessageBox.Yes | QMessageBox.No) != QMessageBox.Yes: return
            cur_args = self._cur_args()
            rows_to_import = list(self._rows); auto_units = self.auto_units.isChecked()
            opening = None
            if self.stock_chk.isChecked() and self.stock_chk.isVisible():
                if self.stock_wh.currentData() is None: return QMessageBox.warning(self, self.title, 'اختر المستودع أولًا (أو ألغِ حفظ الكميات).')
                opening = {'warehouse_id': self.stock_wh.currentData(), 'date': self.stock_date.date().toString('yyyy-MM-dd')}
            kind_txt = self.kind.currentText()
            fy_id = self.fy_cb.currentData() if self.fy_cb.isVisible() else None
            branch_id = self.branch_cb.currentData(); auto_parties = self.auto_parties.isChecked()
            vcf_opts = self._vcf_opts() if self._is_vcf() else None
            if self._is_vcf(): cur_args = {}
            self.notify('جارٍ استيراد البيانات في الخلفية...')
            def _bg(s, ctx):
                from alhisabat.ui.core.system_service import SystemService
                return SystemService(s).import_commit(rows_to_import, kind_txt, fiscal_year_id=fy_id, auto_create_units=auto_units, opening_stock=opening, branch_id=branch_id, auto_create_parties=auto_parties, vcf_opts=vcf_opts, **cur_args)
            def _done(r):
                self._rows = None; self._details = {}; self._doc_path = None; self._rows_are_vcf = False
                self._vcf_excl_ids.clear(); self._vcf_excl_names.clear()
                self.btn_commit.setEnabled(False); self.btn_drop.setEnabled(False)
                self.notify(f"تم استيراد {r.get('imported', 0)} سجل بنجاح، وتخطي {r.get('skipped', 0)}" + (f"، وأُنشئ {r['parties_created']} طرف جديد" if r.get('parties_created') else "") + (f"، وأُدخل رصيد افتتاحي لـ {len(r['stock_in'])} صنف" + (f" (بلا رصيد لعدم توفر تكلفة/كمية موجبة: {len(r.get('stock_skipped') or [])})" if r.get('stock_skipped') else "") if r.get('stock_in') is not None and (r.get('stock_in') or r.get('stock_skipped')) else ""))
                self.grid.set_rows([])
                self.info.setText('اكتمل الاستيراد بنجاح.')
                self.actions_changed.emit()
                self.window_.data_changed(self.key)
            self.run_task(_bg, on_done=_done)



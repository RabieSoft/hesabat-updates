def repolish(w):
    w.style().unpolish(w)
    w.style().polish(w)


class StatusBadge(QLabel):
    """شارة حالة بدلالة لونية ثابتة (مسودة/مراجعة/معتمد/مرحّل/ملغى...). النص يحمل المعنى مع اللون."""

    def __init__(self, status=None, workflow_state=None, parent=None):
        super().__init__(parent)
        self.setProperty('badge', True)
        self.setAlignment(Qt.AlignCenter)
        self.set_status(status, workflow_state)

    def set_status(self, status, workflow_state=None):
        code = T.workflow_badge(status, workflow_state)
        self.setText(T.status_label(code))
        self.setProperty('tone', T.status_tone(code))
        repolish(self)


class KpiCard(QFrame):

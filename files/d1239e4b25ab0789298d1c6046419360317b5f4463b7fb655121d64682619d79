class ConfirmDangerDialog(QDialog):
    """تأكيد الإجراءات الحرجة: يعرض الأثر المتوقع ويطلب سببًا نصيًا حين يشترطه المحرك.
    زر التأكيد معطّل حتى يُكتب السبب (إن كان إلزاميًا). يستعمل: dlg.reason() بعد exec()."""

    def __init__(self, parent, title, impact_lines, need_reason=True, confirm_text='تأكيد', danger=True):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(460)
        lay = QVBoxLayout(self)
        h = QLabel(title)
        h.setObjectName('panelTitle')
        lay.addWidget(h)
        for line in impact_lines:
            lb = QLabel('• ' + line)
            lb.setWordWrap(True)
            lay.addWidget(lb)
        self._need = need_reason
        self._reason = QPlainTextEdit()
        self._reason.setFixedHeight(70)
        if need_reason:
            lay.addWidget(QLabel(S.GENERIC['reason_required']))
            lay.addWidget(self._reason)
            self._reason.textChanged.connect(self._sync)
        bb = QDialogButtonBox()
        self._ok = bb.addButton(confirm_text, QDialogButtonBox.AcceptRole)
        self._ok.setProperty('danger' if danger else 'primary', True)
        cancel = bb.addButton(S.ACTION['cancel'], QDialogButtonBox.RejectRole)
        cancel.setDefault(True)
        bb.accepted.connect(self.accept)
        bb.rejected.connect(self.reject)
        lay.addWidget(bb)
        self._sync()

    def _sync(self):
        self._ok.setEnabled(not self._need or bool(self._reason.toPlainText().strip()))

    def reason(self):
        return self._reason.toPlainText().strip()


def ask_reason(parent, title, impact_lines=(), need_reason=True, confirm_text='تأكيد', danger=True):
    """نافذة تأكيد + سبب: تُرجع النص (قد يكون '') أو None عند الإلغاء."""
    dlg = ConfirmDangerDialog(parent, title, list(impact_lines), need_reason, confirm_text, danger)
    return dlg.reason() if dlg.exec() == QDialog.Accepted else None


def make_resizable(dlg, width=None, height=None, min_size=(420, 300)):
    """يجعل النافذة قابلة للتكبير والتصغير بالسحب من الحواف/المقبض السفلي، وزر التكبير في شريط العنوان (ونقر مزدوج عليه).
    يُستدعى في __init__ قبل العرض. لا يغيّر ترتيب المكوّنات: تتمدد بحسب الـlayout."""
    dlg.setWindowFlag(Qt.WindowMaximizeButtonHint, True)
    dlg.setWindowFlag(Qt.WindowContextHelpButtonHint, False)
    dlg.setSizeGripEnabled(True)
    if min_size:
        dlg.setMinimumSize(*min_size)
    if width and height:
        dlg.resize(width, height)
    return dlg



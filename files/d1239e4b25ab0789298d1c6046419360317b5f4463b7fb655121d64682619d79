class MoneyEdit(QLineEdit):
    """حقل مبلغ بـDecimal: يقبل الأرقام العربية والفواصل، يتحقق لحظيًا، ويُنسّق عند فقد التركيز."""
    valueChanged = Signal(object)

    def __init__(self, currency='', allow_negative=False, places=2, parent=None):
        super().__init__(parent)
        self.currency, self.allow_negative, self.places = currency, allow_negative, places
        self.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self.setLayoutDirection(Qt.LeftToRight)
        self.setPlaceholderText('0.00')
        self.setValidator(QRegularExpressionValidator(QRegularExpression(r'[-0-9٠-٩,٬.٫ ]*')))
        self.textChanged.connect(self._changed)

    def value(self):
        """Decimal أو None إن كان الحقل فارغًا/غير صالح."""
        try:
            t = self.text().strip()
            return None if not t else fmt.parse_money(t, allow_negative=self.allow_negative)
        except ValueError:
            return None

    def set_value(self, v):
        self.setText('' if v is None else fmt.fmt_money(v, self.places).replace('(', '-').replace(')', '').replace(',', ''))

    def _changed(self, _t):
        v = self.value()
        bad = bool(self.text().strip()) and v is None
        self.setProperty('invalid', bad)
        repolish(self)
        self.setToolTip('قيمة غير صالحة' if bad else '')
        self.valueChanged.emit(v)

    def focusOutEvent(self, e):
        v = self.value()
        if v is not None:
            self.blockSignals(True)
            self.set_value(v)
            self.blockSignals(False)
        super().focusOutEvent(e)


class DateField(QDateEdit):
    """حقل تاريخ يحترم حدود السنة والفترة: خارج [min,max] يُرفض، والفترة المقفلة تُفسَّر في التلميح."""
    dateIso = Signal(str)

    def __init__(self, start=None, end=None, closed_reason_fn=None, parent=None):
        super().__init__(parent)
        self.setCalendarPopup(True)
        self.setDisplayFormat('yyyy-MM-dd')
        self.setLayoutDirection(Qt.LeftToRight)
        self._reason_fn = closed_reason_fn      # دالة (iso) → سبب إغلاق أو ''
        self.set_bounds(start, end)
        self.setDate(QDate.currentDate())
        self.dateChanged.connect(self._on_change)

    def set_bounds(self, start, end):
        if start:
            self.setMinimumDate(QDate.fromString(str(start), 'yyyy-MM-dd'))
        if end:
            self.setMaximumDate(QDate.fromString(str(end), 'yyyy-MM-dd'))

    def iso(self):
        return self.date().toString('yyyy-MM-dd')

    def set_iso(self, iso):
        self.setDate(QDate.fromString(str(iso)[:10], 'yyyy-MM-dd'))

    def _on_change(self, _d):
        why = self._reason_fn(self.iso()) if self._reason_fn else ''
        self.setProperty('invalid', bool(why))
        repolish(self)
        self.setToolTip(why)
        self.dateIso.emit(self.iso())


class CurrencyRateField(QWidget):
    """سعر الصرف: يعرض السعر ومصدره، والتجاوز مقفل إلا بصلاحية currency.override_rate ويُحذَّر منه."""
    changed = Signal()

    def __init__(self, can_override, parent=None):
        super().__init__(parent)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        self.edit = MoneyEdit(places=8)
        self.edit.setReadOnly(True)
        self.note = QLabel('')
        self.note.setObjectName('ctxKey')
        lay.addWidget(self.edit)
        lay.addWidget(self.note, 1)
        self._can = can_override
        self.edit.valueChanged.connect(lambda _v: self.changed.emit())

    def set_rate(self, rate, source=''):
        self.edit.set_value(rate)
        self.note.setText(source or 'من جدول أسعار الصرف')
        self.edit.setReadOnly(not self._can)
        self.edit.setToolTip('' if self._can else 'تعديل السعر يتطلب صلاحية «تجاوز سعر الصرف»')

    def missing(self, currency, date_iso):
        self.edit.set_value(None)
        self.note.setText(f'لا يوجد سعر للعملة {currency} بتاريخ {date_iso}: أضفه من «العملات وأسعار الصرف»')
        self.edit.setReadOnly(True)

    def value(self):
        return self.edit.value()



def label(code):
    return PERMISSION_LABELS.get(code, code)


@dataclass(frozen=True)
class ActionState:
    """حالة زر/إجراء: visible=False يخفيه، enabled=False يعطّله و`reason` يظهر في التلميح."""
    enabled: bool = True
    reason: str = ''
    visible: bool = True

    def __bool__(self):
        return self.enabled


ALLOWED = ActionState(True, '')


class Access:
    """غلاف صلاحيات فوق دالة `can(code) -> bool` (مثل AppSession.can). يخزّن النتائج مؤقتًا حتى `invalidate()`."""

    def __init__(self, can):
        self._can = can
        self._cache = {}

    def invalidate(self):
        self._cache.clear()

    def has(self, code):
        if not code:
            return True
        if code not in self._cache:
            self._cache[code] = bool(self._can(code))
        return self._cache[code]

    def any_of(self, *codes):
        return any(self.has(c) for c in codes)

    def all_of(self, *codes):
        return all(self.has(c) for c in codes)

    def state(self, perm=None, *checks, read_only_reason='', hide_if_denied=False):
        """يحسب ActionState: الصلاحية أولًا، ثم وضع القراءة فقط، ثم الشروط بالترتيب؛ أول فشل يحدد السبب.

        checks: أزواج (ok: bool, reason: str).
        """
        if perm and not self.has(perm):
            return ActionState(False, f'تتطلب صلاحية «{label(perm)}»', visible=not hide_if_denied)
        if read_only_reason:
            return ActionState(False, read_only_reason)
        for ok, why in checks:
            if not ok:
                return ActionState(False, why)
        return ALLOWED


def deny_all(reason='غير متاح'):
    return ActionState(False, reason)

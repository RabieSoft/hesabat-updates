WHEN NEW.branch_id IS NOT NULL
 AND EXISTS(SELECT 1 FROM cash_accounts c WHERE c.id=NEW.cash_account_id AND c.branch_id IS NOT NULL AND c.branch_id<>NEW.branch_id)
BEGIN SELECT RAISE(ABORT,'الصندوق/البنك يتبع فرعًا آخر غير فرع السند'); END;

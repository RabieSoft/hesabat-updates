    # ------------------------------------------------------------------ التحميل
    def refresh(self):
        if not getattr(self, '_built', False): return
        want, prm = self._id, getattr(self, 'params', None)
        if isinstance(prm, dict): want = prm.get('item_id') or prm.get('id') or want
        elif isinstance(prm, int): want = prm
        self.params = None
        try: self._items = self.svc.items(limit=5000)
        except Exception as exc:
            self.show_error(exc); self._items = []
        self._loading = True
        try:
            self.pick.clear()
            for r in self._items:
                self.pick.addItem(f"{r.get('code', '')} — {r.get('name', '')}" + ('' if r.get('is_active') else ' (معطّل)'), r['id'])
            keep = self.cur.currentData()
            self.cur.clear()
            try: curs = self.svc.enabled_currencies()
            except Exception: curs = []
            for c in curs: self.cur.addItem(f"{c['code']} — {c.get('name_ar') or ''}".strip(' —'), '' if c.get('is_base') else c['code'])
            self.cur.setCurrentIndex(max(self.cur.findData(keep), 0))
        finally:
            self._loading = False
        if want is None and self._items: want = self._items[0]['id']
        self._load(want)

    def _load(self, item_id):
        if self._loading or not getattr(self, '_built', False): return
        if item_id is None or not any(r['id'] == item_id for r in self._items):
            self._id, self._info = None, None; self._render(None); return
        try:
            self._cur, self._rate = self.svc.currency_view(self.cur.currentData() or None)
        except Exception as exc:
            self._cur, self._rate = '', Decimal(1)
            self.cur.setCurrentIndex(0); self.notify(f'تعذّر عرض العملة المختارة: {exc}')
        try:
            self._info = self.svc.item_info(item_id); self._id = item_id
            self._moves = self.svc.item_movements(item_id)
            self._buys = self.svc.item_invoice_history(item_id, 'purchases')
            self._sells = self.svc.item_invoice_history(item_id, 'sales')
        except Exception as exc:
            self.show_error(exc); self._info = None
        self._render(self._info)

    def _money(self, minor, places=2):
        return fmt.fmt_money(_d(minor, self._rate), places=places)

    def _render(self, i):
        for v in self.f.values(): v.setText('—')
        if not i:
            self.h_name.setText('اختر صنفًا' if self._items else 'لا توجد أصناف بعد'); self.h_sub.setText(''); self.h_state.setText('')
            for g in (self.g_moves, self.g_buy, self.g_sell, self.g_prices, self.g_wh, self.g_br, self.g_units, self.g_bar): g.set_rows([])
            self.actions_changed.emit(); return
        cur = self._cur or self._base
        if not self._base:
            try: self._base = self.svc.currency_view(None)[0]
            except Exception: self._base = ''
            cur = self._cur or self._base
        sfx = f' {cur}' if cur else ''
        self.pick.blockSignals(True); self.pick.setCurrentIndex(max(self.pick.findData(i['id']), 0)); self.pick.blockSignals(False)
        self.h_name.setText(i['name'])
        self.h_sub.setText(f"{i['code']}  ·  {i['category'] or 'بلا مجموعة'}  ·  {'خدمة' if i['kind'] == 'service' else 'مخزون'}")
        self.h_state.setText('● نشط' if i['is_active'] else '● معطّل')
        pal = T.palette(self.state.get('mode'))
        self.h_state.setStyleSheet('font-weight: bold; color: %s;' % pal['success' if i['is_active'] else 'danger'])
        service = i['kind'] == 'service'
        qty_t = fmt.fmt_qty(i['qty_milli']) + f" {i['unit']}"
        low = (not service) and i['min_qty_milli'] > 0 and i['qty_milli'] <= i['min_qty_milli']
        mg = i['margin_pct']
        f = self.f
        f['name'].setText(i['name']); f['name_en'].setText(i['name_en'] or '—'); f['code'].setText(i['code']); f['category'].setText(i['category'] or '—')
        f['brand'].setText(i['brand'] or '—'); f['unit'].setText(i['unit']); f['barcode'].setText(i['barcode'] or '—'); f['notes'].setText(i['notes'] or '—')
        f['avg_cost'].setText('—' if service else self._money(i['avg_cost']) + sfx)
        lp, ls = i['last_purchase'], i['last_sale']
        f['last_purchase'].setText(self._money(lp['price_base']) + sfx if lp else '—'); f['last_purchase'].setToolTip(self._price_text(lp, sfx) if lp else '')
        f['supplier'].setText(i['supplier'] or '—')
        f['sale_price'].setText(self._money(i['sale_price']) + sfx + ('' if i['sale_price_minor'] else '  (آخر سعر بيع)') if i['sale_price'] else '—')
        f['last_sale'].setText(self._money(ls['price_base']) + sfx if ls else '—'); f['last_sale'].setToolTip(self._price_text(ls, sfx) if ls else '')
        f['margin'].setText('—' if mg is None else f"{mg:.2f}%"); f['margin'].setToolTip(f"ربح الوحدة: {self._money(i['sale_price'] - i['avg_cost'])}{sfx}")
        f['cost_method'].setText(S.COST_METHOD_LABELS.get(i['cost_method'] or 'avg', S.COST_METHOD_LABELS['avg']))
        f['qty'].setText('—' if service else qty_t); f['qty'].setStyleSheet('color: %s; font-weight: bold;' % pal['danger'] if low else '')
        f['min_qty'].setText(fmt.fmt_qty(i['min_qty_milli']) + f" {i['unit']}" if i['min_qty_milli'] else 'غير محددة')
        f['reorder'].setText('خدمة — بلا رصيد' if service else ('⚠ عند/تحت نقطة إعادة الطلب' if low else ('نفد' if i['qty_milli'] <= 0 else 'كافٍ')))
        f['expiry'].setText(('أقرب انتهاء: ' + fmt.fmt_date(i['next_expiry']) if i['next_expiry'] else 'يتتبّع الصلاحية — لا دفعات') if i['track_expiry']
                            else 'لا يتتبّع الصلاحية')
        yc, yp = i['years'][i['year']], i['years'][i['year'] - 1]
        for pre, y in (('y_cur', yc), ('y_prev', yp)):
            f[pre + '_in'].setText(fmt.fmt_qty(y['in_qty']) + f" {i['unit']}"); f[pre + '_in'].setToolTip(f"القيمة: {self._money(y['in_value'])}{sfx}")
            f[pre + '_out'].setText(fmt.fmt_qty(y['out_qty']) + f" {i['unit']}"); f[pre + '_out'].setToolTip(f"القيمة: {self._money(y['out_value'])}{sfx}")
        big = max((u for u in i['units'] if not u['is_base']), key=lambda u: u['factor_milli'], default=None)
        fm = big['factor_milli'] if big else 1000
        bn = big['name'] if big else i['unit']
        whole, rem = divmod(i['qty_milli'], fm)
        f['bu_name'].setText(bn); f['bu_factor'].setText(f"{fmt.fmt_qty(fm)} {i['unit']}")
        f['bu_buy'].setText(self._money(lp['price_base'] * fm / 1000) + sfx if lp else '—')
        f['bu_cost'].setText('—' if service else self._money(i['avg_cost'] * fm / 1000) + sfx)
        f['bu_sale'].setText(self._money(i['sale_price'] * fm / 1000) + sfx if i['sale_price'] else '—')
        f['bu_qty'].setText('—' if service else (f"{whole:,} {bn}" + (f" و {fmt.fmt_qty(rem)} {i['unit']}" if rem and big else '')))
        self.tabs.setTabText(2, 'حركة بيع الصنف'); self._fill_grids(i)
        self.actions_changed.emit()

    def _price_text(self, p, sfx):
        t = f"{self._money(p['price_base'])}{sfx}  ·  {fmt.fmt_date(p['date'])}"
        if p.get('party'): t += f"  ·  {p['party']}"
        return t

    def _fill_grids(self, i):
        r = self._rate
        self.g_moves.set_rows([{**m, 'type': MOVE_LABELS.get(m['movement_type'], m['movement_type']), 'dir': 'وارد' if m['direction'] == 'in' else 'صادر',
                                'value': _d(m['value_base'], r)} for m in self._moves])

        def inv_rows(rows):
            return [{'date': h['date'], 'invoice_no': h['invoice_no'] or ('مسودة' if h['status'] == 'draft' else ''),
                     'doc': 'مرتجع' if h['doc_type'] == 'return' else 'فاتورة', 'party': h['party'] or '—', 'qty_milli': h['qty_milli'],
                     'unit': h['unit'] or i['unit'], 'price': _d(h['base_price'] * h['factor_milli'] / 1000, r), 'currency': self._cur or self._base,
                     'total': _d(int(Decimal(h['total'] or 0) * Decimal(str(h['rate'] or 1))), r)} for h in rows]
        self.g_buy.set_rows(inv_rows(self._buys)); self.g_sell.set_rows(inv_rows(self._sells))
        pr = [{'date': h['date'], 'kind': 'شراء', 'party': h['party'] or '—', 'unit': h['unit'] or i['unit'], 'price': _d(h['price'], 1),
               'currency': h['currency'], 'invoice_no': h['invoice_no'] or ''} for h in self._buys if h['doc_type'] == 'invoice']
        pr += [{'date': h['date'], 'kind': 'بيع', 'party': h['party'] or '—', 'unit': h['unit'] or i['unit'], 'price': _d(h['price'], 1),
                'currency': h['currency'], 'invoice_no': h['invoice_no'] or ''} for h in self._sells if h['doc_type'] == 'invoice']
        self.g_prices.set_rows(sorted(pr, key=lambda x: x['date'], reverse=True))
        self.g_wh.set_rows([{**w, 'avg': _d(w['avg_cost'], r), 'value': _d(w['value_base'], r)} for w in i['warehouses']])
        self.g_br.set_rows([{**b, 'avg': _d(b['avg_cost'], r), 'value': _d(b['value_base'], r)} for b in i['branches']])
        self.g_units.set_rows([{**u, 'factor': u['factor_milli'], 'kind': 'أساسية' if u['is_base'] else 'تحويل'} for u in i['units']])
        self.g_bar.set_rows(i['barcodes'])

    # ------------------------------------------------------------------ التنقل
    def _on_pick(self, idx):
        self._load(self.pick.itemData(idx))

    def _step(self, d):
        ids = [r['id'] for r in self._items]
        if not ids: return
        n = (ids.index(self._id) + d) % len(ids) if self._id in ids else 0
        self._load(ids[n])

    def _on_barcode(self):
        code = self.barcode.text().strip()
        if not code: return
        try: iid = self.svc.item_find_barcode(code)
        except Exception as exc: return self.show_error(exc)
        self.barcode.selectAll()
        if iid is None: return QMessageBox.information(self, self.title, f'لا يوجد صنف بالباركود «{code}».')
        if not any(r['id'] == iid for r in self._items): return QMessageBox.information(self, self.title, 'الصنف ليس ضمن الفرع الحالي.')
        self._load(iid)

    # ------------------------------------------------------------------ الإجراءات
    def _row(self):
        return next((r for r in self._items if r['id'] == self._id), None)

    def _state(self, k):
        if not self._info: return ActionState(False, 'اختر صنفًا أولًا')
        if k in ('edit', 'extras', 'units', 'add_bar', 'toggle'): return self.access.state('inventory.manage')
        if k == 'rm_bar':
            if not self._bar_sel or self._bar_sel.get('primary'): return ActionState(False, 'حدّد باركودًا إضافيًا (الأساسي يُعدَّل من «تعديل الصنف»)')
            return self.access.state('inventory.manage')
        return ActionState(True)

    def ribbon_groups(self):
        def a(k, lab, icon, **kw):
            return Action(k, lab, icon, state_fn=lambda kk=k: self._state(kk), handler=lambda kk=k: self.do(kk), **kw)
        return [
            ActionGroup('الصنف', [a('edit', 'تعديل الصنف', 'edit', primary=True), a('extras', 'بيانات إضافية وسعر البيع', 'edit'),
                                  a('units', 'وحدات التحويل', 'link'), a('toggle', 'تفعيل/تعطيل', 'refresh')]),
            ActionGroup('الباركودات', [a('add_bar', '+ باركود', 'new'), a('rm_bar', 'حذف الباركود', 'delete', danger=True)]),
            ActionGroup('تقارير', [a('card', 'كارت الصنف (حركات)', 'history'), a('print', 'طباعة بطاقة الصنف', 'print')]),
            ActionGroup('عرض', [Action('refresh', 'تحديث', 'refresh', handler=self.refresh)]),
        ]

    def _after(self):
        self.window_.data_changed(self.key); self.refresh()

    def do(self, k):
        st = self._state(k)
        if not st.enabled: return QMessageBox.information(self, self.title, st.reason)
        row, i = self._row(), self._info
        if k == 'edit':
            from alhisabat.ui.app_dialogs.inventory import ItemDialog
            d = ItemDialog(self, row)
            if self.exec_form(d):
                ok, _ = self.guarded(self.svc.edit_item, i['id'], d.values(), reload=False)
                if ok: self._after()
        elif k == 'extras':
            from alhisabat.ui.app_dialogs.item_info import ItemExtrasDialog
            d = ItemExtrasDialog(self, i, self._base)
            if self.exec_form(d):
                ok, _ = self.guarded(self.svc.item_update_extras, i['id'], reload=False, **d.values())
                if ok: self._after()
        elif k == 'units':
            from alhisabat.ui.app_dialogs.catalog import ItemUnitsDialog
            ItemUnitsDialog(self, row).exec(); self._load(self._id)
        elif k == 'toggle':
            from alhisabat.ui.components.basic import ask_reason
            verb = 'تعطيل' if i['is_active'] else 'تفعيل'
            if ask_reason(self, verb, [f"هل تريد {verb} «{i['name']}»؟"], need_reason=False, confirm_text=verb) is None: return
            ok, _ = self.guarded(self.svc.set_item_active, i['id'], not i['is_active'], reload=False)
            if ok: self._after()
        elif k == 'add_bar':
            from alhisabat.ui.app_dialogs.item_info import BarcodeDialog
            d = BarcodeDialog(self, i)
            if self.exec_form(d):
                ok, _ = self.guarded(self.svc.item_add_barcode, i['id'], d.code.text(), d.unit.currentData(), d.note.text(), reload=False)
                if ok: self._load(self._id)
        elif k == 'rm_bar':
            if QMessageBox.question(self, self.title, f"حذف الباركود «{self._bar_sel['barcode']}»؟") != QMessageBox.Yes: return
            ok, _ = self.guarded(self.svc.item_remove_barcode, self._bar_sel['id'], reload=False)
            if ok: self._load(self._id)
        elif k == 'card':
            from alhisabat.ui.app_dialogs.inventory import ItemCardDialog
            ItemCardDialog(self, row).exec()
        elif k == 'print':
            self._print()

    def _print(self):
        from alhisabat.ui.components import print_service as PS
        i, sfx = self._info, f' {self._cur or self._base}'.rstrip()
        extra = [('رقم الصنف', i['code']), ('الصنف', i['name']), ('الاسم الأجنبي', i['name_en'] or '—'), ('المجموعة', i['category'] or '—'),
                 ('الماركة', i['brand'] or '—'), ('الوحدة', i['unit']), ('الباركود', i['barcode'] or '—'),
                 ('الرصيد', fmt.fmt_qty(i['qty_milli']) + ' ' + i['unit']), ('متوسط التكلفة', self._money(i['avg_cost']) + sfx),
                 ('سعر البيع', self._money(i['sale_price']) + sfx if i['sale_price'] else '—'),
                 ('هامش الربح', '—' if i['margin_pct'] is None else f"{i['margin_pct']:.2f}%"),
                 ('آخر مورد', i['supplier'] or '—')]
        cols = [{'key': 'wh', 'label': 'المستودع'}, {'key': 'qty', 'label': 'الكمية', 'numeric': True},
                {'key': 'avg', 'label': 'متوسط التكلفة', 'numeric': True}, {'key': 'value', 'label': 'القيمة', 'numeric': True}]
        rows = [{'wh': w['warehouse'], 'qty': Decimal(w['qty_milli']) / 1000, 'avg': _d(w['avg_cost'], self._rate), 'value': _d(w['value_base'], self._rate)}
                for w in i['warehouses']]
        spec = {'title': 'بطاقة معلومات الصنف', 'company': self.state.get('company', {}).get('name', ''), 'currency': self._cur or self._base,
                'extra': extra, 'columns': cols, 'rows': rows, 'totals': [{'label': 'إجمالي القيمة', 'value': sum((r['value'] for r in rows), Decimal(0))}]}
        try: PS.print_dialog(self, DM.from_print_spec(spec, 'report'), self.window_.prefs.get('paper') or 'A4')
        except Exception as exc: self.show_error(exc)

def _style(pal):
    return (f"QLabel#infoLabel {{ background: {pal['nav_bg']}; color: {pal['nav_text']}; border-radius: 5px; padding: 4px 8px; font-weight: bold; }}"
            f"QLabel#infoValue {{ background: palette(base); border: 1px solid {pal['border_strong']}; border-radius: 5px; padding: 4px 10px; }}"
            f"QFrame#infoPanel {{ border: 1px solid {pal['border']}; border-radius: 8px; background: {pal['surface2']}; }}"
            f"QLabel#photoBox {{ border: 1px dashed {pal['border_strong']}; border-radius: 6px; color: {pal['muted']}; background: palette(base); }}"
            f"QPushButton#miniEdit {{ padding: 2px 6px; border-radius: 5px; background: {pal['accent_soft']}; color: {pal['accent_soft_text']}; }}"
            f"QPushButton#miniEdit:hover {{ background: {pal['accent']}; color: {pal['accent_text']}; }}")


def _d(minor, rate):
    """مبلغ بوحدة صغرى بالعملة الأساسية ← Decimal بعملة العرض."""
    return (Decimal(int(minor or 0)) / 100 / rate) if rate else Decimal(0)



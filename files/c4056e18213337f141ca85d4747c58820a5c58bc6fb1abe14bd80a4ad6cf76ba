_BADGE_TMPL = 'QLabel[tone="@tone@"] { background: @@tone@_soft@; color: @@tone@@; border: 1px solid @@tone@@; }'


def build_qss(mode='light', density='compact'):
    p = T.palette(mode)
    pt = T.FONT_PT.get(density, T.FONT_PT['compact'])
    ctx = dict(p)
    ctx.update({f'brand_{k}': v for k, v in T.BRAND.items()})
    ctx.update({
        'font': T.FONT_STACK, 'pt': pt, 'pt_small': max(pt - 1, 8), 'pt_large': pt + 3, 'pt_kpi': pt + 7,
        'mono': T.MONO_STACK, 'radius': T.RADIUS, 'field_h': T.ROW_HEIGHT.get(density, 24) - 6,
        'ctl_h': T.CONTROL_H, 'btn_w': T.BUTTON_MIN_W,
    })
    badges = '\n'.join(_fill(_BADGE_TMPL, {'tone': t, **p}) for t in T.TONES)
    ctx['badges'] = badges
    _a = arrow_urls(p['muted'])                    # أسهم أزرار شريط التمرير العمودي بلون النص الثانوي
    ctx['arrow_up'], ctx['arrow_down'] = _a['up'], _a['down']
    return _fill(_TEMPLATE, ctx)


def _fill(text, ctx):
    # استبدال متكرر: القوالب الداخلية مثل @@tone@_soft@ تُحل على مرحلتين
    def sub(m):
        k = m.group(1)
        if k not in ctx:
            raise KeyError(f'رمز غير معرّف في QSS: {k}')
        return str(ctx[k])
    prev = None
    out = text
    for _ in range(3):
        out = re.sub(r'@([a-z_0-9]+)@', sub, out)
        if out == prev:
            break
        prev = out
    return out


def unresolved(qss):
    """أي @رمز@ متبقٍ = خطأ في القالب (يستعمله الاختبار)."""
    return re.findall(r'@[a-zA-Z_0-9]+@', qss)

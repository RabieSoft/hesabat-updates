def get_entry(conn, user_id, entry_id):
    e = _entry(conn, entry_id)
    permissions.require(conn, user_id, e["company_id"], "journal.view", e["branch_id"])
    lines = [dict(r) for r in conn.execute(
        "SELECT l.*,a.code account_code,a.name account_name FROM journal_lines l JOIN accounts a ON a.id=l.account_id "
        "WHERE l.entry_id=? ORDER BY l.line_no", (entry_id,))]
    return {**dict(e), "lines": lines}


def list_entries(conn, user_id, company_id, *, status=None, workflow_state=None, date_from=None, date_to=None,
                 source_type=None, limit=50, offset=0, branch_id=None, currency=None, no_from=None, no_to=None, text=None):
    permissions.require(conn, user_id, company_id, "journal.view", check_branch=False)   # التصفية بالفروع أدناه
    q, args = "SELECT * FROM journal_entries WHERE company_id=?", [company_id]
    # بحث برقم القيد (الرقم الظاهر = رقم الترحيل إن وُجد وإلا رقم المسودة): من/إلى، وبالنص في البيان أو بيان أي سطر — قراءة فقط
    if no_from is not None:
        q += " AND COALESCE(posted_no, entry_no)>=?"; args.append(int(no_from))
    if no_to is not None:
        q += " AND COALESCE(posted_no, entry_no)<=?"; args.append(int(no_to))
    if text and str(text).strip():
        like = "%" + str(text).strip().replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"
        q += (" AND (description LIKE ? ESCAPE '\\' OR EXISTS(SELECT 1 FROM journal_lines jm WHERE jm.entry_id=journal_entries.id"
              " AND jm.memo LIKE ? ESCAPE '\\'))")
        args += [like, like]
    if currency:                                           # القيود التي فيها سطر بهذه العملة
        q += " AND EXISTS(SELECT 1 FROM journal_lines jl WHERE jl.entry_id=journal_entries.id AND jl.currency=?)"
        args.append(str(currency).strip().upper())
    for col, val, op in (("status", status, "="), ("workflow_state", workflow_state, "="), ("entry_date", date_from, ">="),
                         ("entry_date", date_to, "<="), ("source_type", source_type, "=")):
        if val is not None:
            q += f" AND {col}{op}?"; args.append(val)
    restricted = conn.execute("SELECT branch_id FROM user_branch_access WHERE user_id=?", (user_id,)).fetchall()
    if restricted:
        q += " AND branch_id IN (%s)" % ",".join("?" * len(restricted)); args += [r[0] for r in restricted]
    f, fa = branch_scope.txn_clause(conn, company_id, branch_id)
    q += f; args += fa
    q += " ORDER BY entry_date DESC,id DESC LIMIT ? OFFSET ?"
    return [dict(r) for r in conn.execute(q, (*args, min(int(limit), 500), int(offset)))]


def account_balance_base(conn, account_id):
    """رصيد بالعملة الأساسية (مدين - دائن) من القيود المرحّلة/المعكوسة فقط. مؤقت حتى Gate 05."""
    r = conn.execute(
        "SELECT COALESCE(SUM(l.debit_base),0)-COALESCE(SUM(l.credit_base),0) FROM journal_lines l "
        "JOIN journal_entries e ON e.id=l.entry_id WHERE l.account_id=? AND e.status IN ('posted','reversed')",
        (account_id,)).fetchone()
    return r[0]

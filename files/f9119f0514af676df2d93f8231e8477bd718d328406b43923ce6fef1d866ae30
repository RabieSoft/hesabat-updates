"""مسح شجرة المشروع وحساب بصمات الملفات (SHA-256). يستعمله build.py (نسخة الأساس) وأداة النشر (نسخة التحديث)
فتكون المقارنة بينهما على نفس المجموعة من الملفات."""
import hashlib
import re
import uuid
from pathlib import Path

INCLUDE = ('alhisabat', 'migrations')
EXCLUDE_DIRS = {'__pycache__', 'tests', '.git'}
EXCLUDE_FILES = {'baseline.json'}
EXTS = {'.py', '.sql', '.png', '.ico', '.svg', '.json', '.qm', '.ttf', '.otf'}


def sha256_bytes(data):
    return hashlib.sha256(data).hexdigest()


def scan_tree(root):
    """{'alhisabat/ui/x.py': {'sha256':..., 'size':...}} لكل ملف مؤهل."""
    root, out = Path(root), {}
    for top in INCLUDE:
        base = root / top
        if not base.is_dir():
            continue
        for p in sorted(base.rglob('*')):
            if not p.is_file() or p.suffix.lower() not in EXTS or p.name in EXCLUDE_FILES:
                continue
            if EXCLUDE_DIRS & set(p.relative_to(root).parts):
                continue
            data = p.read_bytes()
            out[p.relative_to(root).as_posix()] = {'sha256': sha256_bytes(data), 'size': len(data)}
    return out


def source_version(root):
    text = (Path(root) / 'alhisabat' / 'ui' / 'shell' / 'main_window.py').read_text(encoding='utf-8')
    m = re.search(r"^VERSION\s*=\s*['\"]([\d.]+)['\"]", text, re.M)
    if not m:
        raise RuntimeError('تعذّر قراءة VERSION من main_window.py')
    return m.group(1)


def vtuple(v):
    try:
        return tuple(int(x) for x in str(v).strip().split('.'))
    except ValueError:
        return (0,)


def write_baseline(root):
    """يُستدعى من build.py قبل البناء: بصمات ما سيُدمج في exe + معرّف بناء فريد."""
    import json
    data = {'version': source_version(root), 'build_id': uuid.uuid4().hex, 'files': scan_tree(root)}
    (Path(root) / 'alhisabat' / 'updater' / 'baseline.json').write_text(json.dumps(data, ensure_ascii=False), encoding='utf-8')
    return data

ALTER TABLE items ADD COLUMN name_en TEXT NOT NULL DEFAULT '';
ALTER TABLE items ADD COLUMN brand TEXT NOT NULL DEFAULT '';
ALTER TABLE items ADD COLUMN sale_price_minor INTEGER NOT NULL DEFAULT 0 CHECK(sale_price_minor>=0);   -- بالعملة الأساسية، لكل وحدة أساس

CREATE TABLE item_barcodes(
  id INTEGER PRIMARY KEY, company_id INTEGER NOT NULL REFERENCES companies(id),
  item_id INTEGER NOT NULL REFERENCES items(id), barcode TEXT NOT NULL CHECK(length(trim(barcode))>0),
  unit_id INTEGER REFERENCES units(id), note TEXT NOT NULL DEFAULT '',
  created_by INTEGER REFERENCES users(id), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE(company_id,barcode));
CREATE INDEX ix_item_barcodes_item ON item_barcodes(item_id);

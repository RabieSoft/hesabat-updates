class ItemCardDialog(QDialog):
    """كارت الصنف: عرض حركات الصنف في مستودع محدد مع إمكانية عكس حركة (void_movement)."""
    def __init__(self, page, item):
        super().__init__(page)
        self.page = page
        self.item = item
        self.setWindowTitle(f"كارت وحركات الصنف — {item.get('name', '')} ({item.get('code', '')})")
        self.setLayoutDirection(Qt.RightToLeft)
        make_resizable(self, 900, 560, (640, 380))

        from PySide6.QtWidgets import QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QTableWidget, QTableWidgetItem, QHeaderView, QMessageBox
        from alhisabat.ui.components.basic import DateField, ask_reason
        from alhisabat.ui.components.datagrid import format_minor

        lay = QVBoxLayout(self)
        bar = QHBoxLayout()
        self.wh_cb = QComboBox()
        try:
            for w in page.svc.warehouses():
                self.wh_cb.addItem(w['name'], w['id'])
        except Exception: pass
        self.d_from = DateField()
        self.d_to = DateField()
        btn_filter = QPushButton("عرض")
        btn_filter.clicked.connect(self._load)

        bar.addWidget(QLabel("المستودع:"))
        bar.addWidget(self.wh_cb)
        bar.addWidget(QLabel("من:"))
        bar.addWidget(self.d_from)
        bar.addWidget(QLabel("إلى:"))
        bar.addWidget(self.d_to)
        bar.addWidget(btn_filter)
        bar.addStretch(1)
        lay.addLayout(bar)

        self.table = QTableWidget()
        self.table.setColumnCount(8)
        self.table.setHorizontalHeaderLabels(["المعرف", "التاريخ", "النوع", "الاتجاه", "الكمية", "القيمة", "الرصيد الجاري", "ملاحظة"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Interactive)      # أعمدة قابلة للسحب
        self.table.horizontalHeader().setStretchLastSection(True)
        for _i, _w in enumerate((70, 100, 90, 70, 90, 110, 110)):
            self.table.setColumnWidth(_i, _w)
        self.table.setSelectionBehavior(QTableWidget.SelectRows)
        lay.addWidget(self.table, 1)

        bottom = QHBoxLayout()
        self.lbl_summary = QLabel("")
        self.btn_void = QPushButton("عكس الحركة المحددة (تسوية عكسية)")
        self.btn_void.setProperty("danger", True)
        self.btn_void.clicked.connect(self._void_selected)
        close_btn = QPushButton("إغلاق")
        close_btn.clicked.connect(self.accept)

        bottom.addWidget(self.lbl_summary)
        bottom.addStretch(1)
        bottom.addWidget(self.btn_void)
        bottom.addWidget(close_btn)
        lay.addLayout(bottom)

        self._movements = []
        self._load()

    def _load(self):
        wid = self.wh_cb.currentData()
        if not wid:
            return
        df = self.d_from.iso()
        dt = self.d_to.iso()
        from alhisabat.ui.components.datagrid import format_minor
        from decimal import Decimal
        try:
            res = self.page.svc.item_card(self.item['id'], wid, df, dt)
            rows = res.get('rows', [])
            self._movements = rows
            self.table.setRowCount(len(rows))
            for i, r in enumerate(rows):
                self.table.setItem(i, 0, QTableWidgetItem(str(r.get('id', ''))))
                self.table.setItem(i, 1, QTableWidgetItem(str(r.get('movement_date', ''))))
                self.table.setItem(i, 2, QTableWidgetItem(str(r.get('movement_type', ''))))
                self.table.setItem(i, 3, QTableWidgetItem('وارد' if r.get('direction') == 'in' else 'صادر'))
                qty_val = (Decimal(r.get('qty_milli') or 0) / Decimal(1000))
                self.table.setItem(i, 4, QTableWidgetItem(f"{qty_val:g}"))
                self.table.setItem(i, 5, QTableWidgetItem(format_minor(r.get('value_base', 0))))
                run_qty = (Decimal(r.get('run_qty') or 0) / Decimal(1000))
                self.table.setItem(i, 6, QTableWidgetItem(f"{run_qty:g}"))
                self.table.setItem(i, 7, QTableWidgetItem(str(r.get('note') or '')))
            op_qty = (Decimal(res.get('opening_qty_milli') or 0) / Decimal(1000))
            self.lbl_summary.setText(f"رصيد أول الفترة: {op_qty:g} | عدد الحركات: {len(rows)}")
        except Exception as e:
            self.page.show_error(e)

    def _void_selected(self):
        sr = self.table.currentRow()
        if sr < 0 or sr >= len(self._movements):
            from PySide6.QtWidgets import QMessageBox
            return QMessageBox.information(self, "عكس حركة", "حدد حركة من الجدول أولًا.")
        m = self._movements[sr]
        from alhisabat.ui.components.basic import ask_reason
        reason = ask_reason(self, "عكس حركة المخزون", [f"هل تريد عكس الحركة رقم {m['id']}؟", "سيتم إنشاء حركة معاكسة بالكمية والقيمة الأصلية."], need_reason=True, confirm_text="عكس الحركة", danger=True)
        if not reason:
            return
        ok, _ = self.page.guarded(self.page.svc.void_movement, m['id'], reason, reverse_entry=True, reload=False)
        if ok:
            self.page.notify("تم عكس الحركة بنجاح")
            self._load()
            self.page.refresh()



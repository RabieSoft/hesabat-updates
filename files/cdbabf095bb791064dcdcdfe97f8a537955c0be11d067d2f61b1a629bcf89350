ALTER TABLE users ADD COLUMN failed_attempts INTEGER NOT NULL DEFAULT 0;
ALTER TABLE users ADD COLUMN locked_until TEXT;

CREATE TABLE permissions(code TEXT PRIMARY KEY, name_ar TEXT NOT NULL, is_sensitive INTEGER NOT NULL DEFAULT 0 CHECK(is_sensitive IN (0,1)));
CREATE TABLE roles(id INTEGER PRIMARY KEY, name_ar TEXT NOT NULL UNIQUE, is_system INTEGER NOT NULL DEFAULT 1);
CREATE TABLE role_permissions(
  role_id INTEGER NOT NULL REFERENCES roles(id), permission_code TEXT NOT NULL REFERENCES permissions(code),
  PRIMARY KEY(role_id,permission_code));
CREATE TABLE user_roles(
  user_id INTEGER NOT NULL REFERENCES users(id), company_id INTEGER NOT NULL REFERENCES companies(id),
  role_id INTEGER NOT NULL REFERENCES roles(id), PRIMARY KEY(user_id,company_id,role_id));
-- إن وُجد أي سجل هنا للمستخدم في الشركة فهو مقيّد بهذه الفروع فقط
CREATE TABLE user_branch_access(
  user_id INTEGER NOT NULL REFERENCES users(id), branch_id INTEGER NOT NULL REFERENCES branches(id),
  PRIMARY KEY(user_id,branch_id));


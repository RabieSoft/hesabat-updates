        if self._can_party: v['allow_manual_party_entries']=self.allow_party.isChecked()
        if self._can_edit_entries: v['allow_edit_posted_entries']=self.allow_edit_entries.isChecked()
        if self._can_delete_entries: v['allow_delete_posted_entries']=self.allow_delete_entries.isChecked()

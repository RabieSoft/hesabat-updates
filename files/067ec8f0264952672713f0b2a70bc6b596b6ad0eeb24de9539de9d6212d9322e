class RolesManagerDialog(QDialog):
    """إدارة مجموعات الصلاحيات: قائمة المجموعات يمينًا وشجرة الصلاحيات مجمّعة حسب القسم؛ المدير يحدد ما يُمنح لكل مجموعة.
    «مدير النظام» ثابتة (كل الصلاحيات). المجموعات النظامية تُعدَّل صلاحياتها لا أسماؤها. المخصّصة تُنشأ وتُعدَّل وتُحذف."""
    no_inline = True

    def __init__(self, page):
        super().__init__(page); self._page=page; self.svc=page.svc; self._rid=None; self._loading=False; self._dirty=False
        self.setWindowTitle('مجموعات الصلاحيات'); self.setLayoutDirection(Qt.RightToLeft); self.resize(820,560)
        root=QHBoxLayout(self)
        # قائمة المجموعات
        left=QVBoxLayout(); self.lst=QListWidget(); self.lst.setMaximumWidth(250); left.addWidget(QLabel('المجموعات')); left.addWidget(self.lst,1)
        b_new=QPushButton('+ مجموعة جديدة'); b_new.clicked.connect(self._new); self.b_del=QPushButton('حذف المجموعة'); self.b_del.clicked.connect(self._delete)
        left.addWidget(b_new); left.addWidget(self.b_del); root.addLayout(left)
        # التفاصيل
        right=QVBoxLayout(); form=QFormLayout(); self.name=QLineEdit(); form.addRow('اسم المجموعة', self.name); right.addLayout(form)
        self.note=QLabel(''); self.note.setWordWrap(True); right.addWidget(self.note)
        row=QHBoxLayout(); b_all=QPushButton('تحديد الكل'); b_none=QPushButton('إلغاء الكل'); b_all.clicked.connect(lambda: self._set_all(Qt.Checked)); b_none.clicked.connect(lambda: self._set_all(Qt.Unchecked))
        row.addWidget(b_all); row.addWidget(b_none); row.addStretch(1); right.addLayout(row)
        self.tree=QTreeWidget(); self.tree.setHeaderHidden(True); self.tree.setLayoutDirection(Qt.RightToLeft); right.addWidget(self.tree,1)
        row2=QHBoxLayout(); self.b_save=QPushButton('حفظ'); self.b_save.clicked.connect(self._save); b_close=QPushButton('إغلاق'); b_close.clicked.connect(self.accept)
        row2.addStretch(1); row2.addWidget(self.b_save); row2.addWidget(b_close); right.addLayout(row2); root.addLayout(right,1)
        self._build_tree(); self._load_roles()
        self.lst.currentRowChanged.connect(self._on_pick); self.name.textEdited.connect(lambda _t: self._mark()); self.tree.itemChanged.connect(lambda *_a: self._mark())
        if self.lst.count(): self.lst.setCurrentRow(0)

    # ---- بناء الشجرة
    def _build_tree(self):
        self._items={}; groups={}; self.tree.blockSignals(True)
        try: cat=self.svc.permissions_catalog()
        except Exception as exc: QMessageBox.warning(self,'خطأ',str(exc)); cat=[]
        for p in cat:
            seg=p['code'].split('.')[0]; title=PERM_GROUPS.get(seg, f'أخرى ({seg})')
            g=groups.get(title)
            if g is None:
                g=QTreeWidgetItem([title]); g.setFlags(g.flags()|Qt.ItemIsUserCheckable|Qt.ItemIsAutoTristate); g.setCheckState(0,Qt.Unchecked); self.tree.addTopLevelItem(g); groups[title]=g
            label=p['name_ar']+('  ⚠' if p.get('is_sensitive') else '')
            it=QTreeWidgetItem([label]); it.setData(0,Qt.UserRole,p['code']); it.setFlags(it.flags()|Qt.ItemIsUserCheckable); it.setCheckState(0,Qt.Unchecked)
            it.setToolTip(0,p['code'])
            if not self._page.access.has(p['code']):                  # لا تُمنح صلاحية لا يملكها المنفِّذ
                it.setFlags(it.flags() & ~Qt.ItemIsEnabled); it.setToolTip(0,'لا تملك هذه الصلاحية فلا يمكنك منحها')
            g.addChild(it); self._items[p['code']]=it
        self.tree.expandAll(); self.tree.blockSignals(False)

    def _load_roles(self, select_id=None):
        self._loading=True; self.lst.clear()
        try: rows=self.svc.roles()
        except Exception as exc: QMessageBox.warning(self,'خطأ',str(exc)); rows=[]
        self._roles={r['id']:r for r in rows}
        for r in rows:
            it=QListWidgetItem(f"{r['name_ar']}  ({r['user_count']} مستخدم)"); it.setData(Qt.UserRole,r['id']); self.lst.addItem(it)
            if select_id is not None and r['id']==select_id: self.lst.setCurrentItem(it)
        self._loading=False

    # ---- اختيار/عرض مجموعة
    def _confirm_discard(self):
        if not self._dirty: return True
        return QMessageBox.question(self,'تعديلات غير محفوظة','هناك تعديلات لم تُحفظ. تجاهلها؟')==QMessageBox.Yes

    def _on_pick(self, row):
        if self._loading or row<0: return
        rid=self.lst.item(row).data(Qt.UserRole)
        if rid!=self._rid and not self._confirm_discard():
            self._loading=True; self._select_rid(self._rid); self._loading=False; return
        self._show(rid)

    def _select_rid(self, rid):
        for i in range(self.lst.count()):
            if self.lst.item(i).data(Qt.UserRole)==rid: self.lst.setCurrentRow(i); return

    def _show(self, rid):
        self._rid=rid; r=self._roles.get(rid) or {}
        try: codes=set(self.svc.role_permissions(rid)) if rid else set()
        except Exception as exc: QMessageBox.warning(self,'خطأ',str(exc)); codes=set()
        self._loading=True; self.tree.blockSignals(True)
        self.name.setText(r.get('name_ar',''))
        for code,it in self._items.items(): it.setCheckState(0,Qt.Checked if code in codes else Qt.Unchecked)
        self.tree.blockSignals(False); self._loading=False; self._dirty=False
        admin=(rid==1); system=bool(r.get('is_system'))
        self.name.setEnabled(not system); self.tree.setEnabled(not admin); self.b_save.setEnabled(not admin); self.b_del.setEnabled(not system)
        self.note.setText('«مدير النظام» ثابتة بكل الصلاحيات ولا تُعدَّل.' if admin else
                          ('مجموعة نظامية: تُعدَّل صلاحياتها دون اسمها ولا تُحذف.' if system else 'مجموعة مخصّصة: عدّل اسمها وصلاحياتها أو احذفها إن لم يكن لها مستخدمون.'))

    def _mark(self):
        if not self._loading: self._dirty=True

    def _set_all(self, state):
        self._loading=True
        for it in self._items.values():
            if it.flags() & Qt.ItemIsEnabled: it.setCheckState(0,state)
        self._loading=False; self._dirty=True

    def _checked(self):
        return [c for c,it in self._items.items() if it.checkState(0)==Qt.Checked]

    # ---- إجراءات
    def _new(self):
        if not self._confirm_discard(): return
        name,ok=QInputDialog.getText(self,'مجموعة جديدة','اسم المجموعة:')
        name=(name or '').strip()
        if not ok or not name: return
        usable=[c for c,it in self._items.items() if it.flags() & Qt.ItemIsEnabled]          # تبدأ المجموعة بصلاحية عرض واحدة ثم يحدد المدير الباقي
        start=['account.view'] if 'account.view' in usable else usable[:1]
        try: rid=self.svc.create_role(name, start)
        except Exception as exc: return QMessageBox.warning(self,'خطأ',str(exc))
        self._load_roles(rid); self._show(rid); self._page.notify('تم إنشاء المجموعة: حدّد صلاحياتها ثم احفظ')

    def _save(self):
        if self._rid is None: return
        try: self.svc.update_role(self._rid, self.name.text().strip(), self._checked())
        except Exception as exc: return QMessageBox.warning(self,'خطأ',str(exc))
        self._dirty=False; self._load_roles(self._rid); self._show(self._rid); self._page.notify('تم حفظ صلاحيات المجموعة')

    def _delete(self):
        if self._rid is None: return
        if QMessageBox.question(self,'حذف المجموعة',f"حذف المجموعة «{self.name.text()}»؟")!=QMessageBox.Yes: return
        try: self.svc.delete_role(self._rid)
        except Exception as exc: return QMessageBox.warning(self,'خطأ',str(exc))
        self._dirty=False; self._rid=None; self._load_roles()
        if self.lst.count(): self.lst.setCurrentRow(0)

    def reject(self):
        if self._confirm_discard(): super().reject()

    def accept(self):
        if self._confirm_discard(): super().accept()


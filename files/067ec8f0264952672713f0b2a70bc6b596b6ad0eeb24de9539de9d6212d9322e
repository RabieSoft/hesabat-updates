class _PwMixin:
    """تحقق مشترك لكلمة المرور الجديدة (اختيارية) وتأكيدها."""
    MIN_PW = 8

    def _check_new_pw(self, pw, confirm):
        if not pw and not confirm:
            return True
        if len(pw) < self.MIN_PW:
            QMessageBox.warning(self, 'خطأ', f'كلمة المرور الجديدة يجب ألا تقل عن {self.MIN_PW} أحرف'); return False
        if pw != confirm:
            QMessageBox.warning(self, 'خطأ', 'تأكيد كلمة المرور لا يطابق الكلمة الجديدة'); return False
        return True



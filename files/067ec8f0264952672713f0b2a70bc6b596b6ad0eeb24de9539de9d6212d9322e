        self._can_negative=page.access.has('stock.allow_negative'); self.allow_negative.setEnabled(self._can_negative)
        self.credit_mode=QComboBox(); self.credit_mode.addItems(['block','warn','off']); self.credit_mode.setItemText(0,'منع تجاوز الحد'); self.credit_mode.setItemText(1,'تحذير فقط'); self.credit_mode.setItemText(2,'بدون فحص')
        # تحميل القيم الحالية من الشبكة
        try:
            rows=page.svc.settings()
            m={r['key']:r['value'] for r in rows}
            self.require_review.setChecked(m.get('المراجعة إلزامية')=='نعم')
            self.require_approval.setChecked(m.get('الاعتماد إلزامي')=='نعم')
            self.enforce_sep.setChecked(m.get('فصل المهام')=='نعم')
            self.allow_party.setChecked(m.get('السماح بقيد يدوي على العملاء والموردين')=='نعم')
            self.allow_edit_entries.setChecked(m.get('السماح بتعديل القيود المرحّلة')=='نعم')
            self.allow_delete_entries.setChecked(m.get('السماح بحذف القيود المرحّلة')=='نعم')

class UserRestrictionDialog(QDialog):
    """تقييد صلاحيات المستخدم بنطاق الفروع أو المستودعات أو حسابات النقدية."""
    def __init__(self, page, user):
        super().__init__(page)
        self.page = page
        self.user = user
        self.setWindowTitle(f"تقييد النطاق — {user.get('username', '')} ({user.get('full_name', '')})")
        self.setLayoutDirection(Qt.RightToLeft)
        self.resize(540, 420)

        from PySide6.QtWidgets import QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QGroupBox, QListWidget
        lay = QVBoxLayout(self)

        # 1. فروع
        gb_branch = QGroupBox("التقييد بالفروع")
        b_lay = QHBoxLayout(gb_branch)
        self.cb_branch = QComboBox()
        try:
            for b in page.svc.branches():
                self.cb_branch.addItem(f"{b.get('code','')} — {b.get('name','')}", b['id'])
        except Exception: pass
        btn_add_b = QPushButton("+ إضافة تقييد فرع")
        btn_add_b.clicked.connect(self._add_branch)
        b_lay.addWidget(self.cb_branch, 1)
        b_lay.addWidget(btn_add_b)
        lay.addWidget(gb_branch)

        # 2. مستودعات
        gb_wh = QGroupBox("التقييد بالمستودعات")
        wh_lay = QHBoxLayout(gb_wh)
        self.cb_wh = QComboBox()
        try:
            for w in page.session.warehouses(all_branches=True):
                self.cb_wh.addItem(f"{w.get('code','')} — {w.get('name','')}", w['id'])
        except Exception: pass
        btn_add_wh = QPushButton("+ إضافة تقييد مستودع")
        btn_add_wh.clicked.connect(self._add_wh)
        wh_lay.addWidget(self.cb_wh, 1)
        wh_lay.addWidget(btn_add_wh)
        lay.addWidget(gb_wh)

        # 3. حسابات نقدية
        gb_cash = QGroupBox("التقييد بحسابات النقدية والبنوك")
        c_lay = QHBoxLayout(gb_cash)
        self.cb_cash = QComboBox()
        try:
            for cid, lab in page.session.lookup_cash():
                self.cb_cash.addItem(lab, cid)
        except Exception: pass
        btn_add_c = QPushButton("+ إضافة تقييد حساب")
        btn_add_c.clicked.connect(self._add_cash)
        c_lay.addWidget(self.cb_cash, 1)
        c_lay.addWidget(btn_add_c)
        lay.addWidget(gb_cash)

        # ملخص التقييدات الحالية
        self.lbl_current = QLabel("التقييدات الحالية المسجلة:")
        self.lbl_current.setWordWrap(True)
        lay.addWidget(self.lbl_current)

        bb = QDialogButtonBox(QDialogButtonBox.Close)
        bb.rejected.connect(self.accept)
        lay.addWidget(bb)

        self._load_current()

    def _load_current(self):
        try:
            r = self.page.svc.user_restrictions(self.user['id'])
            b_cnt = len(r.get('branches', []))
            w_cnt = len(r.get('warehouses', []))
            c_cnt = len(r.get('cash_accounts', []))
            names = lambda cb, ids: "، ".join(cb.itemText(i) for i in range(cb.count()) if cb.itemData(i) in ids) or "—"
            txt = (f"القيود المفروضة: {b_cnt} فرع | {w_cnt} مستودع | {c_cnt} حساب نقدية\n"
                   f"الفروع المسموحة: {names(self.cb_branch, r.get('branches', [])) if b_cnt else 'كل الفروع (بلا تقييد)'}\n"
                   f"المستودعات المسموحة: {names(self.cb_wh, r.get('warehouses', [])) if w_cnt else 'كل المستودعات (بلا تقييد)'}\n"
                   f"الصناديق/البنوك المسموحة: {names(self.cb_cash, r.get('cash_accounts', [])) if c_cnt else 'كل الحسابات (بلا تقييد)'}\n"
                   "(المستخدم بلا أي قيد في قسم ما يصل لكل عناصره؛ قيّده من القسم المطلوب)")
            self.lbl_current.setText(txt)
        except Exception: pass

    def _add_branch(self):
        bid = self.cb_branch.currentData()
        if not bid: return
        ok, _ = self.page.guarded(self.page.svc.restrict_to_branch, self.user['id'], bid, reload=False)
        if ok:
            self.page.notify("تم تقييد المستخدم بالفرع المحدد")
            self._load_current()

    def _add_wh(self):
        wid = self.cb_wh.currentData()
        if not wid: return
        ok, _ = self.page.guarded(self.page.svc.restrict_to_warehouse, self.user['id'], wid, reload=False)
        if ok:
            self.page.notify("تم تقييد المستخدم بالمستودع المحدد")
            self._load_current()

    def _add_cash(self):
        cid = self.cb_cash.currentData()
        if not cid: return
        ok, _ = self.page.guarded(self.page.svc.restrict_to_cash_account, self.user['id'], cid, reload=False)
        if ok:
            self.page.notify("تم تقييد المستخدم بحساب النقدية المحدد")
            self._load_current()

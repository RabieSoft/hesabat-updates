            self.allow_negative.setChecked(m.get('السماح ببيع كمية سالبة من المخزون')=='نعم')
            cur=m.get('وضع الحد الائتماني') or 'block'
            idx=self.credit_mode.findText(cur)
            if idx<0:
                idx={'block':0,'warn':1,'off':2}.get(cur,0)
            self.credit_mode.setCurrentIndex(idx)
        except Exception: pass
        form.addRow(self.require_review); form.addRow(self.require_approval); form.addRow(self.enforce_sep); form.addRow(self.allow_party); form.addRow(self.allow_edit_entries); form.addRow(self.allow_delete_entries); form.addRow(self.allow_edit_posted); form.addRow(self.allow_negative); form.addRow('وضع الحد الائتماني', self.credit_mode)
        bb=QDialogButtonBox(QDialogButtonBox.Ok|QDialogButtonBox.Cancel); bb.accepted.connect(self.accept); bb.rejected.connect(self.reject); form.addRow(bb)

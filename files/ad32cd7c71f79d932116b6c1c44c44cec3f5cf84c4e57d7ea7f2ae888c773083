-- 0032: رفع سعة الحسابات الفرعية تحت حساب العملاء/الموردين الرقابي (1103/2101).
-- الافتراضي القديم 1,1,2,2,2 يعطي 99 حسابا فقط تحت الحساب الرقابي (المقطع الرابع = رقمان).
-- التعديل يرفع المقطع الرابع إلى 3 أرقام (999 حسابا). يُطبَّق فقط على الشركات ذات الإعداد الافتراضي،
-- وفقط إذا لم توجد أي حسابات في المستوى الرابع أو أعمق (حتى لا تتعارض مع أرقام موجودة).
UPDATE numbering_settings
SET segment_lengths = '1,1,2,3,2'
WHERE segment_lengths = '1,1,2,2,2'
  AND NOT EXISTS (SELECT 1 FROM accounts a WHERE a.company_id = numbering_settings.company_id AND a.level >= 4);

    def _accept(self):
        if not self.period.text().strip(): return QMessageBox.warning(self,'خطأ','الشهر مطلوب')
        self.accept()
    def values(self): return {'period':self.period.text().strip(),'date':self.date.iso()}

class AssetDialog(QDialog):
    def __init__(self, page):
        super().__init__(page); self.setWindowTitle('أصل ثابت جديد'); self.setLayoutDirection(Qt.RightToLeft); form=QFormLayout(self)
        self.name=QLineEdit(); self.cost=QLineEdit(); self.cost.setPlaceholderText('0.00'); self.life=QLineEdit(); self.life.setPlaceholderText('بالأشهر (مثل 60)')
        self.date=DateField(); self.account=QComboBox()
        try:
            for aid,lab in page.session.lookup_accounts(types=['asset'], groups=True): self.account.addItem(lab, aid)   # فئة الأصل يجب أن تكون حسابًا تجميعيًا (fixed_assets.register_asset)
        except Exception: pass
        form.addRow('اسم الأصل *', self.name); form.addRow('فئة الأصل (حساب تجميعي) *', self.account); form.addRow('تاريخ الاقتناء', self.date); form.addRow('التكلفة *', self.cost); form.addRow('العمر الإنتاجي (شهر) *', self.life)
        bb=QDialogButtonBox(QDialogButtonBox.Ok|QDialogButtonBox.Cancel); bb.accepted.connect(self._accept); bb.rejected.connect(self.reject); form.addRow(bb)
    def _accept(self):
        if not self.name.text().strip(): return QMessageBox.warning(self,'خطأ','الاسم مطلوب')
        if self.account.currentData() is None: return QMessageBox.warning(self,'خطأ','اختر حساب الأصل')
        if not self.cost.text().strip(): return QMessageBox.warning(self,'خطأ','التكلفة مطلوبة')
        if not self.life.text().strip(): return QMessageBox.warning(self,'خطأ','العمر مطلوب')
        self.accept()
    def values(self): return {'name':self.name.text().strip(),'account_id':self.account.currentData(),'date':self.date.iso(),'cost':self.cost.text().strip().replace(',', ''),'life':self.life.text().strip()}


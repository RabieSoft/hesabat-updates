class PayrollDialog(QDialog):
    def __init__(self, page):
        super().__init__(page); self.setWindowTitle('مسير رواتب جديد'); self.setLayoutDirection(Qt.RightToLeft); form=QFormLayout(self)
        from datetime import date as _d
        self.period=QLineEdit(_d.today().strftime('%Y-%m')); self.period.setPlaceholderText('YYYY-MM')

class AssetDisposalDialog(QDialog):
    """استبعاد أو بيع أصل ثابت."""
    def __init__(self, page, asset):
        super().__init__(page)
        self.setWindowTitle(f"استبعاد أصل: {asset.get('name', '')}")
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(440)
        form = QFormLayout(self)
        self.date = DateField()
        self.proceeds = QLineEdit('0.00')
        self.account = QComboBox()
        try:
            for aid, lab in page.session.lookup_accounts(groups=False):
                self.account.addItem(lab, aid)
        except Exception: pass
        self.reason = QLineEdit()
        self.reason.setPlaceholderText("سبب الاستبعاد...")

        form.addRow('تاريخ الاستبعاد *', self.date)
        form.addRow('عوائد البيع (0 إن أُتلف) *', self.proceeds)
        form.addRow('الحساب المقابل للعوائد *', self.account)
        form.addRow('السبب', self.reason)

        bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        bb.accepted.connect(self._accept)
        bb.rejected.connect(self.reject)
        form.addRow(bb)

    def _accept(self):
        if self.account.currentData() is None:
            return QMessageBox.warning(self, 'خطأ', 'اختر الحساب المقابل')
        try:
            from decimal import Decimal
            Decimal(self.proceeds.text().strip().replace(',', ''))
        except Exception:
            return QMessageBox.warning(self, 'خطأ', 'مبلغ العوائد غير صالح')
        self.accept()

    def values(self):
        return {
            'date': self.date.iso(),
            'proceeds': self.proceeds.text().strip().replace(',', ''),
            'counter_account_id': self.account.currentData(),
            'reason': self.reason.text().strip()
        }


class PayEmployeeDialog(QDialog):
    """سداد راتب موظف نقداً أو عبر البنك."""
    def __init__(self, page, employee, advance=False):
        super().__init__(page)
        self.setWindowTitle(f"{'سلفة' if advance else 'صرف راتب'} — {employee.get('name', '')}")
        self.setLayoutDirection(Qt.RightToLeft)
        self.setMinimumWidth(440)
        form = QFormLayout(self)

        self.cash = QComboBox()
        try:
            for cid, lab in page.session.lookup_cash():
                self.cash.addItem(lab, cid)
        except Exception: pass

        from decimal import Decimal
        base_sal = Decimal(employee.get('base_salary_minor') or 0) / Decimal(100)
        self.amount = QLineEdit('' if advance else f"{base_sal:.2f}")
        self.date = DateField()
        self.desc = QLineEdit(f"{'سلفة موظف' if advance else 'صرف راتب'} {employee.get('name', '')}")

        form.addRow('صندوق/بنك الصرف *', self.cash)
        form.addRow('المبلغ *', self.amount)
        form.addRow('تاريخ الصرف *', self.date)
        form.addRow('البيان', self.desc)

        bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        bb.accepted.connect(self._accept)
        bb.rejected.connect(self.reject)
        form.addRow(bb)

    def _accept(self):
        if not self.cash.currentData():
            return QMessageBox.warning(self, 'خطأ', 'اختر الصندوق أو البنك')
        try:
            from decimal import Decimal
            Decimal(self.amount.text().strip().replace(',', ''))
        except Exception:
            return QMessageBox.warning(self, 'خطأ', 'المبلغ غير صالح')
        self.accept()

    def values(self):
        return {
            'cash_id': self.cash.currentData(),
            'amount': self.amount.text().strip().replace(',', ''),
            'date': self.date.iso(),
            'description': self.desc.text().strip()
        }

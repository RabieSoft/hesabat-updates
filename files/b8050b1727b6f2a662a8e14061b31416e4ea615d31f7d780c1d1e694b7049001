"""نوافذ الموارد: موظف، مركز تكلفة، مسير، أصل.
"""
from PySide6.QtCore import Qt
from PySide6.QtWidgets import QComboBox, QDialog, QDialogButtonBox, QFormLayout, QLineEdit, QMessageBox

from alhisabat.ui.components.basic import DateField
from alhisabat.ui.core import strings_ar as S

class EmployeeDialog(QDialog):
    def __init__(self, page, existing=None):
        super().__init__(page); self.setWindowTitle('تعديل موظف' if existing else 'تعيين موظف'); self.setLayoutDirection(Qt.RightToLeft); self.setMinimumWidth(420)
        form=QFormLayout(self)
        self.name=QLineEdit(existing.get('name','') if existing else ''); self.job=QLineEdit(existing.get('job_title','') if existing else '')
        from decimal import Decimal
        sal_val = Decimal(existing.get('base_salary_minor') or 0) / Decimal(100) if existing else ''
        self.salary = QLineEdit(f"{sal_val:.2f}" if sal_val != '' else '')
        self.phone = QLineEdit(existing.get('phone') or '' if existing else '')
        self.date=DateField()
        if existing and existing.get('hire_date'): self.date.set_iso(existing['hire_date'])
        form.addRow('الاسم *', self.name); 
        form.addRow('تاريخ التعيين', self.date)
        form.addRow('الوظيفة', self.job); form.addRow('الراتب الأساسي *', self.salary)
        form.addRow('الهاتف', self.phone)
        bb=QDialogButtonBox(QDialogButtonBox.Ok|QDialogButtonBox.Cancel); bb.accepted.connect(self._accept); bb.rejected.connect(self.reject); form.addRow(bb)
    def _accept(self):
        if not self.name.text().strip(): return QMessageBox.warning(self,'خطأ','الاسم مطلوب')
        if not self.salary.text().strip(): return QMessageBox.warning(self,'خطأ','الراتب مطلوب')
        self.accept()
    def values(self):
        out={'name':self.name.text().strip(),'job':self.job.text().strip(),'salary':self.salary.text().strip().replace(',', '')}
        if hasattr(self,'phone'): out['phone']=self.phone.text().strip()
        if hasattr(self,'date'): out['date']=self.date.iso()
        return out


def trial_balance_print(conn, user_id, company_id, date_from, date_to, **kw):
    tb = be.trial_balance(conn, user_id, company_id, date_from, date_to, **kw)
    company, branch = _company_header(conn, company_id, kw.get("branch_id"))
    cols = [{"key": "code", "label": "الرقم"}, {"key": "name", "label": "الحساب"},
           {"key": "opening", "label": "افتتاحي", "numeric": True}, {"key": "debit", "label": "مدين", "numeric": True},
           {"key": "credit", "label": "دائن", "numeric": True}, {"key": "closing", "label": "ختامي", "numeric": True}]
    rows = [{"code": r["code"], "name": ("  " * (r["level"] - 1)) + r["name"], "opening": _u(r["opening_debit"] - r["opening_credit"]),
            "debit": _u(r["period_debit"]), "credit": _u(r["period_credit"]), "closing": _u(r["closing_debit"] - r["closing_credit"])}
            for r in tb["rows"]]
    totals = [{"label": "الإجماليات", "value": _u(tb["totals"]["period_debit"]), "words_label": "إجمالي المدين"},
              {"label": "دائن", "value": _u(tb["totals"]["period_credit"]), "words_label": "إجمالي الدائن"}]
    if totals[0]["value"] == totals[1]["value"]:          # ميزان متوازن: سطر تفقيط واحد للجانبين
        totals[0]["words_label"], totals[1]["no_words"] = "إجمالي المدين والدائن", True
    return _with_words(conn, company_id, _spec("ميزان المراجعة", company=company, branch=branch, period=f"{date_from} — {date_to}",
                                               columns=cols, rows=rows, totals=totals))


# ترتيب أعمدة كل كشوف الحساب (من اليمين لليسار): التاريخ، نوع المستند، رقم المستند، البيان، رقم المرجع، العملة، ثم المبلغ (مدين/دائن)، وأخيرًا الرصيد
_STATEMENT_COLS_HEAD = [{"key": "date", "label": "التاريخ"}, {"key": "doc_type", "label": "نوع المستند"}, {"key": "doc_no", "label": "رقم المستند"},
                        {"key": "desc", "label": "البيان"}, {"key": "ref", "label": "رقم المرجع"}, {"key": "currency", "label": "العملة"}]


BALANCE_SIDES = {"all": "دائن ومدين", "debit": "مدينون فقط", "credit": "دائنون فقط"}


def norm_side(side):
    side = (side or "all").strip().lower()
    if side not in BALANCE_SIDES:
        raise AccountingError("قيمة ترشيح الرصيد غير معروفة")
    return side


def side_match(net, side):
    """net = مدين − دائن (موجب = رصيد مدين، سالب = دائن). الرصيد الصفري لا يطابق «مدينون» ولا «دائنون»."""
    if side == "debit":
        return net > 0
    if side == "credit":
        return net < 0
    return True


def ledger_print(conn, user_id, company_id, account_id, date_from, date_to, **kw):
    """كشف حساب. بلا currency: كل الحركات بمعادلها بالعملة الأساسية (والحركة الأجنبية يظهر مبلغها الأصلي في البيان).
    مع currency=XXX: حركات تلك العملة وحدها بمبالغها وأرصدتها **بالعملة الأصلية** (كشف يمني/دولار…)."""
    kw.setdefault("limit", 1000)                           # الحد الأقصى في المحرك؛ كان 200 فيُقتطع الكشف الطويل
    multi = bool(kw.pop("multi_currency", False)) and not kw.get("currency")
    side = norm_side(kw.pop("balance_side", None))
    r = le.ledger(conn, user_id, company_id, account_id, date_from, date_to, **kw)
    if side != "all":
        _cl = r["closing_balance_orig"] if kw.get("currency") else r["closing_balance"]
        _net = _cl if r["account"]["nature"] == "debit" else -_cl
        if not side_match(_net, side):
            raise AccountingError(f"رصيد هذا الحساب في الفترة المحددة ليس {'مدينًا' if side == 'debit' else 'دائنًا'}، فلا يطابق الترشيح «{BALANCE_SIDES[side]}».")
    company, branch = _company_header(conn, company_id)
    if multi:
        return _ledger_multi_currency(conn, company_id, r, company, branch, date_from, date_to)
    cur = r.get("currency")
    sfx = f" ({cur})" if cur else ""
    cols = _STATEMENT_COLS_HEAD + [{"key": "debit", "label": "مدين" + sfx, "numeric": True, "group": "المبلغ"},
                                   {"key": "credit", "label": "دائن" + sfx, "numeric": True, "group": "المبلغ"},
                                   {"key": "balance", "label": "الرصيد" + sfx, "numeric": True}]
    base = conn.execute("SELECT base_currency FROM companies WHERE id=?", (company_id,)).fetchone()[0]
    rows, _cache = [], {}
    for x in r["rows"]:
        _note = _voucher_note(conn, x, _cache)              # بيان السند (إن وُجد) بدل نص القيد العام «سند قبض رقم N»
        desc = _note or x["description"]
        if cur:
            d, c, bal = x["debit_orig"], x["credit_orig"], x["running_balance_orig"]
        else:
            d, c, bal = x["debit_base"], x["credit_base"], x["running_balance"]
            if x["currency"] != base:                       # حركة بعملة أجنبية داخل كشف بالأساسية: نُظهر مبلغها الأصلي
                amt = _u(x["debit_orig"] or x["credit_orig"])
                desc = f"{desc or ''} [{x['currency']} {amt:,.2f}]".strip()
        dtype, dno, dref = _doc_info(conn, x, _cache)
        rows.append({"entry_id": x.get("entry_id"), "source_type": x.get("source_type"), "source_id": x.get("source_id"),
                     "date": x["entry_date"], "no": x["posted_no"], "desc": desc, "currency": cur or base,
                     "debit": _u(d), "credit": _u(c), "balance": _u(bal), "doc_type": dtype, "doc_no": dno, "ref": dref})
    opening, closing = (r["opening_balance_orig"], r["closing_balance_orig"]) if cur else (r["opening_balance"], r["closing_balance"])
    extra = [("الحساب", f"{r['account']['code']} {r['account']['name']}")]
    if cur:
        extra.append(("العملة", cur))
    extra.append(("الرصيد الافتتاحي" + sfx, str(_u(opening))))
    spec = _spec("كشف حساب" + (f" — {cur}" if cur else ""), company=company, branch=branch, currency=cur or base,
                 period=f"{date_from} — {date_to}", extra=extra, columns=cols, rows=rows,
                 totals=[{"label": "الرصيد الختامي" + sfx, "value": _u(closing)}])
    # بيانات قالب «كشف الربيع»: الرصيد الافتتاحي (مدين موجب) وإجماليات الفترة كلها (لا صفوف الصفحة وحدها) وعدد الحركات
    nature = 1 if r["account"]["nature"] == "debit" else -1
    open_net = opening * nature if cur else r["opening_net"]
    spec["opening"] = _u(open_net)
    spec["sums"] = {"sign": nature, "debit": _u(r["total_debit_orig"] if cur else r["total_debit"]),
                    "credit": _u(r["total_credit_orig"] if cur else r["total_credit"]), "count": r["count"],
                    "truncated": bool(r["has_more"])}
    return _with_words(conn, company_id, spec)


def _ledger_multi_currency(conn, company_id, r, company, branch, date_from, date_to):
    """كشف «كل العملات»: كل حركة بعملتها الأصلية مع عمود «العملة»، بلا رصيد جارٍ مخلوط؛ والأرصدة الافتتاحية والإجماليات والختامي
    تُعرض لكل عملة على حدة (لا يصح جمع يمني مع سعودي في رقم واحد). العملة الافتراضية للشركة أولًا ثم الأساسية ثم الباقي."""
    from alhisabat.accounting import rates as _rates
    base = _base_cur(conn, company_id)
    dflt = _rates.default_currency(conn, company_id)
    rank = {dflt: 0, base: 1}
    cols = _STATEMENT_COLS_HEAD + [{"key": "debit", "label": "مدين", "numeric": True, "group": "المبلغ"},
                                   {"key": "credit", "label": "دائن", "numeric": True, "group": "المبلغ"},
                                   {"key": "balance", "label": "الرصيد", "numeric": True}]
    sign = 1 if r["account"]["nature"] == "debit" else -1
    run = {c["currency"]: c["opening_net_orig"] for c in (r.get("by_currency") or [])}     # رصيد جارٍ لكل عملة على حدة (لا يُخلط يمني بسعودي)
    rows, _cache = [], {}
    for x in r["rows"]:
        dtype, dno, dref = _doc_info(conn, x, _cache)
        run[x["currency"]] = run.get(x["currency"], 0) + x["debit_orig"] - x["credit_orig"]
        rows.append({"entry_id": x.get("entry_id"), "source_type": x.get("source_type"), "source_id": x.get("source_id"),
                     "date": x["entry_date"], "no": x["posted_no"], "desc": _voucher_note(conn, x, _cache) or x["description"], "currency": x["currency"],
                     "debit": _u(x["debit_orig"]), "credit": _u(x["credit_orig"]), "balance": _u(sign * run[x["currency"]]),
                     "doc_type": dtype, "doc_no": dno, "ref": dref})
    per = sorted(r.get("by_currency") or [], key=lambda c: (rank.get(c["currency"], 2), c["currency"]))
    per = [c for c in per if c["opening_net_orig"] or c["debit_orig"] or c["credit_orig"]]
    by_cur = [{"currency": c["currency"], "opening": _u(c["opening_net_orig"]), "debit": _u(c["debit_orig"]),
               "credit": _u(c["credit_orig"]), "closing": _u(c["closing_net_orig"]), "count": c["count"]} for c in per]
    totals = [{"label": f"الرصيد الختامي ({c['currency']})", "value": _u(sign * c["closing_net_orig"]), "currency": c["currency"]}
              for c in per]
    spec = _spec("كشف حساب — كل العملات", company=company, branch=branch, currency=None,
                 period=f"{date_from} — {date_to}",
                 extra=[("الحساب", f"{r['account']['code']} {r['account']['name']}"), ("العملة", "كل العملات")],
                 columns=cols, rows=rows, totals=totals)
    spec["opening"] = None
    spec["sums"] = {"sign": sign, "debit": None, "credit": None, "count": r["count"], "truncated": bool(r["has_more"]),
                    "multi": True, "by_currency": by_cur}
    return _with_words(conn, company_id, spec)



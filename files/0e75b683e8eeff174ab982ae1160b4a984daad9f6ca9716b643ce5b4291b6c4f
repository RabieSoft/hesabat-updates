def _party_owed(conn, company_id, party, upto_entry_id=None, upto_date=None, include_entry=True):
    """ما **على الطرف لنا** (موجب = «عليكم»، سالب = «لكم») بالعملة الأساسية، من قيود الأستاذ المرحّلة: مدين − دائن لحساب الطرف
    عميلًا كان أو موردًا (نحن مدينون للمورد ⇒ سالب ⇒ «لكم»). upto_entry_id: يشمل/يستثني هذا القيد وما بعده
    (ترتيب التاريخ ثم رقم القيد) فيُحسب الرصيد السابق والحالي لنفس الفاتورة بثبات حتى لو طُبعت لاحقًا."""
    q = ("SELECT COALESCE(SUM(l.debit_base - l.credit_base),0) FROM journal_lines l JOIN journal_entries e ON e.id=l.entry_id "
         "WHERE e.company_id=? AND l.account_id=? AND e.status IN ('posted','reversed')")
    args = [company_id, party["account_id"]]
    if upto_entry_id is not None:
        op = "<=" if include_entry else "<"
        q += f" AND (e.entry_date < ? OR (e.entry_date = ? AND e.id {op} ?))"
        args += [upto_date, upto_date, upto_entry_id]
    elif upto_date is not None:
        q += " AND e.entry_date <= ?"
        args.append(upto_date)
    return Decimal(int(conn.execute(q, args).fetchone()[0] or 0)) / 100


def _side(owed):
    return "عليكم" if owed > 0 else ("لكم" if owed < 0 else "")


def _invoice_rate(conn, company_id, h, base):
    """سعر صرف الفاتورة (أساسي لكل وحدة أجنبية): المرحّلة تحمل سعرها المخزّن، والمسودة سعر اليوم المسجّل؛ None إن لم يوجد."""
    if h["currency"] == base:
        return Decimal(1)
    if h["status"] == "posted":
        return Decimal(str(h["exchange_rate"]))
    try:
        from alhisabat.accounting import rates as fxr
        return fxr.get_rate(conn, company_id, h["currency"], h["invoice_date"])
    except Exception:  # noqa: BLE001 — لا سعر صرف: يُعرض الرصيد بالعملة الأساسية بدل رقم مضلِّل
        return None


def _invoice_balance(conn, company_id, party, h, kind):
    """كتلة «كشف رصيد الطرف» أسفل الفاتورة: الرصيد السابق + أثر هذه الفاتورة = الرصيد الحالي، بصيغة «عليكم / لكم» وبالتفقيط.
    تُعرض **بعملة الفاتورة** (فاتورة باليمني ⇒ أرصدة باليمني): أثر الفاتورة بمبلغها الأصلي بلا تقريب، والرصيد السابق = رصيد الأستاذ
    (بالأساسي) ÷ سعر صرف الفاتورة؛ ويُضاف المعادل بالعملة الأساسية. فاتورة مرحّلة: السابق/الحالي من الأستاذ عند قيدها؛ مسودة: تقديري."""
    base = _base_cur(conn, company_id)
    cur = h["currency"]
    rate = _invoice_rate(conn, company_id, h, base)
    show_cur, rate_used = (cur, rate) if rate else (base, Decimal(1))        # لا سعر ⇒ نعرض بالأساسي صراحةً
    eid, posted = h.get("journal_entry_id"), h["status"] == "posted"
    sign = (-1 if h["doc_type"] == "return" else 1) * (1 if kind == "sales" else -1)
    due_orig = _u(h["due_total"]) * sign                                       # أثر الفاتورة بعملتها (موجب = عليكم)
    if posted and eid:
        d = conn.execute("SELECT entry_date FROM journal_entries WHERE id=?", (eid,)).fetchone()[0]
        prev_b = _party_owed(conn, company_id, party, eid, d, include_entry=False)
        cur_b = _party_owed(conn, company_id, party, eid, d, include_entry=True)
        estimated = False
    else:
        prev_b = _party_owed(conn, company_id, party, upto_date=h["invoice_date"])
        cur_b = prev_b + due_orig * (rate or Decimal(1))
        estimated = True
    move_b = cur_b - prev_b
    if show_cur == base:
        prev, move = prev_b, move_b
    else:
        q = Decimal("0.01")
        prev = (prev_b / rate_used).quantize(q)
        move = due_orig                                                        # بمبلغ الفاتورة الأصلي تمامًا
    now = prev + move
    return {"currency": show_cur, "base_currency": base, "rate": rate_used, "estimated": estimated,
            "previous": prev, "movement": move, "current": now,
            "previous_side": _side(prev), "current_side": _side(now),
            "current_words": _words(abs(now), show_cur) if now != 0 else "",
            "base": {"previous": prev_b, "movement": move_b, "current": cur_b},
            "party_kind": party["kind"]}


def invoice_print(conn, user_id, invoice_id, kind="sales"):
    get = sales.get_invoice if kind == "sales" else pu.get_purchase
    h = get(conn, user_id, invoice_id)
    company, branch = _company_header(conn, h["company_id"], h["branch_id"])
    party_key = "customer_id" if kind == "sales" else "supplier_id"
    party = None
    if h.get(party_key):
        party = conn.execute("SELECT name FROM parties WHERE id=?", (h[party_key],)).fetchone()
    units = {r[0]: r[1] for r in conn.execute("SELECT id,name FROM units WHERE company_id=?", (h["company_id"],))}
    cols = [{"key": "item", "label": "الصنف/الوصف"}, {"key": "qty", "label": "الكمية", "numeric": True},
           {"key": "unit", "label": "الوحدة"}, {"key": "price", "label": "السعر", "numeric": True},
           {"key": "total", "label": "الإجمالي", "numeric": True}]
    rows = []
    for n, l in enumerate(h["lines"], 1):
        nm = l.get("item_name") or l.get("description", "") or ""
        rows.append({"item": f"{l.get('item_code') or ''} {nm}".strip(),
                     "qty": _u(l["qty_milli"]) / 10 if "qty_milli" in l.keys() else None,
                     "unit": units.get(l.get("unit_id"), ""),
                     "price": _u(l["unit_price_minor"]),
                     "total": _u(l["total_minor"]),
                     # حقول إضافية لقالب الفاتورة (لا تظهر في CSV/XLSX لأنها خارج columns)
                     "no": n, "code": l.get("item_code") or "", "name": nm,
                     "note": (l.get("description") or "") if l.get("item_name") else "",
                     "discount": _u(l.get("discount_ex") or 0), "tax": _u(l.get("tax_minor") or 0),
                     "net": _u(l.get("net_ex") or 0), "tax_pct": Decimal(int(l.get("tax_bps") or 0)) / 100})
    totals = [{"label": "الإجمالي", "value": _u(h["grand_total"])}, {"label": "المدفوع", "value": _u(h["paid_total"])},
             {"label": "المتبقي", "value": _u(h["due_total"])}]
    extra = [("رقم المستند", h["invoice_no"] or "(مسودة)"), ("التاريخ", h["invoice_date"]), ("الحالة", h["status"]),
            (("العميل" if kind == "sales" else "المورد"), party["name"] if party else "نقدي")]
    title = {"invoice": "فاتورة مبيعات", "return": "مرتجع مبيعات"}.get(h["doc_type"], "مستند") if kind == "sales" else \
        {"invoice": "فاتورة مشتريات", "return": "مرتجع مشتريات"}.get(h["doc_type"], "مستند")
    spec = _spec(title, company=company, branch=branch, currency=h["currency"], period=h["invoice_date"], extra=extra, columns=cols, rows=rows, totals=totals)
    spec["amount_words"] = _words(_u(h["grand_total"]), h["currency"])
    spec["invoice"] = _invoice_meta(conn, h, kind, party_key)
    return spec


def _invoice_meta(conn, h, kind, party_key):
    """بيانات قالب الفاتورة (أسلوب أونكس): الطرف، المستودع، نوع الدفع، المبالغ، وكشف الرصيد. لا تغيّر أرقام المحرك."""
    p = conn.execute("SELECT * FROM parties WHERE id=?", (h[party_key],)).fetchone() if h.get(party_key) else None
    wh = conn.execute("SELECT name FROM warehouses WHERE id=?", (h["warehouse_id"],)).fetchone() if h.get("warehouse_id") else None
    by = conn.execute("SELECT full_name FROM users WHERE id=?", (h["created_by"],)).fetchone()
    orig = None
    if h.get("original_invoice_id"):
        tbl = "sales_invoices" if kind == "sales" else "purchase_invoices"
        orig = conn.execute(f"SELECT invoice_no FROM {tbl} WHERE id=?", (h["original_invoice_id"],)).fetchone()
    grand, paid, due = h["grand_total"], h["paid_total"], h["due_total"]
    payment = "نقدي" if due == 0 else ("آجل" if paid == 0 else "جزئي")
    meta = {"kind": kind, "doc_type": h["doc_type"],
            "party": ({"label": "العميل" if kind == "sales" else "المورد", "code": p["code"], "name": p["name"], "phone": p["phone"],
                       "address": p["address"], "tax_no": p["tax_no"]} if p else
                      {"label": "العميل" if kind == "sales" else "المورد", "code": "", "name": "نقدي", "phone": "", "address": "", "tax_no": ""}),
            "warehouse": wh[0] if wh else "", "payment": payment, "due_date": h.get("due_date") or "",
            "prepared_by": by[0] if by else "", "notes": h.get("notes") or "", "supplier_ref": h.get("supplier_ref") or "",
            "original_no": (orig[0] if orig else "") or "", "invoice_no": h["invoice_no"] or "", "currency": h["currency"],
            "amounts": {"gross": _u(h["gross_ex_total"]), "discount": _u(h["discount_ex_total"]), "net": _u(h["net_ex_total"]),
                        "tax": _u(h["tax_total"]), "grand": _u(grand), "paid": _u(paid), "due": _u(due),
                        "costs": _u(h["costs_total"]) if "costs_total" in h.keys() else None},
            "balance": None}
    if p:
        try:
            meta["balance"] = _invoice_balance(conn, h["company_id"], p, h, kind)
        except Exception:  # noqa: BLE001 — الرصيد إضافة للعرض؛ لا يُفشل طباعة الفاتورة
            meta["balance"] = None
    return meta


def voucher_print(conn, user_id, voucher_id):
    v = cash.get_voucher(conn, user_id, voucher_id)
    company, branch = _company_header(conn, v["company_id"], v["branch_id"])
    party = conn.execute("SELECT name FROM parties WHERE id=?", (v["party_id"],)).fetchone() if v["party_id"] else None
    ca = conn.execute("SELECT name FROM cash_accounts WHERE id=?", (v["cash_account_id"],)).fetchone()
    cols = [{"key": "account", "label": "الحساب"}, {"key": "amount", "label": "المبلغ", "numeric": True}, {"key": "note", "label": "بيان"}]
    if v["lines"]:
        rows = [{"account": conn.execute("SELECT name FROM accounts WHERE id=?", (l["account_id"],)).fetchone()[0],
                "amount": _u(l["amount_minor"]), "note": l["description"]} for l in v["lines"]]
    else:
        rows = [{"account": party["name"] if party else "", "amount": _u(v["amount_minor"]), "note": v["description"]}]
    title = "سند قبض" if v["voucher_type"] == "receipt" else "سند صرف"
    extra = [("رقم السند", v["voucher_no"] or "(مسودة)"), ("التاريخ", v["voucher_date"]), ("الحالة", v["status"]),
            ("الصندوق/البنك", ca[0] if ca else "")]
    spec = _spec(title, company=company, branch=branch, currency=v["currency"], period=v["voucher_date"], extra=extra,
                 columns=cols, rows=rows, totals=[{"label": "الإجمالي", "value": _u(v["amount_minor"])}])
    spec["amount_words"] = _words(_u(v["amount_minor"]), v["currency"])
    spec["voucher"] = _voucher_details(conn, v, party, ca)
    return spec


def _voucher_details(conn, v, party, ca):
    """تفاصيل السند للقالب المخصص (قبض/صرف): الطرف المقابل، الحساب المقابل، القيد، الفواتير المسددة، المُعِدّ/المُرحِّل. قراءة فقط."""
    def one(sql, args):
        r = conn.execute(sql, args).fetchone()
        return r[0] if r else None
    kind = conn.execute("SELECT kind FROM cash_accounts WHERE id=?", (v["cash_account_id"],)).fetchone()
    ptype = one("SELECT kind FROM parties WHERE id=?", (v["party_id"],)) if v["party_id"] else None
    je_no = one("SELECT COALESCE(posted_no,entry_no) FROM journal_entries WHERE id=?", (v["journal_entry_id"],)) if v["journal_entry_id"] else None
    allocs = []
    for a in v.get("allocations") or []:
        tbl, lab = ("sales_invoices", "فاتورة مبيعات") if a["doc_type"] == "sales_invoice" else ("purchase_invoices", "فاتورة مشتريات")
        r = conn.execute(f"SELECT invoice_no,invoice_date FROM {tbl} WHERE id=?", (a["doc_id"],)).fetchone()
        allocs.append({"type": lab, "no": (r[0] if r else "") or "", "date": (r[1] if r else "") or "", "amount": _u(a["amount_minor"])})
    return {"kind": v["voucher_type"], "party_name": party["name"] if party else "", "party_kind": ptype,
            "counter_accounts": [r["account"] for r in ([{"account": conn.execute("SELECT name FROM accounts WHERE id=?", (l["account_id"],)).fetchone()[0]} for l in v["lines"]])],
            "cash_name": ca[0] if ca else "", "cash_kind": kind[0] if kind else "", "amount": _u(v["amount_minor"]), "currency": v["currency"],
            "description": v["description"] or "", "exchange_rate": v.get("exchange_rate") or "", "journal_no": je_no,
            "allocations": allocs, "created_by": one("SELECT full_name FROM users WHERE id=?", (v["created_by"],)) or "",
            "posted_by": one("SELECT full_name FROM users WHERE id=?", (v["posted_by"],)) if v.get("posted_by") else "",
            "posted_at": v.get("posted_at") or "", "status": v["status"]}


def journal_entry_print(conn, user_id, entry_id):
    e = je.get_entry(conn, user_id, entry_id)
    company, branch = _company_header(conn, e["company_id"], e["branch_id"])
    cols = [{"key": "account", "label": "الحساب"}, {"key": "debit", "label": "مدين", "numeric": True},
           {"key": "credit", "label": "دائن", "numeric": True}, {"key": "note", "label": "بيان"}]
    rows = [{"account": f"{l['account_code']} {l['account_name']}", "debit": _u(l["debit_base"]) or Decimal(0),
            "credit": _u(l["credit_base"]) or Decimal(0), "note": l["memo"]} for l in e["lines"]]
    totals = [{"label": "الإجمالي", "value": sum(r["debit"] for r in rows)}]
    extra = [("رقم القيد", e["posted_no"] or e["entry_no"]), ("التاريخ", e["entry_date"]), ("الحالة", e["status"]), ("البيان", _voucher_note(conn, e, {}) or e["description"])]
    _ref = _voucher_note(conn, e, {})
    if _ref:
        extra.append(("المرجع", _ref))
    base = conn.execute("SELECT base_currency FROM companies WHERE id=?", (e["company_id"],)).fetchone()
    base = base[0] if base else None
    spec = _spec("قيد محاسبي", company=company, branch=branch, currency=base, period=e["entry_date"], extra=extra, columns=cols, rows=rows, totals=totals)
    spec["amount_words"] = _words(totals[0]["value"], base)
    return spec



# ---------------- التصدير ----------------
_TOTAL_PREFIXES = ("إجمالي", "الإجمالي", "الإجماليات", "مجمل", "صافي", "الصافي", "رصيد النقدية", "الرصيد الختامي")
_STATEMENT_TITLES = ("ميزان المراجعة", "قائمة الدخل", "المركز المالي", "التدفقات النقدية", "قائمة المركز المالي")
_DEFAULT_SIGNATURES = ("أعدّه", "راجعه", "اعتمده")


def _fmt(v):
    if v is None:
        return ""
    if isinstance(v, Decimal):
        return f"{v:,.2f}"
    return str(v)


def _extra_pairs(spec):
    """extra قد تحوي أزواجًا (عنوان، قيمة) أو نصوصًا مفردة (ملاحظات)؛ نوحّدها دائمًا إلى أزواج كي لا ينهار التصدير."""
    out = []
    for e in spec.get("extra") or []:
        if isinstance(e, (tuple, list)) and len(e) == 2:
            out.append((str(e[0]), "" if e[1] is None else str(e[1])))
        else:
            out.append(("ملاحظة", str(e)))
    return out


def _is_total_row(row, columns):
    first = next((c["key"] for c in columns if not c.get("numeric")), None)
    label = str(row.get(first) or "").strip() if first else ""
    return label.startswith(_TOTAL_PREFIXES)


def _indent_of(text):
    t = str(text or "")
    return (len(t) - len(t.lstrip(" "))) // 2


def _num_html(v, *, dash_zero=True):
    """رقم للعرض: السالب بين قوسين وبالأحمر، والصفر شرطة خافتة (الأرقام الحقيقية تبقى كما هي في XLSX/CSV)."""
    if v is None or v == "":
        return ""
    if not isinstance(v, (Decimal, int, float)):
        return html_escape(str(v))
    d = Decimal(str(v))
    if d == 0:
        return '<span class="z">&ndash;</span>' if dash_zero else "0.00"
    txt = f"{abs(d):,.2f}"
    return f'<span class="neg">({txt})</span>' if d < 0 else txt


def _kpi_cards(spec):
    """بطاقات ملخص لكشف الحساب (افتتاحي/مدين/دائن/ختامي/عدد الحركات) متى توفرت بيانات الكشف في المواصفة."""
    sums = spec.get("sums")
    if not sums or spec.get("opening") is None:
        return ""
    closing = next((t["value"] for t in spec.get("totals", []) if str(t["label"]).startswith("الرصيد الختامي")), None)
    cards = [("الرصيد الافتتاحي", spec["opening"]), ("إجمالي المدين", sums.get("debit")), ("إجمالي الدائن", sums.get("credit")),
             ("الرصيد الختامي", closing), ("عدد الحركات", sums.get("count"))]
    out = []
    for lab, val in cards:
        if val is None:
            continue
        shown = str(val) if lab == "عدد الحركات" else _num_html(val, dash_zero=False)
        out.append(f'<div class="kpi"><span>{lab}</span><b>{shown}</b></div>')
    note = ""
    if sums.get("truncated"):
        note = '<div class="warn">تنبيه: الكشف يتجاوز الحد الأقصى للصفوف المعروضة؛ الإجماليات أعلاه تشمل كل الحركات.</div>'
    return f'<div class="kpis">{"".join(out)}</div>{note}'


def render_html(spec, signatures=None):
    """HTML احترافي للطباعة والمعاينة: رأس بهوية الشركة، بطاقات ملخص، جدول بترويسة متكررة وتظليل متناوب وإبراز الإجماليات،
    أرقام سالبة بين قوسين، مسافات بادئة للمستويات، توقيعات، وترقيم صفحات. يتحول تلقائيًا للعرض الأفقي إن كثرت الأعمدة.
    كل القيم تُهرَّب (escape) فلا يكسر اسم يحوي رموز HTML الصفحة."""
    cols = spec["columns"]
    landscape = len(cols) > 7
    meta = [(k, v) for k, v in (("الفرع", spec.get("branch")), ("العملة", spec.get("currency")), ("الفترة", spec.get("period"))) if v]
    meta += _extra_pairs(spec)
    meta_html = "".join(f"<div><span>{html_escape(str(k))}</span><b>{html_escape(str(v))}</b></div>" for k, v in meta)
    ths = "".join(f"<th class='{'num' if c.get('numeric') else ''}'>{html_escape(str(c['label']))}</th>" for c in cols)
    first_text = next((c["key"] for c in cols if not c.get("numeric")), None)
    trs = []
    for r in spec["rows"]:
        tot = _is_total_row(r, cols)
        tds = []
        for c in cols:
            v = r.get(c["key"])
            cls = ["num"] if c.get("numeric") else []
            if c["key"] in ("debit", "debit_base"):
                cls.append("cd")
            elif c["key"] in ("credit", "credit_base"):
                cls.append("cc")
            elif c["key"] in ("balance", "running_balance", "closing"):
                cls.append("cb")
            if tot:
                cls.append("tot")
            style = ""
            if c["key"] == first_text:
                ind = _indent_of(v)
                style = f" style='padding-right:{8 + ind * 14}px'" if ind else ""
                v = str(v).strip() if v is not None else v
            cell = _num_html(v) if c.get("numeric") else html_escape(_fmt(v))
            tds.append(f"<td class='{' '.join(cls)}'{style}>{cell}</td>")
        trs.append(f"<tr>{''.join(tds)}</tr>")
    if not trs:
        trs.append(f"<tr><td colspan='{max(len(cols), 1)}' class='empty'>لا توجد بيانات في هذه الفترة</td></tr>")
    totals_html = ""
    if spec["totals"]:
        items = "".join(f"<div class='trow'><span>{html_escape(str(t['label']))}</span><b>{_num_html(t['value'], dash_zero=False)}</b></div>"
                        for t in spec["totals"])
        totals_html = f"<div class='totals'>{items}</div>"
    if spec.get("amount_words"):
        wl = _wd.split_lines(spec["amount_words"])
        if len(wl) > 1:
            totals_html += ("<div class='words'><span>المبلغ كتابةً:</span>"
                            + "".join(f"<div><b>{html_escape(x)}</b></div>" for x in wl) + "</div>")
        else:
            totals_html += f"<div class='words'><span>المبلغ كتابةً:</span> <b>{html_escape(wl[0] if wl else str(spec['amount_words']))}</b></div>"
    inv = spec.get("invoice") or {}
    bal = inv.get("balance")
    if bal:                                                # كشف رصيد الطرف لفواتير التصدير بصيغة HTML (نفس منطق قالب الطباعة)
        def _bl(lab, v, side):
            return (f"<div class='trow'><span>{html_escape(lab)}</span><b>{_num_html(abs(v), dash_zero=False)}"
                    f"{(' ' + html_escape(side)) if side else ''}</b></div>")
        mv_side = "عليكم" if bal["movement"] > 0 else ("لكم" if bal["movement"] < 0 else "")
        totals_html += (f"<div class='totals'><div class='trow'><span><b>كشف رصيد {html_escape(inv['party']['label'])}</b></span><span></span></div>"
                        + _bl("الرصيد السابق", bal["previous"], bal["previous_side"]) + _bl("هذه الفاتورة (المتبقي)", bal["movement"], mv_side)
                        + _bl("الرصيد الحالي" + (" (تقديري)" if bal["estimated"] else ""), bal["current"], bal["current_side"]) + "</div>")
    sigs = signatures if signatures is not None else (_DEFAULT_SIGNATURES if str(spec["title"]).startswith(_STATEMENT_TITLES) else ())
    sig_html = ("<div class='sigs'>" + "".join(f"<div><i></i>{html_escape(s)}</div>" for s in sigs) + "</div>") if sigs else ""
    company = html_escape(spec.get("company") or "")
    title = html_escape(spec["title"])
    return f"""<!DOCTYPE html><html dir="rtl" lang="ar"><head><meta charset="utf-8">
<title>{title}</title>
<style>
@page {{ size: A4 {'landscape' if landscape else 'portrait'}; margin: 14mm 12mm; @bottom-center {{ content: "صفحة " counter(page) " من " counter(pages); font-size: 9px; color: #666; }} }}
* {{ box-sizing: border-box; }}
body {{ font-family: 'Segoe UI', Tahoma, 'Noto Naskh Arabic', 'DejaVu Sans', sans-serif; direction: rtl; color: #1b2430; margin: 0; padding: 18px; font-size: 12px; }}
.bar {{ display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid #8a6508; padding-bottom: 8px; margin-bottom: 12px; }}
.bar .co {{ font-size: 16px; font-weight: 700; color: #8a6508; }}
.bar .ttl {{ font-size: 20px; font-weight: 700; text-align: center; flex: 1; }}
.bar .pd {{ font-size: 11px; color: #555; text-align: left; min-width: 160px; }}
.meta {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 4px 18px; background: #fbf7e8; border: 1px solid #e3d7ae; border-radius: 6px; padding: 8px 12px; margin-bottom: 12px; }}

def render_csv(spec):
    buf = io.StringIO()
    w = csv.writer(buf)
    w.writerow([spec["title"]])
    if spec.get("company"):
        w.writerow(["الشركة", spec["company"]])
    if spec.get("period"):
        w.writerow(["الفترة", spec["period"]])
    for k, v in _extra_pairs(spec):
        w.writerow([k, v])
    w.writerow([])
    w.writerow([c["label"] for c in spec["columns"]])
    for r in spec["rows"]:
        w.writerow([r.get(c["key"], "") for c in spec["columns"]])
    for t in spec["totals"]:
        w.writerow([t["label"], t["value"]])
    for line in _wd.split_lines(spec.get("amount_words")):
        w.writerow(["المبلغ كتابةً", line])
    return buf.getvalue().encode("utf-8-sig")   # BOM: إكسل يعرض العربية بشكل صحيح عند فتح CSV مباشرة


def render_xlsx(spec):
    """XLSX احترافي: ترويسة بهوية الشركة، رأس جدول ملوّن مع تجميد وفلترة، أرقام حقيقية بتنسيق محاسبي (السالب أحمر بين قوسين)،
    إبراز صفوف الإجماليات، مسافات بادئة للمستويات، وإعداد طباعة جاهز (تكرار الرأس، ملاءمة العرض، ترقيم الصفحات)."""
    from openpyxl import Workbook
    from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
    from openpyxl.utils import get_column_letter
    NAVY, LIGHT, ZEBRA = "8A6508", "F6ECC8", "FCFAF2"
    NUM_FMT = '#,##0.00;[Red](#,##0.00);"-"'
    thin = Side(style="thin", color="E3D7AE")
    box = Border(left=thin, right=thin, top=thin, bottom=thin)
    cols = spec["columns"]
    ncols = max(len(cols), 2)
    wb = Workbook()
    ws = wb.active
    ws.sheet_view.rightToLeft = True
    ws.title = (spec["title"][:31] or "تقرير").replace("/", "-").replace(":", "-")
    wb.properties.title = spec["title"]
    wb.properties.creator = spec.get("company") or "الحسابات برو"

    ws.append([spec["title"]])
    ws["A1"].font = Font(bold=True, size=16, color=NAVY)
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncols)
    ws["A1"].alignment = Alignment(horizontal="center")
    meta = [("الشركة", spec.get("company")), ("الفرع", spec.get("branch")), ("العملة", spec.get("currency")), ("الفترة", spec.get("period"))]
    for k, v in [m for m in meta if m[1]] + _extra_pairs(spec):
        ws.append([k, v])
        ws.cell(row=ws.max_row, column=1).font = Font(bold=True, color="445566")
    ws.append([])
    header_row = ws.max_row + 1
    ws.append([c["label"] for c in cols])
    for cell in ws[header_row]:
        cell.font = Font(bold=True, color="FFFFFF")
        cell.fill = PatternFill("solid", fgColor=NAVY)
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        cell.border = box
    ws.row_dimensions[header_row].height = 22

    first_text = next((c["key"] for c in cols if not c.get("numeric")), None)
    widths = [len(str(c["label"])) + 4 for c in cols]
    for n, r in enumerate(spec["rows"]):
        vals = []
        for c in cols:
            v = r.get(c["key"], "")
            if c.get("numeric") and isinstance(v, Decimal):
                v = float(v)
            elif c["key"] == first_text and isinstance(v, str):
                v = v.strip()
            vals.append(v)
        ws.append(vals)
        row_no = ws.max_row
        tot = _is_total_row(r, cols)
        for i, c in enumerate(cols):
            cell = ws.cell(row=row_no, column=i + 1)
            cell.border = box
            if c.get("numeric"):
                cell.number_format = NUM_FMT
                cell.alignment = Alignment(horizontal="right")
            elif c["key"] == first_text:
                cell.alignment = Alignment(horizontal="right", indent=_indent_of(r.get(c["key"])))
            if tot:
                cell.font = Font(bold=True)
                cell.fill = PatternFill("solid", fgColor=LIGHT)
            elif n % 2:
                cell.fill = PatternFill("solid", fgColor=ZEBRA)
            widths[i] = max(widths[i], min(len(str(vals[i])) + 3, 60))
    last_data = ws.max_row
    for t in spec["totals"]:
        ws.append([t["label"], float(t["value"]) if isinstance(t["value"], Decimal) else t["value"]])
        for cell in ws[ws.max_row]:
            cell.font = Font(bold=True)
        ws.cell(row=ws.max_row, column=2).number_format = NUM_FMT
        for i in (1, 2):
            ws.cell(row=ws.max_row, column=i).fill = PatternFill("solid", fgColor=LIGHT)
            ws.cell(row=ws.max_row, column=i).border = Border(top=Side(style="medium", color=NAVY))
    for line in _wd.split_lines(spec.get("amount_words")):
        ws.append(["المبلغ كتابةً", line])
        ws.cell(row=ws.max_row, column=1).font = Font(bold=True)
        ws.cell(row=ws.max_row, column=2).alignment = Alignment(horizontal="right")
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = max(12, min(w, 60))
    if spec["rows"]:
        ws.freeze_panes = ws.cell(row=header_row + 1, column=1)
        ws.auto_filter.ref = f"A{header_row}:{get_column_letter(len(cols))}{last_data}"
    ws.page_setup.orientation = "landscape" if len(cols) > 6 else "portrait"
    ws.page_setup.paperSize = ws.PAPERSIZE_A4
    ws.page_setup.fitToWidth, ws.page_setup.fitToHeight = 1, 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.print_title_rows = f"{header_row}:{header_row}"
    ws.oddFooter.center.text = "صفحة &P من &N"
    ws.oddFooter.left.text = f"طُبع بتاريخ {spec.get('printed_at', '')}"
    buf = io.BytesIO(); wb.save(buf)
    return buf.getvalue()


_ARABIC_RE = re.compile(r"[\u0600-\u06FF]")


def _has_arabic(spec):
    texts = [spec["title"], spec["company"] or "", spec["branch"] or ""] + [k for k, v in _extra_pairs(spec)] + \
        [str(v) for _, v in _extra_pairs(spec)] + [c["label"] for c in spec["columns"]]
    for r in spec["rows"]:
        texts += [str(v) for v in r.values()]
    return any(_ARABIC_RE.search(t) for t in texts)


def render_pdf(spec):
    """PDF حقيقي عبر reportlab — لكنه محدود فعليا حاليا: لا توجد في هذه البيئة مكتبتا تشكيل الحروف العربية وترتيب
    الاتجاه (arabic_reshaper وpython-bidi)، فالنص العربي في PDF سيظهر بحروف منفصلة وبترتيب معكوس. لذلك هذه الدالة
    تمنع صراحةً توليد PDF إن كان في المحتوى نص عربي (وهو كل تقرير تقريبا) بدل تسليم ملف يبدو صحيحا وهو مكسور
    (خلاف مواصفة §91: منع الوظائف الوهمية). التصدير العملي حاليا: HTML للطباعة، وCSV/XLSX للبيانات."""
    if _has_arabic(spec):
        raise AccountingError("تصدير PDF للنصوص العربية غير مدعوم في هذه البيئة (تحتاج مكتبتي تشكيل الحروف والاتجاه: "
                              "arabic-reshaper وpython-bidi). استخدم HTML للطباعة أو XLSX/CSV للبيانات حتى تتوفر.")
    from reportlab.lib.pagesizes import A4
    from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer
    from reportlab.lib.styles import getSampleStyleSheet
    from reportlab.lib import colors
    buf = io.BytesIO()
    doc = SimpleDocTemplate(buf, pagesize=A4)
    styles = getSampleStyleSheet()
    story = [Paragraph(spec["title"], styles["Title"]), Spacer(1, 8)]
    for k, v in [("Company", spec["company"]), ("Period", spec["period"])] + _extra_pairs(spec):
        if v:
            story.append(Paragraph(f"<b>{k}:</b> {v}", styles["Normal"]))
    story.append(Spacer(1, 8))
    data = [[c["label"] for c in spec["columns"]]] + [[_fmt(r.get(c["key"])) for c in spec["columns"]] for r in spec["rows"]]
    t = Table(data, repeatRows=1)
    t.setStyle(TableStyle([("GRID", (0, 0), (-1, -1), 0.5, colors.grey), ("BACKGROUND", (0, 0), (-1, 0), colors.whitesmoke),
                          ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold")]))
    story.append(t)
    for tt in spec["totals"]:
        story.append(Paragraph(f"<b>{tt['label']}:</b> {_fmt(tt['value'])}", styles["Normal"]))
    doc.build(story)
    return buf.getvalue()

def _company_header(conn, company_id, branch_id=None):
    c = conn.execute("SELECT name FROM companies WHERE id=?", (company_id,)).fetchone()
    b = conn.execute("SELECT name FROM branches WHERE id=?", (branch_id,)).fetchone() if branch_id else None
    return c[0] if c else None, (b[0] if b else None)


def _words(amount, currency):
    """المبلغ كتابةً بنوع العملة (تفقيط). '' إن تعذّر أو كان المبلغ غير موجب."""
    try:
        from alhisabat.ui.core import format as _fmt
        return _fmt.amount_in_words(amount, currency) if amount is not None and currency else ""
    except Exception:
        return ""


def _base_cur(conn, company_id):
    """العملة الأساسية للشركة (أساس التفقيط حين لا تحمل المواصفة عملة)."""
    r = conn.execute("SELECT base_currency FROM companies WHERE id=?", (company_id,)).fetchone()
    return r[0] if r else None


def _with_words(conn, company_id, spec):
    """يُلحق «المبلغ كتابةً» بإجماليات التقرير بعملته (أو الأساسية) — يُستدعى في آخر كل باني تقرير."""
    return _wd.attach_words(spec, _base_cur(conn, company_id))


def _u(minor):
    return None if minor is None else Decimal(int(minor)) / 100


def _spec(title, *, company=None, branch=None, currency=None, period=None, extra=None, columns, rows, totals=None):
    return {"title": title, "company": company, "branch": branch, "currency": currency, "period": period,
           "printed_at": datetime.now().isoformat(timespec="seconds"), "extra": extra or [],
           "columns": columns, "rows": rows, "totals": totals or []}


_SRC_LABELS = {"party_opening": "رصيد افتتاحي", "party_reconcile": "مطابقة", "stock_opening": "رصيد مخزون افتتاحي", "stock_adjustment": "تسوية مخزون",
               "stock_count": "جرد مخزون", "cash_transfer": "تحويل نقدية", "cash_count": "جرد صندوق", "payroll_run": "مسير رواتب",
               "asset_depreciation": "إهلاك أصول", "fixed_asset": "أصل ثابت", "fixed_asset_disposal": "استبعاد أصل",
               "revaluation": "إعادة تقييم", "bank_statement": "كشف بنكي"}


def _doc_info(conn, x, cache):
    """(نوع المستند، رقمه، المرجع) لحركة دفتر الأستاذ، من المستند المصدر؛ والقيد اليدوي «قيد يومية» برقم ترحيله."""
    st, sid = x.get("source_type"), x.get("source_id")
    key = (st, sid)
    if key in cache:
        return cache[key]
    out = None
    try:
        if st == "sales_invoice" and sid:
            r = conn.execute("SELECT doc_type,invoice_no FROM sales_invoices WHERE id=?", (sid,)).fetchone()
            if r:
                out = ("مرتجع مبيعات" if r["doc_type"] == "return" else "فاتورة مبيعات", r["invoice_no"] or "", "")
        elif st == "purchase_invoice" and sid:
            r = conn.execute("SELECT doc_type,invoice_no,supplier_ref FROM purchase_invoices WHERE id=?", (sid,)).fetchone()
            if r:
                out = ("مرتجع مشتريات" if r["doc_type"] == "return" else "فاتورة مشتريات", r["invoice_no"] or "", r["supplier_ref"] or "")
        elif st == "cash_voucher" and sid:
            r = conn.execute("SELECT v.voucher_type,v.voucher_no,v.description,a.kind FROM cash_vouchers v LEFT JOIN cash_accounts a ON a.id=v.cash_account_id "
                             "WHERE v.id=?", (sid,)).fetchone()
            if r:
                base = "سند قبض" if r["voucher_type"] == "receipt" else "سند صرف"
                out = (f"{base} {'بنكي' if r['kind'] == 'bank' else 'نقدي'}", r["voucher_no"] or "", (r["description"] or "").strip())
    except Exception:  # noqa: BLE001 — نوع المستند للعرض فقط؛ لا يُفشل الكشف
        out = None
    if out is None:
        out = (_SRC_LABELS.get(st, "قيد يومية"), x.get("posted_no") or x.get("entry_no") or "", "")
    cache[key] = out
    return out


def _voucher_note(conn, x, cache):
    """بيان سند القبض/الصرف (الملاحظة/رقم السند الدفتري) لحركة الأستاذ، وإلا None. القيود القديمة خزّنت «سند قبض رقم N» فقط."""
    if x.get("source_type") != "cash_voucher" or not x.get("source_id"):
        return None
    key = ("note", x["source_id"])
    if key not in cache:
        try:
            r = conn.execute("SELECT description FROM cash_vouchers WHERE id=?", (x["source_id"],)).fetchone()
            cache[key] = ((r[0] or "").strip() or None) if r else None
        except Exception:  # noqa: BLE001 — للعرض فقط
            cache[key] = None
    return cache[key]



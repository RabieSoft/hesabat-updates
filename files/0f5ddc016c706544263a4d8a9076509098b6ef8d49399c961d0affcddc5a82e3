    def count_sheet(self, count_id):
        """ورقة الجرد: كل صنف مخزني مفعّل (الأم المجمِّعة تُستثنى وتُجرد ألوانها) برصيد النظام في مستودع الجرد وما أُدخل سابقًا."""
        self.require('inventory.count')
        c = self.conn.execute("SELECT warehouse_id,status FROM stock_counts WHERE id=? AND company_id=?", (int(count_id), self.company_id)).fetchone()
        if not c: raise AccountingError('عملية الجرد غير موجودة')
        return c['status'], [dict(r) for r in self.conn.execute(
            "SELECT i.id item_id,i.code,i.name,COALESCE(p.name,'') parent_name,COALESCE(c.name,'') color_name,COALESCE(c.shade_code,'') shade_code,COALESCE(c.hex,'') color_hex,"
            "COALESCE((SELECT qty_milli FROM stock_balances b WHERE b.item_id=i.id AND b.warehouse_id=?),0) system_qty_milli,"
            "(SELECT counted_qty_milli FROM stock_count_lines l WHERE l.count_id=? AND l.item_id=i.id) counted_qty_milli "
            "FROM items i LEFT JOIN items p ON p.id=i.parent_item_id LEFT JOIN colors c ON c.id=i.color_id "
            "WHERE i.company_id=? AND i.item_type='stock' AND i.is_active=1 AND i.has_variants=0 ORDER BY COALESCE(p.code,i.code),c.name,i.code",
            (c['warehouse_id'], int(count_id), self.company_id))]

    def save_count_lines(self, count_id, qtys):
        """يحفظ الكميات المعدودة {item_id: qty} في معاملة واحدة."""
        from alhisabat.database.tx import transaction
        with transaction(self.conn):
            for item_id, q in qtys.items():
                self.set_count_line(count_id, item_id, q)
        return len(qtys)

    def post_stock_count(self, count_id):

    def currency_view(self, code, on_date=None):
        """معامل تحويل العملة الأساسية إلى عملة العرض: (الرمز, عدد وحدات الأساسية لوحدة واحدة من العملة). الأساسية = 1."""
        from alhisabat.accounting import rates
        base = rates.base_currency(self.conn, self.company_id)
        if not code or code == base:
            return base, Decimal(1)
        return code, Decimal(str(rates.get_rate(self.conn, self.company_id, code, on_date or str(date.today()))))

    def stock_count_lines(self, count_id):
        self.require('inventory.view')
        return [dict(r) for r in self.conn.execute(
            "SELECT l.item_id,i.code,i.name,l.system_qty_milli,l.counted_qty_milli,l.diff_qty_milli,"
            "l.diff_value_base,l.unit_cost_minor "
            "FROM stock_count_lines l JOIN items i ON i.id=l.item_id WHERE l.count_id=? ORDER BY i.code",
            (int(count_id),))]

    # ---------------- الأصناف (ربط بالتصنيف والوحدة بالمعرّف)
    def create_item(self, v):
        self.require('inventory.manage')
        unit_id = v.get('unit_id')
        if not unit_id:   # توافق: اسم وحدة نصي (ينشئها إن لم توجد)
            unit_name = (v.get('unit') or 'قطعة').strip()
            u = self.conn.execute("SELECT id FROM units WHERE company_id=? AND name=? COLLATE NOCASE", (self.company_id, unit_name)).fetchone()
            unit_id = u[0] if u else inventory.create_unit(self.conn, self.user_id, self.company_id, unit_name)
        return inventory.create_item(
            self.conn, self.user_id, self.company_id, v['name'], int(unit_id),
            code=v.get('code') or None, barcode=v.get('barcode', ''),
            category_id=int(v['category_id']) if v.get('category_id') else None,
            category='' if v.get('category_id') else v.get('category', ''),
            min_qty=Decimal(str(v.get('min_qty') or 0)),
            item_type=v.get('kind') or v.get('item_type') or 'stock', cost_method=v.get('cost_method') or '',
            branch_id=self._master_branch(), track_expiry=bool(v.get('track_expiry')),
            expiry_alert_days=int(v.get('expiry_alert_days') or 0) if v.get('expiry_alert_days') not in (None, '') else 30)

    def edit_item(self, item_id, v):
        kw = {}
        if 'category_id' in v:      # None = فك الارتباط بالتصنيف
            kw['category_id'] = int(v['category_id']) if v['category_id'] else None
        else:
            kw['category'] = v.get('category')
        return inventory.edit_item(self.conn, self.user_id, int(item_id), name=v.get('name'), barcode=v.get('barcode'),
                                   min_qty=Decimal(str(v['min_qty'])) if v.get('min_qty') not in (None, '') else None,
                                   cost_method=v.get('cost_method') if 'cost_method' in v else None,
                                   track_expiry=bool(v['track_expiry']) if 'track_expiry' in v else None,
                                   expiry_alert_days=int(v['expiry_alert_days']) if v.get('expiry_alert_days') not in (None, '') else None, **kw)


from alhisabat.accounting.errors import AccountingError
from alhisabat.business import branch_scope, inventory, item_catalog, item_cleanup, item_info, item_variants, stock_lots


class InventoryMixin:
    def items(self, limit=500):
        self.require('inventory.view')
        f, fa = branch_scope.master_clause(self.conn, self.company_id, self.branch_id, col="i.branch_id")
        return [dict(r) for r in self.conn.execute(
            "SELECT i.id,i.code,i.name,u.name unit,i.base_unit_id unit_id,i.category,i.category_id,i.barcode,i.item_type kind,i.min_qty_milli,"
            "COALESCE((SELECT SUM(sb.qty_milli) FROM stock_balances sb WHERE sb.item_id=i.id),0) stock_milli,i.is_active,i.cost_method,"
            "EXISTS(SELECT 1 FROM stock_movements m WHERE m.item_id=i.id) has_moves,i.branch_id,i.track_expiry,i.expiry_alert_days,i.has_variants,i.parent_item_id,i.color_id,"
            "(SELECT MIN(l.expiry_date) FROM stock_lots l WHERE l.item_id=i.id AND l.qty_milli>0 AND l.expiry_date<>'') next_expiry "
            "FROM items i JOIN units u ON u.id=i.base_unit_id WHERE i.company_id=?" + f + " ORDER BY i.name LIMIT ?",
            (self.company_id, *fa, int(limit)))]

    def item_color_map(self):
        """{item_id: [(اسم اللون، hex)]}: الأم = ألوان أبنائها الفعّالة، واللون التابع = لونه (لعمود «اللون» في جدول الأصناف)."""
        self.require('inventory.view')
        out = {}
        for r in self.conn.execute(
                "SELECT i.id,i.parent_item_id pid,c.name,c.shade_code,c.hex FROM items i JOIN colors c ON c.id=i.color_id "
                "WHERE i.company_id=? ORDER BY c.color_family,c.name,c.shade_code", (self.company_id,)):
            lab = f"{r['name']} {r['shade_code']}".strip()
            out.setdefault(r['id'], []).append((lab, r['hex']))
            if r['pid']: out.setdefault(r['pid'], []).append((lab, r['hex']))
        return out


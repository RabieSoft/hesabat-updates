    def warehouses(self, all_branches=False):
        """مخازن الفرع الحالي فقط (كل فرع مستقل)، ومقيَّدة بمخازن المستخدم إن وُجد تقييد.
        all_branches=True لشاشات الإدارة التي تحتاج كل المخازن (مثل نافذة تقييد المستخدم)."""
        self.require('inventory.view')
        f, fa = ("", []) if all_branches else branch_scope.txn_clause(self.conn, self.company_id, self.branch_id)
        g, ga = ("", []) if all_branches else self._access_clause('user_warehouse_access', 'warehouse_id')
        return [dict(r) for r in self.conn.execute(
            "SELECT id,code,name,branch_id,is_active FROM warehouses WHERE company_id=?" + f + g + " ORDER BY name", (self.company_id, *fa, *ga))]


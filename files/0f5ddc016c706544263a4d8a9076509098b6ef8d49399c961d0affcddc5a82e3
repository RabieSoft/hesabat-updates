    def post_opening_stock(self, v):
        rows = []
        for r in v["rows"]:
            row = {"item_id": int(r["item_id"]), "warehouse_id": int(r["warehouse_id"]), "qty": Decimal(str(r["qty"])),
                   "unit_cost": Decimal(str(r.get("unit_cost") or 0)), "expiry_date": r.get("expiry_date") or None,
                   "lot_no": r.get("lot_no") or ""}
            if r.get("total_cost") not in (None, ""):      # الإجمالي هو المرساة: يُرسل كما أُدخل بلا فاقد تقريب
                row["total_cost"] = Decimal(str(r["total_cost"]))
            rows.append(row)
        return inventory.post_opening_stock(self.conn, self.user_id, self.company_id, v.get("date") or str(date.today()),
                                            rows, note=v.get("note") or "",
                                            counter_account_id=v.get("counter_account_id"))


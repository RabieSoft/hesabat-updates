def settings_rows(conn, company_id, tables_map):
    rows = []
    comp = conn.execute("SELECT name, base_currency FROM companies WHERE id=?", (company_id,)).fetchone()
    if comp:
        rows += [{'group': 'الشركة', 'key': 'الاسم', 'value': comp['name'] or ''},
                 {'group': 'الشركة', 'key': 'العملة الأساسية', 'value': comp['base_currency'] or ''}]
    for table, (group, names) in tables_map.items():
        r = conn.execute(f"SELECT * FROM {table} WHERE company_id=?", (company_id,)).fetchone()
        if r:
            for k, label in names.items():
                v = r[k]
                rows.append({'group': group, 'key': label, 'value': ('نعم' if v == 1 else 'لا') if k in ('require_review', 'require_approval', 'enforce_separation', 'allow_manual_party_entries', 'allow_edit_posted_entries', 'allow_delete_posted_entries', 'transfer_to_retained', 'allow_edit_posted_invoice', 'allow_negative_stock') else v})
    return rows


def invoices(conn, company_id, kind='sales', limit=300):
    if kind == 'sales':
        q = ("SELECT i.id,i.invoice_no,i.invoice_date,i.due_date,p.name party,i.doc_type,i.status,"
             "i.grand_total g,i.paid_total pt,i.due_total dt,i.currency,i.notes "
             "FROM sales_invoices i LEFT JOIN parties p ON p.id=i.customer_id "
             "WHERE i.company_id=? ORDER BY i.invoice_date DESC,i.id DESC LIMIT ?")
    else:
        q = ("SELECT i.id,i.invoice_no,i.invoice_date,i.due_date,p.name party,i.doc_type,i.status,"
             "i.grand_total g,i.paid_total pt,i.due_total dt,i.currency,i.notes "
             "FROM purchase_invoices i LEFT JOIN parties p ON p.id=i.supplier_id "
             "WHERE i.company_id=? ORDER BY i.invoice_date DESC,i.id DESC LIMIT ?")
    out = []
    for r in conn.execute(q, (company_id, int(limit))):
        out.append({'id': r['id'], 'invoice_no': r['invoice_no'], 'invoice_date': r['invoice_date'],
                    'due_date': r['due_date'], 'party': r['party'], 'doc_type': r['doc_type'],
                    'status': r['status'], 'grand_total_minor': r['g'], 'paid_total_minor': r['pt'],
                    'due_total_minor': r['dt'], 'currency': r['currency'], 'notes': r['notes'], 'kind': kind})
    return out


def last_price(conn, company_id, kind, item_id, party_id=None, exclude_invoice_id=None):
    """آخر سعر (بيع/شراء) لصنف: يُفضَّل سعر آخر فاتورة لنفس الطرف إن وُجد، وإلا آخر سعر عام. المرحَّلة والمسودات (غير الملغاة)
    كي يتذكر المحرر ما أدخله المستخدم نفسه؛ وتُستثنى الفاتورة الجاري تعديلها. يعيد أيضًا الوحدة ومعاملها لتحويل السعر بين الوحدات.
    عرض مساعد أثناء الإدخال فقط (بلا فحص صلاحية مستقل؛ الصفحة التي تستدعيه محمية أصلًا بصلاحية الفواتير)."""
    if kind == 'sales':
        tbl, htbl, pcol = 'sales_invoice_lines', 'sales_invoices', 'customer_id'
    else:
        tbl, htbl, pcol = 'purchase_invoice_lines', 'purchase_invoices', 'supplier_id'
    base = (f"SELECT l.unit_price_minor p, l.unit_id u, l.factor_milli f, h.invoice_date d, h.invoice_no n, h.currency c, h.status st "
            f"FROM {tbl} l JOIN {htbl} h ON h.id=l.invoice_id "
            f"WHERE h.company_id=? AND l.item_id=? AND h.status IN ('posted','draft')")
    args = [company_id, item_id]
    if exclude_invoice_id:
        base += " AND h.id<>?"
        args.append(int(exclude_invoice_id))

    def pack(r, same):
        return {'price_minor': r['p'], 'unit_id': r['u'], 'factor_milli': r['f'] or 1000, 'date': r['d'], 'invoice_no': r['n'],
                'currency': r['c'], 'status': r['st'], 'same_party': same}
    if party_id:
        r = conn.execute(base + f" AND h.{pcol}=? ORDER BY h.invoice_date DESC,h.id DESC LIMIT 1", (*args, party_id)).fetchone()
        if r:
            return pack(r, True)
    r = conn.execute(base + " ORDER BY h.invoice_date DESC,h.id DESC LIMIT 1", args).fetchone()
    return pack(r, False) if r else None


def stock_on_hand(conn, company_id, item_id, warehouse_id=None):
    """الكمية الحالية بالمخزون (وحدة ملّي) لصنف: بمستودع محدد أو مجموع كل المستودعات. عرض مساعد فقط أثناء الإدخال."""
    if warehouse_id:
        r = conn.execute("SELECT qty_milli FROM stock_balances WHERE item_id=? AND warehouse_id=?", (item_id, warehouse_id)).fetchone()
        return r['qty_milli'] if r else 0
    r = conn.execute("SELECT COALESCE(SUM(b.qty_milli),0) FROM stock_balances b JOIN items i ON i.id=b.item_id "
                     "WHERE b.item_id=? AND i.company_id=?", (item_id, company_id)).fetchone()
    return r[0] if r else 0



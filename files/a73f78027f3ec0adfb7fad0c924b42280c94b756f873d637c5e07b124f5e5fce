def currencies_list(conn, company_id):
    """قائمة كل العملات في النظام مع حالتها في الشركة."""
    base = conn.execute("SELECT base_currency FROM companies WHERE id=?", (company_id,)).fetchone()
    base_cur = base[0] if base else ''
    q = (
        "SELECT c.code, c.name_ar, c.symbol, c.minor_digits, "
        "COALESCE(cc.is_enabled, 1) as is_enabled, "
        "(c.code = ?) as is_base "
        "FROM currencies c "
        "LEFT JOIN company_currencies cc ON cc.currency=c.code AND cc.company_id=? "
        "WHERE c.is_active=1 "
        "ORDER BY is_base DESC, c.code"
    )
    rows = [dict(r) for r in conn.execute(q, (base_cur, company_id)).fetchall()]
    dflt = default_currency_code(conn, company_id, rows)
    for r in rows:
        r['is_default'] = (r['code'] == dflt)
    return rows


def default_currency_code(conn, company_id, rows=None):
    """رمز عملة الإدخال الافتراضية الفعلية: المحددة للشركة إن كانت مفعّلة، وإلا الأساسية."""
    r = conn.execute("SELECT base_currency, default_currency FROM companies WHERE id=?", (company_id,)).fetchone()
    if not r:
        return ''
    base, d = r[0], r[1]
    if not d or d == base:
        return base
    if rows is not None:
        ok = any(x['code'] == d and x.get('is_enabled') for x in rows)
    else:
        c = conn.execute("SELECT is_enabled FROM company_currencies WHERE company_id=? AND currency=?", (company_id, d)).fetchone()
        ok = c is None or bool(c[0])
    return d if ok else base


def cash_transfers(conn, company_id, limit=200):
    return [dict(r) for r in conn.execute(
        "SELECT t.id, t.transfer_no, t.transfer_date, t.from_cash_id, t.to_cash_id, "
        "t.from_amount_minor, t.to_amount_minor, t.fee_minor, t.status, t.description, "
        "f.name from_cash_name, to_c.name to_cash_name "
        "FROM cash_transfers t "
        "JOIN cash_accounts f ON f.id=t.from_cash_id "
        "JOIN cash_accounts to_c ON to_c.id=t.to_cash_id "
        "WHERE t.company_id=? ORDER BY t.id DESC LIMIT ?",
        (company_id, int(limit))
    )]


def cash_counts(conn, company_id, limit=200):
    return [dict(r) for r in conn.execute(
        "SELECT c.id, c.cash_account_id, c.count_date, c.book_minor, c.counted_minor, c.diff_minor, c.note, "
        "ca.name cash_name "
        "FROM cash_counts c JOIN cash_accounts ca ON ca.id=c.cash_account_id "
        "WHERE c.company_id=? ORDER BY c.id DESC LIMIT ?",
        (company_id, int(limit))
    )]


def depreciation_runs(conn, company_id, limit=200):
    return [dict(r) for r in conn.execute(
        "SELECT r.id, r.run_date, r.status, r.journal_entry_id, "
        "COUNT(l.asset_id) assets_count, COALESCE(SUM(l.amount_minor), 0) total_minor "
        "FROM asset_depreciation_runs r "
        "LEFT JOIN asset_depreciation_lines l ON l.run_id=r.id "
        "WHERE r.company_id=? GROUP BY r.id ORDER BY r.id DESC LIMIT ?",
        (company_id, int(limit))
    )]


def user_restrictions(conn, user_id):
    branches = [r[0] for r in conn.execute("SELECT branch_id FROM user_branch_access WHERE user_id=?", (user_id,))]
    warehouses = [r[0] for r in conn.execute("SELECT warehouse_id FROM user_warehouse_access WHERE user_id=?", (user_id,))]
    cash_accounts = [r[0] for r in conn.execute("SELECT cash_account_id FROM user_cash_access WHERE user_id=?", (user_id,))]
    return {'branches': branches, 'warehouses': warehouses, 'cash_accounts': cash_accounts}


def branches_list(conn, company_id, user_id=None):
    """الفروع النشطة؛ ومع user_id يُقتصر على فروع المستخدم المقيَّد (بلا تقييد = كلها)."""
    q, a = "SELECT id, code, name FROM branches WHERE company_id=? AND is_active=1", [company_id]
    if user_id is not None and conn.execute("SELECT 1 FROM user_branch_access WHERE user_id=? LIMIT 1", (user_id,)).fetchone():
        q += " AND id IN (SELECT branch_id FROM user_branch_access WHERE user_id=?)"; a.append(user_id)
    return [dict(r) for r in conn.execute(q + " ORDER BY id", a)]


def tax_report_data(conn, company_id, date_from, date_to, branch_id=None):
    """بيانات الإقرار الضريبي: مبيعات ومشتريات مع مرتجعاتها وضريبتها للفترة."""
    q_s = (
        "SELECT doc_type, COALESCE(SUM(net_ex_total), 0) net, COALESCE(SUM(tax_total), 0) tax "
        "FROM sales_invoices "
        "WHERE company_id=? AND status='posted' AND invoice_date BETWEEN ? AND ?"
    )
    p_s = [company_id, date_from, date_to]
    if branch_id:
        q_s += " AND branch_id=?"
        p_s.append(branch_id)
    q_s += " GROUP BY doc_type"
    sales_rows = {r['doc_type']: (r['net'], r['tax']) for r in conn.execute(q_s, p_s)}

    q_p = (
        "SELECT doc_type, COALESCE(SUM(net_ex_total), 0) net, COALESCE(SUM(tax_total), 0) tax "
        "FROM purchase_invoices "
        "WHERE company_id=? AND status='posted' AND invoice_date BETWEEN ? AND ?"
    )
    p_p = [company_id, date_from, date_to]
    if branch_id:
        q_p += " AND branch_id=?"
        p_p.append(branch_id)
    q_p += " GROUP BY doc_type"
    purch_rows = {r['doc_type']: (r['net'], r['tax']) for r in conn.execute(q_p, p_p)}

    return {'sales': sales_rows, 'purchases': purch_rows}


def default_view_label(conn, company_id):
    """نص خيار «العرض الافتراضي» في قوائم اختيار عملة الكشوف: كل الحركات محوّلة بسعر الصرف إلى العملة الأساسية."""
    row = next((c for c in currencies_list(conn, company_id) if c.get('is_base')), None)
    name = (row.get('name_ar') or row['code']) if row else 'العملة الأساسية'
    return f'العرض الافتراضي (محوّل بسعر الصرف إلى {name})'


def party_account_options(conn, company_id, kind):

def fiscal_overview(conn, company_id):
    """كل السنوات المالية مع فتراتها وحالاتها: [{id,name,start,end,status,periods:[{id,no,name,start,end,status}]}]."""
    years = []
    for y in conn.execute("SELECT id,name,start_date,end_date,status FROM fiscal_years WHERE company_id=? ORDER BY start_date", (company_id,)):
        periods = [{'id': p['id'], 'no': p['period_no'], 'name': p['name'], 'start': p['start_date'], 'end': p['end_date'], 'status': p['status']}
                   for p in conn.execute("SELECT id,period_no,name,start_date,end_date,status FROM fiscal_periods WHERE fiscal_year_id=? ORDER BY period_no", (y['id'],))]
        years.append({'id': y['id'], 'name': y['name'], 'start': y['start_date'], 'end': y['end_date'], 'status': y['status'], 'periods': periods})
    return years


def current_fiscal_context(conn, company_id, today=None):
    """(سنة، فترة) لتاريخ اليوم؛ وإن لم يقع اليوم في أي فترة فآخر فترة معرّفة. (None, None) إن لم توجد سنوات."""
    iso = (today or date.today()).isoformat()
    r = conn.execute(
        "SELECT y.id yid,y.name yname,y.start_date ys_,y.end_date ye_,y.status ystatus,"
        "p.id pid,p.name pname,p.start_date ps_,p.end_date pe_,p.status pstatus "
        "FROM fiscal_periods p JOIN fiscal_years y ON y.id=p.fiscal_year_id "
        "WHERE y.company_id=? AND ? BETWEEN p.start_date AND p.end_date", (company_id, iso)).fetchone()
    if not r:
        r = conn.execute(
            "SELECT y.id yid,y.name yname,y.start_date ys_,y.end_date ye_,y.status ystatus,"
            "p.id pid,p.name pname,p.start_date ps_,p.end_date pe_,p.status pstatus "
            "FROM fiscal_periods p JOIN fiscal_years y ON y.id=p.fiscal_year_id "
            "WHERE y.company_id=? ORDER BY p.end_date DESC LIMIT 1", (company_id,)).fetchone()
    if not r:
        return None, None
    return ({'id': r['yid'], 'name': r['yname'], 'start': r['ys_'], 'end': r['ye_'], 'status': r['ystatus']},
            {'id': r['pid'], 'name': r['pname'], 'start': r['ps_'], 'end': r['pe_'], 'status': r['pstatus']})


def pending_journal_counts(conn, company_id, branch_id=None):
    """عدد مسودات القيود بحسب حالة سير العمل: {'draft': n, 'reviewed': n, 'approved': n}."""
    q = "SELECT workflow_state ws, COUNT(*) n FROM journal_entries WHERE company_id=? AND status='draft'"
    a = [company_id]
    if branch_id:
        q += " AND (branch_id=? OR branch_id IS NULL)"       # القيد بلا فرع إجراؤه ممكن من أي فرع، فيُنبَّه إليه
        a.append(branch_id)
    q += " GROUP BY workflow_state"
    got = {r['ws']: r['n'] for r in conn.execute(q, a)}
    return {'draft': got.get('draft', 0), 'reviewed': got.get('reviewed', 0), 'approved': got.get('approved', 0)}


def draft_document_counts(conn, company_id, branch_id=None):
    """مستندات مسودة لم تُرحَّل: فواتير مبيعات ومشتريات وسندات."""
    out = {}
    for key, table in (('sales', 'sales_invoices'), ('purchases', 'purchase_invoices'), ('vouchers', 'cash_vouchers')):
        q = f"SELECT COUNT(*) FROM {table} WHERE company_id=? AND status='draft'"
        a = [company_id]
        if branch_id:
            q += " AND (branch_id=? OR branch_id IS NULL)"       # القيد بلا فرع إجراؤه ممكن من أي فرع، فيُنبَّه إليه
            a.append(branch_id)
        out[key] = conn.execute(q, a).fetchone()[0]
    return out


def journal_counterparties(conn, rows):
    """«من / إلى (الطرف المقابل)» لقيود السندات النقدية في قائمة القيود (SELECT فقط): {entry_id: «من: X» | «إلى: X»}.

    سند القبض «من» الطرف المقابل، وسند الصرف «إلى» الطرف المقابل. الطرف المقابل هو العميل/المورد/الموظف إن وُجد، وإلا أسماء
    الحسابات المقابلة في بنود السند. والقيد اليدوي البسيط يعرض «إلى: الحساب الدائن». غير ذلك يبقى بلا قيمة.
    """
    out = simple_entry_counters(conn, rows)
    by_voucher = {}
    for r in rows:
        if r.get('source_type') == 'cash_voucher' and r.get('source_id'):
            by_voucher.setdefault(int(r['source_id']), []).append(r['id'])
    if not by_voucher:
        return out
    vids = list(by_voucher)
    ph = ','.join('?' for _ in vids)
    vouchers = {v['id']: v for v in conn.execute(
        f"SELECT v.id, v.voucher_type, p.name AS party_name FROM cash_vouchers v LEFT JOIN parties p ON p.id=v.party_id "
        f"WHERE v.id IN ({ph})", vids)}
    accs = {}
    for l in conn.execute(f"SELECT l.voucher_id v, a.name n FROM cash_voucher_lines l JOIN accounts a ON a.id=l.account_id "
                          f"WHERE l.voucher_id IN ({ph}) ORDER BY l.voucher_id, l.line_no", vids):
        accs.setdefault(l['v'], []).append(l['n'])
    for vid, eids in by_voucher.items():
        v = vouchers.get(vid)
        if not v:
            continue
        cp = v['party_name'] or '، '.join(dict.fromkeys(accs.get(vid, [])))
        if cp:
            label = ('من: ' if v['voucher_type'] == 'receipt' else 'إلى: ') + cp
            for e in eids:
                out[e] = label
    return out


def journal_voucher_notes(conn, rows):
    """بيان سندات القبض/الصرف لقيودها في قائمة القيود (SELECT فقط): {entry_id: البيان}. هو البيان والمرجع (ملاحظة/رقم السند الدفتري)."""
    by_voucher = {}
    for r in rows:
        if r.get('source_type') == 'cash_voucher' and r.get('source_id'):
            by_voucher.setdefault(int(r['source_id']), []).append(r['id'])
    if not by_voucher:
        return {}
    vids = list(by_voucher)
    out = {}
    for i in range(0, len(vids), 500):
        part = vids[i:i + 500]
        for v in conn.execute(f"SELECT id, description FROM cash_vouchers WHERE id IN ({','.join('?' for _ in part)})", part):
            note = (v['description'] or '').strip()
            if note:
                for e in by_voucher[v['id']]:
                    out[e] = note
    return out


def journal_list_extras(conn, entry_ids):
    """إثراء قائمة القيود: الإجمالي والمرفقات وروابط العكس (SELECT فقط)."""
    if not entry_ids:
        return {}
    ph = ','.join('?' for _ in entry_ids)
    totals = {r['eid']: r['total'] for r in conn.execute(
        f"SELECT entry_id eid, COALESCE(SUM(debit_base),0) total FROM journal_lines WHERE entry_id IN ({ph}) GROUP BY entry_id",
        entry_ids)}
    curs = {}                                              # عملة القيد: رمزها إن كانت كل أسطره بعملة واحدة وإلا «متعددة»
    for r in conn.execute(
            f"SELECT entry_id eid, currency cur, COALESCE(SUM(debit_orig),0) d FROM journal_lines WHERE entry_id IN ({ph}) "
            f"GROUP BY entry_id, currency", entry_ids):
        curs.setdefault(r['eid'], []).append((r['cur'], r['d']))
    has_att = conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='journal_attachments'").fetchone()
    atts = {}
    if has_att:
        for r in conn.execute(f"SELECT entry_id eid, COUNT(*) n FROM journal_attachments WHERE entry_id IN ({ph}) GROUP BY entry_id", entry_ids):
            atts[r['eid']] = r['n']
    id_to_label = {}
    label_to_id = {}
    for r in conn.execute(f"SELECT id, COALESCE(posted_no, entry_no) label_no FROM journal_entries WHERE id IN ({ph})", entry_ids):
        id_to_label[r['id']] = r['label_no']
        if r['label_no'] is not None:
            label_to_id[r['label_no']] = r['id']
    reverses = {}
    reversed_by = {}
    for r in conn.execute(f"SELECT id, reverses_entry_id FROM journal_entries WHERE id IN ({ph}) AND reverses_entry_id IS NOT NULL", entry_ids):
        reverses[r['id']] = id_to_label.get(r['reverses_entry_id'])
    if entry_ids:
        for r in conn.execute(f"SELECT reverses_entry_id rid, id FROM journal_entries WHERE reverses_entry_id IN ({ph})", entry_ids):
            if r['rid'] in id_to_label:
                reversed_by[r['rid']] = id_to_label.get(r['id'])
    out = {}
    for eid in entry_ids:
        cl = curs.get(eid) or []
        out[eid] = {'total_minor': totals.get(eid, 0), 'attachments': atts.get(eid, 0),
                    'currency': (cl[0][0] if len(cl) == 1 else ('متعددة' if cl else '')),
                    'total_orig_minor': (cl[0][1] if len(cl) == 1 else None),
                    'label_no': id_to_label.get(eid), 'reverses_no': reverses.get(eid), 'reversed_by_no': reversed_by.get(eid)}
    return out



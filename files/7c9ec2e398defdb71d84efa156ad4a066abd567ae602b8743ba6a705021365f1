"""تنسيق المبالغ والتواريخ والكميات (مصدر وحيد) + المبلغ كتابةً بالعربية.

قاعدة: `Decimal` فقط لكل مبلغ. لا `float` في هذه الحزمة. التنسيق للعرض فقط ولا يغيّر القيمة المخزنة.
يعتمد على logic.py الحالي للتحليل (parse_money) حتى لا يتكرر المنطق.
"""
from datetime import date, datetime
from decimal import Decimal, InvalidOperation, ROUND_HALF_UP

from alhisabat.ui.core.logic import parse_money, to_ascii_digits, strip_bidi  # noqa: F401

_TO_ARABIC = str.maketrans('0123456789.,', '٠١٢٣٤٥٦٧٨٩٫٬')
_CFG = {'digits': 'latin', 'neg': 'parens'}   # digits: latin|arabic ، neg: parens|minus


def configure(digits=None, neg=None):
    if digits in ('latin', 'arabic'):
        _CFG['digits'] = digits
    if neg in ('parens', 'minus'):
        _CFG['neg'] = neg


def _digits(s):
    return s.translate(_TO_ARABIC) if _CFG['digits'] == 'arabic' else s


def to_decimal(v):
    if v is None or v == '':
        return None
    if isinstance(v, Decimal):
        return v
    if isinstance(v, float):
        raise TypeError('ممنوع استخدام float للمبالغ: مرّر Decimal أو نصًا')
    try:
        return Decimal(str(v))
    except InvalidOperation:
        return None


def minor_to_decimal(m):
    """وحدات صغرى (÷100) → Decimal."""
    return None if m is None else Decimal(int(m)) / 100


def decimal_to_minor(d):
    """Decimal → وحدات صغرى بتقريب نصف-لأعلى."""
    return int((Decimal(d) * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))


def fmt_money(v, places=2, currency=None, neg=None, zero_dash=False, minor=False):
    """نص المبلغ بفواصل الآلاف. السالب بين أقواس أو بعلامة (لا باللون وحده). None ← «—»."""
    d = to_decimal(v)
    if d is None:
        return '—'
    if minor:
        d = d / 100
    if zero_dash and d == 0:
        return '—'
    q = Decimal(1).scaleb(-places)
    d = d.quantize(q, rounding=ROUND_HALF_UP)
    body = _digits(f'{abs(d):,.{places}f}')
    if currency:
        body = f'{body} {currency}'
    if d < 0:
        return f'({body})' if (neg or _CFG['neg']) == 'parens' else f'-{body}'
    return body


def fmt_qty(milli, places=3):
    """كمية بوحدات ×1000 (qty_milli) ← نص بلا أصفار زائدة."""
    if milli is None:
        return '—'
    d = Decimal(int(milli)) / 1000
    s = f'{d:,.{places}f}'.rstrip('0').rstrip('.')
    return _digits(s or '0')


def fmt_date(v, style='iso'):
    """نص التاريخ. style: iso (2026-09-30) | dmy (30/09/2026)."""
    if v in (None, ''):
        return '—'
    if isinstance(v, datetime):
        v = v.date()
    if not isinstance(v, date):
        try:
            v = date.fromisoformat(str(v)[:10])
        except ValueError:
            return str(v)
    s = v.strftime('%d/%m/%Y') if style == 'dmy' else v.isoformat()
    return _digits(s)


def is_negative(v):
    d = to_decimal(v)
    return d is not None and d < 0



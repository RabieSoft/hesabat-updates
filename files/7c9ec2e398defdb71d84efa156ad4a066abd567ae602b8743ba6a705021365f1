            'BHD': 'بحريني', 'JOD': 'أردني', 'IQD': 'عراقي', 'EGP': 'مصري', 'USD': 'أمريكي'}


def _below_1000(n, masc):
    """1..999 بالكلمات (n>0). masc = جنس المعدود في خانة الآحاد."""
    ones = _ONES_M if masc else _ONES_F
    parts = []
    h, r = divmod(n, 100)
    if h:
        parts.append(_HUNDREDS[h])
    if r:
        if r < 20:
            parts.append(ones[r])
        else:
            t, u = divmod(r, 10)
            parts.append(f'{ones[u]} و{_TENS[t]}' if u else _TENS[t])
    return ' و'.join(parts)


_CONSTRUCT = (('ألفان', 'ألفا'), ('مليونان', 'مليونا'), ('ملياران', 'مليارا'), ('تريليونان', 'تريليونا'), ('مائتان', 'مائتا'))


def _to_construct(words):
    """حالة الإضافة حين يلي العددَ المعدودُ مباشرة: «مائتا ريال» و«ألفا ريال» لا «مائتان ريال»."""
    for full, short in _CONSTRUCT:
        if words.endswith(full):
            return words[:-len(full)] + short
    return words


def int_to_words(n, masc=True, construct=False):
    """عدد صحيح ≥ 0 بالعربية. المجموعات الكبيرة (آلاف فأكثر) مذكّرة دائمًا؛ masc يخص خانة الآحاد.
    construct=True: يليه معدود مباشرة (عملة) فيُستعمل المفرد بدل المنصوب ويُضاف المثنى."""
    n = int(n)
    if n == 0:
        return 'صفر'
    if n >= 10 ** 15:
        raise ValueError('المبلغ أكبر من المدى المدعوم للكتابة بالحروف')
    groups = []
    k = 0
    while n:
        n, g = divmod(n, 1000)
        groups.append((k, g))
        k += 1
    out = []
    for k, g in reversed(groups):
        if g == 0:
            continue
        if k == 0:
            out.append(_below_1000(g, masc))
            continue
        one, dual, plur, acc = _SCALES[k]
        last2 = g % 100
        if g == 1:
            out.append(one)
        elif g == 2:
            out.append(dual)
        elif 3 <= last2 <= 10 or (3 <= g <= 10):
            out.append(f'{_below_1000(g, True)} {plur}')
        elif 11 <= last2 <= 99:
            is_last = all(x[1] == 0 for x in groups if x[0] < k)
            out.append(f'{_below_1000(g, True)} {one if (construct and is_last) else acc}')
        else:  # تنتهي بـ 00 أو 01 أو 02 (مع مئات)
            w = _below_1000(g, True)
            out.append(f'{_to_construct(w) if g % 100 == 0 else w} {one}')
    text = ' و'.join(out)
    return _to_construct(text) if construct else text


def _unit_phrase(n, unit, adj=''):
    """عدد + معدود (+ نسبة العملة بمطابقتها): «ريال سعودي واحد» «ريالان سعوديان» «ثلاثة ريالات سعودية» «أحد عشر ريالًا سعوديًا»."""
    one, dual, plur, acc, masc = unit
    if n == 0:
        return ''
    if n == 1:
        return f'{one} {adj} {_ONES_M[1] if masc else _ONES_F[1]}' if adj else f'{one} {_ONES_M[1] if masc else _ONES_F[1]}'
    if n == 2:
        return f'{dual} {adj}ان' if adj else dual
    words = int_to_words(n, masc, construct=(n % 100 == 0 or n % 100 > 10) and not (11 <= n % 100 <= 99))
    last2 = n % 100
    if 3 <= last2 <= 10:
        noun, a = plur, (adj + 'ة' if adj else '')
    elif 11 <= last2 <= 99:
        noun, a = acc, (adj + 'ًا' if adj else '')
    else:
        noun, a = one, adj
    return f'{words} {noun} {a}'.strip().replace('  ', ' ')


def amount_in_words(amount, currency='SAR', prefix='فقط', suffix='لا غير'):
    """المبلغ كتابةً: «فقط ألف ومائتان وخمسون ريالًا وخمسون هللة لا غير». 2 خانة عشرية كحد أقصى."""
    d = to_decimal(amount)
    if d is None:
        return ''
    neg = d < 0
    d = abs(d).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    whole = int(d)
    frac = int((d - whole) * 100)
    adj = _CUR_ADJ.get(str(currency).upper(), '')
    major, minor = _CUR.get(str(currency).upper(), ((str(currency), str(currency), str(currency), str(currency), True),
                                                     ('جزء', 'جزءان', 'أجزاء', 'جزءًا', True)))
    parts = []
    if whole or not frac:
        parts.append(_unit_phrase(whole, major, adj) if whole else f'صفر {major[0]}' + (f' {adj}' if adj else ''))
    if frac:
        parts.append(_unit_phrase(frac, minor))
    text = ' و'.join(parts)
    if neg:
        text = 'سالب ' + text
    return ' '.join(x for x in (prefix, text, suffix) if x)
